    "app.transfer.upgrade.data_safe": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يضِع شيء. مكتبتك قابلة للقراءة وكل نسخة محلية سليمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist nichts verloren gegangen. Deine Mediathek ist lesbar und jede lokale Kopie ist intakt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been lost. Your library is readable and every local copy is intact."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha perdido nada. Tu biblioteca se puede leer y todas las copias locales están intactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été perdu. Votre bibliothèque reste lisible et chaque copie locale est intacte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी नहीं खोया है। आपकी लाइब्रेरी पढ़ी जा सकती है और हर स्थानीय कॉपी सुरक्षित है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è andato perso nulla. La tua libreria è leggibile e ogni copia locale è intatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失われたものはありません。ライブラリは閲覧可能で、ローカルのコピーはすべて無事です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손실된 것은 없습니다. 보관함을 읽을 수 있으며 모든 로컬 사본이 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi perdido. Sua biblioteca pode ser lida e todas as cópias locais estão intactas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не потеряно. Ваша медиатека доступна для чтения, а все локальные копии целы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有丢失任何内容。您的资料库可正常读取，所有本地副本均完好无损。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有遺失任何內容。您的圖庫仍可讀取，所有本機副本皆完好無損。"
          }
        }
      }
    },
    "app.transfer.upgrade.explanation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتقل خادمك إلى إصدار لا يفهمه هذا التطبيق. لا مجال للتفاوض — تحديث Capsule هو الحل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server verwendet jetzt eine Version, die diese App nicht versteht. Da gibt es nichts auszuhandeln – ein Update von Capsule ist die Lösung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server has moved on to a version this app doesn't speak. There's nothing to negotiate — updating Capsule is the fix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor se ha actualizado a una versión que esta app no entiende. No hay nada que negociar: la solución es actualizar Capsule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur est passé à une version que cette app ne prend pas en charge. Il n'y a rien à négocier : la solution est de mettre à jour Capsule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सर्वर एक ऐसे संस्करण पर चला गया है जिसे यह ऐप नहीं समझता। इसका एकमात्र समाधान Capsule को अपडेट करना है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server è passato a una versione che questa app non supporta. Non c'è nulla da negoziare: la soluzione è aggiornare Capsule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが、このアプリでは対応していないバージョンに移行しました。Capsule をアップデートすることで解決します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 앱이 지원하지 않는 버전으로 업데이트되었습니다. 다른 방법은 없으며, Capsule을 업데이트하면 해결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor passou para uma versão que este app não entende. Não há o que negociar — atualizar o Capsule é a solução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер перешёл на версию, которую это приложение не поддерживает. Договориться не получится — нужно обновить Capsule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器已升级到此应用不支持的版本。无需协商——更新 Capsule 即可解决。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的伺服器已更新至此 App 不支援的版本。沒有其他折衷辦法——更新 Capsule 即可解決。"
          }
        }
      }
    },
