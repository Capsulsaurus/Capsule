        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 원본은 반복된 오류로 인해 일시적으로 백오프되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fonte está temporariamente em espera após erros repetidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот источник временно приостановлен после повторяющихся ошибок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
