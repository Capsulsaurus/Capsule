    "app.recovery.passphrase.done.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بعبارتك في مكان آمن. ستحتاج إليها إذا فقدت جميع أجهزتك يومًا ما."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahre deine Phrase an einem sicheren Ort auf. Du brauchst sie, falls du jemals alle Geräte verlierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep your phrase somewhere safe. You'll need it if you ever lose every device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda tu frase en un lugar seguro. La necesitarás si alguna vez pierdes todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez votre phrase en lieu sûr. Vous en aurez besoin si vous perdez un jour tous vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना फ़्रेज़ किसी सुरक्षित जगह पर रखें। अगर आप कभी अपने सभी डिवाइस खो दें, तो आपको इसकी ज़रूरत होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva la frase in un posto sicuro. Ti servirà se perderai tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレーズは安全な場所に保管してください。すべてのデバイスを失った場合に必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문구를 안전한 곳에 보관하세요. 모든 기기를 잃어버렸을 때 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde sua frase em um lugar seguro. Você vai precisar dela se um dia perder todos os seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните фразу в надёжном месте. Она понадобится, если вы потеряете все устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将短语保存在安全的地方。如果您丢失了所有设备，将需要用到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將短語存放在安全的地方。如果您遺失了所有裝置，就會需要它。"
          }
        }
      }
    },
