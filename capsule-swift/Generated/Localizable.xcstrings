    "app.custody.action.release.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد خادمك وجود هذه الصورة، لذا يمكن تحرير النسخة الموجودة على هذا الجهاز. سيعيد Capsule تنزيلها عندما تحتاج إليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat dieses Foto bestätigt, daher kann die Kopie auf diesem Gerät freigegeben werden. Capsule lädt es erneut, wenn du es brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server has confirmed this photo, so the copy on this device can be freed. Capsule downloads it again when you need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor ha confirmado esta foto, así que se puede liberar la copia de este dispositivo. Capsule la volverá a descargar cuando la necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur a confirmé cette photo : la copie sur cet appareil peut donc être libérée. Capsule la téléchargera à nouveau quand vous en aurez besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर ने इस फ़ोटो की पुष्टि कर दी है, इसलिए इस डिवाइस की कॉपी हटाई जा सकती है। ज़रूरत पड़ने पर Capsule इसे फिर से डाउनलोड कर लेता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server ha confermato questa foto, quindi la copia su questo dispositivo può essere liberata. Capsule la scaricherà di nuovo quando ti servirà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがこの写真を確認したため、このデバイス上のコピーを解放できます。必要なときに Capsule が再度ダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 사진을 확인했으므로 이 기기의 사본을 해제할 수 있습니다. 필요할 때 Capsule이 다시 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor confirmou esta foto, então a cópia neste dispositivo pode ser liberada. O Capsule a baixa novamente quando você precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер подтвердил хранение этого фото, поэтому копию на этом устройстве можно освободить. Capsule снова загрузит её, когда она понадобится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器已确认保存此照片，因此可以释放此设备上的副本。需要时 Capsule 会重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的伺服器已確認此照片，因此可以釋放此裝置上的副本。需要時 Capsule 會重新下載。"
          }
        }
      }
    },
