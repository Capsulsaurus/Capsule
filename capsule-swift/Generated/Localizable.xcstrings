    "app.settings.storage.budget.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تجاوز الحد، يمسح Capsule أقدم النسخ التي تم تنزيلها أولًا. يُعاد جلب أي شيء يُمسح عند الحاجة إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird das Limit überschritten, löscht Capsule zuerst die ältesten geladenen Kopien. Gelöschtes wird erneut geladen, wenn du es brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule clears the oldest downloaded copies first when it goes over. Anything cleared is fetched again when you need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se supera, Capsule borra primero las copias descargadas más antiguas. Todo lo borrado se vuelve a descargar cuando lo necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cas de dépassement, Capsule efface d'abord les copies téléchargées les plus anciennes. Tout ce qui est effacé est récupéré à nouveau quand vous en avez besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमा पार होने पर Capsule सबसे पुरानी डाउनलोड की गई कॉपियाँ पहले साफ़ करता है। साफ़ की गई कोई भी चीज़ ज़रूरत पड़ने पर फिर से लाई जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando supera il limite, Capsule cancella prima le copie scaricate più vecchie. Ciò che viene cancellato viene scaricato di nuovo quando ti serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を超えると、Capsule はダウンロード済みのコピーを古いものから順に削除します。削除したものは必要なときに再度取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한도를 넘으면 Capsule이 가장 오래된 다운로드 사본부터 정리합니다. 정리된 항목은 필요할 때 다시 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando passa do limite, o Capsule limpa primeiro as cópias baixadas mais antigas. O que for limpo é baixado de novo quando você precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При превышении лимита Capsule сначала удаляет самые старые загруженные копии. Удалённое загружается снова, когда понадобится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超出上限时，Capsule 会先清除最早下载的副本。被清除的内容会在需要时重新获取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "超過上限時，Capsule 會先清除最舊的已下載副本。清除的內容會在您需要時再次下載。"
          }
        }
      }
    },
