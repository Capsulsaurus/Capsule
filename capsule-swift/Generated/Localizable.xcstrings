    "app.settings.language.catalog.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل الترجمات فور اكتمالها. يُعرض كل ما لم يُترجم بعد باللغة الإنجليزية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übersetzungen kommen hinzu, sobald sie fertig sind. Was noch nicht übersetzt ist, wird auf Englisch angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Translations arrive as they're finished. Anything not yet translated is shown in English."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las traducciones llegan a medida que se terminan. Lo que aún no está traducido se muestra en inglés."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les traductions arrivent au fur et à mesure qu'elles sont terminées. Tout ce qui n'est pas encore traduit s'affiche en anglais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुवाद पूरे होते ही उपलब्ध होते जाते हैं। जिसका अनुवाद अभी नहीं हुआ है, वह अंग्रेज़ी में दिखाया जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le traduzioni arrivano man mano che vengono completate. Ciò che non è ancora tradotto viene mostrato in inglese."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "翻訳は完成しだい追加されます。まだ翻訳されていない部分は英語で表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "번역은 완료되는 대로 제공됩니다. 아직 번역되지 않은 항목은 영어로 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As traduções chegam conforme ficam prontas. O que ainda não foi traduzido aparece em inglês."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переводы появляются по мере готовности. Всё, что ещё не переведено, отображается на английском."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "翻译完成后即会推出。尚未翻译的内容将以英文显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "翻譯完成後就會推出。尚未翻譯的內容會以英文顯示。"
          }
        }
      }
    },
