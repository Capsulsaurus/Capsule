    "app.federation.note.auto_recovery": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يواصل Capsule المحاولة تلقائيًا. لا يلزمك فعل أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule versucht es automatisch weiter. Du musst nichts tun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule keeps trying on its own. There's nothing you need to do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule sigue intentándolo por sí solo. No tienes que hacer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule continue d'essayer automatiquement. Vous n'avez rien à faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule अपने आप प्रयास करता रहता है। आपको कुछ करने की ज़रूरत नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule continua a riprovare da solo. Non devi fare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule が自動的に再試行し続けます。操作は必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 자동으로 계속 시도합니다. 따로 하실 일은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule continua tentando automaticamente. Você não precisa fazer nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule продолжает попытки самостоятельно. Вам ничего не нужно делать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 会自动持续重试，您无需进行任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會自動持續重試，你不需要做任何事。"
          }
        }
      }
    },
    "app.federation.note.never_removed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُزال الصور من عرضك أبدًا لأن أحد الخوادم صامت. فهي تعود عندما يستجيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos verschwinden nie aus deiner Ansicht, nur weil ein Server nicht antwortet. Sie kehren zurück, sobald er wieder antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are never removed from your view because a server is quiet. They come back when it answers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos nunca desaparecen de tu vista porque un servidor no responda. Vuelven cuando responde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos ne disparaissent jamais de votre vue parce qu'un serveur ne répond pas. Elles reviennent dès qu'il répond."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी सर्वर के चुप होने पर फ़ोटो आपके व्यू से कभी नहीं हटाई जातीं। उसके उत्तर देने पर वे वापस आ जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto non vengono mai rimosse dalla tua vista perché un server tace. Tornano quando risponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが応答しなくても、写真が表示から削除されることはありません。応答が戻れば再び表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 응답하지 않는다고 해서 사진이 화면에서 제거되지는 않습니다. 서버가 응답하면 다시 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos nunca são removidas da sua visualização porque um servidor está em silêncio. Elas voltam quando ele responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото никогда не пропадают из виду из-за того, что сервер молчит. Они вернутся, когда он ответит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片绝不会因为某台服务器没有响应而从您的视图中移除。服务器恢复响应后，照片就会回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片絕不會因為伺服器沒有回應而從你的畫面中移除。伺服器回應後照片就會回來。"
          }
        }
      }
    },
    "app.federation.note.no_kick": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لأحد إزالة شخص آخر من هذا الألبوم. يمكنك إيقاف مشاركة صورك، أما صور الآخرين فسحبها يعود إليهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand kann jemand anderen aus diesem Album entfernen. Du kannst aufhören, deine eigenen Fotos zu teilen; die Fotos anderer können nur diese selbst zurückziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nobody can remove someone else from this album. You can stop sharing your own photos; other people's are theirs to withdraw."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie puede expulsar a otra persona de este álbum. Puedes dejar de compartir tus propias fotos; las de los demás solo pueden retirarlas ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personne ne peut retirer quelqu'un d'autre de cet album. Vous pouvez cesser de partager vos propres photos ; c'est aux autres de retirer les leurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी किसी और को इस एल्बम से नहीं हटा सकता। आप अपनी फ़ोटो साझा करना बंद कर सकते हैं; दूसरों की फ़ोटो वापस लेना उनका काम है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno può rimuovere qualcun altro da questo album. Puoi smettere di condividere le tue foto; quelle degli altri spetta a loro ritirarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムから他人を削除することは誰にもできません。自分の写真の共有は停止できますが、他人の写真を取り下げるのはその人自身です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누구도 다른 사람을 이 앨범에서 제거할 수 없습니다. 자신의 사진 공유는 중단할 수 있지만, 다른 사람의 사진은 그 사람만 철회할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém pode remover outra pessoa deste álbum. Você pode parar de compartilhar suas próprias fotos; as das outras pessoas cabe a elas retirar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никто не может удалить другого участника из этого альбома. Вы можете перестать делиться своими фото, а фото других участников могут убрать только они сами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何人都无法将他人移出此相册。您可以停止共享自己的照片；他人的照片只能由他们自己撤回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有人可以將其他人從此相簿中移除。你可以停止分享自己的照片；其他人的照片則由他們自行撤回。"
          }
        }
      }
    },
