    "app.settings.server.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل Capsule على هذا الجهاز فقط. اربط خادمًا للنسخ الاحتياطي والمزامنة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule läuft nur auf diesem Gerät. Verbinde einen Server, um Backups zu erstellen und zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule is running on this device only. Connect a server to back up and sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule se está ejecutando solo en este dispositivo. Conecta un servidor para hacer copias de seguridad y sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule fonctionne uniquement sur cet appareil. Connectez un serveur pour sauvegarder et synchroniser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule केवल इस डिवाइस पर चल रहा है। बैकअप और सिंक के लिए कोई सर्वर कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule è in esecuzione solo su questo dispositivo. Collega un server per eseguire backup e sincronizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はこのデバイスのみで動作しています。バックアップと同期を行うにはサーバーに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 이 기기에서만 실행 중입니다. 백업하고 동기화하려면 서버를 연결하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule está funcionando só neste dispositivo. Conecte um servidor para fazer backup e sincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule работает только на этом устройстве. Подключите сервер для резервного копирования и синхронизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 目前仅在此设备上运行。连接服务器以进行备份和同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 目前僅在此裝置上執行。連接伺服器即可備份和同步。"
          }
        }
      }
    },
