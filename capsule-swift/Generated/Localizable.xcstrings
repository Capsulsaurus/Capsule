    "app.settings.recovery.restore.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيطابق Capsule هذا الجهاز مع ما تفتحه عبارتك. توضح القواعد الأربع أعلاه بدقة ما يحدث لكل صورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule gleicht dieses Gerät mit dem ab, was deine Phrase entsperrt. Die vier Regeln oben beschreiben genau, was mit jedem Foto passiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule will reconcile this device against what your phrase unlocks. The four rules above say exactly what happens to each photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule conciliará este dispositivo con lo que desbloquea tu frase. Las cuatro reglas de arriba indican exactamente qué ocurre con cada foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule va rapprocher cet appareil de ce que votre phrase déverrouille. Les quatre règles ci-dessus indiquent précisément ce qu'il advient de chaque photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule इस डिवाइस का मिलान उससे करेगा जो आपका फ़्रेज़ अनलॉक करता है। ऊपर दिए चार नियम बताते हैं कि हर फ़ोटो के साथ ठीक-ठीक क्या होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule riallineerà questo dispositivo con ciò che la tua frase sblocca. Le quattro regole qui sopra indicano esattamente cosa succede a ogni foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は、フレーズで解除される内容とこのデバイスを照合します。各写真がどうなるかは、上記の4つのルールのとおりです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 복구 문구로 잠금 해제되는 항목과 이 기기를 대조합니다. 위의 네 가지 규칙에 각 사진이 어떻게 처리되는지 정확히 나와 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule vai conciliar este dispositivo com o que sua frase desbloqueia. As quatro regras acima dizem exatamente o que acontece com cada foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule сверит это устройство с тем, что открывает ваша фраза. Четыре правила выше точно описывают, что произойдёт с каждым фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 将根据您的短语所能解锁的内容来核对此设备。上面的四条规则说明了每张照片会如何处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會依據您的詞組可解鎖的內容來核對此裝置。上方的四條規則已說明每張照片會如何處理。"
          }
        }
      }
    },
