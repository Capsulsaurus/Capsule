    "app.moderation.section.audit_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل هنا كل إجراء يتخذه خادمك. لا يحذف أي منها صورك — بل توقف خادمك عن تقديمها، وتبقى نسخك الخاصة ونسخك الاحتياطية كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Maßnahme deines Servers wird hier festgehalten. Keine davon löscht deine Fotos – sie verhindern nur, dass dein Server sie bereitstellt. Deine eigenen Kopien und Backups bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action your server takes is recorded here. None of them delete your photos — they stop your server serving them, and your own copies and backups are untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medida que toma tu servidor queda registrada aquí. Ninguna elimina tus fotos: hacen que tu servidor deje de servirlas, y tus propias copias y copias de seguridad no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mesure prise par votre serveur est enregistrée ici. Aucune ne supprime vos photos : elles empêchent seulement votre serveur de les diffuser, et vos propres copies et sauvegardes restent intactes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सर्वर जो भी कार्रवाई करता है, वह यहाँ दर्ज होती है। इनमें से कोई भी आपकी फ़ोटो नहीं हटाती — वे बस आपके सर्वर को उन्हें दिखाने से रोकती हैं, और आपकी अपनी कॉपी और बैकअप सुरक्षित रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni azione intrapresa dal tuo server viene registrata qui. Nessuna elimina le tue foto: impediscono al server di distribuirle, mentre le tue copie e i tuoi backup restano intatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが行うすべての措置はここに記録されます。いずれも写真を削除するものではありません。サーバーからの提供が停止されるだけで、手元のコピーやバックアップはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 취하는 모든 조치가 여기에 기록됩니다. 어떤 조치도 사진을 삭제하지 않습니다. 서버가 사진을 제공하지 않게 될 뿐, 사용자 본인의 사본과 백업은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda ação que seu servidor toma fica registrada aqui. Nenhuma delas apaga suas fotos — elas impedem que seu servidor as disponibilize, e suas próprias cópias e backups permanecem intactos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое действие вашего сервера записывается здесь. Ни одно из них не удаляет ваши фото — сервер лишь перестаёт их показывать, а ваши собственные копии и резервные копии остаются нетронутыми."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器采取的每项操作都会记录在这里。这些操作都不会删除您的照片，只是让服务器停止提供它们，您自己的副本和备份不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的伺服器採取的每項處置都會記錄在這裡。這些處置都不會刪除您的照片，只會讓伺服器停止提供照片；您自己的副本和備份完全不受影響。"
          }
        }
      }
    },
    "app.moderation.section.blocks": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحظورون"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockiert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Personnes bloquées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक किए गए"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloccati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロック中"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloqueados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокированные"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已屏蔽"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已封鎖"
          }
        }
      }
    },
    "app.moderation.section.blocks_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُزال الشخص المحظور من الألبومات التي تشاركها معه، ولا يمكنه مشاركة ألبومات جديدة معك. أما ما نزّله بالفعل فيبقى لديه — لا يمكن لأي شيء استرجاعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine blockierte Person wird aus Alben entfernt, die du mit ihr teilst, und kann keine neuen mit dir teilen. Was sie bereits heruntergeladen hat, bleibt bei ihr – nichts kann es zurückholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blocked person is removed from albums you share with them and can't share new ones with you. What they already downloaded stays with them — nothing can reach back and take it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona bloqueada se elimina de los álbumes que compartes con ella y no puede compartir álbumes nuevos contigo. Lo que ya descargó se queda con ella: no hay forma de recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une personne bloquée est retirée des albums que vous partagez avec elle et ne peut plus partager de nouveaux albums avec vous. Ce qu'elle a déjà téléchargé lui reste : rien ne peut le lui reprendre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉक किए गए व्यक्ति को उन एल्बम से हटा दिया जाता है जिन्हें आप उनके साथ साझा करते हैं, और वे आपके साथ नए एल्बम साझा नहीं कर सकते। जो उन्होंने पहले ही डाउनलोड कर लिया है वह उनके पास रहता है — कोई भी चीज़ उसे वापस नहीं ले सकती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una persona bloccata viene rimossa dagli album che condividi con lei e non può condividerne di nuovi con te. Ciò che ha già scaricato resta a lei: nulla può riprenderselo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックした相手は共有アルバムから削除され、新たにアルバムを共有できなくなります。相手がすでにダウンロードしたものは相手の手元に残り、取り戻すことはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단된 사람은 공유 중인 앨범에서 제거되며 새 앨범을 공유할 수 없습니다. 이미 다운로드한 항목은 그 사람에게 남아 있으며, 이를 되찾아 올 방법은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma pessoa bloqueada é removida dos álbuns que você compartilha com ela e não pode compartilhar novos álbuns com você. O que ela já baixou continua com ela — nada pode voltar atrás e tirar isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заблокированный человек удаляется из альбомов, которыми вы с ним делитесь, и не может делиться с вами новыми. То, что он уже скачал, остаётся у него — забрать это обратно невозможно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被屏蔽的人会被移出您与其共享的相册，且无法再与您共享新相册。对方已下载的内容仍归其所有，没有任何办法能追回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "被封鎖的人會從您與其共享的相簿中移除，也無法再與您共享新的相簿。對方已下載的內容仍會留在對方手上，沒有任何方式能將其收回。"
          }
        }
      }
    },
