    "error.moderation.account_suspended": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابك موقوف. لا يمكنك الرفع أو المشاركة حتى تتم إعادته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Konto ist gesperrt. Sie können nichts hochladen oder teilen, bis es wiederhergestellt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is suspended. You can't upload or share until it's reinstated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta está suspendida. No puedes subir ni compartir hasta que se restablezca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre compte est suspendu. Vous ne pouvez ni téléverser ni partager tant qu'il n'est pas rétabli."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका खाता निलंबित है। बहाल होने तक आप अपलोड या साझा नहीं कर सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account è sospeso. Non puoi caricare né condividere finché non viene ripristinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントが停止されています。復元されるまで、アップロードや共有はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정이 정지되었습니다. 복구될 때까지 업로드하거나 공유할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta está suspensa. Você não pode enviar nem compartilhar até que ela seja restabelecida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша учётная запись приостановлена. Вы не можете загружать или делиться, пока она не будет восстановлена."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的账户已被停用。在恢复之前，您无法上传或分享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
