    "app.drops.compose.destination.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدخل أي شيء إلى هذا الألبوم حتى تراجعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts landet in diesem Album, bevor du es geprüft hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing goes into this album until you've reviewed it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada entra en este álbum hasta que lo hayas revisado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est ajouté à cet album avant que vous l'ayez vérifié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी समीक्षा से पहले इस एल्बम में कुछ भी नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla viene aggiunto a questo album finché non l'hai esaminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するまで、このアルバムには何も追加されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토하기 전까지는 이 앨범에 아무것도 추가되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada entra neste álbum até você revisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этот альбом ничего не попадёт, пока вы это не проверите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您审核之前，任何内容都不会进入此相册。"
