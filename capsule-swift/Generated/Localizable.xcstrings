    "app.devices.revoke_all.proof_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُطلب منك التأكيد باستخدام مفتاح حسابك. وبدونه، لن يتم تسجيل الخروج من أي جهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst aufgefordert, mit deinem Kontoschlüssel zu bestätigen. Ohne ihn wird nichts abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll be asked to confirm with your account key. Without it, nothing is signed out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se te pedirá que confirmes con la clave de tu cuenta. Sin ella, no se cierra ninguna sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vous sera demandé de confirmer avec la clé de votre compte. Sans elle, aucun appareil n'est déconnecté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपसे अपनी खाता कुंजी से पुष्टि करने के लिए कहा जाएगा। इसके बिना, कोई भी साइन आउट नहीं होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verrà chiesto di confermare con la chiave dell'account. Senza di essa, nessun dispositivo viene disconnesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントキーでの確認を求められます。確認しない場合、何もサインアウトされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 키로 확인하라는 메시지가 표시됩니다. 확인하지 않으면 아무것도 로그아웃되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Será solicitado que você confirme com a chave da sua conta. Sem ela, nenhum dispositivo é desconectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потребуется подтверждение ключом учётной записи. Без него выход не будет выполнен ни на одном устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统将要求您使用账户密钥确认。未确认则不会退出任何设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會要求你使用帳號密鑰確認。若未確認，則不會登出任何裝置。"
          }
        }
      }
    },
