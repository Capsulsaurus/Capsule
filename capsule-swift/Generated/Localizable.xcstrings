    "app.recovery.verify.rewrap.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لـ Capsule منحك عبارة جديدة لمفتاح الحساب نفسه. لن تُمسّ صورك ولن يُعاد تشفير أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule kann dir eine neue Phrase für denselben Kontoschlüssel geben. Deine Fotos bleiben unberührt und nichts wird neu verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule can give you a new phrase for the same account key. Your photos aren't touched and nothing is re-encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule puede darte una frase nueva para la misma clave de cuenta. Tus fotos no se tocan y no se vuelve a cifrar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule peut vous fournir une nouvelle phrase pour la même clé de compte. Vos photos ne sont pas touchées et rien n'est rechiffré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule आपको उसी खाता कुंजी के लिए नया फ़्रेज़ दे सकता है। आपकी फ़ोटो को छुआ नहीं जाता और कुछ भी फिर से एन्क्रिप्ट नहीं किया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule può darti una nuova frase per la stessa chiave dell'account. Le tue foto non vengono toccate e nulla viene crittografato di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は同じアカウントキーに対して新しいフレーズを発行できます。写真には影響せず、再暗号化も行われません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 동일한 계정 키에 대해 새 문구를 제공할 수 있습니다. 사진은 변경되지 않으며 다시 암호화되는 항목도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule pode gerar uma nova frase para a mesma chave da conta. Suas fotos não são alteradas e nada é criptografado novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule может выдать вам новую фразу для того же ключа учётной записи. Ваши фото не затрагиваются и ничего не шифруется заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 可以为同一账户密钥提供新的短语。您的照片不受影响，也不会重新加密任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 可以為同一把帳號金鑰提供新的短語。您的照片不會受到影響，也不會重新加密任何內容。"
          }
        }
      }
    },
