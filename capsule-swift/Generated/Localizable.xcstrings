    "app.custody.verdict.receipt_missing.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُصدر خادمك إيصالًا موقَّعًا لهذه الصورة، لذا لا يوجد ما يمكن التحقق منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat für dieses Foto keine signierte Quittung ausgestellt, daher gibt es nichts zum Abgleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server hasn't issued a signed receipt for this photo, so there's nothing to check against."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor no ha emitido un recibo firmado para esta foto, así que no hay nada con qué comprobarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur n'a pas émis de reçu signé pour cette photo : il n'y a donc rien à vérifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर ने इस फ़ोटो के लिए हस्ताक्षरित रसीद जारी नहीं की है, इसलिए जाँचने के लिए कुछ नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server non ha emesso una ricevuta firmata per questa foto, quindi non c'è nulla con cui confrontarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはこの写真の署名付き受領証を発行していないため、照合するものがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 사진의 서명된 영수증을 발급하지 않아 대조할 대상이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor não emitiu um recibo assinado para esta foto, então não há com o que comparar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер не выдал подписанную квитанцию для этого фото, поэтому сверять не с чем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器尚未为此照片出具签名回执，因此没有可供核对的依据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的伺服器尚未為此照片發出簽署收據，因此沒有可供核對的依據。"
          }
        }
      }
    },
