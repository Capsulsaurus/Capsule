          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमाइंडर टाला गया"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria rimandato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リマインダーを延期しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림 미뤄짐"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrete adiado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминание отложено"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已推迟提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已延後提醒"
          }
        }
      }
    },
    "app.sync.snooze.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتم تذكيرك مرة أخرى لمدة أسبوعين تقريبًا. تستمر المزامنة كالمعتاد في هذه الأثناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wirst ein paar Wochen lang nicht erneut erinnert. Die Synchronisierung läuft in der Zwischenzeit wie gewohnt weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't be reminded again for a couple of weeks. Syncing carries on as usual in the meantime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se te volverá a recordar durante un par de semanas. Mientras tanto, la sincronización continúa como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne recevrez plus de rappel pendant quelques semaines. La synchronisation continue normalement en attendant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको लगभग दो सप्ताह तक फिर से याद नहीं दिलाया जाएगा। इस बीच सिंक सामान्य रूप से जारी रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non riceverai altri promemoria per un paio di settimane. Nel frattempo la sincronizzazione continua come sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2週間ほどは再通知されません。その間も同期は通常どおり続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2주 정도는 다시 알리지 않습니다. 그동안 동기화는 평소대로 계속됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não será lembrado de novo por algumas semanas. A sincronização continua normalmente enquanto isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пару недель напоминаний не будет. Синхронизация тем временем продолжается как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大约两周内不会再提醒您。在此期间同步照常进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接下來約兩週內不會再提醒您。在此期間，同步仍會照常進行。"
          }
        }
      }
    },
    "app.sync.stale.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُكمل Capsule أي مزامنة منذ أسبوعين، ولا تزال هناك تغييرات لم تُرسل. على هذا الجهاز، يقرر النظام متى يعمل في الخلفية، ولم يمنح أي وقت لذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hat seit zwei Wochen keine Synchronisierung abgeschlossen, und es gibt noch Änderungen zu senden. Auf diesem Gerät entscheidet das System, wann Hintergrundaufgaben laufen, und es hat keine zugelassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hasn't finished a sync in two weeks, and there are still changes to send. On this device the system decides when background work runs, and it hasn't granted any."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no ha completado una sincronización en dos semanas y aún hay cambios por enviar. En este dispositivo, el sistema decide cuándo se ejecuta el trabajo en segundo plano y no lo ha permitido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a terminé aucune synchronisation depuis deux semaines, et des modifications restent à envoyer. Sur cet appareil, le système décide quand le travail en arrière-plan s'exécute, et il n'en a accordé aucun."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ने दो सप्ताह से कोई सिंक पूरा नहीं किया है, और अभी भी बदलाव भेजने बाकी हैं। इस डिवाइस पर बैकग्राउंड काम कब चले, यह सिस्टम तय करता है, और उसने अभी तक कोई समय नहीं दिया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non completa una sincronizzazione da due settimane e ci sono ancora modifiche da inviare. Su questo dispositivo è il sistema a decidere quando eseguire il lavoro in background, e finora non lo ha concesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は2週間同期を完了しておらず、まだ送信する変更があります。このデバイスではバックグラウンド処理の実行タイミングをシステムが決めており、まだ実行が許可されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 2주 동안 동기화를 완료하지 못했으며, 아직 보낼 변경 사항이 있습니다. 이 기기에서는 백그라운드 작업 실행 시점을 시스템이 결정하는데, 아직 허용하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não conclui uma sincronização há duas semanas, e ainda há alterações a enviar. Neste dispositivo, o sistema decide quando o trabalho em segundo plano é feito, e ele não liberou nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не завершала синхронизацию уже две недели, а изменения ещё ожидают отправки. На этом устройстве система решает, когда выполнять фоновую работу, и пока не выделила для неё времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 已有两周未完成同步，且仍有更改需要发送。在此设备上，后台任务何时运行由系统决定，而系统尚未分配任何时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 已有兩週沒有完成同步，且仍有變更尚未傳送。在此裝置上，背景工作的執行時機由系統決定，而系統尚未給予任何時間。"
          }
        }
      }
    },
    "app.sync.stale.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم المزامنة الآن اتصالك الحالي، أيًا كان. يمكنك أيضًا تأجيل هذا التذكير أو إيقافه من الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt synchronisieren verwendet deine aktuelle Verbindung, egal welche. Du kannst diese Erinnerung auch aufschieben oder in den Einstellungen deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing now uses your current connection, whatever it is. You can also put this reminder off or turn it off in settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar ahora usa tu conexión actual, sea cual sea. También puedes posponer este recordatorio o desactivarlo en los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser maintenant utilise votre connexion actuelle, quelle qu'elle soit. Vous pouvez aussi reporter ce rappel ou le désactiver dans les réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सिंक करने पर आपका मौजूदा कनेक्शन उपयोग होगा, चाहे वह कोई भी हो। आप इस रिमाइंडर को टाल भी सकते हैं या सेटिंग्स में बंद कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzare ora usa la connessione attuale, qualunque essa sia. Puoi anche rimandare questo promemoria o disattivarlo nelle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ同期すると、種類にかかわらず現在の接続が使用されます。このリマインダーは延期することも、設定でオフにすることもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 동기화하면 현재 연결을 종류에 관계없이 사용합니다. 이 알림을 미루거나 설정에서 끌 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar agora usa sua conexão atual, seja ela qual for. Você também pode adiar este lembrete ou desativá-lo nos ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация сейчас использует текущее подключение, каким бы оно ни было. Вы также можете отложить это напоминание или отключить его в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步会使用您当前的网络连接，无论是哪种连接。您也可以在设置中推迟或关闭此提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步會使用您目前的連線，無論是哪種連線。您也可以延後此提醒，或在設定中將它關閉。"
          }
        }
      }
    },
