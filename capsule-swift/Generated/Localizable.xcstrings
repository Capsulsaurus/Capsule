    "app.crossdevice.code.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح هذا الرمز على الجهاز الآخر. إذا تعذّر المسح، فاكتب الأرقام بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen Code auf dem anderen Gerät. Falls das Scannen nicht klappt, gib stattdessen die Ziffern ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On the other device, scan this code. If it can't scan, type the digits instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código en el otro dispositivo. Si no puede escanearlo, escribe los dígitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce code sur l'autre appareil. S'il ne peut pas le scanner, saisissez plutôt les chiffres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरे डिवाइस पर, यह कोड स्कैन करें। यदि स्कैन न हो, तो इसके बजाय अंक टाइप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice sull'altro dispositivo. Se non riesce a scansionarlo, digita invece le cifre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスでこのコードをスキャンしてください。スキャンできない場合は、数字を入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 이 코드를 스캔하세요. 스캔할 수 없으면 숫자를 대신 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No outro dispositivo, escaneie este código. Se não for possível escanear, digite os números."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте этот код на другом устройстве. Если сканирование не работает, введите цифры."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在另一台设备上扫描此代码。如果无法扫描，请改为输入数字。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在另一台裝置上掃描此代碼。若無法掃描，請改為輸入數字。"
          }
        }
      }
    },
    "app.crossdevice.code.expired": {
      "localizations": {
