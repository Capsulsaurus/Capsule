    "drop.privacy_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُشفَّر ملفاتك في متصفحك قبل رفعها. لا يرى الخادم ملفاتك الأصلية أبدًا، ولا يمكن لهذه الصفحة أن تعرض لك أي شيء موجود في الألبوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien werden in deinem Browser verschlüsselt, bevor sie hochgeladen werden. Der Server sieht deine Originale nie, und diese Seite kann dir nichts anzeigen, was bereits im Album ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files are encrypted in your browser before they are uploaded. The server never sees your originals, and this page can't show you anything already in the album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos se cifran en tu navegador antes de subirse. El servidor nunca ve tus originales y esta página no puede mostrarte nada de lo que ya hay en el álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers sont chiffrés dans votre navigateur avant d'être téléversés. Le serveur ne voit jamais vos originaux, et cette page ne peut rien vous montrer de ce qui se trouve déjà dans l'album."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ाइलें अपलोड होने से पहले आपके ब्राउज़र में एन्क्रिप्ट की जाती हैं। सर्वर आपकी मूल फ़ाइलें कभी नहीं देखता, और यह पेज आपको एल्बम में पहले से मौजूद कुछ भी नहीं दिखा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file vengono crittografati nel browser prima di essere caricati. Il server non vede mai i tuoi originali e questa pagina non può mostrarti nulla di ciò che è già nell'album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはアップロード前にブラウザ内で暗号化されます。サーバーがオリジナルを見ることはなく、このページからアルバム内の既存の内容を見ることもできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일은 업로드되기 전에 브라우저에서 암호화됩니다. 서버는 원본을 볼 수 없으며, 이 페이지에서는 앨범에 이미 있는 항목을 볼 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos são criptografados no seu navegador antes de serem enviados. O servidor nunca vê seus originais, e esta página não pode mostrar nada que já esteja no álbum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши файлы шифруются в браузере перед загрузкой. Сервер никогда не видит ваши оригиналы, а эта страница не может показать вам ничего из того, что уже есть в альбоме."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的文件在上传前会在浏览器中加密。服务器永远看不到您的原始文件，而且此页面无法向您显示相册中已有的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的檔案會在上傳前於瀏覽器中加密。伺服器永遠看不到您的原始檔案，而且此頁面無法顯示相簿中已有的任何內容。"
          }
        }
      }
    },
