    "app.import.plan.move.warning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف ملفاتك المصدر بمجرد تخزين كل صورة بأمان على خادمك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Quelldateien werden gelöscht, sobald jedes Foto sicher auf deinem Server gespeichert ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your source files will be deleted once each photo is safely stored on your server"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos de origen se eliminarán cuando cada foto esté guardada de forma segura en tu servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers source seront supprimés dès que chaque photo sera stockée en sécurité sur votre serveur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर फ़ोटो के आपके सर्वर पर सुरक्षित रूप से संग्रहीत हो जाने पर आपकी स्रोत फ़ाइलें हटा दी जाएँगी"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file di origine verranno eliminati non appena ogni foto sarà archiviata in sicurezza sul tuo server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各写真がサーバーに安全に保存されると、元のファイルは削除されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 사진이 서버에 안전하게 저장되면 원본 파일이 삭제됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos de origem serão apagados assim que cada foto estiver armazenada com segurança no seu servidor"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные файлы будут удалены после того, как каждое фото будет надёжно сохранено на вашем сервере"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每张照片安全存储到您的服务器后，源文件将被删除"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每張照片安全儲存到你的伺服器後，你的來源檔案就會被刪除"
          }
        }
      }
    },
    "app.import.plan.reason.derived_default": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنه ألبوم مكتبتك، ويُستخدم عندما لا تنطبق أي قاعدة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist dein Mediathek-Album, das verwendet wird, wenn keine andere Regel greift."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's your library album, used when no other rule applies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es el álbum de tu biblioteca, que se usa cuando no se aplica ninguna otra regla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C'est l'album de votre bibliothèque, utilisé quand aucune autre règle ne s'applique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपका लाइब्रेरी एल्बम है, जिसका उपयोग तब होता है जब कोई अन्य नियम लागू नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È l'album della tua libreria, usato quando non si applica nessun'altra regola."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのルールが適用されない場合に使用されるライブラリアルバムです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 규칙이 적용되지 않을 때 사용하는 라이브러리 앨범입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É o álbum da sua biblioteca, usado quando nenhuma outra regra se aplica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это альбом вашей медиатеки, который используется, когда не подходит ни одно другое правило."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您的资料库相册，在没有其他规则适用时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是你的圖庫相簿，在沒有其他規則適用時使用。"
          }
        }
      }
    },
