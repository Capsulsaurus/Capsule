    "app.add_to_album.choose": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر ألبومًا في Capsule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Capsule-Album."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a Capsule album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un álbum de Capsule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un album Capsule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई Capsule एल्बम चुनें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un album di Capsule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule アルバムを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 앨범을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um álbum do Capsule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите альбом Capsule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个 Capsule 相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個 Capsule 相簿。"
          }
        }
      }
    },
    "app.add_to_album.empty_albums": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ ألبومًا في علامة التبويب «الألبومات» أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle zuerst ein Album im Tab „Alben“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an album in the Albums tab first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero crea un álbum en la pestaña Álbumes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez d'abord un album dans l'onglet Albums."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एल्बम टैब में एक एल्बम बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea prima un album nella scheda Album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず「アルバム」タブでアルバムを作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 앨범 탭에서 앨범을 생성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro, crie um álbum na aba Álbuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создайте альбом на вкладке «Альбомы»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在“相册”标签页中创建相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先在「相簿」標籤頁中建立相簿。"
          }
