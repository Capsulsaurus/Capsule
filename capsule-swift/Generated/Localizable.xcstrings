    "app.storage.budget.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ Capsule بالنسخ التي تم تنزيلها حتى هذا الحد، ويمسح الأقدم أولًا عند تجاوزه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule behält geladene Kopien bis zu diesem Limit und löscht bei Überschreitung zuerst die ältesten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule keeps downloaded copies up to this limit and clears the oldest first when it goes over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule conserva copias descargadas hasta este límite y, si lo supera, borra primero las más antiguas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule conserve les copies téléchargées jusqu'à cette limite et efface d'abord les plus anciennes en cas de dépassement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule इस सीमा तक डाउनलोड की गई कॉपियाँ रखता है और सीमा पार होने पर सबसे पुरानी पहले साफ़ करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule conserva le copie scaricate fino a questo limite e, quando lo supera, cancella prima le più vecchie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はダウンロード済みのコピーをこの上限まで保持し、超えた場合は古いものから順に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 이 한도까지 다운로드한 사본을 보관하며, 한도를 넘으면 가장 오래된 사본부터 정리합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule mantém cópias baixadas até este limite e, quando passa dele, limpa primeiro as mais antigas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule хранит загруженные копии в пределах этого лимита и при превышении сначала удаляет самые старые."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 会在此上限内保留已下载的副本，超出时会先清除最早的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會在此上限內保留已下載的副本，超過時會先清除最舊的副本。"
          }
        }
      }
    },
