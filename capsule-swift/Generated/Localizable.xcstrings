    "app.totp.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف حسابك إلى تطبيق مصادقة، ثم أدخل رمزًا للإنهاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dein Konto zu einer Authentifizierungs-App hinzu und gib dann zum Abschluss einen Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your account to an authenticator app, then enter a code to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu cuenta a una app de autenticación y luego introduce un código para terminar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre compte à une app d'authentification, puis saisissez un code pour terminer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना खाता किसी ऑथेंटिकेटर ऐप में जोड़ें, फिर समाप्त करने के लिए कोड दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il tuo account a un'app di autenticazione, quindi inserisci un codice per terminare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリにアカウントを追加し、コードを入力して完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱에 계정을 추가한 다음 코드를 입력하여 완료하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione sua conta a um app autenticador e depois digite um código para concluir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте учётную запись в приложение-аутентификатор, затем введите код для завершения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您的账户添加到验证器应用，然后输入验证码以完成设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將您的帳號加入驗證器 App，然後輸入驗證碼以完成設定。"
          }
        }
      }
    },
