    "drop.error.rate_limited": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. يُرجى الانتظار لحظة ثم المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Bitte warte einen Moment und versuche es erneut."
