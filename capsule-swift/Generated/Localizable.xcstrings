    "app.sync.auto.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل المزامنة التلقائية عندما يمنح النظام Capsule وقتًا في الخلفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Synchronisierung läuft, wenn das System Capsule Zeit im Hintergrund gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic sync runs when the system gives Capsule time in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización automática se ejecuta cuando el sistema le da tiempo a Capsule en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation automatique s'exécute lorsque le système accorde du temps en arrière-plan à Capsule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वचालित सिंक तब चलता है जब सिस्टम Capsule को बैकग्राउंड में समय देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione automatica avviene quando il sistema concede a Capsule tempo in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同期は、システムが Capsule にバックグラウンドでの実行時間を与えたときに行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 동기화는 시스템이 Capsule에 백그라운드 시간을 허용할 때 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização automática acontece quando o sistema dá ao Capsule tempo em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматическая синхронизация выполняется, когда система выделяет Capsule время в фоновом режиме."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当系统给予 Capsule 后台运行时间时，自动同步就会运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動同步會在系統給予 Capsule 背景執行時間時進行。"
          }
        }
      }
    },
