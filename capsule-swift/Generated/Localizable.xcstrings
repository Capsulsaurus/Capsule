    "app.sync.criterion.external_power.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنتظر الدفعات الكبيرة جدًا حتى يتم شحن هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehr große Mengen warten, bis dieses Gerät geladen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Very large batches wait until this device is charging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los lotes muy grandes esperan a que este dispositivo se esté cargando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les très gros lots attendent que cet appareil soit en charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहुत बड़े बैच तब तक प्रतीक्षा करते हैं जब तक यह डिवाइस चार्ज न हो रहा हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gruppi molto grandi attendono che questo dispositivo sia in carica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非常に大きな処理は、このデバイスが充電中になるまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "매우 큰 작업은 이 기기가 충전 중일 때까지 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lotes muito grandes aguardam até este dispositivo estar carregando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Очень крупные пакеты ждут, пока устройство заряжается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "非常大的批量任务会等到此设备充电时进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "非常大量的工作會等到此裝置充電時才進行。"
          }
        }
      }
    },
    "app.sync.criterion.non_metered": {
      "localizations": {
