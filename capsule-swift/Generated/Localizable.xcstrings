    "app.import.scan.cancelled.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفت الفحص. لم يتم استيراد أي شيء، ويمكنك الفحص مجددًا متى شئت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Scan gestoppt. Es wurde nichts importiert, und du kannst jederzeit erneut scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stopped the scan. Nothing was imported, and you can scan again whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detuviste el análisis. No se importó nada y puedes volver a analizar cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez arrêté l'analyse. Rien n'a été importé, et vous pouvez relancer l'analyse quand vous le souhaitez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने स्कैन रोक दिया। कुछ भी इंपोर्ट नहीं हुआ, और आप जब चाहें फिर से स्कैन कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai interrotto la scansione. Non è stato importato nulla e puoi eseguire di nuovo la scansione quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンを停止しました。何も読み込まれていません。いつでも再度スキャンできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔을 중단했습니다. 아무것도 가져오지 않았으며 언제든지 다시 스캔할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você interrompeu a verificação. Nada foi importado, e você pode verificar novamente quando quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы остановили сканирование. Ничего не импортировано, и вы можете снова запустить сканирование в любой момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您停止了扫描。没有导入任何内容，您可以随时重新扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已停止掃描。沒有匯入任何內容，你可以隨時重新掃描。"
          }
        }
      }
    },
