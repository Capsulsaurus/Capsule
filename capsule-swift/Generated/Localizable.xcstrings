          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 실행하겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить сейчас?"
          }
        },
        "zh-Hans": {
