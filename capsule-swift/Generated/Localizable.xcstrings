          }
        }
      }
    },
    "app.quarantine.surface.verify_reject.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل تغيير تعذّر على Capsule التأكد من أنه صادر عن جهاز على حسابك، لذا لم يُطبَّق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Änderung ist eingetroffen, bei der Capsule nicht bestätigen konnte, dass sie von einem Gerät deines Kontos stammt, daher wurde sie nicht angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A change arrived that Capsule couldn't confirm came from a device on your account, so it wasn't applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó un cambio que Capsule no pudo confirmar que procediera de un dispositivo de tu cuenta, así que no se aplicó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas pu confirmer qu'une modification reçue provenait d'un appareil de votre compte ; elle n'a donc pas été appliquée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऐसा परिवर्तन आया जिसके बारे में Capsule पुष्टि नहीं कर सका कि वह आपके खाते के किसी डिवाइस से आया है, इसलिए उसे लागू नहीं किया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È arrivata una modifica di cui Capsule non ha potuto confermare la provenienza da un dispositivo del tuo account, quindi non è stata applicata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのアカウントのデバイスから送られたことを Capsule が確認できない変更が届いたため、適用されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 계정의 기기에서 보낸 것인지 Capsule이 확인할 수 없는 변경이 도착하여 적용하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegou uma alteração que o Capsule não conseguiu confirmar que veio de um dispositivo da sua conta, então ela não foi aplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поступило изменение, происхождение которого с устройства вашей учётной записи Capsule не удалось подтвердить, поэтому оно не было применено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到一项更改，但 Capsule 无法确认它来自您账户上的设备，因此未应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到一項變更，但 Capsule 無法確認它來自您帳號中的裝置，因此未套用。"
          }
        }
      }
    },
    "app.quarantine.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بحاجة إلى مراجعة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu prüfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs Review"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendiente de revisión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À examiner"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समीक्षा ज़रूरी"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da esaminare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要確認"
          }
        },
        "ko": {
          "stringUnit": {
