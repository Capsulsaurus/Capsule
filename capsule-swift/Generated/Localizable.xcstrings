    "app.drops.detail.discard.confirm_message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف الملف نهائيًا وتُحرَّر المساحة التي كان يشغلها. ولن يُبلَّغ مرسله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei wird endgültig gelöscht und der belegte Speicherplatz freigegeben. Der Absender wird nicht benachrichtigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is deleted for good and the space it used is freed. Whoever sent it isn't told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo se elimina definitivamente y se libera el espacio que ocupaba. No se avisa a quien lo envió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est définitivement supprimé et l'espace qu'il occupait est libéré. L'expéditeur n'en est pas informé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल हमेशा के लिए हटा दी जाती है और उसकी जगह ख़ाली हो जाती है। भेजने वाले को नहीं बताया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file viene eliminato definitivamente e lo spazio che occupava viene liberato. Il mittente non viene avvisato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは完全に削除され、使用していた容量は解放されます。送信者には通知されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 영구적으로 삭제되고 사용하던 공간이 확보됩니다. 보낸 사람에게는 알리지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo é apagado definitivamente e o espaço que ocupava é liberado. Quem o enviou não é avisado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл будет удалён навсегда, а занятое им место освободится. Отправитель об этом не узнает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件将被永久删除，其占用的空间将被释放。发送者不会收到通知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檔案將被永久刪除，其佔用的空間也會釋放。傳送者不會收到通知。"
          }
        }
      }
    },
    "app.drops.detail.discard.confirm_title": {
      "localizations": {
        "ar": {
