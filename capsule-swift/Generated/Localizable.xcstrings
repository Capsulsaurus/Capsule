    "app.auth.login.totp.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط إذا كان حسابك يستخدم المصادقة الثنائية. أدخل الرمز المكوّن من ستة أرقام من تطبيق المصادقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur wenn dein Konto die Zwei-Faktor-Authentifizierung verwendet. Gib den sechsstelligen Code aus deiner Authentifizierungs-App ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only if your account uses two-factor authentication. Enter the six-digit code from your authenticator app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo si tu cuenta usa autenticación de dos factores. Introduce el código de seis dígitos de tu app de autenticación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement si votre compte utilise l'authentification à deux facteurs. Saisissez le code à six chiffres de votre app d'authentification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल तभी, जब आपका खाता टू-फ़ैक्टर प्रमाणीकरण का उपयोग करता हो। अपने ऑथेंटिकेटर ऐप से छह अंकों का कोड दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se il tuo account usa l'autenticazione a due fattori. Inserisci il codice a sei cifre dell'app di autenticazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントで2ファクタ認証を使用している場合のみ。認証アプリに表示される6桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에서 이중 인증을 사용하는 경우에만 필요합니다. 인증 앱에 표시된 6자리 코드를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente se sua conta usar autenticação de dois fatores. Digite o código de seis dígitos do seu app autenticador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только если в вашей учётной записи включена двухфакторная аутентификация. Введите шестизначный код из приложения-аутентификатора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当您的账户启用了双重认证时需要。请输入身份验证器应用中的六位数验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在你的帳號使用雙重認證時需要。請輸入驗證器 App 中的六位數代碼。"
          }
        }
      }
    },
