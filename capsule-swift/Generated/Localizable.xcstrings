    "app.auth.path.oidc.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول عبر موفّر الهوية الذي يستخدمه هذا الخادم لتسجيل الدخول الموحّد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich über den Identitätsanbieter an, den dieser Server für Single Sign-On verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in through the identity provider this server uses for single sign-on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión a través del proveedor de identidad que este servidor usa para el inicio de sesión único."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous via le fournisseur d'identité que ce serveur utilise pour l'authentification unique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस पहचान प्रदाता के ज़रिए साइन इन करें जिसे यह सर्वर सिंगल साइन-ऑन के लिए उपयोग करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi tramite il provider di identità che questo server usa per il Single Sign-On."
          }
        },
        "ja": {
          "stringUnit": {
