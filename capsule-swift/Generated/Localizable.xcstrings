    "ios.peering.note.lan_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only over the local network. Nothing is exchanged across the internet this way."
          }
        }
      }
    },
    "ios.peering.note.no_scope_knob": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby syncing follows the same What to Sync setting as everything else — there's no separate one to set."
          }
        }
      }
    },
    "ios.peering.note.pull_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each device asks for what it's missing. Nothing is pushed at you."
          }
        }
