          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule couldn't reach the device list. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no pudo acceder a la lista de dispositivos. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas pu accéder à la liste d'appareils. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule डिवाइस सूची तक नहीं पहुँच सका। कृपया फिर से प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non è riuscito a raggiungere l'elenco dei dispositivi. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はデバイス一覧にアクセスできませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 기기 목록에 접근하지 못했습니다. 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não conseguiu acessar a lista de dispositivos. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не удалось получить список устройств. Повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 无法访问设备列表，请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 無法存取裝置清單，請重試。"
          }
        }
      }
    },
    "error.directory.unsupported_media_type": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
