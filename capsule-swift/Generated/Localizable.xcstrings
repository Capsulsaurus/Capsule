    "app.settings.ai.processing.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل كل شيء على هذا الجهاز. لا تُرسل أي صورة ولا أي شيء مستمد منها إلى أي مكان للتحليل أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf diesem Gerät. Kein Foto und nichts daraus Abgeleitetes wird jemals zur Analyse irgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything runs on this device. No photo and nothing derived from one is ever sent anywhere for analysis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se ejecuta en este dispositivo. Ninguna foto, ni nada derivado de ella, se envía nunca a ningún sitio para analizarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout s'exécute sur cet appareil. Aucune photo, ni rien qui en soit dérivé, n'est jamais envoyé ailleurs pour analyse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ इसी डिवाइस पर चलता है। विश्लेषण के लिए कोई फ़ोटो या उससे निकाली गई कोई भी चीज़ कभी कहीं नहीं भेजी जाती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto viene eseguito su questo dispositivo. Nessuna foto, né nulla derivato da una foto, viene mai inviato altrove per l'analisi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのデバイス上で実行されます。分析のために写真やそこから得られた情報がどこかに送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 작업은 이 기기에서 실행됩니다. 사진이나 사진에서 추출한 어떤 정보도 분석을 위해 다른 곳으로 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo é executado neste dispositivo. Nenhuma foto, nem nada derivado dela, é enviado a lugar nenhum para análise."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё выполняется на этом устройстве. Ни фото, ни что-либо, полученное из них, никогда никуда не отправляется для анализа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有处理都在此设备上进行。任何照片或由照片派生的内容都不会被发送到任何地方进行分析。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在此裝置上執行。任何照片或由照片衍生的內容都絕不會傳送到任何地方進行分析。"
          }
        }
      }
    },
