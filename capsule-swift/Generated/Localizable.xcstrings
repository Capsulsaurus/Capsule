    "app.transfer.recovery.resend_chunk.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يصل جزء من الرفع سليمًا. سيرسل Capsule ذلك الجزء مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Teil des Uploads ist nicht unbeschädigt angekommen. Capsule sendet dieses Stück erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Part of the upload didn't arrive intact. Capsule will send that piece again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte de la subida no llegó intacta. Capsule volverá a enviar ese fragmento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie du téléversement n'est pas arrivée intacte. Capsule renverra ce fragment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड का एक हिस्सा सही-सलामत नहीं पहुँचा। Capsule वह खंड फिर से भेजेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parte del caricamento non è arrivata integra. Capsule invierà di nuovo quel blocco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードの一部が正常に届きませんでした。Capsule はそのピースを再送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드의 일부가 손상된 채 도착했습니다. Capsule이 해당 조각을 다시 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte do envio não chegou intacta. O Capsule vai enviar essa parte novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть загрузки повреждена при передаче. Capsule отправит её снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
