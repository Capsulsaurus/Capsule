          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此來源已達其請求上限。請稍候再試。"
          }
        }
      }
    },
    "error.federation.scope_insufficient": {
      "localizations": {
        "ar": {
