    "app.storage.plan.refetch_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم المسح بهذا الترتيب: الصور بالحجم الكامل أولًا، والصور المصغّرة أخيرًا. يُعاد جلب أي شيء يُمسح عند الحاجة إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reihenfolge beim Löschen: zuerst Fotos in voller Größe, zuletzt Miniaturen. Gelöschtes wird erneut geladen, wenn du es brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cleared in this order: full-size photos first, thumbnails last. Anything cleared is fetched again when you need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se borra en este orden: primero las fotos a tamaño completo y, por último, las miniaturas. Todo lo borrado se vuelve a descargar cuando lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacement dans cet ordre : photos en taille réelle d'abord, vignettes en dernier. Tout ce qui est effacé est récupéré à nouveau quand vous en avez besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस क्रम में साफ़ किया जाता है: पहले पूर्ण-आकार फ़ोटो, आख़िर में थंबनेल। साफ़ की गई कोई भी चीज़ ज़रूरत पड़ने पर फिर से लाई जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordine di cancellazione: prima le foto a dimensione piena, per ultime le miniature. Ciò che viene cancellato viene scaricato di nuovo quando ti serve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去はフルサイズの写真から始まり、サムネイルが最後です。消去したものは必要なときに再度取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 크기 사진부터 썸네일 순으로 정리됩니다. 정리된 항목은 필요할 때 다시 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limpo nesta ordem: fotos em tamanho original primeiro, miniaturas por último. O que for limpo é baixado de novo quando você precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Порядок очистки: сначала полноразмерные фото, миниатюры — в последнюю очередь. Всё удалённое загрузится снова, когда понадобится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除顺序：先清除全尺寸照片，最后清除缩略图。被清除的内容会在需要时重新获取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除順序：先清除原尺寸照片，最後清除縮圖。清除的內容會在您需要時再次下載。"
          }
        }
      }
    },
