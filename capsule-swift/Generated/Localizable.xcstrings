    "app.settings.maintenance.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد يستغرق هذا بعض الوقت ويستهلك الكثير من البطارية. سيظل Capsule ينتظر الظروف المناسبة — طلب التشغيل لا يتجاوز ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das kann eine Weile dauern und viel Akku verbrauchen. Capsule wartet trotzdem auf die richtigen Bedingungen – das Anfordern setzt sie nicht außer Kraft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can take a while and use a lot of battery. Capsule still waits for the right conditions — asking for it doesn't override that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto puede tardar bastante y consumir mucha batería. Capsule sigue esperando a que se den las condiciones adecuadas: pedirlo no lo anula."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela peut prendre du temps et consommer beaucoup de batterie. Capsule attend toujours les bonnes conditions : le demander ne passe pas outre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें कुछ समय लग सकता है और बहुत बैटरी खर्च हो सकती है। Capsule फिर भी सही परिस्थितियों की प्रतीक्षा करता है — आपके कहने से वह नियम नहीं बदलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può richiedere un po' di tempo e consumare molta batteria. Capsule attende comunque le condizioni giuste: richiederlo non le scavalca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間がかかり、バッテリーを多く消費する場合があります。Capsule は引き続き適切な条件になるまで待機します。実行を指示しても、この条件は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 오래 걸리고 배터리를 많이 사용할 수 있습니다. 요청하더라도 Capsule은 적절한 조건이 될 때까지 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso pode demorar e gastar muita bateria. O Capsule ainda espera as condições certas — pedir não muda isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это может занять много времени и сильно расходовать заряд аккумулятора. Capsule всё равно дождётся подходящих условий — запрос этого не отменяет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可能需要一段时间并消耗大量电量。Capsule 仍会等待合适的条件——手动请求不会改变这一点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這可能需要一段時間，且會消耗大量電量。Capsule 仍會等待合適的時機，手動要求並不會改變這一點。"
          }
        }
      }
    },
    "app.settings.maintenance.confirm.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل هذا الآن؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jetzt ausführen?"
          }
        },
        "en": {
