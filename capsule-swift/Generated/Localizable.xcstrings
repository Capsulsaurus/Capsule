    "app.auth.welcome.session_expired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية هذه الجلسة. سجّل الدخول مرة أخرى للوصول إلى خادمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Sitzung ist abgelaufen. Melde dich erneut an, um deinen Server zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session has expired. Sign in again to reach your server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sesión ha caducado. Vuelve a iniciar sesión para acceder a tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette session a expiré. Reconnectez-vous pour accéder à votre serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सत्र समाप्त हो गया है। अपने सर्वर तक पहुँचने के लिए फिर से साइन इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa sessione è scaduta. Accedi di nuovo per raggiungere il tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このセッションは期限切れです。サーバーにアクセスするには、もう一度サインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 만료되었습니다. 서버에 접속하려면 다시 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta sessão expirou. Entre novamente para acessar seu servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия сеанса истёк. Войдите снова, чтобы получить доступ к серверу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此会话已过期。请重新登录以访问您的服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此工作階段已過期。請重新登入以連線至你的伺服器。"
          }
        }
      }
    },
