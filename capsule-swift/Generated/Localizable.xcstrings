    "app.crossdevice.safety.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يعرض الجهازان رمز الأمان نفسه. لو كان هناك أي شيء بينهما، لاختلفت الرموز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Geräte sollten denselben Sicherheitscode anzeigen. Wenn sich etwas dazwischengeschaltet hätte, wären die Codes unterschiedlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both devices should show the same safety code. If anything were sitting between them, the codes would differ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ambos dispositivos deben mostrar el mismo código de seguridad. Si algo se interpusiera entre ellos, los códigos serían distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux appareils doivent afficher le même code de sécurité. Si quelque chose s'interposait entre eux, les codes seraient différents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों डिवाइस पर एक ही सुरक्षा कोड दिखना चाहिए। यदि उनके बीच कुछ भी होता, तो कोड अलग होते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrambi i dispositivi dovrebbero mostrare lo stesso codice di sicurezza. Se qualcosa si frapponesse tra loro, i codici sarebbero diversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のデバイスに同じ安全コードが表示されるはずです。間に何かが介在している場合、コードは一致しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 기기에 같은 안전 코드가 표시되어야 합니다. 중간에 무언가가 끼어 있다면 코드가 달라집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dois dispositivos devem mostrar o mesmo código de segurança. Se houvesse algo entre eles, os códigos seriam diferentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На обоих устройствах должен отображаться одинаковый код безопасности. Если бы между ними кто-то находился, коды бы различались."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两台设备应显示相同的安全码。如果中间有任何东西介入，安全码就会不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩台裝置應顯示相同的安全碼。如果有任何東西介入兩者之間，代碼就會不同。"
          }
        }
      }
    },
