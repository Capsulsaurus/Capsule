    "app.settings.server.origin.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توجد صورك هنا عندما لا تكون على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier liegen deine Fotos, wenn sie nicht auf diesem Gerät sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photos live here when they're not on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus fotos se guardan aquí cuando no están en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos photos sont conservées ici lorsqu'elles ne sont pas sur cet appareil."
          }
