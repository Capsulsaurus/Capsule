        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 진행 중인 로그인이 너무 많습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
