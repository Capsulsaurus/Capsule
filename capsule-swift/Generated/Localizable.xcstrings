    "app.custody.release.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكّد خادمك أنه يحتفظ بهذه الصورة. سيعيد Capsule تنزيلها كلما احتجت إليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat bestätigt, dass er dieses Foto gespeichert hat. Capsule lädt es erneut, wann immer du es brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server has confirmed it holds this photo. Capsule will download it again whenever you need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor ha confirmado que guarda esta foto. Capsule la volverá a descargar siempre que la necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur a confirmé détenir cette photo. Capsule la téléchargera à nouveau chaque fois que vous en aurez besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर ने पुष्टि की है कि उसके पास यह फ़ोटो है। जब भी आपको ज़रूरत होगी, Capsule इसे फिर से डाउनलोड कर लेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server ha confermato di avere questa foto. Capsule la scaricherà di nuovo ogni volta che ti servirà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはこの写真の保管を確認済みです。必要なときはいつでも Capsule が再度ダウンロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 사진을 보관하고 있음을 확인했습니다. 필요할 때마다 Capsule이 다시 다운로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor confirmou que tem esta foto. O Capsule vai baixá-la novamente sempre que você precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер подтвердил, что хранит это фото. Capsule снова загрузит его, когда оно понадобится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器已确认保存此照片。需要时 Capsule 会重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的伺服器已確認保存此照片。需要時 Capsule 會隨時重新下載。"
          }
        }
      }
    },
