    "error.enrollment.code_refused": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينجح رمز الجهاز هذا. أنشئ رمزًا جديدًا وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Gerätecode hat nicht funktioniert. Erzeugen Sie einen neuen und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
