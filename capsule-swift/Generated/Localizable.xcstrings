          }
        }
      }
    },
    "error.enrollment.local_auth_required": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكِّد هويتك على هذا الجهاز لإضافة جهاز آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätigen Sie auf diesem Gerät, dass Sie es sind, um ein weiteres Gerät hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm it's you on this device to add another device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que eres tú en este dispositivo para añadir otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez votre identité sur cet appareil pour en ajouter un autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूसरा डिवाइस जोड़ने के लिए इस डिवाइस पर पुष्टि करें कि यह आप ही हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma la tua identità su questo dispositivo per aggiungerne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスを追加するには、このデバイスで本人確認を行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기를 추가하려면 이 기기에서 본인 확인을 완료해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que é você neste dispositivo para adicionar outro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите на этом устройстве, что это вы, чтобы добавить другое устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在此设备上确认是您本人，以添加另一台设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在此裝置上確認是您本人，以新增另一台裝置。"
          }
        }
      }
    },
    "error.enrollment.rate_limited": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا لإضافة جهاز. يُرجى الانتظار ثم المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche, ein Gerät hinzuzufügen. Bitte warten Sie und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many device-add attempts. Please wait and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos de añadir dispositivos. Espera e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
