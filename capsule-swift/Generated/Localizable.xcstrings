    "app.import.source.photos.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ الصور الموجودة بالفعل على هذا الجهاز. لا يُحذف أي شيء من مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest die Fotos, die bereits auf diesem Gerät sind. Aus deiner Mediathek wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reads the photos already on this device. Nothing is deleted from your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las fotos que ya están en este dispositivo. No se elimina nada de tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lit les photos déjà présentes sur cet appareil. Rien n'est supprimé de votre photothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर पहले से मौजूद फ़ोटो पढ़ता है। आपकी लाइब्रेरी से कुछ भी नहीं हटाया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Legge le foto già presenti su questo dispositivo. Nulla viene eliminato dalla tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにすでにある写真を読み取ります。ライブラリから何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 이미 있는 사진을 읽습니다. 보관함에서 삭제되는 항목은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lê as fotos que já estão neste dispositivo. Nada é apagado da sua biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Читает фото, уже имеющиеся на этом устройстве. Из вашей медиатеки ничего не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "读取此设备上已有的照片。不会从您的资料库中删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讀取此裝置上現有的照片。不會從您的圖庫刪除任何內容。"
          }
        }
      }
    },
