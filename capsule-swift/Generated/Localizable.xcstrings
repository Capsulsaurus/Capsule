        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते के लिए अभी तक कोई रिकवरी फ़्रेज़ नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è ancora una frase di ripristino per questo account."
          }
        },
        "ja": {
