    "app.settings.import.default.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم كلما لم تحدّد أي قاعدة أدناه مكانًا آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn keine Regel unten ein anderes Ziel wählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used whenever no rule below picks somewhere else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa siempre que ninguna regla de abajo elija otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé chaque fois qu'aucune règle ci-dessous ne choisit une autre destination."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब नीचे का कोई नियम कोई और जगह नहीं चुनता, तब इसका उपयोग होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato ogni volta che nessuna regola qui sotto sceglie un'altra destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のルールで他の場所が選ばれない場合に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 규칙이 다른 위치를 선택하지 않을 때 사용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado sempre que nenhuma regra abaixo escolher outro destino."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, когда ни одно правило ниже не выбирает другое место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当下方没有规则选择其他位置时使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當下方沒有規則指定其他位置時使用。"
          }
        }
      }
    },
