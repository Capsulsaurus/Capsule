    "app.quota.state.suspended.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف مدير هذا الخادم الحساب. يمكنه إخبارك بالسبب وبما سيحدث بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Betreiber dieses Servers haben das Konto gesperrt. Sie können dir sagen, warum und wie es weitergeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever runs this server has suspended the account. They can tell you why and what happens next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien administra este servidor ha suspendido la cuenta. Puede explicarte el motivo y qué ocurrirá a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'administrateur de ce serveur a suspendu le compte. Il peut vous en indiquer la raison et la suite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सर्वर को चलाने वाले ने खाता निलंबित कर दिया है। वे आपको बता सकते हैं कि क्यों और आगे क्या होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi gestisce questo server ha sospeso l'account. Può spiegarti il motivo e cosa succederà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーの管理者がアカウントを停止しました。理由と今後の対応については管理者にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버의 운영자가 계정을 정지했습니다. 정지 사유와 이후 절차는 운영자에게 문의하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem administra este servidor suspendeu a conta. Essa pessoa pode explicar o motivo e o que acontece a seguir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Администратор этого сервера приостановил учётную запись. Он может объяснить причину и что будет дальше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器的运营者已停用该账户。对方可以告诉您原因以及后续情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器的管理者已將此帳號停權。他們可以告訴您原因及後續情況。"
          }
        }
      }
    },
