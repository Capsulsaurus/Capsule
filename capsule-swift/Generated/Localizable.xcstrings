    "app.custody.verdict.not_confirmed.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتفظ خادمك بكل أجزاء هذه الصورة بعد. تبقى النسخة الموجودة على هذا الجهاز كما هي تمامًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat noch nicht alle Teile dieses Fotos. Die Kopie auf diesem Gerät bleibt genau, wo sie ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server doesn't hold every part of this photo yet. The copy on this device stays exactly where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor aún no guarda todas las partes de esta foto. La copia de este dispositivo se queda exactamente donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur ne détient pas encore toutes les parties de cette photo. La copie sur cet appareil reste exactement où elle est."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर के पास अभी इस फ़ोटो के सभी भाग नहीं हैं। इस डिवाइस की कॉपी जहाँ है वहीं रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server non possiede ancora tutte le parti di questa foto. La copia su questo dispositivo resta esattamente dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはまだこの写真のすべての部分を保管していません。このデバイス上のコピーはそのまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 아직 이 사진의 모든 부분을 보관하고 있지 않습니다. 이 기기의 사본은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor ainda não tem todas as partes desta foto. A cópia neste dispositivo permanece exatamente onde está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер пока хранит не все части этого фото. Копия на этом устройстве остаётся на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器尚未保存此照片的所有部分。此设备上的副本会原样保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的伺服器尚未保存此照片的所有部分。此裝置上的副本會原封不動地保留。"
          }
        }
      }
    },
