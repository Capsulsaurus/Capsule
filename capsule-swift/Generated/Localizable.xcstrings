        }
      }
    },
    "app.quarantine.surface.unknown.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتجز إصدار أحدث من Capsule هذا لسبب لا يتعرّف عليه هذا الإصدار. يُحتفظ به تمامًا كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Version von Capsule hat dies aus einem Grund zurückgehalten, den diese Version nicht kennt. Es wird genau so aufbewahrt, wie es ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer version of Capsule held this back for a reason this version doesn't recognize. It's kept exactly as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión más reciente de Capsule retuvo esto por un motivo que esta versión no reconoce. Se conserva exactamente como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version plus récente de Capsule a retenu cet élément pour une raison que cette version ne reconnaît pas. Il est conservé exactement tel quel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule के नए संस्करण ने इसे ऐसे कारण से रोका जिसे यह संस्करण नहीं पहचानता। इसे ठीक वैसा ही रखा गया है जैसा यह है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versione più recente di Capsule ha trattenuto questo elemento per un motivo che questa versione non riconosce. Viene conservato esattamente com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンの Capsule が、このバージョンでは認識できない理由でこれを保留しました。そのままの状態で保管されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전의 Capsule이 이 버전에서 인식할 수 없는 사유로 이 항목을 보류했습니다. 있는 그대로 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão mais recente do Capsule reteve isto por um motivo que esta versão não reconhece. Está guardado exatamente como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более новая версия Capsule задержала это по причине, которую эта версия не распознаёт. Данные сохранены в точности как есть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新版本的 Capsule 因此版本无法识别的原因暂扣了此项目。它已按原样完整保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較新版本的 Capsule 基於此版本無法辨識的原因暫留了此項目。它會完全按原樣保留。"
          }
        }
      }
    },
    "app.quarantine.surface.verify_reject": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
