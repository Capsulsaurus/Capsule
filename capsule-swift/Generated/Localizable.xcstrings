    "app.enrollment.failure.hardware.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض التخزين الآمن لهذا الجهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherer Speicher dieses Geräts hat abgelehnt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Device's Secure Storage Refused"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento seguro de este dispositivo se negó"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage sécurisé de cet appareil a refusé"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस के सुरक्षित स्टोरेज ने मना कर दिया"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La memoria sicura di questo dispositivo ha rifiutato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
