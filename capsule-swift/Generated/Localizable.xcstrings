    "app.settings.maintenance.detail.cache_eviction": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحرر النسخ التي تم تنزيلها للبقاء ضمن حد ذاكرة التخزين المؤقت. يشمل فقط النسخ الموجودة على الخادم، ويُعاد جلبها عند الحاجة إليها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt geladene Kopien frei, um unter deinem Cache-Limit zu bleiben. Nur Kopien, die dein Server bereits hat – sie werden erneut geladen, wenn du sie brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees downloaded copies to stay under your cache limit. Only copies your server already holds, and they're fetched again when you need them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera copias descargadas para no superar el límite de caché. Solo las copias que tu servidor ya tiene, y se vuelven a descargar cuando las necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libère des copies téléchargées pour rester sous votre limite de cache. Seules les copies déjà détenues par votre serveur sont concernées, et elles sont récupérées à nouveau quand vous en avez besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कैश सीमा के भीतर रहने के लिए डाउनलोड की गई कॉपियाँ हटाता है। केवल वही कॉपियाँ जो आपके सर्वर पर पहले से हैं, और ज़रूरत पड़ने पर वे फिर से लाई जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera le copie scaricate per restare entro il limite della cache. Solo copie già presenti sul tuo server, che vengono scaricate di nuovo quando ti servono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャッシュの上限を超えないよう、ダウンロード済みのコピーを削除します。対象はサーバーにすでに保存されているコピーのみで、必要なときに再度取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "캐시 한도를 넘지 않도록 다운로드한 사본을 정리합니다. 서버에 이미 있는 사본만 정리되며, 필요할 때 다시 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera cópias baixadas para ficar dentro do limite do cache. Só cópias que seu servidor já tem, e elas são baixadas de novo quando você precisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождает загруженные копии, чтобы не превышать лимит кэша. Только копии, которые уже есть на вашем сервере; при необходимости они загружаются снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放已下载的副本，使占用空间保持在缓存上限以内。只会清除服务器上已有的副本，需要时会重新获取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "釋放已下載的副本，以維持在快取上限內。只會釋放伺服器已保存的副本，需要時會再次下載。"
          }
        }
      }
    },
    "app.settings.maintenance.detail.deep_content_validation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد قراءة كل ملف مخزّن لاكتشاف التلف الذي لن يلاحظه أي شيء آخر. بطيء، ويُفضَّل توصيل الشاحن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Liest jede gespeicherte Datei erneut, um Beschädigungen zu finden, die sonst niemand bemerken würde. Langsam und am besten am Ladegerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-reads every stored file to catch corruption that nothing else would notice. Slow, and wants a charger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a leer todos los archivos almacenados para detectar daños que nada más notaría. Es lento y conviene tener el cargador conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Relit chaque fichier stocké pour détecter une corruption que rien d'autre ne remarquerait. Lent, de préférence sur secteur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर संग्रहीत फ़ाइल को फिर से पढ़ता है ताकि ऐसी ख़राबी पकड़ी जा सके जो और किसी तरह पता न चले। धीमा है, और चार्जर चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilegge ogni file archiviato per individuare danni che nient'altro noterebbe. Lento, meglio con il caricabatterie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存されているすべてのファイルを読み直し、ほかでは気づけない破損を検出します。時間がかかるため、充電中の実行をおすすめします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 모든 파일을 다시 읽어 다른 방법으로는 알아차릴 수 없는 손상을 찾아냅니다. 시간이 오래 걸리므로 충전 중에 실행하는 것이 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Relê todos os arquivos armazenados para detectar corrupção que nada mais perceberia. Lento, e é melhor com o carregador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заново читает каждый сохранённый файл, чтобы выявить повреждения, которые иначе остались бы незамеченными. Медленно, лучше подключить зарядку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新读取每个已存储的文件，以发现其他方式无法察觉的损坏。速度较慢，建议连接充电器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新讀取每個已儲存的檔案，找出其他方式無法察覺的損毀。速度較慢，建議接上充電器。"
          }
        }
      }
    },
    "app.settings.maintenance.detail.index_reconciliation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن فهرس Capsule بما هو موجود فعلًا على هذا الجهاز. سريع، ويُبلغ عن أي شيء غير متطابق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht den Index von Capsule mit dem, was tatsächlich auf diesem Gerät ist. Schnell, und meldet alles, was nicht übereinstimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares Capsule's index against what's actually on this device. Quick, and reports anything that doesn't line up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara el índice de Capsule con lo que hay realmente en este dispositivo. Es rápido e informa de cualquier discrepancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare l'index de Capsule à ce qui se trouve réellement sur cet appareil. Rapide, et signale toute incohérence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule के इंडेक्स की तुलना इस डिवाइस पर वास्तव में मौजूद चीज़ों से करता है। तेज़ है, और जो कुछ मेल नहीं खाता उसकी रिपोर्ट करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta l'indice di Capsule con ciò che si trova davvero su questo dispositivo. Rapido, segnala tutto ciò che non corrisponde."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule のインデックスを、このデバイス上の実際の内容と照合します。短時間で終わり、一致しないものがあれば報告します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule의 색인을 이 기기에 실제로 있는 항목과 비교합니다. 빠르게 끝나며, 일치하지 않는 항목을 알려줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara o índice do Capsule com o que realmente está neste dispositivo. Rápido, e informa tudo o que não confere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивает индекс Capsule с тем, что действительно есть на этом устройстве. Быстро; сообщает обо всех расхождениях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 Capsule 的索引与此设备上的实际内容进行比较。速度较快，会报告所有不一致之处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將 Capsule 的索引與此裝置上的實際內容進行比對。速度很快，並會回報任何不一致之處。"
          }
        }
      }
    },
    "app.settings.maintenance.detail.intra_library_deduplication": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث عن الصورة نفسها المخزّنة أكثر من مرة ويعرض ما يعثر عليه. لا يدمج أو يحذف أي شيء بنفسه أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sucht nach Fotos, die mehrfach gespeichert sind, und listet die Funde auf. Es führt selbst nie etwas zusammen und löscht nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks for the same photo stored more than once and lists what it finds. It never merges or deletes anything itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca la misma foto almacenada más de una vez y muestra lo que encuentra. Nunca combina ni elimina nada por sí mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche les photos stockées plusieurs fois et liste ce qu'il trouve. Ne fusionne ni ne supprime jamais rien de lui-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही फ़ोटो के एक से अधिक बार संग्रहीत होने की जाँच करता है और जो मिलता है उसकी सूची बनाता है। यह ख़ुद कभी कुछ मर्ज या हटाता नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerca la stessa foto archiviata più di una volta ed elenca ciò che trova. Non unisce né elimina mai nulla da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ写真が複数保存されていないかを探し、見つかったものを一覧表示します。自動で結合や削除を行うことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번 이상 저장된 같은 사진을 찾아 목록으로 보여줍니다. 직접 병합하거나 삭제하지는 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procura a mesma foto armazenada mais de uma vez e lista o que encontrar. Nunca mescla nem apaga nada por conta própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ищет одинаковые фото, сохранённые несколько раз, и выводит список найденного. Сама ничего не объединяет и не удаляет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找被多次存储的同一张照片，并列出找到的结果。它本身绝不会合并或删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尋找重複儲存的相同照片，並列出找到的項目。它絕不會自行合併或刪除任何內容。"
          }
        }
      }
    },
    "app.settings.maintenance.detail.structural_validation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق من أن سجل كل صورة يُقرأ بشكل صحيح وأن توقيعاته سليمة. سريع نسبيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüft, ob sich der Eintrag jedes Fotos korrekt lesen lässt und seine Signaturen gültig sind. Relativ schnell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that each photo's record reads correctly and its signatures hold. Reasonably quick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que el registro de cada foto se lee correctamente y que sus firmas son válidas. Bastante rápido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie que la fiche de chaque photo se lit correctement et que ses signatures sont valides. Assez rapide."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचता है कि हर फ़ोटो का रिकॉर्ड सही ढंग से पढ़ा जाता है और उसके हस्ताक्षर मान्य हैं। काफ़ी तेज़ है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che il record di ogni foto sia leggibile e che le sue firme siano valide. Abbastanza rapido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各写真の記録が正しく読み取れ、署名が有効であることを確認します。比較的短時間で終わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 사진의 기록을 올바르게 읽을 수 있는지, 서명이 유효한지 확인합니다. 비교적 빠르게 끝납니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica se o registro de cada foto é lido corretamente e se as assinaturas são válidas. Razoavelmente rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяет, что запись каждого фото читается правильно, а её подписи действительны. Достаточно быстро."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查每张照片的记录能否正确读取，以及其签名是否有效。速度较快。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查每張照片的紀錄能否正確讀取，以及其簽章是否有效。速度還算快。"
          }
        }
      }
    },
    "app.settings.maintenance.detail.trash_purge": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الصور المحذوفة نهائيًا بعد انقضاء فترة الاحتفاظ بها، ويحرر المساحة التي كانت تشغلها. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt gelöschte Fotos endgültig, sobald ihre Aufbewahrungsfrist abgelaufen ist, und gibt ihren Speicherplatz frei. Das lässt sich nicht widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently removes deleted photos once they're past their retention period, freeing the space they held. This one can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina definitivamente las fotos borradas cuando superan su período de retención y libera el espacio que ocupaban. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime définitivement les photos supprimées une fois leur durée de conservation écoulée, libérant l'espace qu'elles occupaient. Cette action est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाई गई फ़ोटो को उनकी प्रतिधारण अवधि बीत जाने पर स्थायी रूप से हटाता है, और उनकी जगह ख़ाली करता है। इसे पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove definitivamente le foto eliminate una volta superato il periodo di conservazione, liberando lo spazio che occupavano. Questa operazione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持期間を過ぎた削除済みの写真を完全に消去し、使用していた容量を解放します。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관 기간이 지난 삭제된 사진을 영구적으로 제거하여 사용하던 공간을 확보합니다. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove permanentemente as fotos apagadas que passaram do período de retenção, liberando o espaço que ocupavam. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Безвозвратно удаляет удалённые фото по истечении срока хранения и освобождает занимаемое ими место. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永久移除已超过保留期的已删除照片，释放其占用的空间。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永久移除已超過保留期限的已刪除照片，釋放它們佔用的空間。此操作無法復原。"
          }
        }
      }
    },
    "app.settings.maintenance.detail.unknown": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهمة يعرفها إصدار أحدث من Capsule ولا يعرفها هذا الإصدار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufgabe, die eine neuere Version von Capsule kennt, diese aber nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A job a newer version of Capsule knows about and this one doesn't."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea que conoce una versión más reciente de Capsule, pero esta no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tâche connue d'une version plus récente de Capsule, mais pas de celle-ci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ऐसा कार्य जिसे Capsule का नया संस्करण जानता है, पर यह संस्करण नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'attività nota a una versione più recente di Capsule ma non a questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンの Capsule が認識している、このバージョンでは不明な処理です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전의 Capsule에서 지원하며 이 버전에서는 알 수 없는 작업입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma tarefa que uma versão mais recente do Capsule conhece e esta não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задача, о которой знает более новая версия Capsule, но не эта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "较新版本的 Capsule 能识别、但此版本无法识别的任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "較新版本的 Capsule 才認得的工作，此版本無法辨識。"
          }
        }
      }
    },
    "app.settings.maintenance.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مكتبة على هذا الجهاز لفحصها بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät gibt es noch keine Mediathek, die geprüft werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no library on this device to check yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay ninguna biblioteca en este dispositivo que comprobar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n'y a pas encore de bibliothèque à vérifier sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर अभी जाँचने के लिए कोई लाइब्रेरी नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo dispositivo non c'è ancora una libreria da controllare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスには、まだチェックするライブラリがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 아직 확인할 라이브러리가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há biblioteca neste dispositivo para verificar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве пока нет медиатеки для проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上尚无可检查的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上還沒有可檢查的圖庫。"
          }
        }
      }
    },
