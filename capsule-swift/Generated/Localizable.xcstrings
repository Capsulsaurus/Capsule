    "error.sync.cursor_invalid": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جلسة المزامنة قديمة. سيعيد Capsule المزامنة من البداية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierungssitzung ist veraltet. Capsule synchronisiert von vorne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync session is out of date. Capsule will resync from the start."
          }
        },
        "es": {
