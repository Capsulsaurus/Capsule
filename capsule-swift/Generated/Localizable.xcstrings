    "app.settings.security.method.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Capsule ما يوفره هذا الجهاز بالفعل. لا يوجد رمز دخول منفصل لـ Capsule قد تنساه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule verwendet, was dieses Gerät bereits bietet. Es gibt keinen separaten Capsule-Code, den du vergessen könntest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule uses whatever this device already offers. There's no separate Capsule passcode to forget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule usa lo que este dispositivo ya ofrece. No hay un código de Capsule aparte que olvidar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule utilise ce que cet appareil propose déjà. Pas de code Capsule distinct à oublier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule वही उपयोग करता है जो यह डिवाइस पहले से देता है। भूलने के लिए कोई अलग Capsule पासकोड नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule usa ciò che questo dispositivo offre già. Non c'è un codice Capsule separato da dimenticare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はこのデバイスにすでにある機能を使用します。Capsule 専用のパスコードを覚える必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 이 기기에서 이미 제공하는 방법을 사용합니다. 잊어버릴 별도의 Capsule 암호는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule usa o que este dispositivo já oferece. Não há um código separado do Capsule para esquecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule использует то, что уже есть на этом устройстве. Отдельного код-пароля Capsule, который можно забыть, нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 使用此设备已有的解锁方式，没有需要另外记住的 Capsule 密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會使用此裝置現有的功能，不需要另外記住 Capsule 密碼。"
          }
        }
      }
    },
