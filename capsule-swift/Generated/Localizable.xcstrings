    "app.settings.storage.reclaim.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تُمسح إلا النسخ الموجودة على الخادم بالفعل. يبقى كل ما لم يؤكده الخادم في مكانه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Kopien, die dein Server bereits hat, werden gelöscht. Alles, was er nicht bestätigt hat, bleibt erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only copies your server already holds are cleared. Anything it hasn't confirmed stays put."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se borran las copias que tu servidor ya tiene. Lo que no haya confirmado se queda donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les copies déjà détenues par votre serveur sont effacées. Tout ce qu'il n'a pas confirmé reste en place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही कॉपियाँ साफ़ की जाती हैं जो आपके सर्वर पर पहले से हैं। जिसकी सर्वर ने पुष्टि नहीं की है, वह यहीं रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono cancellate solo le copie già presenti sul tuo server. Ciò che non ha confermato resta dov'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消去されるのは、サーバーにすでに保存されているコピーのみです。サーバーで確認されていないものはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 이미 있는 사본만 정리됩니다. 서버가 확인하지 않은 항목은 그대로 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só são limpas as cópias que seu servidor já tem. O que ele ainda não confirmou permanece aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляются только копии, которые уже есть на вашем сервере. Всё, что он не подтвердил, остаётся на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会清除服务器上已有的副本。服务器尚未确认的内容都会保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會清除伺服器已保存的副本。伺服器尚未確認的內容會保留不動。"
          }
        }
      }
    },
