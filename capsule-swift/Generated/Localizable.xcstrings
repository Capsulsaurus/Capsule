    "app.auth.server.domain.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث Capsule عن تفاصيل الخادم في هذا النطاق. لا يُرسَل إليه أي شيء بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ruft die Serverdetails unter dieser Domain ab. Es wird noch nichts an den Server gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule looks up the server's details at this domain. Nothing is sent to it yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule busca los datos del servidor en este dominio. Todavía no se le envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule recherche les informations du serveur à ce domaine. Rien ne lui est encore envoyé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule इस डोमेन पर सर्वर का विवरण खोजता है। अभी इसे कुछ भी नहीं भेजा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule cerca i dettagli del server a questo dominio. Per ora non gli viene inviato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はこのドメインでサーバーの情報を検索します。この時点ではまだ何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 이 도메인에서 서버 정보를 찾습니다. 아직 아무것도 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule busca os detalhes do servidor neste domínio. Nada é enviado a ele ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule получит сведения о сервере по этому домену. Пока ему ничего не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 会在此域名下查找服务器信息，此时不会向其发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會在此網域查詢伺服器的詳細資料，目前尚不會傳送任何內容給它。"
          }
        }
      }
    },
