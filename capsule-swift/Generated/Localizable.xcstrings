    "app.quarantine.action.inspect.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاطلاع على ما تم الاحتفاظ به، دون تغيير أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufbewahrte ansehen, ohne etwas zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at what was kept, without changing anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver lo que se guardó sin cambiar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner ce qui a été conservé, sans rien modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिना कुछ बदले देखें कि क्या रखा गया था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda ciò che è stato conservato, senza modificare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も変更せずに、保管されているデータを確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 변경하지 않고 보관된 항목을 살펴봅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ver o que foi guardado, sem alterar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотреть сохранённые данные, ничего не изменяя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查看保留的内容，不做任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "查看保留的內容，不做任何變更。"
          }
        }
      }
    },
    "app.quarantine.action.inspect.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحتفظ بشيء لفحصه — فقط سجل بأن هذا حدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nichts zum Untersuchen aufbewahrt – nur ein Eintrag, dass dies passiert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing was kept to inspect — only a record that this happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó nada que inspeccionar, solo un registro de lo que ocurrió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a été conservé à inspecter, seulement une trace de l'événement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जाँचने के लिए कुछ नहीं रखा गया — केवल इस बात का रिकॉर्ड है कि ऐसा हुआ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato conservato nulla da esaminare, solo una registrazione dell'accaduto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認できるデータは保管されていません。発生した記録だけが残っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사할 수 있도록 보관된 항목이 없습니다. 이 일이 발생했다는 기록만 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada foi guardado para inspecionar — apenas um registro de que isso aconteceu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для просмотра ничего не сохранено — только запись о том, что это произошло."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有保留可供检查的内容，只有一条事件记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有保留可供檢查的內容，只有此事發生過的紀錄。"
          }
        }
      }
    },
