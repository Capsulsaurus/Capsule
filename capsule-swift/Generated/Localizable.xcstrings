      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "{title}. {reason}"
          }
        }
      }
    },
    "android.sync.quarantine_never_silent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never applied automatically"
          }
        }
      }
    },
    "android.sync.quarantine_reason_album_upgrade": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change arrived while its album was mid-upgrade, so it is held until the upgrade finishes."
          }
        }
      }
    },
    "android.sync.quarantine_reason_drop_review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone sent this through one of your upload links. It stays out of your library until you say otherwise."
          }
        }
      }
    },
    "android.sync.quarantine_reason_federation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared album's server sent an item that did not verify. It is held rather than shown."
          }
        }
      }
    },
    "android.sync.quarantine_reason_malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This photo's details would not parse. The unreadable bytes have been kept exactly as they arrived rather than guessed at."
          }
        }
      }
    },
    "android.sync.quarantine_reason_orphaned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An original file was found with nothing beside it describing what it is."
          }
        }
      }
    },
    "android.sync.quarantine_reason_restore_conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A restored copy of this photo has a different history from the one on this device. Only you can say which one is right."
          }
        }
      }
    },
    "android.sync.quarantine_reason_stale_revival": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another device proposed a change built on an older version of this photo than the one you already have. Applying it would undo what came after."
          }
        }
      }
    },
    "android.sync.quarantine_reason_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Capsule does not recognise why this was held. It has not been applied to anything."
          }
        }
      }
    },
    "android.sync.quarantine_reason_verify_reject": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signature on this change did not verify against your device directory, so Capsule will not treat it as yours."
          }
        }
      }
    },
    "android.sync.quarantine_summary": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule refused these rather than applying them. Nothing here has been changed while it waits for you."
          }
        }
      }
    },
    "android.sync.quarantine_title_album_upgrade": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held during an album upgrade"
          }
        }
      }
    },
    "android.sync.quarantine_title_drop_review": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deposit awaiting your review"
          }
        }
      }
    },
    "android.sync.quarantine_title_federation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shared source failed verification"
          }
        }
      }
    },
    "android.sync.quarantine_title_malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details that could not be read"
          }
        }
      }
    },
    "android.sync.quarantine_title_orphaned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An original with no details beside it"
          }
        }
      }
    },
    "android.sync.quarantine_title_restore_conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A restore conflicts with this device"
          }
        }
      }
    },
    "android.sync.quarantine_title_stale_revival": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stale change from another device"
          }
        }
      }
    },
    "android.sync.quarantine_title_unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Held for a reason this version does not know"
