    "app.settings.maintenance.jobs.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعض هذه المهام بطيء ويُفضَّل توصيل الشاحن. ينتظر Capsule الظروف المناسبة بدلًا من تشغيلها في وقت غير مناسب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige davon sind langsam und brauchen ein Ladegerät. Capsule wartet auf die richtigen Bedingungen, statt sie zu einem ungünstigen Zeitpunkt auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some of these are slow and want a charger. Capsule waits for the right conditions rather than running them at a bad moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunas son lentas y conviene tener el cargador conectado. Capsule espera a que se den las condiciones adecuadas en lugar de ejecutarlas en mal momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines de ces tâches sont lentes et préfèrent un chargeur. Capsule attend les bonnes conditions plutôt que de les lancer au mauvais moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनमें से कुछ धीमे हैं और चार्जर चाहते हैं। Capsule इन्हें ग़लत समय पर चलाने के बजाय सही परिस्थितियों की प्रतीक्षा करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune sono lente e richiedono il caricabatterie. Capsule attende le condizioni giuste invece di eseguirle in un momento sbagliato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の処理は時間がかかるため、充電中の実行をおすすめします。Capsule は都合の悪いタイミングで実行せず、適切な条件になるまで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 작업은 시간이 오래 걸리므로 충전 중에 실행하는 것이 좋습니다. Capsule은 부적절한 때에 실행하지 않고 적절한 조건이 될 때까지 기다립니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas são lentas e é melhor rodá-las com o carregador. O Capsule espera as condições certas em vez de executá-las num momento ruim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые из них выполняются медленно, и лучше подключить зарядку. Capsule дожидается подходящих условий, а не запускает их в неудачный момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中一些任务较慢，建议连接充电器。Capsule 会等待合适的条件，而不会在不恰当的时候运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分工作速度較慢，建議接上充電器。Capsule 會等待合適的時機，而不會在不恰當的時候執行。"
          }
        }
      }
    },
