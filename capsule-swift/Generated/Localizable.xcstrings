    "drop.done.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسلت ملفاتك ليراجعها مالك الألبوم. لن تظهر حتى يضيفها المالك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Dateien wurden zur Prüfung an den Albumbesitzer gesendet. Sie erscheinen erst, wenn der Besitzer sie hinzufügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files have been sent for the album owner to review. They won't appear until the owner adds them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos se han enviado para que el propietario del álbum los revise. No aparecerán hasta que el propietario los añada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers ont été envoyés au propriétaire de l'album pour examen. Ils n'apparaîtront pas tant qu'il ne les aura pas ajoutés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ाइलें एल्बम के स्वामी को समीक्षा के लिए भेज दी गई हैं। स्वामी के जोड़ने तक वे दिखाई नहीं देंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi file sono stati inviati al proprietario dell'album per la revisione. Non compariranno finché il proprietario non li aggiunge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはアルバムの所有者に送信され、確認を待っています。所有者が追加するまで表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일이 앨범 소유자에게 검토용으로 전송되었습니다. 소유자가 추가하기 전까지는 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus arquivos foram enviados para revisão do dono do álbum. Eles só aparecerão quando o dono os adicionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши файлы отправлены владельцу альбома на проверку. Они появятся только после того, как владелец их добавит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的文件已发送给相册所有者审核。所有者添加后它们才会显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
