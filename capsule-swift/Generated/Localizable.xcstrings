    "app.devices.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل جهاز مسجّل في حسابك، والجلسات المسجّل دخولها على كل منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle in deinem Konto registrierten Geräte und die auf jedem angemeldeten Sitzungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device enrolled on your account, and the sessions signed in on each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los dispositivos registrados en tu cuenta y las sesiones iniciadas en cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les appareils enrôlés sur votre compte, et les sessions ouvertes sur chacun d'eux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खाते पर पंजीकृत हर डिवाइस, और हर एक पर साइन इन किए गए सत्र।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i dispositivi registrati sul tuo account e le sessioni attive su ciascuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントに登録されたすべてのデバイスと、それぞれでサインイン中のセッションです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 등록된 모든 기기와 각 기기에서 로그인한 세션입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dispositivos registrados na sua conta e as sessões conectadas em cada um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все устройства, зарегистрированные в вашей учётной записи, и сеансы на каждом из них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您账户上注册的所有设备，以及每台设备上登录的会话。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已註冊到你帳號的所有裝置，以及每台裝置上已登入的工作階段。"
          }
        }
      }
    },
