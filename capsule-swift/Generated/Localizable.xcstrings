            "value": "還原衝突"
          }
        }
      }
    },
    "app.quarantine.surface.restore_conflict.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتعارض نسخة احتياطية استعدتها مع ما تحتويه مكتبتك بالفعل. احتجزها Capsule بدلًا من الكتابة فوق عمل أحدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wiederhergestelltes Backup weicht von dem ab, was bereits in deiner Mediathek ist. Capsule hat es zurückgehalten, statt neuere Arbeit zu überschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup you restored disagrees with what your library already has. Capsule held it rather than overwriting newer work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de seguridad que restauraste no coincide con lo que ya tiene tu fototeca. Capsule la retuvo en lugar de sobrescribir trabajo más reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde que vous avez restaurée ne concorde pas avec le contenu actuel de votre photothèque. Capsule l'a retenue plutôt que d'écraser un travail plus récent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा रीस्टोर किया गया बैकअप आपकी लाइब्रेरी में पहले से मौजूद सामग्री से मेल नहीं खाता। Capsule ने नए काम को ओवरराइट करने के बजाय इसे रोक दिया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un backup che hai ripristinato non concorda con il contenuto attuale della tua libreria. Capsule lo ha trattenuto invece di sovrascrivere il lavoro più recente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元したバックアップの内容がライブラリの内容と一致しません。Capsule は新しい作業を上書きせずに保留しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원한 백업이 보관함에 이미 있는 내용과 다릅니다. Capsule은 최신 작업을 덮어쓰지 않고 이 항목을 보류했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup que você restaurou diverge do que sua biblioteca já tem. O Capsule o reteve em vez de sobrescrever um trabalho mais recente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановленная резервная копия расходится с тем, что уже есть в медиатеке. Capsule задержала её, чтобы не перезаписать более новые изменения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您恢复的备份与资料库中已有的内容不一致。Capsule 暂扣了它，以免覆盖较新的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您還原的備份與圖庫中現有的內容不一致。Capsule 已將其暫留，而不是覆寫較新的內容。"
          }
        }
      }
    },
    "app.quarantine.surface.sidecar": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل غير مقروء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlesbarer Eintrag"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unreadable Record"
          }
        },
        "es": {
