    "app.totp.manual.note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذا إذا تعذّر على تطبيق المصادقة المسح. تعامل معه ككلمة مرور — فأي شخص يملكه يمكنه إنشاء رموزك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende dies, wenn deine Authentifizierungs-App nicht scannen kann. Behandle ihn wie ein Passwort – wer ihn hat, kann deine Codes erzeugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this if your authenticator can't scan. Treat it like a password — anyone with it can generate your codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa esto si tu autenticador no puede escanear. Trátala como una contraseña: cualquiera que la tenga puede generar tus códigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez cette clé si votre authentificateur ne peut pas scanner. Traitez-la comme un mot de passe : toute personne qui la possède peut générer vos codes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपका ऑथेंटिकेटर स्कैन नहीं कर सकता, तो इसका उपयोग करें। इसे पासवर्ड की तरह सुरक्षित रखें — जिसके पास भी यह है, वह आपके कोड बना सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usala se l'app di autenticazione non riesce a scansionare. Trattala come una password: chiunque la possieda può generare i tuoi codici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリでスキャンできない場合に使用します。パスワードと同様に扱ってください。これを知っている人は誰でもコードを生成できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱에서 스캔할 수 없는 경우 사용하세요. 비밀번호처럼 취급하세요. 이 키가 있으면 누구나 코드를 생성할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use isto se o seu autenticador não conseguir ler o código. Trate como uma senha — qualquer pessoa com ela pode gerar seus códigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте это, если приложение-аутентификатор не может отсканировать код. Храните ключ как пароль — любой, у кого он есть, может генерировать ваши коды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的验证器无法扫描，请使用此密钥。请像对待密码一样保管它——任何拥有它的人都能生成您的验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的驗證器無法掃描，請使用此金鑰。請像密碼一樣妥善保管——任何取得它的人都能產生您的驗證碼。"
          }
        }
      }
    },
