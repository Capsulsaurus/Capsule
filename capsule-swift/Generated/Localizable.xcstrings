    "app.settings.recovery.verify.rewrap_offer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعد عدة فحوصات غير ناجحة، يمكن لـ Capsule أن يمنحك عبارة جديدة لمفتاح الحساب نفسه. لن تتأثر صورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach mehreren erfolglosen Prüfungen kann Capsule dir eine neue Phrase für denselben Kontoschlüssel geben. Deine Fotos bleiben unberührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After several unsuccessful checks, Capsule can give you a new phrase for the same account key. Your photos aren't touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras varias comprobaciones fallidas, Capsule puede darte una nueva frase para la misma clave de cuenta. Tus fotos no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après plusieurs vérifications infructueuses, Capsule peut vous fournir une nouvelle phrase pour la même clé de compte. Vos photos ne sont pas modifiées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई असफल जाँचों के बाद, Capsule आपको उसी खाता कुंजी के लिए एक नया फ़्रेज़ दे सकता है। आपकी फ़ोटो पर कोई असर नहीं पड़ता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo diverse verifiche non riuscite, Capsule può darti una nuova frase per la stessa chiave dell'account. Le tue foto non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認に何度か失敗した場合、Capsule は同じアカウントキーに対する新しいフレーズを発行できます。写真には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인에 여러 번 실패하면 Capsule이 같은 계정 키에 대한 새 문구를 발급할 수 있습니다. 사진은 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após várias verificações sem sucesso, o Capsule pode criar uma nova frase para a mesma chave da conta. Suas fotos não são alteradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После нескольких неудачных проверок Capsule может выдать вам новую фразу для того же ключа учётной записи. Ваши фото не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多次检查未成功后，Capsule 可以为同一账户密钥生成新的短语。您的照片不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在多次檢查失敗後，Capsule 可以為同一把帳號金鑰提供新的詞組。您的照片不會受到影響。"
          }
        }
      }
    },
