          }
        }
      }
    },
    "app.quarantine.surface.stale_revival.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض شيء ما إصدارًا من صورة أقدم من الإصدار الموجود لديك. احتجزه Capsule بدلًا من إرجاع مكتبتك إلى الوراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas hat eine ältere Version eines Fotos angeboten als die, die du bereits hast. Capsule hat sie zurückgehalten, statt deine Mediathek zurückzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something offered an older version of a photo than the one you already have. Capsule held it rather than winding your library back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ofreció una versión de una foto anterior a la que ya tienes. Capsule la retuvo en lugar de hacer retroceder tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version d'une photo plus ancienne que celle que vous possédez a été proposée. Capsule l'a retenue plutôt que de faire revenir votre photothèque en arrière."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी चीज़ ने किसी फ़ोटो का वह संस्करण भेजा जो आपके पास पहले से मौजूद संस्करण से पुराना है। Capsule ने आपकी लाइब्रेरी को पीछे ले जाने के बजाय इसे रोक दिया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata proposta una versione di una foto più vecchia di quella che hai già. Capsule l'ha trattenuta invece di riportare indietro la tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでにあるものより古いバージョンの写真が送られてきました。Capsule はライブラリを巻き戻さずに保留しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 가지고 있는 사진보다 오래된 버전이 전송되었습니다. Capsule은 보관함을 이전 상태로 되돌리지 않고 이 항목을 보류했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo ofereceu uma versão de uma foto mais antiga do que a que você já tem. O Capsule a reteve em vez de fazer sua biblioteca voltar no tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поступила версия фото старше той, что у вас уже есть. Capsule задержала её, чтобы не откатывать вашу медиатеку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到了比您现有版本更旧的照片版本。Capsule 暂扣了它，以免让您的资料库回退。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有來源提供了比您現有版本更舊的照片版本。Capsule 已將其暫留，而不是讓您的圖庫倒退。"
          }
        }
      }
    },
    "app.quarantine.surface.unknown": {
