    "app.diagnostics.crash_alert.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن أن يساعدنا تقرير تشخيصي منقّح في إصلاح التعطّل. لا يحتوي على أي صور أو محتويات ألبومات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein bereinigter Diagnosebericht kann uns helfen, den Absturz zu beheben. Er enthält keine Fotos oder Albuminhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A redacted diagnostic report can help us fix the crash. It contains no photos or album contents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un informe de diagnóstico anonimizado puede ayudarnos a corregir el fallo. No contiene fotos ni contenido de álbumes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapport de diagnostic expurgé peut nous aider à corriger le plantage. Il ne contient aucune photo ni contenu d'album."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक संशोधित डायग्नोस्टिक रिपोर्ट से हमें क्रैश ठीक करने में मदद मिल सकती है। इसमें कोई फ़ोटो या एल्बम सामग्री नहीं होती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapporto diagnostico anonimizzato può aiutarci a risolvere l'arresto anomalo. Non contiene foto né contenuti degli album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集済みの診断レポートはクラッシュの修正に役立ちます。写真やアルバムの内容は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집된 진단 보고서는 충돌 문제를 해결하는 데 도움이 됩니다. 사진이나 앨범 콘텐츠는 포함되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um relatório de diagnóstico sem dados sensíveis pode nos ajudar a corrigir a falha. Ele não contém fotos nem conteúdo de álbuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обезличенный диагностический отчёт поможет нам устранить сбой. В нём нет фото и содержимого альбомов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份已脱敏的诊断报告可以帮助我们修复此崩溃。报告不包含任何照片或相册内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "經過遮蔽處理的診斷報告可協助我們修正當機問題，其中不含任何照片或相簿內容。"
          }
        }
      }
    },
