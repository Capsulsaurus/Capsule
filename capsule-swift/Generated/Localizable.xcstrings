    "app.settings.appearance.theme.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتباع النظام هو غالبًا ما تريده — فهو يعرف بالفعل متى تفضّل الوضع الداكن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem System zu folgen ist meist die beste Wahl – es weiß bereits, wann du es dunkel magst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Following the system is usually what you want — it already knows when you prefer dark."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir el sistema suele ser lo más adecuado: ya sabe cuándo prefieres el modo oscuro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Suivre le système est généralement le meilleur choix : il sait déjà quand vous préférez le mode sombre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमतौर पर सिस्टम का पालन करना ही सही रहता है — उसे पहले से पता है कि आप कब डार्क पसंद करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguire il sistema è di solito la scelta migliore: sa già quando preferisci la modalità scura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常はシステムに合わせるのがおすすめです。ダークモードを使いたいタイミングはシステムが把握しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 경우 시스템 설정을 따르는 것이 좋습니다. 시스템은 언제 다크 모드를 선호하는지 이미 알고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir o sistema costuma ser o ideal — ele já sabe quando você prefere o modo escuro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно лучше следовать системе — она уже знает, когда вы предпочитаете тёмное оформление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通常跟随系统即可，系统已经知道您何时偏好深色。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "跟隨系統通常是最好的選擇，系統已經知道您何時偏好深色。"
          }
        }
      }
    },
