    "app.enrollment.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشئ Capsule المفاتيح التي تحمي مكتبتك. كل خطوة مدرجة أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule erstellt die Schlüssel, die deine Mediathek schützen. Die einzelnen Schritte sind unten aufgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule is making the keys that protect your library. Each step is listed below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule está creando las claves que protegen tu biblioteca. Cada paso aparece a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule crée les clés qui protègent votre bibliothèque. Chaque étape est indiquée ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule आपकी लाइब्रेरी की सुरक्षा करने वाली कुंजियाँ बना रहा है। हर चरण नीचे सूचीबद्ध है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule sta creando le chiavi che proteggono la tua libreria. Ogni passaggio è elencato qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule がライブラリを保護する鍵を作成しています。各手順を以下に示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 라이브러리를 보호하는 키를 생성하고 있습니다. 각 단계는 아래에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule está criando as chaves que protegem sua biblioteca. Cada etapa está listada abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule создаёт ключи, защищающие вашу медиатеку. Все шаги перечислены ниже."
          }
        },
