            "value": "同期が完了しました：%3$@ ページで %2$@ 個のアルバムにわたり %1$@ 件の変更を適用しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 완료: %3$@개 페이지에 걸쳐 %2$@개 앨범에 %1$@개의 변경 사항을 적용했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronização concluída: %1$@ alteração(ões) aplicada(s) em %2$@ álbum(ns) ao longo de %3$@ página(s)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация завершена: применено изменений — %1$@, альбомов — %2$@, страниц — %3$@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步完成：在 %3$@ 页中跨 %2$@ 个相册应用了 %1$@ 项更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步完成：在 %3$@ 頁中跨 %2$@ 個相簿套用了 %1$@ 項變更。"
          }
        }
      }
    },
