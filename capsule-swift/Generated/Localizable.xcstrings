    "ios.settings.maintenance.confirm.action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run"
          }
        }
      }
    },
    "ios.settings.maintenance.confirm.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This can take a while and use a lot of battery. Capsule still waits for the right conditions — asking for it doesn't override that."
          }
        }
      }
    },
    "ios.settings.maintenance.confirm.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run This Now?"
          }
        }
      }
    },
    "ios.settings.maintenance.dedupe.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule only finds duplicates. Which copy to keep is always yours to choose — nothing is merged or deleted on its own."
          }
        }
      }
    },
    "ios.settings.maintenance.dedupe.found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets Found"
          }
        }
      }
    },
    "ios.settings.maintenance.dedupe.header": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplicates"
          }
        }
      }
    },
    "ios.settings.maintenance.dedupe.run": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find Duplicates"
          }
        }
      }
    },
    "ios.settings.maintenance.detail.cache_eviction": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Frees downloaded copies to stay under your cache limit. Only copies your server already holds, and they're fetched again when you need them."
          }
        }
      }
    },
    "ios.settings.maintenance.detail.deep_content_validation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-reads every stored file to catch corruption that nothing else would notice. Slow, and wants a charger."
          }
        }
      }
    },
    "ios.settings.maintenance.detail.index_reconciliation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares Capsule's index against what's actually on this device. Quick, and reports anything that doesn't line up."
          }
        }
      }
    },
    "ios.settings.maintenance.detail.intra_library_deduplication": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looks for the same photo stored more than once and lists what it finds. It never merges or deletes anything itself."
          }
        }
      }
    },
    "ios.settings.maintenance.detail.structural_validation": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks that each photo's record reads correctly and its signatures hold. Reasonably quick."
          }
        }
      }
    },
    "ios.settings.maintenance.detail.trash_purge": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Permanently removes deleted photos once they're past their retention period, freeing the space they held. This one can't be undone."
          }
        }
      }
    },
    "ios.settings.maintenance.detail.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A job a newer version of Capsule knows about and this one doesn't."
          }
        }
      }
    },
    "ios.settings.maintenance.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no library on this device to check yet."
          }
        }
      }
    },
    "ios.settings.maintenance.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to Maintain"
          }
        }
      }
    },
