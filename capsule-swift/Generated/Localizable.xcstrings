    "app.sync.cursor.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Capsule التغييرات من الخادم بالترتيب، لذا تستأنف المزامنة المنقطعة من حيث توقفت تمامًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule liest Änderungen von deinem Server der Reihe nach, sodass eine unterbrochene Synchronisierung genau dort weitermacht, wo sie aufgehört hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule reads changes from your server in order, so an interrupted sync picks up exactly where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule lee los cambios de tu servidor en orden, así que una sincronización interrumpida continúa exactamente donde se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule lit les modifications de votre serveur dans l'ordre : une synchronisation interrompue reprend exactement là où elle s'était arrêtée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule आपके सर्वर से बदलावों को क्रम से पढ़ता है, इसलिए बाधित सिंक ठीक वहीं से शुरू होता है जहाँ वह रुका था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule legge le modifiche dal tuo server in ordine, quindi una sincronizzazione interrotta riprende esattamente da dove si era fermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はサーバーからの変更を順番に読み込むため、中断された同期は停止した位置から正確に再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 서버의 변경 사항을 순서대로 읽으므로, 중단된 동기화는 멈춘 곳부터 정확히 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule lê as alterações do seu servidor em ordem, então uma sincronização interrompida continua exatamente de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule читает изменения с вашего сервера по порядку, поэтому прерванная синхронизация продолжается точно с места остановки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 按顺序从您的服务器读取更改，因此中断的同步会准确地从停止处继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會依序讀取伺服器上的變更，因此中斷的同步會從停止的地方準確繼續。"
          }
        }
      }
    },
