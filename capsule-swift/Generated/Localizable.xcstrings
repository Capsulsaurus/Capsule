    "app.settings.server.version.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يتفق Capsule والخادم على إصدار البروتوكول. إذا لم يعودا متفقين، فتحديث التطبيق هو الحل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule und dein Server müssen dieselbe Protokollversion verwenden. Wenn sie nicht mehr übereinstimmen, hilft ein Update der App."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule and your server have to agree on the protocol version. If they stop agreeing, updating the app is the fix."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule y tu servidor tienen que coincidir en la versión del protocolo. Si dejan de coincidir, la solución es actualizar la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule et votre serveur doivent utiliser la même version du protocole. S'ils ne s'accordent plus, mettez à jour l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule और आपके सर्वर के प्रोटोकॉल संस्करण का मेल खाना ज़रूरी है। अगर वे मेल न खाएँ, तो ऐप अपडेट करना ही उपाय है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule e il tuo server devono concordare sulla versione del protocollo. Se smettono di concordare, la soluzione è aggiornare l'app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule とサーバーのプロトコルバージョンは一致している必要があります。一致しなくなった場合は、アプリをアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule과 서버의 프로토콜 버전이 일치해야 합니다. 일치하지 않으면 앱을 업데이트하면 해결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule e seu servidor precisam concordar sobre a versão do protocolo. Se deixarem de concordar, atualizar o app resolve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версии протокола Capsule и вашего сервера должны совпадать. Если они перестанут совпадать, обновите приложение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 和您的服务器必须在协议版本上保持一致。如果出现不一致，更新应用即可解决。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 與您的伺服器必須使用一致的通訊協定版本。如果兩者不再一致，請更新 App。"
          }
        }
      }
    },
