    "app.recovery.passphrase.shown_once": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض هذه العبارة مرة واحدة فقط. دوّنها أو احفظها في مكان آمن الآن — لا أحد، بما في ذلك Capsule، يستطيع عرضها لك مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Phrase wird nur einmal angezeigt. Notiere sie oder speichere sie jetzt an einem sicheren Ort – niemand, auch nicht Capsule, kann sie dir erneut anzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phrase is shown once. Write it down or save it somewhere safe now — nobody, including Capsule, can show it to you again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta frase se muestra una sola vez. Anótala o guárdala ahora en un lugar seguro: nadie, ni siquiera Capsule, podrá volver a mostrártela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette phrase n'est affichée qu'une seule fois. Notez-la ou enregistrez-la en lieu sûr dès maintenant : personne, pas même Capsule, ne pourra vous la montrer de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़्रेज़ केवल एक बार दिखाया जाता है। इसे अभी लिख लें या किसी सुरक्षित जगह पर सहेज लें — Capsule सहित कोई भी इसे आपको फिर से नहीं दिखा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa frase viene mostrata una sola volta. Annotala o salvala subito in un posto sicuro: nessuno, nemmeno Capsule, potrà mostrartela di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフレーズは1回だけ表示されます。今すぐ書き留めるか、安全な場所に保存してください。Capsule を含め、誰も再表示することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 문구는 한 번만 표시됩니다. 지금 적어 두거나 안전한 곳에 저장하세요. Capsule을 포함해 누구도 다시 보여 줄 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta frase é mostrada uma única vez. Anote-a ou guarde-a em um lugar seguro agora — ninguém, nem mesmo o Capsule, poderá mostrá-la a você novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта фраза показывается один раз. Запишите её или сохраните в надёжном месте прямо сейчас — никто, включая Capsule, не сможет показать её вам снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此短语仅显示一次。请立即记下或保存在安全的地方。任何人（包括 Capsule）都无法再次向您显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此短語只會顯示一次。請立即抄寫下來或存放在安全的地方，任何人（包括 Capsule）都無法再次向您顯示。"
          }
        }
      }
    },
    "app.recovery.passphrase.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه العبارة هي الطريقة الوحيدة للعودة إلى مكتبتك إذا فقدت أجهزتك. دوّنها قبل المتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Phrase ist der einzige Weg zurück in deine Mediathek, wenn du deine Geräte verlierst. Notiere sie, bevor du fortfährst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This phrase is the only way back into your library if you lose your devices. Write it down before you continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta frase es la única forma de volver a tu fototeca si pierdes tus dispositivos. Anótala antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette phrase est le seul moyen de retrouver l'accès à votre photothèque si vous perdez vos appareils. Notez-la avant de continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप अपने डिवाइस खो दें, तो यह फ़्रेज़ ही आपकी लाइब्रेरी में वापस आने का एकमात्र तरीक़ा है। जारी रखने से पहले इसे लिख लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa frase è l'unico modo per rientrare nella tua libreria se perdi i dispositivi. Annotala prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを失った場合、このフレーズがライブラリに戻る唯一の方法です。続ける前に書き留めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 잃어버렸을 때 보관함에 다시 접근할 수 있는 유일한 방법이 이 문구입니다. 계속하기 전에 적어 두세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta frase é a única forma de voltar à sua biblioteca se você perder seus dispositivos. Anote-a antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта фраза — единственный способ вернуться в медиатеку, если вы потеряете устройства. Запишите её, прежде чем продолжить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您丢失了设备，此短语是重新进入资料库的唯一途径。请在继续之前记下它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您遺失了裝置，此短語是重新進入圖庫的唯一方式。請在繼續之前將它抄寫下來。"
          }
        }
      }
    },
