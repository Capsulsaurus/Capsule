    "app.restore.commit.note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح فقط بعد مقارنة اجتازت فحوصها. سيُطلب منك كتابة عبارة للتأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur nach einem Vergleich verfügbar, der seine Prüfungen bestanden hat. Du wirst gebeten, zur Bestätigung eine Phrase einzugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only after a comparison that passed its checks. You'll be asked to type a phrase to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo disponible tras una comparación que haya superado sus comprobaciones. Se te pedirá que escribas una frase para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement après une comparaison ayant passé ses vérifications. Vous devrez saisir une phrase pour confirmer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उस तुलना के बाद उपलब्ध है जो अपनी जाँचों में सफल रही हो। पुष्टि के लिए आपसे एक फ़्रेज़ टाइप करने को कहा जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibile solo dopo un confronto che ha superato i controlli. Ti verrà chiesto di digitare una frase per confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェックに合格した比較の後にのみ使用できます。確認のためにフレーズの入力が求められます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검사를 통과한 비교 후에만 사용할 수 있습니다. 확인을 위해 문구를 입력하라는 메시지가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível somente após uma comparação aprovada nas verificações. Você precisará digitar uma frase para confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно только после сравнения, прошедшего проверки. Для подтверждения потребуется ввести фразу."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅在比较通过检查后可用。系统会要求您输入短语以确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅在比對通過檢查後才能使用。系統會要求您輸入短語以確認。"
          }
        }
      }
    },
