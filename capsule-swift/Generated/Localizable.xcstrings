    "app.share.composer.passphrase.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل عبارة المرور بشكل منفصل عن الرابط. يمكن لأي شخص لديه كلاهما فتحه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende die Passphrase getrennt vom Link. Wer beides hat, kann ihn öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send the passphrase separately from the link. Anyone with both can open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía la frase de contraseña por separado del enlace. Cualquiera que tenga ambos puede abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez la phrase secrète séparément du lien. Toute personne disposant des deux peut l'ouvrir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासफ़्रेज़ लिंक से अलग भेजें। जिसके पास दोनों हों, वह इसे खोल सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia la passphrase separatamente dal link. Chiunque abbia entrambi può aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスフレーズはリンクとは別に送信してください。両方を持っている人は誰でも開くことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "암호문은 링크와 따로 보내십시오. 둘 다 가진 사람은 누구나 열 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envie a frase secreta separadamente do link. Quem tiver os dois pode abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправьте парольную фразу отдельно от ссылки. Любой, у кого есть и то и другое, сможет её открыть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将密码短语与链接分开发送。同时拥有两者的任何人都可以打开它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將密碼短語與連結分開傳送。同時擁有兩者的任何人都能開啟。"
          }
        }
      }
    },
