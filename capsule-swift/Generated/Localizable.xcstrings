    "app.enrollment.stage.publish_directory.explanation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال قائمة أجهزتك الموقَّعة إلى الخادم حتى تتعرّف أجهزتك الأخرى على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine signierte Geräteliste wird an den Server gesendet, damit deine anderen Geräte dieses erkennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending your signed device list to the server so your other devices recognize this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando tu lista firmada de dispositivos al servidor para que tus otros dispositivos reconozcan este."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoi de votre liste d'appareils signée au serveur pour que vos autres appareils reconnaissent celui-ci."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी हस्ताक्षरित डिवाइस सूची सर्वर को भेजी जा रही है ताकि आपके अन्य डिवाइस इसे पहचान सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invio dell'elenco firmato dei tuoi dispositivi al server, affinché gli altri tuoi dispositivi riconoscano questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名済みのデバイス一覧をサーバーに送信し、ほかのデバイスがこのデバイスを認識できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 기기 목록을 서버로 보내 다른 기기가 이 기기를 인식하도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviando sua lista de dispositivos assinada ao servidor para que seus outros dispositivos reconheçam este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписанный список устройств отправляется на сервер, чтобы другие ваши устройства распознали это."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在将您签名的设备列表发送到服务器，以便您的其他设备识别此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在將你已簽署的裝置清單傳送到伺服器，讓你的其他裝置能辨識此裝置。"
          }
        }
      }
    },
