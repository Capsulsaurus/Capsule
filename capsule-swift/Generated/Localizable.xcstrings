    "app.crossdevice.code.fallback_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم هذه الأرقام إذا تعذّر على الجهاز الآخر المسح. لا بأس بقراءتها بصوت عالٍ — فالرمز يعمل مرة واحدة، وتنتهي صلاحيته خلال عشر دقائق، وستقارن رمز أمان بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende diese Ziffern, wenn das andere Gerät nicht scannen kann. Du kannst sie bedenkenlos laut vorlesen – der Code funktioniert nur einmal, läuft nach zehn Minuten ab, und danach vergleichst du trotzdem noch einen Sicherheitscode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use these digits if the other device can't scan. They're safe to read aloud — the code works once, expires in ten minutes, and you'll still compare a safety code afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa estos dígitos si el otro dispositivo no puede escanear. Puedes leerlos en voz alta sin riesgo: el código funciona una sola vez, caduca en diez minutos y después compararás igualmente un código de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ces chiffres si l'autre appareil ne peut pas scanner. Vous pouvez les lire à voix haute sans risque : le code ne fonctionne qu'une fois, expire dans dix minutes, et vous comparerez ensuite un code de sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि दूसरा डिवाइस स्कैन न कर सके तो इन अंकों का उपयोग करें। इन्हें ज़ोर से पढ़ना सुरक्षित है — कोड एक ही बार काम करता है, दस मिनट में समाप्त हो जाता है, और बाद में आप फिर भी एक सुरक्षा कोड की तुलना करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa queste cifre se l'altro dispositivo non riesce a scansionare. Puoi leggerle ad alta voce senza rischi: il codice funziona una sola volta, scade dopo dieci minuti e in seguito confronterai comunque un codice di sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一方のデバイスでスキャンできない場合は、この数字を使用してください。読み上げても安全です。コードは1回限り有効で、10分で期限切れになり、そのあとで安全コードも照合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 스캔할 수 없으면 이 숫자를 사용하세요. 소리 내어 읽어도 안전합니다. 코드는 한 번만 작동하고 10분 후 만료되며, 이후에 안전 코드도 비교하게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use estes números se o outro dispositivo não conseguir escanear. Eles podem ser lidos em voz alta com segurança — o código funciona uma vez, expira em dez minutos e você ainda vai comparar um código de segurança depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте эти цифры, если другое устройство не может отсканировать код. Их можно безопасно произнести вслух: код одноразовый, действует десять минут, а после вы всё равно сравните код безопасности."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果另一台设备无法扫描，请使用这些数字。可以放心大声读出——该代码仅能使用一次，十分钟后过期，之后您还需比对安全码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果另一台裝置無法掃描，請使用這些數字。大聲唸出也很安全：此代碼只能使用一次、十分鐘後過期，而且之後你仍需比對安全碼。"
          }
        }
      }
    },
