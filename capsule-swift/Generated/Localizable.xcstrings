          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए ऊपर दिए गए हर विरोध का उत्तर दें और इस डिवाइस पर जगह बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi a tutti i conflitti sopra e libera spazio su questo dispositivo per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続けるには、上のすべての競合に回答し、このデバイスの空き容量を確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 위의 모든 충돌에 답하고 이 기기의 공간을 확보하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda a todos os conflitos acima e libere espaço neste dispositivo para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы продолжить, решите все конфликты выше и освободите место на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请处理上方的所有冲突并在此设备上腾出空间以继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請回答上方的每個衝突，並在此裝置上騰出空間以繼續。"
          }
        }
      }
    },
