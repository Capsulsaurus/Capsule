    "app.passkey.done.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الآن تسجيل الدخول بمفتاح المرور هذا بدلًا من كلمة المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich jetzt mit diesem Passkey statt mit deinem Passwort anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can now sign in with this passkey instead of your password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora puedes iniciar sesión con esta llave de acceso en lugar de tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désormais vous connecter avec cette clé d'accès au lieu de votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अब आप अपने पासवर्ड के बजाय इस पासकी से साइन इन कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora puoi accedere con questa passkey invece che con la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今後はパスワードの代わりにこのパスキーでサインインできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 비밀번호 대신 이 패스키로 로그인할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agora você pode iniciar sessão com esta chave de acesso em vez da sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Теперь вы можете входить с этим ключом доступа вместо пароля."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在您可以使用此通行密钥代替密码登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您現在可以使用此通行密鑰登入，而不必輸入密碼。"
          }
        }
      }
