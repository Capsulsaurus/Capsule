    "app.auth.welcome.local.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد صورك ونظّمها وابحث فيها وصدّرها بالكامل على هذا الجهاز. لا شيء يغادره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere, organisiere, durchsuche und exportiere deine Fotos vollständig auf diesem Gerät. Nichts verlässt es."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import, organize, search, and export your photos entirely on this device. Nothing leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa, organiza, busca y exporta tus fotos completamente en este dispositivo. Nada sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez, organisez, recherchez et exportez vos photos entièrement sur cet appareil. Rien n'en sort."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो पूरी तरह इसी डिवाइस पर इंपोर्ट, व्यवस्थित, खोजें और एक्सपोर्ट करें। कुछ भी बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa, organizza, cerca ed esporta le tue foto interamente su questo dispositivo. Nulla ne esce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の読み込み、整理、検索、書き出しをすべてこのデバイス上で行います。データがデバイスの外に出ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 이 기기에서만 가져오고, 정리하고, 검색하고, 내보낼 수 있습니다. 아무것도 기기 밖으로 나가지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe, organize, pesquise e exporte suas fotos inteiramente neste dispositivo. Nada sai dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте, упорядочивайте, ищите и экспортируйте фото полностью на этом устройстве. Ничто его не покидает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完全在此设备上导入、整理、搜索和导出照片。所有内容都不会离开此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完全在此裝置上匯入、整理、搜尋和輸出你的照片，任何內容都不會離開裝置。"
          }
        }
      }
    },
