          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일을 업로드하는 중 문제가 발생했습니다. 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo deu errado ao enviar este arquivo. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При загрузке этого файла что-то пошло не так. Повторите попытку."
