    "app.settings.sync.stale.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرر النظام متى يمكن لـ Capsule العمل في الخلفية، وأحيانًا لا يسمح بذلك لفترة. هكذا تعرف ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System entscheidet, wann Capsule im Hintergrund arbeiten darf, und manchmal eine Weile lang gar nicht. So erfährst du davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system decides when Capsule may work in the background, and sometimes it doesn't for a while. This is how you find out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema decide cuándo puede trabajar Capsule en segundo plano, y a veces no lo permite durante un tiempo. Así es como te enteras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système décide quand Capsule peut travailler en arrière-plan, et parfois il ne le permet pas pendant un moment. C'est ainsi que vous en êtes informé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule बैकग्राउंड में कब काम कर सकता है, यह सिस्टम तय करता है, और कभी-कभी वह काफ़ी समय तक अनुमति नहीं देता। इसी से आपको पता चलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il sistema a decidere quando Capsule può lavorare in background, e a volte non lo consente per un po'. Così te ne accorgi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule がバックグラウンドで動作できるタイミングはシステムが決めるため、しばらく動作できないこともあります。この警告でそれを知ることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 백그라운드에서 언제 작업할 수 있는지는 시스템이 결정하며, 한동안 허용하지 않을 때도 있습니다. 이를 통해 그런 상황을 알 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema decide quando o Capsule pode trabalhar em segundo plano, e às vezes isso demora. É assim que você fica sabendo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система решает, когда Capsule может работать в фоновом режиме, и иногда долго этого не разрешает. Так вы об этом узнаете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统决定 Capsule 何时可以在后台运行，有时会在一段时间内不允许。此功能可让您及时得知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會決定 Capsule 何時可在背景運作，有時會有一段時間不允許。這裡會讓您得知此情況。"
          }
        }
      }
    },
