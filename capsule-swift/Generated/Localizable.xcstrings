    "app.drops.caps.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل الحدود اختيارية. ضبطها يمنع الرابط المسرَّب من أن يكلّفك الكثير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Limits sind optional. Wenn du sie festlegst, kostet dich ein Link, der in falsche Hände gerät, nicht viel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every limit is optional. Setting them keeps a link that gets out from costing you much."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los límites son opcionales. Si los estableces, un enlace que se difunda no te costará mucho."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les limites sont facultatives. Les définir évite qu'un lien qui circule ne vous coûte cher."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सीमा वैकल्पिक है। इन्हें सेट करने से, लिंक बाहर चले जाने पर भी आपका ज़्यादा नुकसान नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i limiti sono facoltativi. Impostarli evita che un link finito in mani sbagliate ti costi troppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの制限も任意です。設定しておくと、リンクが流出しても負担を抑えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 제한은 선택 사항입니다. 제한을 설정하면 링크가 유출되더라도 큰 부담이 되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os limites são opcionais. Defini-los evita que um link vazado custe muito para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ограничения необязательны. Они не дадут ссылке, попавшей в чужие руки, обойтись вам дорого."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有限制均为可选。设置限制可以避免链接外泄后给您带来太大损失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有限制皆為選用。設定限制可避免連結外流時造成你太大的負擔。"
          }
        }
      }
    },
