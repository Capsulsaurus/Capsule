    "app.quota.state.soft_warning.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال الرفع يعمل. تحرير بعض المساحة الآن يجنّبك التوقف لاحقًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads funktionieren noch. Wenn du jetzt etwas Speicher freigibst, wirst du später nicht gestoppt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads still work. Freeing some space now avoids being stopped later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las subidas siguen funcionando. Liberar algo de espacio ahora evita que se detengan más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléversements fonctionnent toujours. Libérer un peu d'espace maintenant évitera un blocage plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड अब भी काम करते हैं। अभी कुछ जगह ख़ाली करने से बाद में रुकने से बचा जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I caricamenti funzionano ancora. Liberare un po' di spazio ora evita blocchi in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードは引き続き可能です。今のうちに空き容量を確保しておくと、後で停止されるのを防げます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드는 계속 가능합니다. 지금 공간을 확보하면 나중에 업로드가 중단되는 것을 막을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os envios ainda funcionam. Liberar algum espaço agora evita uma interrupção depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки пока работают. Освободите немного места сейчас, чтобы избежать остановки позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传仍可进行。现在释放一些空间，可避免以后被停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳仍可進行。現在釋放一些空間，可避免之後被迫停止。"
          }
        }
      }
    },
