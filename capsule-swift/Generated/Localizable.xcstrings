    },
    "app.quota.state.grace_expired.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظلّت مساحة التخزين ممتلئة لمدة كافية لإيقاف التعديلات أيضًا — التعليقات والوسوم والروابط الجديدة. لا تزال القراءة والحذف والاستعادة متاحة، وتحرير المساحة يرفع هذا القيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicher ist schon so lange voll, dass auch Bearbeitungen – Bildunterschriften, Tags, neue Links – pausiert sind. Ansehen, Löschen und Wiederherstellen funktionieren weiterhin, und wenn du Speicher freigibst, wird dies aufgehoben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Storage has been full long enough that edits — captions, tags, new links — are paused as well. Reading, deleting, and restoring still work, and freeing space lifts this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacenamiento lleva lleno el tiempo suficiente como para que las ediciones (pies de foto, etiquetas, enlaces nuevos) también estén en pausa. Ver, eliminar y restaurar siguen funcionando, y al liberar espacio se levanta esta restricción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le stockage est plein depuis assez longtemps pour que les modifications (légendes, tags, nouveaux liens) soient elles aussi suspendues. La consultation, la suppression et la restauration fonctionnent toujours, et libérer de l'espace lève cette restriction."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोरेज इतने लंबे समय से भरा हुआ है कि संपादन — कैप्शन, टैग, नए लिंक — भी रोक दिए गए हैं। देखना, हटाना और रीस्टोर करना अब भी काम करता है, और जगह ख़ाली करने से यह रोक हट जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio è pieno da abbastanza tempo che anche le modifiche (didascalie, tag, nuovi link) sono sospese. Visualizzazione, eliminazione e ripristino funzionano ancora, e liberando spazio la sospensione viene revocata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージがいっぱいの状態が長く続いたため、キャプション、タグ、新しいリンクなどの編集も一時停止されています。閲覧、削除、復元は引き続き可能で、空き容量を確保すると解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 오랫동안 가득 차 있어 캡션, 태그, 새 링크 같은 편집도 일시 중지되었습니다. 보기, 삭제 및 복원은 계속 가능하며, 공간을 확보하면 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento está cheio há tempo suficiente para que as edições — legendas, tags, novos links — também estejam pausadas. Ver, apagar e restaurar continuam funcionando, e liberar espaço resolve isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище заполнено уже достаточно долго, поэтому изменения — подписи, теги, новые ссылки — тоже приостановлены. Просмотр, удаление и восстановление по-прежнему работают, а освобождение места снимет это ограничение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储空间已满的时间过长，编辑（说明、标签、新链接）也已暂停。查看、删除和恢复仍可正常使用，释放空间后即可解除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間已滿一段時間，因此編輯（說明、標籤、新連結）也已暫停。檢視、刪除和還原仍可使用，釋放空間即可解除此限制。"
          }
        }
      }
    },
