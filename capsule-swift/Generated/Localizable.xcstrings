    "drop.error.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رابط الرفع هذا غير متاح. ربما انتهت صلاحيته أو أُلغي أو لم يكن موجودًا قط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Upload-Link ist nicht verfügbar. Er ist möglicherweise abgelaufen, wurde widerrufen oder hat nie existiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload link is unavailable. It may have expired, been revoked, or never existed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace de subida no está disponible. Puede que haya caducado, se haya revocado o nunca haya existido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien de téléversement n'est pas disponible. Il a peut-être expiré, été révoqué ou n'a jamais existé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अपलोड लिंक उपलब्ध नहीं है। हो सकता है यह समाप्त हो गया हो, रद्द कर दिया गया हो, या कभी मौजूद ही न रहा हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo link di caricamento non è disponibile. Potrebbe essere scaduto, revocato o non essere mai esistito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアップロードリンクは利用できません。有効期限切れ、取り消し済み、または存在しない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 업로드 링크를 사용할 수 없습니다. 만료되었거나 취소되었거나 존재하지 않는 링크일 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link de envio não está disponível. Ele pode ter expirado, sido revogado ou nunca ter existido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
