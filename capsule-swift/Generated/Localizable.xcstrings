    "error.drop.chunk_unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Capsule الوصول إلى خدمة الرفع. سيُستأنف الرفع قريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule konnte den Upload-Dienst nicht erreichen. Der Upload wird in Kürze fortgesetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule couldn't reach the upload service. The upload will resume shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no pudo conectar con el servicio de subida. La subida se reanudará en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas pu joindre le service de téléversement. Le téléversement reprendra sous peu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule अपलोड सेवा तक नहीं पहुँच सका। अपलोड जल्द ही फिर से शुरू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non è riuscito a raggiungere il servizio di caricamento. Il caricamento riprenderà a breve."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はアップロードサービスにアクセスできませんでした。まもなくアップロードが再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 업로드 서비스에 연결하지 못했습니다. 곧 업로드가 재개됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não conseguiu acessar o serviço de envio. O envio será retomado em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не удалось связаться со службой загрузки. Загрузка скоро возобновится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 无法连接上传服务。上传将很快恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 無法連線至上傳服務。上傳將很快恢復。"
          }
        }
      }
    },
    "error.drop.file_too_large": {
