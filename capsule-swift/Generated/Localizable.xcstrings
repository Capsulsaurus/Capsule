        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un link monouso accetta un solo file, quindi il limite di file sopra non verrà applicato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回限りのリンクは1つのファイルしか受け付けないため、上のファイル数の制限は適用されません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일회용 링크는 파일을 하나만 받으므로 위의 파일 수 제한이 적용되지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um link de uso único aceita um arquivo, então o limite de arquivos acima não se aplica"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одноразовая ссылка принимает один файл, поэтому ограничение числа файлов выше не применится"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次性链接只接受一个文件，因此上方的文件数量限制不会生效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單次使用的連結只接受一個檔案，因此上方的檔案數量限制不會生效"
          }
        }
      }
    },
