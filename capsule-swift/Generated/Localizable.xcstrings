          "stringUnit": {
            "state": "translated",
            "value": "您的帳戶已被停用。在恢復之前，您無法上傳或分享。"
          }
        }
      }
    },
    "error.moderation.report_at_capacity": {
      "localizations": {
        "ar": {
          "stringUnit": {
