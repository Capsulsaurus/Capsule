    "app.drops.detail.preview.unavailable.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Capsule فك ترميز هذا الملف لعرضه. لا يزال بإمكانك قبوله أو تجاهله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule konnte diese Datei nicht zur Anzeige dekodieren. Du kannst sie trotzdem annehmen oder verwerfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule couldn't decode this file to show it. You can still accept or discard it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no pudo decodificar este archivo para mostrarlo. Aún puedes aceptarlo o descartarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas pu décoder ce fichier pour l'afficher. Vous pouvez tout de même l'accepter ou le rejeter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule इसे दिखाने के लिए यह फ़ाइल डिकोड नहीं कर सका। आप फिर भी इसे स्वीकार या त्याग सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non è riuscito a decodificare questo file per mostrarlo. Puoi comunque accettarlo o scartarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はこのファイルを表示用にデコードできませんでした。承認または破棄することは引き続き可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 이 파일을 디코딩하여 표시할 수 없습니다. 그래도 수락하거나 버릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não conseguiu decodificar este arquivo para exibi-lo. Você ainda pode aceitá-lo ou descartá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не удалось декодировать этот файл для показа. Вы всё равно можете принять или отклонить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 无法解码此文件以进行显示。您仍可以接受或丢弃它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 無法解碼此檔案以進行顯示。你仍可以接受或捨棄它。"
          }
        }
      }
    },
