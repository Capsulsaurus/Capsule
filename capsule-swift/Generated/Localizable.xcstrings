    "app.settings.import.order.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمرّ Capsule على هذه القائمة بالترتيب ويستخدم أول قاعدة تنطبق. وتُعرض القاعدة المطبَّقة في كل عملية استيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule geht diese Liste von oben nach unten durch und verwendet die erste zutreffende Regel. Welche gegriffen hat, wird bei jedem Import angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule works down this list and uses the first rule that applies. Whichever one fired is shown on every import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule recorre esta lista y usa la primera regla aplicable. La regla que se aplicó se muestra en cada importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule parcourt cette liste et utilise la première règle applicable. La règle appliquée est indiquée sur chaque importation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule इस सूची में ऊपर से नीचे जाता है और पहला लागू होने वाला नियम उपयोग करता है। जो नियम लागू हुआ, वह हर इंपोर्ट पर दिखाया जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule scorre questo elenco e usa la prima regola applicabile. La regola applicata viene mostrata in ogni importazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はこのリストを上から順に確認し、最初に該当したルールを使用します。適用されたルールは各読み込みに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 이 목록을 위에서부터 확인하여 처음으로 적용되는 규칙을 사용합니다. 적용된 규칙은 모든 가져오기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule percorre esta lista e usa a primeira regra que se aplica. A regra usada é mostrada em cada importação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule проходит по этому списку и использует первое подходящее правило. Сработавшее правило показывается при каждом импорте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 会按此列表从上往下查找，并使用第一条适用的规则。每次导入都会显示生效的规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會依序檢查此清單，並使用第一條適用的規則。每次匯入都會顯示所套用的規則。"
          }
        }
      }
    },
