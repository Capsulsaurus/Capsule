          }
        }
      }
    },
    "error.federation.rate_budget_exceeded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلغ هذا المصدر حدّ الطلبات. يُرجى الانتظار ثم المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Quelle hat ihr Anfragelimit erreicht. Bitte warten Sie und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source has reached its request limit. Please wait and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente ha alcanzado su límite de solicitudes. Espera e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source a atteint sa limite de requêtes. Veuillez patienter et réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्रोत ने अपनी अनुरोध सीमा पूरी कर ली है। कृपया प्रतीक्षा करें और फिर से प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa fonte ha raggiunto il limite di richieste. Attendi e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提供元はリクエスト上限に達しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 원본이 요청 한도에 도달했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fonte atingiu o limite de solicitações. Aguarde e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот источник достиг лимита запросов. Подождите и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
