    "error.federation.mint_at_capacity": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعامل هذا الخادم مع عدد كبير جدًا من منح الوصول حاليًا. يُرجى المحاولة مرة أخرى بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verarbeitet gerade zu viele Zugriffsberechtigungen. Bitte versuche es in Kürze erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
