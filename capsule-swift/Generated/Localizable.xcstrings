    "error.auth.registration_invalid": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام هذا البريد الإلكتروني أو كلمة المرور. يجب أن تتكون كلمة المرور من 12 حرفًا على الأقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese E-Mail-Adresse oder dieses Passwort kann nicht verwendet werden. Passwörter müssen mindestens 12 Zeichen lang sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That email or password can't be used. Passwords need at least 12 characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo electrónico o contraseña no se pueden usar. Las contraseñas deben tener al menos 12 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse e-mail ou ce mot de passe ne peut pas être utilisé. Les mots de passe doivent comporter au moins 12 caractères."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस ईमेल या पासवर्ड का उपयोग नहीं किया जा सकता। पासवर्ड में कम से कम 12 वर्ण होने चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa e-mail o password non può essere usata. Le password devono contenere almeno 12 caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのメールアドレスまたはパスワードは使用できません。パスワードは 12 文字以上にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 이메일 또는 비밀번호는 사용할 수 없습니다. 비밀번호는 12자 이상이어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse e-mail ou senha não pode ser usado. As senhas precisam ter pelo menos 12 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот адрес электронной почты или пароль нельзя использовать. Пароль должен содержать не менее 12 символов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用该邮箱或密码。密码至少需要 12 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法使用該電子郵件或密碼。密碼至少須有 12 個字元。"
          }
        }
      }
    },
    "error.auth.revoke_proof_invalid": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم التأكد من هويتك. لم يتم تسجيل الخروج من أي جهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Identität konnte nicht bestätigt werden. Es wurde nichts abgemeldet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That didn't confirm as you. Nothing was logged out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar que eres tú. No se cerró ninguna sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identité n'a pas pu être confirmée. Aucune session n'a été déconnectée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पहचान की पुष्टि नहीं हुई। किसी को भी लॉग आउट नहीं किया गया।"
          }
        },
        "it": {
          "stringUnit": {
