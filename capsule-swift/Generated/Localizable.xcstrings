          }
        }
      }
    },
    "error.upload.storage_inconsistent": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واجه الخادم مشكلة في التخزين. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server ist ein Speicherproblem aufgetreten. Bitte versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server hit a storage problem. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tuvo un problema de almacenamiento. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rencontré un problème de stockage. Veuillez réessayer."
