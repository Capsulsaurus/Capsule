    "app.import.source.watched_folder.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب مجلدًا ويواصل الاستيراد منه كلما ظهرت صور جديدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt nach einem Ordner und importiert weiter daraus, sobald neue Fotos erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks for a folder and keeps importing from it as new photos appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide una carpeta y sigue importando de ella a medida que aparecen fotos nuevas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande un dossier et continue d'en importer les nouvelles photos à mesure qu'elles apparaissent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फ़ोल्डर माँगता है और नई फ़ोटो आने पर उससे इंपोर्ट करता रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede una cartella e continua a importare da essa man mano che compaiono nuove foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選択し、新しい写真が追加されるたびに読み込み続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 새 사진이 생길 때마다 계속 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede uma pasta e continua importando dela à medida que novas fotos aparecem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает папку и продолжает импортировать из неё по мере появления новых фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个文件夹，并在出现新照片时持续从中导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇一個資料夾，並在出現新照片時持續從中匯入。"
          }
        }
      }
    },
