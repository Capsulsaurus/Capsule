    "app.transfer.recovery.realign.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل الخادم عن مقدار ما لديه، ثم يتابع من هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragt den Server, wie viel er bereits hat, und setzt dort fort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks the server how much it has, then continues from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta al servidor cuánto tiene y continúa desde ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande au serveur ce qu'il a déjà reçu, puis reprend à partir de là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर से पूछता है कि उसके पास कितना है, फिर वहीं से जारी रखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede al server quanto ha ricevuto, poi continua da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが受信済みの量を確認し、そこから続行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 얼마나 저장되었는지 확인한 다음 그 지점부터 계속합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunta ao servidor quanto ele já tem e continua a partir daí."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает у сервера, сколько уже получено, и продолжает с этого места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向服务器询问已接收的量，然后从该位置继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "向伺服器確認已收到多少，然後從該處繼續。"
          }
        }
      }
    },
