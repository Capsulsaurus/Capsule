    "app.import.plan.space.insufficient": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مساحة كافية. وفّر %%2$@ لاستيراد هذه الصور (%%1$@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Platz. Gib %%2$@ frei, um diese %%1$@ Fotos zu importieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough room. Free up %%2$@ to import these %%1$@ photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay espacio suficiente. Libera %%2$@ para importar estas %%1$@ fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Espace insuffisant. Libérez %%2$@ pour importer ces %%1$@ photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पर्याप्त जगह नहीं है। इन %%1$@ फ़ोटो को इंपोर्ट करने के लिए %%2$@ ख़ाली करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente. Libera %%2$@ per importare queste %%1$@ foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "容量が足りません。これらの%%1$@枚の写真を読み込むには、%%2$@の空き容量を確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간이 부족합니다. 사진 %%1$@장을 가져오려면 %%2$@를 확보하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço suficiente. Libere %%2$@ para importar estas %%1$@ fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Недостаточно места. Освободите %%2$@, чтобы импортировать эти фото (%%1$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间不足。请释放 %%2$@ 以导入这 %%1$@ 张照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間不足。請釋放 %%2$@ 以匯入這 %%1$@ 張照片。"
          }
        }
      }
    },
