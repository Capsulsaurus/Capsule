    "app.sync.action.footer.deferred": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمليات النقل الكبيرة في انتظار اتصال أفضل. يتابع خيار «المزامنة الآن على أي حال» بغض النظر عن ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Große Übertragungen warten auf eine bessere Verbindung. „Trotzdem jetzt synchronisieren“ legt dennoch los."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large transfers are waiting for a better connection. Sync Now Anyway goes ahead regardless."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias grandes esperan una conexión mejor. Sincronizar ahora de todos modos las ejecuta igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transferts volumineux attendent une meilleure connexion. Synchroniser quand même les lance malgré tout."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़े ट्रांसफ़र बेहतर कनेक्शन की प्रतीक्षा कर रहे हैं। \"फिर भी अभी सिंक करें\" इसके बावजूद आगे बढ़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trasferimenti di grandi dimensioni attendono una connessione migliore. Sincronizza comunque ora procede in ogni caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大容量の転送は、より良い接続を待機しています。「このまま今すぐ同期」を選ぶと、それにかかわらず実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대용량 전송이 더 나은 연결을 기다리고 있습니다. '그래도 지금 동기화'를 누르면 바로 진행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências grandes estão aguardando uma conexão melhor. Sincronizar mesmo assim prossegue de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Крупные передачи ожидают лучшего подключения. «Всё равно синхронизировать» запускает их в любом случае."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大型传输正在等待更好的网络连接。“仍然立即同步”会不受限制地继续进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大量傳輸正在等待更好的連線。「仍要立即同步」會不顧條件直接進行。"
          }
        }
      }
    },
    "app.sync.action.footer.unmetered": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسمح هذا الاتصال بكل شيء، بما في ذلك الصور بالحجم الكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Verbindung erlaubt alles, auch Fotos in voller Größe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This connection allows everything, including full-size photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión lo permite todo, incluidas las fotos a tamaño completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion autorise tout, y compris les photos en taille réelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कनेक्शन पूर्ण-आकार फ़ोटो सहित सब कुछ की अनुमति देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa connessione consente tutto, comprese le foto a dimensione piena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続では、フルサイズの写真を含むすべての転送が可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에서는 원본 크기 사진을 포함한 모든 항목을 전송할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexão permite tudo, inclusive fotos em tamanho original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это подключение позволяет передавать всё, включая полноразмерные фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此连接允许传输所有内容，包括全尺寸照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連線允許所有傳輸，包括原尺寸照片。"
          }
        }
      }
    },
