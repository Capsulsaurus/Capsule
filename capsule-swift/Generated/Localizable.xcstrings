    "error.quota.grace_locked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ظلّت مساحة التخزين لديك ممتلئة بعد انتهاء فترة السماح، لذا أُوقفت التعديلات مؤقتًا حتى تُفرِغ مساحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Speicher ist über die Nachfrist hinaus voll geblieben, daher sind Bearbeitungen pausiert, bis Sie Speicherplatz freigeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your storage has been full past the grace period, so edits are paused until you free space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacenamiento ha estado lleno más allá del período de gracia, por lo que las ediciones están en pausa hasta que liberes espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre stockage est resté plein au-delà du délai de grâce ; les modifications sont suspendues jusqu'à ce que vous libériez de l'espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्टोरेज छूट अवधि के बाद भी भरा रहा है, इसलिए जब तक आप जगह ख़ाली नहीं करते तब तक संपादन रोक दिए गए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di archiviazione è rimasto pieno oltre il periodo di tolleranza, quindi le modifiche sono sospese finché non liberi spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージが猶予期間を過ぎてもいっぱいのままのため、空き容量を確保するまで編集は一時停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 유예 기간이 지나도록 가득 차 있어 공간을 확보할 때까지 편집이 일시 중지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu armazenamento ficou cheio além do período de tolerância, então as edições estão pausadas até você liberar espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше хранилище оставалось заполненным дольше льготного периода, поэтому изменения приостановлены, пока вы не освободите место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的存储空间已超出宽限期仍处于已满状态，因此在您释放空间前编辑将被暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的儲存空間已超過寬限期仍為已滿狀態，因此在您釋放空間前編輯將暫停。"
          }
        }
      }
    },
