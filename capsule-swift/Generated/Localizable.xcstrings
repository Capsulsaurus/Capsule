    "app.drops.inbox.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات المرسلة إليك عبر رابط رفع ستنتظر هنا حتى تقبلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die dir über einen Upload-Link gesendet werden, warten hier, bis du sie annimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files sent to you through an upload link will wait here until you accept them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que te envíen a través de un enlace de subida esperarán aquí hasta que los aceptes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers qui vous sont envoyés via un lien de téléversement attendront ici jusqu'à ce que vous les acceptiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड लिंक के ज़रिए आपको भेजी गई फ़ाइलें आपके स्वीकार करने तक यहाँ प्रतीक्षा करेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file che ti vengono inviati tramite un link di caricamento resteranno qui finché non li accetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードリンク経由で送信されたファイルは、承認するまでここで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 링크를 통해 받은 파일은 수락할 때까지 여기에서 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos enviados a você por um link de envio aguardam aqui até você aceitá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы, отправленные вам по ссылке для загрузки, будут ждать здесь, пока вы их не примете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过上传链接发送给您的文件会在此等待，直到您接受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過上傳連結傳送給你的檔案會在此等待，直到你接受為止。"
          }
        }
      }
    },
