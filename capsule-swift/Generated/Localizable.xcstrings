    "app.restore.diff.reconciliation_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي اختلاف يُحتجز لتقرّر بشأنه، ولا يُطبَّق تلقائيًا أبدًا. لن تعيد نسخة احتياطية قديمة صورة حذفتها منذ ذلك الحين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was abweicht, wird für deine Entscheidung zurückgehalten und nie von selbst angewendet. Ein altes Backup bringt kein Foto zurück, das du seitdem gelöscht hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything that differs is held for you to decide, never applied on its own. An old backup won't bring back a photo you deleted since."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que difiera se retiene para que decidas, nunca se aplica por sí solo. Una copia de seguridad antigua no devolverá una foto que hayas eliminado después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui diffère est retenu pour que vous décidiez, jamais appliqué automatiquement. Une ancienne sauvegarde ne fera pas réapparaître une photo supprimée depuis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ भी अलग है, उसे आपके निर्णय के लिए रोका जाता है, अपने आप कभी लागू नहीं किया जाता। पुराना बैकअप वह फ़ोटो वापस नहीं लाएगा जिसे आपने बाद में हटा दिया था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è diverso viene trattenuto per una tua decisione, mai applicato automaticamente. Un backup vecchio non riporterà una foto che hai eliminato in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内容が異なるものは、あなたの判断を待つために保留され、自動的に適用されることはありません。古いバックアップから、その後削除した写真が戻ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 부분이 있는 항목은 자동으로 적용되지 않고 결정을 위해 보류됩니다. 오래된 백업으로 그 이후에 삭제한 사진이 되살아나지는 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que for diferente fica retido para você decidir, nunca é aplicado sozinho. Um backup antigo não vai trazer de volta uma foto que você apagou depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что различается, задерживается до вашего решения и никогда не применяется само. Старая резервная копия не вернёт фото, удалённое после её создания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何不一致的内容都会暂扣以待您决定，绝不会自动应用。旧备份不会恢复您之后删除的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何不一致的內容都會暫留待您決定，絕不會自動套用。舊備份不會讓您之後刪除的照片重新出現。"
          }
        }
      }
    },
