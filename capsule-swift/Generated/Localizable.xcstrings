    "app.quarantine.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيظهر هنا كل ما يحتجزه Capsule لتطّلع عليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Capsule zur Prüfung für dich zurückhält, wird hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything Capsule holds back for you to look at will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que Capsule retenga para que lo revises aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que Capsule met de côté pour que vous l'examiniez apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule आपके देखने के लिए जो कुछ भी रोकेगा, वह यहाँ दिखाई देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che Capsule trattiene perché tu lo esamini verrà visualizzato qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule が確認のために保留した項目がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 확인을 위해 보류한 항목이 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que o Capsule reter para você analisar aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появится всё, что Capsule задержит для вашей проверки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 暂扣以供您查看的任何内容都会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 暫留待您查看的任何內容都會顯示在這裡。"
          }
        }
      }
