    "app.storage.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Capsule قراءة المساحة التي يستخدمها على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule konnte nicht ermitteln, wie viel Speicher es auf diesem Gerät belegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule couldn't read how much space it's using on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no pudo leer cuánto espacio usa en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas pu lire l'espace qu'il utilise sur cet appareil."
