    "app.sync.criterion.background_window.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرر النظام متى يمكن لـ Capsule العمل في الخلفية، ولا يَعِد بجدول زمني."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System entscheidet, wann Capsule im Hintergrund arbeiten darf, und verspricht keinen festen Zeitplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system decides when Capsule may work in the background, and it doesn't promise a schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema decide cuándo puede trabajar Capsule en segundo plano y no garantiza ningún horario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système décide quand Capsule peut travailler en arrière-plan, sans garantir de calendrier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule बैकग्राउंड में कब काम कर सकता है, यह सिस्टम तय करता है, और वह किसी तय समय का वादा नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È il sistema a decidere quando Capsule può lavorare in background, e non garantisce una pianificazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule がバックグラウンドで動作できるタイミングはシステムが決め、スケジュールは保証されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 백그라운드에서 언제 작업할 수 있는지는 시스템이 결정하며, 일정을 보장하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema decide quando o Capsule pode trabalhar em segundo plano e não garante um horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Система решает, когда Capsule может работать в фоновом режиме, и не гарантирует расписание."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统决定 Capsule 何时可以在后台运行，且不保证具体时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統會決定 Capsule 何時可在背景運作，且不保證固定的排程。"
          }
        }
      }
    },
