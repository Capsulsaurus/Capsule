    "error.album.roster_stale": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة الأعضاء التي أرسلتها غير متوافقة مع القائمة الموجودة على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gesendete Mitgliederliste passt nicht zu der, die der Server hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The roster you sent is out of step with the one the server holds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de miembros que enviaste no coincide con la que tiene el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste de membres que vous avez envoyée ne correspond pas à celle détenue par le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी भेजी गई सदस्य सूची सर्वर पर मौजूद सूची से मेल नहीं खाती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco dei membri inviato non è allineato con quello conservato sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信された名簿は、サーバーが保持している名簿と一致していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 명단이 서버에 있는 명단과 일치하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de membros que você enviou está fora de sincronia com a que o servidor tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправленный список участников не совпадает с тем, что хранится на сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您发送的成员名单与服务器上保存的不一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您傳送的成員名單與伺服器上的不一致。"
          }
        }
      }
    },
    "error.album.roster_version_leap": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إصدار قائمة الأعضاء هذه متقدّم جدًا على الإصدار الموجود على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Version dieser Mitgliederliste liegt zu weit vor der des Servers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That roster's version is too far ahead of the one the server holds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La versión de esa lista de miembros está demasiado por delante de la que tiene el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La version de cette liste de membres est trop en avance sur celle détenue par le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस सदस्य सूची का संस्करण सर्वर पर मौजूद संस्करण से बहुत आगे है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La versione dell'elenco dei membri è troppo avanti rispetto a quella conservata sul server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その名簿のバージョンは、サーバーが保持しているものより大幅に進んでいます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 명단의 버전이 서버에 있는 버전보다 너무 앞서 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A versão dessa lista de membros está muito à frente da que o servidor tem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия этого списка участников слишком опережает версию на сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该成员名单的版本远超服务器上保存的版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該成員名單的版本超前伺服器上的版本太多。"
          }
        }
      }
    },
    "error.album.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Capsule إعداد هذا الألبوم. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule konnte dieses Album nicht einrichten. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule couldn't set up that album. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no pudo configurar ese álbum. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas pu configurer cet album. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule वह एल्बम सेट नहीं कर सका। कृपया फिर से प्रयास करें।"
          }
        },
        "it": {
