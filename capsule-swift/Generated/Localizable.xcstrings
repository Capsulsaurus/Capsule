          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 상태가 전송됨"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado Mais Antigo Recebido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получено старое состояние"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到较旧的状态"
          }
        },
        "zh-Hant": {
