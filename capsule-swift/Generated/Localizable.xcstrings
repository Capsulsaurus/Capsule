    "app.sync.auto.staleness_warning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذيري إذا تأخر هذا الجهاز"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnen, wenn dieses Gerät hinterherhängt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warn Me If This Device Falls Behind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisarme si este dispositivo se queda atrás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "M'avertir si cet appareil prend du retard"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस पीछे छूटे तो मुझे चेतावनी दें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisami se questo dispositivo resta indietro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの同期が遅れたら警告"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 동기화가 지연되면 경고"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar se este dispositivo ficar para trás"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупреждать, если устройство отстаёт"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备同步落后时提醒我"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置進度落後時警告我"
          }
        }
      }
    },
    "app.sync.criteria.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد هذه الشروط متى يعمل Capsule تلقائيًا. يتجاهلها خيار «المزامنة الآن على أي حال»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bedingungen bestimmen, wann Aufgaben von selbst laufen. „Trotzdem jetzt synchronisieren“ ignoriert sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These decide when work runs on its own. Sync Now Anyway ignores them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas condiciones deciden cuándo se ejecuta el trabajo por sí solo. Sincronizar ahora de todos modos las ignora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces conditions déterminent quand le travail s'exécute de lui-même. Synchroniser quand même les ignore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये तय करती हैं कि काम अपने आप कब चलेगा। \"फिर भी अभी सिंक करें\" इन्हें अनदेखा करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste condizioni decidono quando il lavoro viene eseguito da solo. Sincronizza comunque ora le ignora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの条件で自動処理の実行タイミングが決まります。「このまま今すぐ同期」はこれらを無視します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조건에 따라 작업이 자동으로 실행되는 시점이 결정됩니다. '그래도 지금 동기화'는 이 조건을 무시합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas condições decidem quando o trabalho é feito sozinho. Sincronizar mesmo assim as ignora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти условия определяют, когда задачи выполняются сами. «Всё равно синхронизировать» их не учитывает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些条件决定任务何时自动运行。“仍然立即同步”会忽略这些条件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些條件決定工作何時自動執行。「仍要立即同步」會忽略這些條件。"
          }
        }
      }
    },
