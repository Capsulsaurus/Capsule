          }
        }
      }
    },
    "app.transfer.connection.policy.offline": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُرفع شيء حتى تعود إلى الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird hochgeladen, bis du wieder online bist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing uploads until you're back online."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sube nada hasta que vuelvas a tener conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est téléversé tant que vous n'êtes pas de nouveau en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फिर से ऑनलाइन होने तक कुछ भी अपलोड नहीं होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene caricato nulla finché non torni online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインに戻るまで何もアップロードされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 온라인 상태가 될 때까지 아무것도 업로드되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é enviado até você voltar a ficar online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не загружается, пока вы не подключитесь к сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复联网前不会上传任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復連線前不會上傳任何內容。"
          }
        }
      }
    },
    "app.transfer.connection.policy.unknown": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوخّى Capsule الحذر حتى يتعرّف على نوع هذا الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ist vorsichtig, bis erkennbar ist, um welche Verbindung es sich handelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule is being cautious until it can tell what this connection is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule actúa con precaución hasta saber qué tipo de conexión es esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule reste prudent tant qu'il ne peut pas identifier cette connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक Capsule यह पता नहीं लगा लेता कि यह कैसा कनेक्शन है, तब तक वह सावधानी बरत रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule procede con cautela finché non capisce di che connessione si tratta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続の種類が判別できるまで、Capsule は慎重に動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 연결 유형을 파악할 때까지 신중하게 동작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule está sendo cauteloso até identificar que tipo de conexão é esta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule действует осторожно, пока не определит тип соединения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在确定连接类型之前，Capsule 会谨慎处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在判斷出連線類型之前，Capsule 會謹慎處理。"
          }
        }
      }
    },
