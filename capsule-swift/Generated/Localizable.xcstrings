    "app.settings.security.plaintext.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور التي تشاهدها والمعاينات وفهارس البحث موجودة غير مختومة على هذا الجهاز — وهذا ما يجعل فتحها سريعًا. لا يتلقى الخادم إلا نسخًا مختومة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos, die du ansiehst, Vorschauen und Suchindizes liegen unversiegelt auf diesem Gerät – deshalb öffnen sie sich so schnell. Dein Server erhält immer nur versiegelte Kopien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos you're looking at, previews, and search indexes exist unsealed on this device — that's what makes them fast to open. Your server only ever receives sealed copies."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos que estás viendo, las previsualizaciones y los índices de búsqueda existen sin sellar en este dispositivo: por eso se abren rápido. Tu servidor solo recibe copias selladas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos que vous regardez, les aperçus et les index de recherche existent en clair sur cet appareil : c'est ce qui permet de les ouvrir rapidement. Votre serveur ne reçoit jamais que des copies scellées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो फ़ोटो आप देख रहे हैं, प्रीव्यू और खोज इंडेक्स इस डिवाइस पर बिना सील किए मौजूद रहते हैं — इसी से वे जल्दी खुलते हैं। आपके सर्वर को केवल सील की गई कॉपियाँ ही मिलती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto che stai guardando, le anteprime e gli indici di ricerca esistono in chiaro su questo dispositivo: è ciò che le rende veloci da aprire. Il tuo server riceve sempre e solo copie sigillate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の写真、プレビュー、検索インデックスは、このデバイス上では暗号化されない状態で存在します。そのため素早く開くことができます。サーバーが受け取るのは、常に暗号化されたコピーだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보고 있는 사진, 미리보기, 검색 색인은 빠르게 열 수 있도록 이 기기에 암호화되지 않은 상태로 존재합니다. 서버는 항상 암호화된 사본만 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos que você está vendo, as prévias e os índices de busca ficam sem proteção criptográfica neste dispositivo — é isso que permite abri-los rapidamente. Seu servidor só recebe cópias criptografadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фото, которые вы просматриваете, превью и поисковые индексы хранятся на этом устройстве в незашифрованном виде — поэтому они быстро открываются. Ваш сервер получает только зашифрованные копии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您正在查看的照片、预览和搜索索引在此设备上以未加密形式存在——这正是它们能快速打开的原因。您的服务器只会收到加密后的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您正在查看的照片、預覽和搜尋索引在此裝置上是未加密的狀態，這樣才能快速開啟。您的伺服器只會收到已加密的副本。"
          }
        }
      }
    },
    "app.settings.security.plaintext.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُختم كل ما يغادر هذا الجهاز أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was dieses Gerät verlässt, wird zuerst versiegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything that leaves this device is sealed first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que sale de este dispositivo se sella antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui quitte cet appareil est d'abord scellé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस से बाहर जाने वाली हर चीज़ पहले सील की जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che lascia questo dispositivo viene prima sigillato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスから送信されるものは、すべて先に暗号化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 떠나는 모든 항목은 먼저 암호화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que sai deste dispositivo é criptografado antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что покидает это устройство, сначала шифруется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离开此设备的所有内容都会先加密。"
