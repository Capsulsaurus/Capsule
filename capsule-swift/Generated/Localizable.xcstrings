    "app.auth.path.unsupported.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقدّم هذا الخادم طريقة تسجيل دخول يدعمها Capsule. اسأل من يديره، أو اتصل بخادم آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server bietet keine Anmeldemethode an, die Capsule unterstützt. Frag die Person, die ihn betreibt, oder verbinde einen anderen Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server didn't offer a sign-in method Capsule supports. Ask whoever runs it, or connect a different server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor no ofreció ningún método de inicio de sesión compatible con Capsule. Pregunta a quien lo administra o conecta otro servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur ne propose aucune méthode de connexion prise en charge par Capsule. Contactez son administrateur ou connectez un autre serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सर्वर ने ऐसा कोई साइन-इन तरीका नहीं दिया जिसे Capsule समर्थन करता हो। इसे चलाने वाले से पूछें, या कोई दूसरा सर्वर कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server non offre alcun metodo di accesso supportato da Capsule. Chiedi a chi lo gestisce o collega un altro server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは Capsule が対応しているサインイン方法を提供していません。サーバーの管理者に問い合わせるか、別のサーバーに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버가 Capsule에서 지원하는 로그인 방법을 제공하지 않았습니다. 서버 관리자에게 문의하거나 다른 서버에 연결하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor não ofereceu nenhum método de login compatível com o Capsule. Pergunte a quem o administra ou conecte outro servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер не предложил способ входа, который поддерживает Capsule. Обратитесь к его администратору или подключите другой сервер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器未提供 Capsule 支持的登录方式。请联系服务器管理员，或连接其他服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器沒有提供 Capsule 支援的登入方式。請詢問伺服器的管理者，或連接其他伺服器。"
          }
        }
      }
    },
