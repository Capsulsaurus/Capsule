    "app.auth.welcome.server.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انسخ صورك احتياطيًا إلى خادم Capsule تديره أنت أو شخص تثق به، وأبقِها متزامنة عبر أجهزتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere deine Fotos auf einem Capsule-Server, den du oder jemand, dem du vertraust, betreibt, und halte sie auf all deinen Geräten synchron."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up your photos to a Capsule server you or someone you trust runs, and keep them in step across your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz copia de seguridad de tus fotos en un servidor de Capsule que gestiones tú o alguien de confianza, y mantenlas sincronizadas en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez vos photos sur un serveur Capsule géré par vous ou une personne de confiance, et gardez-les synchronisées sur tous vos appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो का बैकअप ऐसे Capsule सर्वर पर लें जिसे आप या आपका कोई भरोसेमंद व्यक्ति चलाता हो, और उन्हें अपने सभी डिवाइस पर एक जैसा रखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il backup delle tue foto su un server Capsule gestito da te o da una persona di fiducia e mantienile sincronizzate su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたや信頼できる人が運営する Capsule サーバーに写真をバックアップし、すべてのデバイスで同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 또는 신뢰하는 사람이 운영하는 Capsule 서버에 사진을 백업하고, 모든 기기에서 최신 상태로 유지합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça backup das suas fotos em um servidor Capsule administrado por você ou por alguém de confiança, e mantenha-as sincronizadas entre seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создавайте резервные копии фото на сервере Capsule, который поддерживаете вы или тот, кому вы доверяете, и синхронизируйте их между устройствами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片备份到由您或您信任的人运行的 Capsule 服务器，并在您的各台设备间保持同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將照片備份到由你或你信任的人所架設的 Capsule 伺服器，並在你的所有裝置間保持同步。"
          }
        }
      }
    },
