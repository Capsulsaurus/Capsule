      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid email or password."
          }
        }
      }
    },
    "error.auth.rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait and try again."
          }
        }
      }
    },
    "error.auth.user_already_exists": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with these details already exists."
          }
        }
      }
    },
    "error.blob.pending_upload": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original photo hasn't been uploaded from its device yet."
          }
        }
      }
    },
    "error.directory.malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device list could not be read."
          }
        }
      }
    },
    "error.directory.version_conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device list is out of date. Capsule will refresh it before continuing."
          }
        }
      }
    },
    "error.drop.cap_exceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload link is full."
          }
        }
      }
    },
    "error.drop.malformed_descriptor": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload couldn't be accepted."
          }
        }
      }
    },
    "error.drop.not_in_inbox": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This drop is no longer available to adopt."
          }
        }
      }
    },
    "error.drop.passphrase_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload link needs its passphrase."
          }
        }
      }
    },
    "error.drop.rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait and try again."
          }
        }
      }
    },
    "error.enrollment.channel_not_found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device-add session has ended. Start again."
          }
        }
      }
    },
    "error.enrollment.code_refused": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device code didn't work. Generate a new one and try again."
          }
        }
      }
    },
    "error.enrollment.local_auth_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm it's you on this device to add another device."
          }
        }
      }
    },
    "error.enrollment.rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many device-add attempts. Please wait and try again."
          }
        }
      }
    },
    "error.enrollment.relay_malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The device-add request could not be read."
          }
        }
      }
    },
    "error.escrow.malformed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery backup could not be saved."
          }
        }
      }
    },
    "error.moderation.account_suspended": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account is suspended. You can't upload or share until it's reinstated."
          }
        }
      }
    },
    "error.moderation.report_rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many reports from this source. Please wait and try again."
          }
        }
      }
    },
    "error.moderation.report_unsigned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The moderation report could not be verified."
          }
        }
      }
    },
    "error.moderation.server_blocked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is blocked from federating with us."
          }
        }
      }
    },
    "error.protocol.version_unsupported": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of Capsule is no longer supported. Please update the app."
          }
        }
      }
    },
    "error.quota.exceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your storage is full."
          }
        }
      }
    },
    "error.quota.grace_locked": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your storage has been full past the grace period, so edits are paused until you free space."
          }
        }
      }
    },
    "error.quota.peer_budget_exceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source has reached its caching limit on your account."
          }
        }
      }
    },
    "error.share.rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Please wait and try again."
          }
        }
      }
    },
    "error.storage.deep_rate_limited": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many deep storage checks. Please wait and try again."
          }
        }
      }
    },
    "error.storage.invalid_request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storage-verification request was malformed."
          }
        }
      }
    },
    "error.sync.cursor_invalid": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sync session is out of date. Capsule will resync from the start."
          }
        }
      }
    },
    "error.sync.unauthenticated": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please sign in again to continue syncing."
          }
        }
      }
    },
    "error.upload.album_access_denied": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to add photos to this album."
          }
        }
      }
    },
    "error.upload.amk_regressed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change references an older album key than the server has recorded."
          }
        }
      }
    },
    "error.upload.checksum_mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload data was corrupted in transit. Retrying…"
          }
        }
      }
    },
    "error.upload.chunk_conflict": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload sent conflicting data and was stopped."
          }
        }
      }
    },
    "error.upload.chunk_not_aligned": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An upload chunk was incorrectly sized."
          }
        }
      }
    },
    "error.upload.chunk_too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An upload chunk exceeded the maximum chunk size."
          }
        }
      }
    },
    "error.upload.content_hash_mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload failed integrity verification and was discarded."
          }
        }
      }
    },
    "error.upload.device_not_authorized": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device isn't authorized to upload. Re-enroll it and try again."
          }
        }
      }
    },
    "error.upload.duplicate_blob": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is already stored."
          }
        }
      }
    },
    "error.upload.empty_chunk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An upload chunk cannot be empty."
          }
        }
      }
    },
    "error.upload.envelope_mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload request contradicts its signed manifest."
          }
        }
      }
    },
    "error.upload.envelope_rejected": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload's signed manifest failed validation."
          }
        }
      }
    },
    "error.upload.file_too_large": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file exceeds the server's size limit."
          }
        }
      }
    },
    "error.upload.finalize_in_progress": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload is already being finalized."
          }
        }
      }
    },
    "error.upload.forbidden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have access to this upload."
          }
        }
      }
    },
    "error.upload.invalid_action": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change uses an action the album doesn't allow."
          }
        }
      }
    },
    "error.upload.invalid_hash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload's declared content hash is invalid."
          }
        }
      }
    },
    "error.upload.invalid_size": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload's declared size is invalid."
          }
        }
      }
    },
    "error.upload.malformed_request": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload request was malformed."
          }
        }
      }
    },
    "error.upload.missing_checksum": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload request was missing its integrity checksum."
          }
        }
      }
    },
    "error.upload.missing_offset": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload request was missing its position marker."
          }
        }
      }
    },
    "error.upload.offset_mismatch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload got out of sync and is realigning."
          }
        }
      }
    },
    "error.upload.owner_not_permitted": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can't upload on behalf of this user."
          }
        }
      }
    },
    "error.upload.receipt_not_available": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload hasn't finished, so its storage receipt isn't available yet."
          }
        }
      }
    },
    "error.upload.session_not_active": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload has already finished."
          }
        }
      }
    },
    "error.upload.session_not_found": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload session expired. Starting over…"
          }
        }
      }
    },
    "error.upload.size_exceeded": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload sent more data than it declared."
          }
        }
      }
    },
    "error.upload.stale_revival": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change is based on an out-of-date version of the item."
          }
        }
      }
    },
    "error.upload.storage_inconsistent": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server hit a storage problem. Please try again."
          }
        }
      }
    },
    "error.upload.timestamp_out_of_range": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device's clock appears to be wrong. Check its date and time."
          }
        }
      }
    },
    "error.upload.unknown_crypto_suite": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
