    "app.auth.server.protocol.incompatible": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا الخادم إصدار بروتوكول لا يدعمه هذا التطبيق. حدّث Capsule للاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verwendet eine Protokollversion, die diese App nicht unterstützt. Aktualisiere Capsule, um dich zu verbinden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server speaks a protocol version this app doesn't. Update Capsule to connect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa una versión del protocolo que esta app no admite. Actualiza Capsule para conectarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur utilise une version du protocole que cette app ne prend pas en charge. Mettez à jour Capsule pour vous connecter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्वर ऐसा प्रोटोकॉल संस्करण उपयोग करता है जिसे यह ऐप नहीं समझता। कनेक्ट करने के लिए Capsule अपडेट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo server usa una versione del protocollo non supportata da questa app. Aggiorna Capsule per connetterti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは、このアプリが対応していないプロトコルバージョンを使用しています。接続するには Capsule をアップデートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버는 이 앱이 지원하지 않는 프로토콜 버전을 사용합니다. 연결하려면 Capsule을 업데이트하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor usa uma versão de protocolo que este app não usa. Atualize o Capsule para conectar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот сервер использует версию протокола, которую не поддерживает это приложение. Обновите Capsule, чтобы подключиться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器使用的协议版本与此应用不兼容。请更新 Capsule 后再连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器使用的通訊協定版本此 App 不支援。請更新 Capsule 以進行連線。"
          }
        }
      }
    },
