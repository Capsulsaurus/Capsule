    "app.devices.revoke_all.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تسجيل الخروج من كل الأجهزة، بما فيها هذا الجهاز. تبقى صورك في مكانها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Geräte, einschließlich dieses, werden abgemeldet. Deine Fotos bleiben, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device, including this one, will be signed out. Your photos stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión en todos los dispositivos, incluido este. Tus fotos se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les appareils, y compris celui-ci, seront déconnectés. Vos photos restent où elles sont."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस सहित हर डिवाइस से साइन आउट हो जाएगा। आपकी फ़ोटो जहाँ हैं वहीं रहेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i dispositivi, incluso questo, verranno disconnessi. Le tue foto restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを含むすべてのデバイスがサインアウトされます。写真はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 포함한 모든 기기에서 로그아웃됩니다. 사진은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dispositivos, incluindo este, serão desconectados. Suas fotos permanecem onde estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет выполнен выход на всех устройствах, включая это. Ваши фото останутся на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括此设备在内的所有设备都将退出登录。您的照片会原样保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有裝置（包括此裝置）都將被登出。你的照片會保留在原處。"
          }
        }
      }
    },
    "app.devices.revoke_all.confirm.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
