        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब आपकी फ़ोटो इस डिवाइस पर नहीं होतीं, तो वे यहाँ रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
