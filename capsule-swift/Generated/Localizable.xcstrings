    "app.settings.security.method.unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تعيين شيء — لا يمكن قفل هذه العروض"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts festgelegt – diese Ansichten können nicht gesperrt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing set — these views can't be locked"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada configurado: estas vistas no se pueden bloquear"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun code défini : ces vues ne peuvent pas être verrouillées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ सेट नहीं है — ये व्यू लॉक नहीं किए जा सकते"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
