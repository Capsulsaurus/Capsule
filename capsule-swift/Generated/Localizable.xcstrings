    "error.upload.album_access_denied": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليست لديك صلاحية لإضافة صور إلى هذا الألبوم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben keine Berechtigung, Fotos zu diesem Album hinzuzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You don't have permission to add photos to this album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes permiso para añadir fotos a este álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas la permission d'ajouter des photos à cet album."
