    "app.auth.server.identity.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قارن مفتاح التوقيع هذا بالمفتاح الذي نشره مسؤول الخادم. بعد تثبيته، يرفض Capsule الاتصال إذا تغيّر المفتاح يومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche diesen Signaturschlüssel mit dem, den der Administrator des Servers veröffentlicht hat. Sobald du ihn anheftest, verweigert Capsule die Verbindung, falls sich der Schlüssel jemals ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare this signing key with the one the server's administrator published. Once you pin it, Capsule refuses to connect if the key ever changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara esta clave de firma con la que publicó el administrador del servidor. Una vez fijada, Capsule se negará a conectarse si la clave cambia alguna vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparez cette clé de signature avec celle publiée par l'administrateur du serveur. Une fois épinglée, Capsule refusera de se connecter si la clé change."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस साइनिंग कुंजी की तुलना सर्वर के व्यवस्थापक द्वारा प्रकाशित कुंजी से करें। पिन करने के बाद, कुंजी कभी बदलने पर Capsule कनेक्ट करने से मना कर देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta questa chiave di firma con quella pubblicata dall'amministratore del server. Una volta fissata, Capsule si rifiuterà di connettersi se la chiave dovesse cambiare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この署名鍵を、サーバー管理者が公開しているものと照合してください。固定すると、鍵が変わった場合に Capsule は接続を拒否します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서명 키를 서버 관리자가 게시한 키와 비교하세요. 고정한 후에는 키가 변경되면 Capsule이 연결을 거부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare esta chave de assinatura com a que o administrador do servidor publicou. Depois de fixá-la, o Capsule se recusa a conectar se a chave mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравните этот ключ подписи с ключом, опубликованным администратором сервера. После закрепления Capsule откажется подключаться, если ключ когда-либо изменится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将此签名密钥与服务器管理员公布的密钥进行比对。固定后，一旦密钥发生变化，Capsule 将拒绝连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將此簽署密鑰與伺服器管理者公布的密鑰比對。釘選後，若密鑰有任何變更，Capsule 將拒絕連線。"
          }
        }
      }
    },
