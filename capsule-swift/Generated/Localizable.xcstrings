    "app.transfer.recovery.retry.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عادةً ما يزول هذا من تلقاء نفسه. سينتظر Capsule لحظة ثم يعيد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das behebt sich meist von selbst. Capsule wartet kurz und versucht es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This usually clears on its own. Capsule will wait a moment and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto suele resolverse solo. Capsule esperará un momento y lo intentará de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce problème se résout généralement de lui-même. Capsule va patienter un instant et réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आमतौर पर अपने आप ठीक हो जाता है। Capsule थोड़ी देर रुककर फिर से प्रयास करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito si risolve da solo. Capsule attenderà un momento e riproverà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常は自然に解消されます。Capsule は少し待ってから再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대개 저절로 해결됩니다. Capsule이 잠시 기다린 후 다시 시도합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso geralmente se resolve sozinho. O Capsule vai aguardar um instante e tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычно это проходит само. Capsule немного подождёт и повторит попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此问题通常会自行解决。Capsule 将稍候片刻后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這通常會自行恢復。Capsule 會稍候片刻再試一次。"
          }
        }
      }
    },
