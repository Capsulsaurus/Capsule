    "app.settings.account.signout.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيسجّل هذا الجهاز الخروج من خادمك. تبقى الصور الموجودة عليه في مكانها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät wird von deinem Server abgemeldet. Fotos, die bereits darauf sind, bleiben, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device signs out of your server. Photos already on it stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo cerrará la sesión en tu servidor. Las fotos que ya tiene se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil va se déconnecter de votre serveur. Les photos qu'il contient déjà restent là où elles sont."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस आपके सर्वर से साइन आउट हो जाएगा। इस पर पहले से मौजूद फ़ोटो जहाँ हैं वहीं रहेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo verrà disconnesso dal server. Le foto già presenti restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはサーバーからサインアウトします。デバイス上にある写真はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 서버에서 로그아웃됩니다. 이미 기기에 있는 사진은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo vai sair do seu servidor. As fotos que já estão nele continuam onde estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство выйдет из вашего сервера. Фото, которые уже на нём, останутся на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备将从您的服务器退出登录。设备上已有的照片会保留在原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置將從您的伺服器登出。裝置上現有的照片會留在原處。"
          }
        }
      }
    },
    "app.settings.account.signout.confirm.title": {
