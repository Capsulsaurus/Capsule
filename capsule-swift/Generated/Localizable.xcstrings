    "auth.forgot.confirmation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كان هناك حساب بهذا البريد الإلكتروني، فستتلقى رابط إعادة التعيين قريبًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Falls ein Konto mit dieser E-Mail-Adresse existiert, erhältst du in Kürze einen Link zum Zurücksetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If an account with that email exists, you'll receive a reset link shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si existe una cuenta con ese correo electrónico, recibirás un enlace para restablecer la contraseña en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si un compte existe avec cette adresse e-mail, vous recevrez bientôt un lien de réinitialisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर उस ईमेल से कोई खाता मौजूद है, तो आपको जल्द ही रीसेट लिंक मिल जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se esiste un account con questa e-mail, riceverai a breve un link per reimpostare la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのメールアドレスのアカウントが存在する場合は、まもなくリセット用リンクが届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 이메일로 등록된 계정이 있으면 곧 재설정 링크가 전송됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se existir uma conta com esse e-mail, você receberá um link de redefinição em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если учётная запись с этим адресом существует, вы вскоре получите ссылку для сброса."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果存在使用该邮箱的账户，您很快会收到重置链接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果有使用該電子郵件的帳號，您很快就會收到重設連結。"
          }
        }
      }
    },
    "auth.forgot.description": {
      "localizations": {
