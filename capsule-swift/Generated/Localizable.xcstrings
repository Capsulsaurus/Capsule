    "error.auth.oidc_unavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Capsule الوصول إلى موفّر الهوية حاليًا. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
