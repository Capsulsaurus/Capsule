    "error.directory.untrusted_signature": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة أجهزة هذا الحساب غير موقّعة بمفتاح الحساب الذي يثق به هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Geräteliste dieses Kontos ist nicht mit dem Kontoschlüssel signiert, dem dieses Gerät vertraut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account's device list isn't signed by the account key this device trusts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La lista de dispositivos de esta cuenta no está firmada con la clave de cuenta en la que confía este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La liste d'appareils de ce compte n'est pas signée par la clé de compte à laquelle cet appareil fait confiance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते की डिवाइस सूची उस खाता कुंजी से हस्ताक्षरित नहीं है जिस पर यह डिवाइस भरोसा करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'elenco dei dispositivi di questo account non è firmato con la chiave dell'account considerata attendibile da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのデバイス一覧は、このデバイスが信頼するアカウントキーで署名されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 기기 목록이 이 기기가 신뢰하는 계정 키로 서명되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de dispositivos desta conta não está assinada pela chave da conta em que este dispositivo confia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Список устройств этой учётной записи не подписан ключом учётной записи, которому доверяет это устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的设备列表并非由此设备信任的账户密钥签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號的裝置清單並非由此裝置信任的帳號金鑰所簽署。"
          }
        }
      }
    },
    "error.directory.version_conflict": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة الأجهزة هذه قديمة. سيقوم Capsule بتحديثها قبل المتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Geräteliste ist veraltet. Capsule aktualisiert sie, bevor es fortfährt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device list is out of date. Capsule will refresh it before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista de dispositivos está desactualizada. Capsule la actualizará antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
