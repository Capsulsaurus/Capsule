    "app.settings.ai.remove.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوقف الميزات التي تستخدمه عن العمل حتى تنزّله مرة أخرى. لا تتأثر صورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Funktionen, die es verwenden, funktionieren erst wieder, wenn du es erneut lädst. Deine Fotos sind nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Features that use it stop working until you download it again. Your photos aren't affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las funciones que lo usan dejarán de funcionar hasta que vuelvas a descargarlo. Tus fotos no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités qui l'utilisent cesseront de fonctionner jusqu'à ce que vous le téléchargiez de nouveau. Vos photos ne sont pas concernées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका उपयोग करने वाली सुविधाएँ तब तक काम नहीं करेंगी जब तक आप इसे फिर से डाउनलोड नहीं करते। आपकी फ़ोटो पर कोई असर नहीं पड़ता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le funzioni che lo usano smetteranno di funzionare finché non lo scarichi di nuovo. Le tue foto non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルを使用する機能は、再度ダウンロードするまで使えなくなります。写真には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 다운로드할 때까지 이 모델을 사용하는 기능이 작동하지 않습니다. 사진에는 영향이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos que o usam deixam de funcionar até você baixá-lo novamente. Suas fotos não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Функции, которые её используют, перестанут работать, пока вы не загрузите её снова. Ваши фото это не затронет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用该模型的功能将停止工作，直到您重新下载。您的照片不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此模型的功能將停止運作，直到您重新下載為止。您的照片不會受到影響。"
          }
        }
      }
    },
