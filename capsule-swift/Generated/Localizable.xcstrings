    "app.share.list.revoke.confirm_message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتمكن أي شخص لديه الرابط من فتحه خلال دقيقة. لن تتأثر صورك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer ihn hat, kann ihn innerhalb einer Minute nicht mehr öffnen. Deine Fotos sind davon nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone holding it will stop being able to open it, within a minute. Your photos aren't affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien lo tenga dejará de poder abrirlo en menos de un minuto. Tus fotos no se ven afectadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les personnes qui le détiennent ne pourront plus l'ouvrir d'ici une minute. Vos photos ne sont pas affectées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिनके पास भी यह है, वे एक मिनट के भीतर इसे नहीं खोल पाएँगे। आपकी फ़ोटो पर कोई असर नहीं पड़ता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi lo possiede non potrà più aprirlo entro un minuto. Le tue foto non vengono toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを持っている人は、1分以内に開けなくなります。写真には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "1분 이내에 이 링크를 가진 사람은 더 이상 열 수 없게 됩니다. 사진은 영향을 받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem tiver o link deixará de conseguir abri-lo em até um minuto. Suas fotos não são afetadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В течение минуты те, у кого она есть, больше не смогут её открыть. Ваши фото не затрагиваются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持有此链接的任何人将在一分钟内无法再打开它。您的照片不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持有此連結的人將在一分鐘內無法再開啟它。您的照片不會受到影響。"
          }
        }
      }
    },
