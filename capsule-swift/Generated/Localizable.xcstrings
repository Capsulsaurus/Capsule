    },
    "app.enrollment.deferred.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتمل الإعداد على هذا الجهاز. ستكتمل الخطوات أعلاه تلقائيًا عندما يصبح خادمك متاحًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einrichtung auf diesem Gerät ist abgeschlossen. Die obigen Schritte werden automatisch beendet, sobald dein Server erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setup is complete on this device. The steps above will finish on their own once your server is reachable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración de este dispositivo está completa. Los pasos anteriores terminarán solos cuando el servidor esté accesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration est terminée sur cet appareil. Les étapes ci-dessus se termineront d'elles-mêmes dès que votre serveur sera joignable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर सेटअप पूरा हो गया है। आपका सर्वर उपलब्ध होने पर ऊपर दिए गए चरण अपने आप पूरे हो जाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione è completa su questo dispositivo. I passaggi sopra verranno completati automaticamente quando il server sarà raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでの設定は完了しました。上記の手順は、サーバーに接続できるようになると自動的に完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 설정이 완료되었습니다. 위 단계는 서버에 연결되면 자동으로 완료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração está concluída neste dispositivo. As etapas acima serão finalizadas automaticamente quando seu servidor estiver acessível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройка на этом устройстве завершена. Шаги выше завершатся сами, когда сервер станет доступен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的设置已完成。服务器恢复连接后，上述步骤将自动完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置上的設定已完成。伺服器可連線後，上方的步驟會自動完成。"
          }
        }
      }
    },
    "app.enrollment.deferred.directory": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز يعمل الآن. ستراه أجهزتك الأخرى بمجرد وصول الرفع إلى خادمك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät funktioniert bereits. Deine anderen Geräte sehen es, sobald der Upload deinen Server erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device works now. Your other devices will see it once the upload reaches your server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo ya funciona. Tus otros dispositivos lo verán cuando la subida llegue a tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil fonctionne dès maintenant. Vos autres appareils le verront une fois l'envoi arrivé sur votre serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस अभी काम करता है। अपलोड आपके सर्वर तक पहुँचने पर आपके अन्य डिवाइस इसे देख पाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo funziona già. Gli altri tuoi dispositivi lo vedranno quando il caricamento raggiungerà il tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはすでに使用できます。アップロードがサーバーに届くと、ほかのデバイスからもこのデバイスが見えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 지금 바로 사용할 수 있습니다. 업로드가 서버에 도달하면 다른 기기에서도 이 기기가 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo já funciona. Seus outros dispositivos vão reconhecê-lo quando o envio chegar ao seu servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство уже работает. Другие ваши устройства увидят его, когда данные дойдут до сервера."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备现在即可使用。上传到达您的服务器后，您的其他设备就会看到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置現在即可使用。上傳內容送達你的伺服器後，你的其他裝置就會看到它。"
          }
        }
      }
    },
