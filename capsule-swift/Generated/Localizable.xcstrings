        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule यह नहीं पढ़ सका कि वह इस डिवाइस पर कितनी जगह उपयोग कर रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
