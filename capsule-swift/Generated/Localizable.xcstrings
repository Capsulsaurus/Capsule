    "app.settings.account.sessions.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنهاء جلسة واحدة يسجّل الخروج من ذلك الجهاز فقط. يستمر كل شيء آخر في العمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Sitzung beendest, wird nur dieses Gerät abgemeldet. Alles andere funktioniert weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ending one session signs out that device only. Everything else keeps working."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar una sesión solo desconecta ese dispositivo. Todo lo demás sigue funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre fin à une session déconnecte uniquement l'appareil concerné. Tout le reste continue de fonctionner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सत्र समाप्त करने से केवल वह डिवाइस साइन आउट होता है। बाकी सब काम करता रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminare una sessione disconnette solo quel dispositivo. Tutto il resto continua a funzionare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セッションを終了すると、そのデバイスだけがサインアウトされます。他はすべて引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션 하나를 종료하면 해당 기기만 로그아웃됩니다. 다른 모든 기기는 계속 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerrar uma sessão desconecta apenas aquele dispositivo. Todo o resto continua funcionando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершение сеанса выполняет выход только на том устройстве. Всё остальное продолжает работать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束一个会话只会让该设备退出登录，其他一切照常工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束一個工作階段只會登出該裝置，其他一切都會照常運作。"
          }
        }
      }
    },
