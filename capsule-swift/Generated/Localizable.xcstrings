    "sharing.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك صورك وألبوماتك مع الأصدقاء والعائلة. سيظهر المحتوى المشترك هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deine Fotos und Alben mit Freunden und Familie. Geteilte Inhalte werden hier angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your photos and albums with friends and family. Shared content will appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tus fotos y álbumes con amigos y familiares. El contenido compartido aparecerá aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez vos photos et albums avec vos proches. Le contenu partagé apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी फ़ोटो और एल्बम दोस्तों और परिवार के साथ साझा करें। साझा सामग्री यहाँ दिखाई देगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi le tue foto e i tuoi album con amici e familiari. I contenuti condivisi appariranno qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真やアルバムを友達や家族と共有しましょう。共有したコンテンツはここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 및 가족과 사진과 앨범을 공유하세요. 공유된 콘텐츠가 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe suas fotos e álbuns com amigos e familiares. O conteúdo compartilhado aparecerá aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Делитесь фото и альбомами с друзьями и близкими. Общий контент появится здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与亲朋好友共享您的照片和相册。共享的内容将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與親朋好友分享您的照片和相簿。分享的內容會顯示在這裡。"
          }
        }
      }
    },
    "sharing.dialog_description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ ألبومًا جديدًا لمشاركته مع الأصدقاء والعائلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein neues Album, um es mit Freunden und Familie zu teilen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a new album to share with friends and family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un álbum nuevo para compartirlo con amigos y familiares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez un nouvel album à partager avec vos proches."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोस्तों और परिवार के साथ साझा करने के लिए एक नया एल्बम बनाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un nuovo album da condividere con amici e familiari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達や家族と共有する新しいアルバムを作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "친구 및 가족과 공유할 새 앨범을 만드세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um novo álbum para compartilhar com amigos e familiares."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте новый альбом, чтобы поделиться им с друзьями и близкими."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建一个新相册，与亲朋好友共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立新相簿以便與親朋好友分享。"
          }
        }
      }
    },
