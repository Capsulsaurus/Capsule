    "app.moderation.unblock.confirm_message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتمكن من مشاركة الألبومات معك مجددًا. لن تُعاد إضافته إلى أي شيء أُزيل منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Person kann wieder Alben mit dir teilen. Sie wird nirgends wieder hinzugefügt, wo sie entfernt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They'll be able to share albums with you again. They aren't added back to anything they were removed from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrá volver a compartir álbumes contigo. No se volverá a añadir a nada de lo que se eliminó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette personne pourra de nouveau partager des albums avec vous. Elle ne sera pas réintégrée là où elle a été retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वे फिर से आपके साथ एल्बम साझा कर सकेंगे। जिन चीज़ों से उन्हें हटाया गया था, उनमें उन्हें वापस नहीं जोड़ा जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrà di nuovo condividere album con te. Non verrà riaggiunta a nulla da cui è stata rimossa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人は再びあなたとアルバムを共有できるようになります。削除されたアルバムに再び追加されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 사람이 다시 앨범을 공유할 수 있게 됩니다. 이전에 제거된 항목에 다시 추가되지는 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pessoa poderá compartilhar álbuns com você novamente. Ela não é adicionada de volta a nada de que foi removida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот человек снова сможет делиться с вами альбомами. Он не будет снова добавлен туда, откуда был удалён."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方将可以再次与您共享相册。对方不会被重新加入之前被移出的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對方將能再次與您共享相簿。對方不會被重新加入先前被移除的任何項目。"
          }
        }
      }
    },
