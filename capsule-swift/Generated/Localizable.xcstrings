    "drop.error.generic": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدث خطأ ما أثناء رفع هذا الملف. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
