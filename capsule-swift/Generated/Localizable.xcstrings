        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主伺服器"
          }
        }
      }
    },
    "app.settings.server.portability.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الانتقال إلى خادم آخر مع الاحتفاظ بهويتك وصورك. يظل معرّفك القديم يشير إلى الخادم الجديد، فيتبعك من تشارك معهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst zu einem anderen Server wechseln und deine Identität und deine Fotos behalten. Dein alter Handle verweist weiter auf den neuen, sodass Personen, mit denen du teilst, dir folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can move to a different server and keep your identity and your photos. Your old handle keeps pointing at the new one, so people you share with follow along."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiarte a otro servidor y conservar tu identidad y tus fotos. Tu identificador anterior sigue apuntando al nuevo, así que las personas con las que compartes te siguen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer à un autre serveur en conservant votre identité et vos photos. Votre ancien identifiant continue de pointer vers le nouveau, pour que les personnes avec qui vous partagez vous suivent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसी दूसरे सर्वर पर जा सकते हैं और अपनी पहचान और अपनी फ़ोटो रख सकते हैं। आपका पुराना हैंडल नए सर्वर की ओर इशारा करता रहता है, इसलिए जिन लोगों के साथ आप साझा करते हैं वे भी साथ आ जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi passare a un altro server mantenendo la tua identità e le tue foto. Il tuo vecchio handle continua a puntare a quello nuovo, così le persone con cui condividi ti seguono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのサーバーに移行しても、ID と写真はそのまま保持できます。以前のハンドルは引き続き新しいサーバーを指すため、共有相手もそのまま引き継がれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ID와 사진을 그대로 유지한 채 다른 서버로 옮길 수 있습니다. 기존 핸들이 새 서버를 계속 가리키므로 공유하는 사람들도 함께 따라옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar para outro servidor e manter sua identidade e suas fotos. Seu identificador antigo continua apontando para o novo, então as pessoas com quem você compartilha acompanham a mudança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете перейти на другой сервер, сохранив свою идентичность и фото. Ваш старый идентификатор продолжит указывать на новый сервер, поэтому те, с кем вы делитесь, последуют за вами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以迁移到其他服务器，同时保留您的身份和照片。您的旧用户名会继续指向新服务器，因此与您共享的人也会随之跟进。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以搬移到其他伺服器，並保留您的身分和照片。您的舊帳號名稱會繼續指向新的伺服器，因此與您共享的人也會跟著轉移。"
          }
        }
      }
    },
    "app.settings.server.portability.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء هنا يقيّدك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier bindet dich nichts fest."
