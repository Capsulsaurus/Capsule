    "app.enrollment.custody.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكان الذي يحتفظ فيه هذا الجهاز بمفاتيحه. نذكره الآن بدلًا من منتصف الطريق، حتى لا يتغيّر شيء بشأنه أثناء الإعداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wo dieses Gerät seine Schlüssel aufbewahrt. Wir sagen es jetzt und nicht erst mittendrin, damit sich daran während der Einrichtung nichts ändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where this device keeps its keys. Said now rather than partway through, so nothing about it changes as setup runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde guarda este dispositivo sus claves. Se indica ahora y no a mitad del proceso, para que nada de esto cambie durante la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'endroit où cet appareil conserve ses clés. Indiqué dès maintenant plutôt qu'en cours de route, pour que rien ne change pendant la configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस अपनी कुंजियाँ कहाँ रखता है। यह अभी बताया जा रहा है, बीच में नहीं, ताकि सेटअप के दौरान इसमें कुछ न बदले।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove questo dispositivo conserva le sue chiavi. Lo indichiamo ora e non a metà, così non cambia nulla durante la configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスが鍵を保管する場所です。設定の途中で変わることがないよう、最初にお知らせしています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기가 키를 보관하는 위치입니다. 설정 도중이 아니라 지금 알려 드리므로 설정이 진행되는 동안 바뀌지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde este dispositivo guarda suas chaves. Informado agora, e não no meio do caminho, para que nada mude durante a configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Где это устройство хранит свои ключи. Сообщается сейчас, а не по ходу дела, чтобы ничего не менялось во время настройки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备保存其密钥的位置。现在就告知您，这样在设置过程中这一点不会发生变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置存放密鑰的位置。現在先告知你，而不是在設定途中才說明，因此設定過程中不會有任何改變。"
          }
        }
      }
    },
