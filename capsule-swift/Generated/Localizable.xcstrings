    "app.settings.account.portability.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الانتقال إلى خادم آخر مع الاحتفاظ بهويتك وصورك وكل من تشاركهم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst auf einen anderen Server umziehen und deine Identität, deine Fotos und alle, mit denen du teilst, behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can move to a different server and keep your identity, your photos, and everyone you share with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes mudarte a otro servidor y conservar tu identidad, tus fotos y a todas las personas con las que compartes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez passer à un autre serveur en conservant votre identité, vos photos et toutes les personnes avec qui vous partagez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप किसी दूसरे सर्वर पर जा सकते हैं और अपनी पहचान, अपनी फ़ोटो और उन सभी लोगों को बनाए रख सकते हैं जिनके साथ आप साझा करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi trasferirti su un altro server mantenendo la tua identità, le tue foto e tutte le persone con cui condividi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ID、写真、共有相手をそのまま保持して、別のサーバーに移行できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 서버로 옮겨도 ID, 사진, 공유 중인 모든 사람을 그대로 유지할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode mudar para outro servidor e manter sua identidade, suas fotos e todas as pessoas com quem compartilha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете перейти на другой сервер, сохранив свою личность, фото и всех, с кем вы делитесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以迁移到其他服务器，并保留您的身份、照片以及所有与您共享的联系人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以搬遷到其他伺服器，並保有您的身分、照片以及所有與您共享的對象。"
          }
        }
      }
    },
    "app.settings.account.revoke_all": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج من كل الأجهزة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Geräte abmelden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign Out All Devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar sesión en todos los dispositivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déconnecter tous les appareils"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी डिवाइस से साइन आउट करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esci da tutti i dispositivi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスからサインアウト"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair de Todos os Dispositivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выйти на всех устройствах"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出所有设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出所有裝置"
          }
        }
      }
    },
    "app.settings.account.revoke_all.confirm.action": {
      "localizations": {
