    "app.settings.account.revoke_all.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم تسجيل الخروج من كل الأجهزة، بما فيها هذا الجهاز. سيُطلب منك التأكيد بمفتاح حسابك. تبقى صورك في مكانها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Geräte, auch dieses, werden abgemeldet. Du wirst gebeten, mit deinem Kontoschlüssel zu bestätigen. Deine Fotos bleiben, wo sie sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every device, including this one, will be signed out. You'll be asked to confirm with your account key. Your photos stay where they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerrará la sesión en todos los dispositivos, incluido este. Se te pedirá que confirmes con la clave de tu cuenta. Tus fotos se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les appareils, y compris celui-ci, seront déconnectés. Vous devrez confirmer avec la clé de votre compte. Vos photos restent là où elles sont."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस सहित हर डिवाइस से साइन आउट हो जाएगा। आपसे अपनी खाता कुंजी से पुष्टि करने को कहा जाएगा। आपकी फ़ोटो जहाँ हैं वहीं रहेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà eseguita l'uscita da tutti i dispositivi, incluso questo. Ti verrà chiesto di confermare con la chiave dell'account. Le tue foto restano dove sono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを含むすべてのデバイスがサインアウトされます。アカウントキーでの確認が求められます。写真はそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 포함한 모든 기기에서 로그아웃됩니다. 계정 키로 확인하라는 메시지가 표시됩니다. 사진은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dispositivos, incluindo este, terão a sessão encerrada. Você precisará confirmar com a chave da sua conta. Suas fotos continuam onde estão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет выполнен выход на всех устройствах, включая это. Потребуется подтверждение ключом учётной записи. Ваши фото останутся на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括此设备在内的所有设备都将退出登录。系统会要求您使用账户密钥确认。您的照片会保留在原处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有裝置（包括此裝置）都將被登出。系統會要求您以帳號金鑰確認。您的照片會留在原處。"
          }
        }
      }
    },
