    "library.archive.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور المؤرشفة مخفية من عرض الصور الرئيسي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivierte Fotos werden in deiner Hauptansicht der Fotos ausgeblendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Archived photos are hidden from your main photos view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos archivadas se ocultan de la vista principal de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos archivées sont masquées de votre vue Photos principale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आर्काइव की गई फ़ोटो आपके मुख्य फ़ोटो दृश्य से छिपी रहती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto archiviate sono nascoste dalla vista principale delle foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブした写真はメインの写真表示に表示されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 사진은 기본 사진 보기에서 숨겨집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos arquivadas ficam ocultas da visualização principal de fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивные фото скрыты из основного раздела «Фото»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的照片不会显示在您的主照片视图中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "封存的照片不會顯示在您的主要照片檢視中。"
          }
        }
      }
    },
