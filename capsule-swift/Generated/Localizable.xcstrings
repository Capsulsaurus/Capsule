        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़्रेज़ ठीक वैसा ही टाइप करें जैसा दिखाया गया है। इस कार्रवाई को पूर्ववत नहीं किया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita la frase esattamente come mostrata. L'azione non può essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されているとおりにフレーズを入力してください。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시된 문구를 정확히 입력하세요. 이 작업은 실행 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite a frase exatamente como mostrada. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите фразу точно так, как показано. Это действие нельзя отменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请严格按照显示内容输入短语。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請完全按照顯示的內容輸入短語。此動作無法還原。"
          }
        }
      }
