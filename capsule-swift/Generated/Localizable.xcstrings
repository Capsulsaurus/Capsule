    "app.settings.ai.stale.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتفظ بالنتائج من إصدار أقدم لكنها تُستبعد من عمليات البحث، لأنه لا يمكن مقارنة نتائج إصدارين مختلفين. إعادة التحليل تعيدها — لم يُحذف أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse einer älteren Version werden aufbewahrt, aber bei Suchen ausgelassen, da Ergebnisse zweier Versionen nicht vergleichbar sind. Eine erneute Analyse bringt sie zurück – es wurde nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results from an older version are kept but left out of searches, because results from two versions can't be compared. Redoing the analysis brings them back — nothing has been deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados de una versión anterior se conservan, pero quedan fuera de las búsquedas, porque no se pueden comparar resultados de dos versiones. Al rehacer el análisis vuelven a incluirse; no se ha eliminado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats d'une version antérieure sont conservés mais exclus des recherches, car les résultats de deux versions ne sont pas comparables. Refaire l'analyse les rétablit : rien n'a été supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुराने संस्करण के परिणाम रखे जाते हैं लेकिन खोजों में शामिल नहीं किए जाते, क्योंकि दो संस्करणों के परिणामों की तुलना नहीं की जा सकती। विश्लेषण दोबारा करने से वे वापस आ जाते हैं — कुछ भी हटाया नहीं गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati di una versione precedente vengono conservati ma esclusi dalle ricerche, perché i risultati di due versioni non sono confrontabili. Ripetendo l'analisi tornano disponibili: non è stato eliminato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いバージョンの結果は保管されますが、異なるバージョンの結果は比較できないため、検索からは除外されます。分析をやり直すと元に戻ります。何も削除されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 버전의 결과는 보관되지만 두 버전의 결과는 서로 비교할 수 없으므로 검색에서 제외됩니다. 분석을 다시 실행하면 다시 포함됩니다. 삭제된 항목은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados de uma versão mais antiga são guardados, mas ficam fora das buscas, porque resultados de duas versões não podem ser comparados. Refazer a análise os traz de volta — nada foi apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты более старой версии сохраняются, но не участвуют в поиске, так как результаты двух версий нельзя сравнивать. Повторный анализ вернёт их — ничего не удалено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧版本的结果会被保留，但不会出现在搜索中，因为两个版本的结果无法比较。重新分析即可恢复，没有任何内容被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "舊版本產生的結果會保留，但不會納入搜尋，因為兩個版本的結果無法相互比較。重新分析即可恢復這些結果，不會刪除任何內容。"
          }
        }
      }
    },
