    "app.export.summary.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور المُصدَّرة تخرج من حماية Capsule. ما تفعله بها بعد ذلك يعود إليك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportierte Fotos verlassen den Schutz von Capsule. Was du danach damit machst, liegt bei dir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exported photos leave Capsule's protection. What you do with them afterwards is up to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos exportadas quedan fuera de la protección de Capsule. Lo que hagas con ellas después depende de ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos exportées ne sont plus protégées par Capsule. Ce que vous en faites ensuite ne dépend que de vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट की गई फ़ोटो Capsule की सुरक्षा से बाहर चली जाती हैं। उसके बाद आप उनके साथ क्या करते हैं, यह आप पर निर्भर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto esportate escono dalla protezione di Capsule. Cosa farne in seguito spetta a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出した写真は Capsule の保護の対象外になります。その後の扱いはあなた次第です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보낸 사진은 더 이상 Capsule의 보호를 받지 않습니다. 이후 사진을 어떻게 사용할지는 사용자에게 달려 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos exportadas saem da proteção do Capsule. O que você faz com elas depois é com você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортированные фото больше не защищены Capsule. Что с ними делать дальше — решать вам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出的照片将不再受 Capsule 保护。之后如何处理由您决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出的照片將不再受 Capsule 保護。之後如何處理由你決定。"
          }
        }
      }
    },
