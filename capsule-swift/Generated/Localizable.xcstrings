    "app.transfer.tier.original.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملف الأصلي. ينتظر شبكة Wi-Fi ما لم ترفعه الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldatei. Wartet auf WLAN, außer du lädst sie jetzt hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original file. Waits for Wi-Fi unless you upload now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo original. Espera al Wi-Fi salvo que lo subas ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier d'origine. Attend le Wi-Fi, sauf si vous téléversez maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल फ़ाइल। जब तक आप अभी अपलोड न करें, Wi-Fi का इंतज़ार करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file originale. Attende il Wi-Fi, a meno che tu non lo carichi subito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オリジナルファイル。今すぐアップロードしない限り Wi-Fi 接続まで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 파일입니다. 지금 업로드하지 않으면 Wi-Fi에 연결될 때까지 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo original. Aguarda o Wi-Fi, a menos que você envie agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оригинальный файл. Ждёт Wi-Fi, если не загрузить сейчас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始文件。除非您选择立即上传，否则将等待 Wi-Fi。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原始檔案。除非您選擇立即上傳，否則會等到連上 Wi-Fi。"
          }
        }
      }
    },
