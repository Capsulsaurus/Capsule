    "app.recovery.verify.badge.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيواصل Capsule عرض هذا حتى تتحقق. ومع ذلك لن يمنعك من فعل أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule zeigt dies weiterhin an, bis du prüfst. Es hindert dich trotzdem an nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule will keep showing this until you check. It still won't stop you doing anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule seguirá mostrando esto hasta que hagas la comprobación. Aun así, no te impedirá hacer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule continuera d'afficher ce rappel jusqu'à ce que vous effectuiez la vérification. Il ne vous empêchera toutefois de rien faire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप जाँच नहीं करते, Capsule यह दिखाता रहेगा। फिर भी यह आपको कुछ भी करने से नहीं रोकेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule continuerà a mostrarlo finché non esegui il controllo. Non ti impedirà comunque di fare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認するまで Capsule はこの表示を続けます。それでも操作が妨げられることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인할 때까지 Capsule이 계속 이 알림을 표시합니다. 그래도 어떤 작업도 막지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule vai continuar mostrando isto até você fazer a verificação. Mesmo assim, isso não vai impedir você de fazer nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule будет показывать это, пока вы не выполните проверку. Это по-прежнему ничему не помешает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您检查之前，Capsule 会一直显示此提示，但不会阻止您进行任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您檢查之前，Capsule 會持續顯示此提示，但不會因此阻止您做任何事。"
          }
        }
      }
    },
