      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking is yours alone and takes effect whether or not the administrators act."
          }
        }
      }
    },
    "android.moderation.report.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A report goes to the server that hosts this content. It carries the content's hash and where it sits — never the photo itself, and never anything that could decrypt it."
          }
        }
      }
    },
    "android.moderation.report.error_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't send that report"
          }
        }
      }
    },
    "android.moderation.report.hash_required": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A report has to name the photo's content hash — that is the only thing an administrator can act on without being handed the photo itself."
          }
        }
      }
    },
    "android.moderation.report.kind_content": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo"
          }
        }
      }
    },
    "android.moderation.report.kind_label": {
