    "mfa.totp.scan_description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح رمز QR هذا باستخدام تطبيق المصادقة، ثم أدخل الرمز المكوّن من 6 أرقام للتأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne diesen QR-Code mit deiner Authentifizierungs-App und gib dann zur Bestätigung den 6-stelligen Code ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this QR code with your authenticator app, then enter the 6-digit code to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanea este código QR con tu app de autenticación y luego introduce el código de 6 dígitos para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce QR code avec votre app d'authentification, puis saisissez le code à 6 chiffres pour confirmer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ऑथेंटिकेटर ऐप से यह QR कोड स्कैन करें, फिर पुष्टि के लिए 6 अंकों का कोड दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo codice QR con la tua app di autenticazione, quindi inserisci il codice a 6 cifre per confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリでこの QR コードをスキャンし、6 桁のコードを入力して確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱으로 이 QR 코드를 스캔한 다음 6자리 코드를 입력하여 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia este código QR com seu app autenticador e depois digite o código de 6 dígitos para confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отсканируйте этот QR-код приложением-аутентификатором, затем введите 6-значный код для подтверждения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的验证器应用扫描此二维码，然后输入 6 位验证码进行确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用您的驗證器 App 掃描此 QR 碼，然後輸入 6 位數驗證碼以確認。"
          }
        }
      }
    },
