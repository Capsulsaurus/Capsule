          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定 — これらの表示はロックできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정된 방법 없음 — 이 보기를 잠글 수 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada configurado — estas visualizações não podem ser bloqueadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
