    "error.auth.oidc_device_expired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية رمز تسجيل الدخول هذا أو سبق استخدامه. ابدأ من جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anmeldecode ist abgelaufen oder wurde bereits verwendet. Beginne erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That sign-in code has expired or was already used. Start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de inicio de sesión ha caducado o ya se usó. Empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce code de connexion a expiré ou a déjà été utilisé. Recommencez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह साइन इन कोड समाप्त हो गया है या पहले ही उपयोग किया जा चुका है। फिर से शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice di accesso è scaduto o è già stato usato. Ricomincia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのサインインコードは有効期限が切れているか、すでに使用されています。もう一度やり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 로그인 코드가 만료되었거나 이미 사용되었습니다. 다시 시작해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse código de login expirou ou já foi usado. Comece novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия этого кода входа истёк, или он уже использован. Начните заново."
