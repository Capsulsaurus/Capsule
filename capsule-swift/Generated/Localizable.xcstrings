          }
        }
      }
    },
    "ios.settings.maintenance.scrub.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most once a week, Capsule clears leftover working files from writes that were interrupted. It only touches files more than ten minutes old, and only ones nothing refers to."
          }
        }
      }
    },
    "ios.settings.maintenance.scrub.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here needs starting — this happens by itself."
          }
        }
      }
    },
