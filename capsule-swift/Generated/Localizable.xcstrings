        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уже выполняется слишком много входов. Повторите попытку через минуту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在进行的登录过多，请稍后再试。"
