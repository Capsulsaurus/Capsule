    "app.moderation.section.reports_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذهب البلاغات إلى من يدير الخادم الذي يوجد عليه المحتوى. يحدّد بلاغك العنصر، لا محتوياته أبدًا — فلا يكتسب أحد القدرة على قراءة أي شيء بتلقّيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldungen gehen an die Betreiber des Servers, auf dem sich der Inhalt befindet. Deine Meldung benennt das Element, nie dessen Inhalt – niemand erhält dadurch die Möglichkeit, etwas zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports go to whoever runs the server the content is on. Your report names the item, never its contents — nobody gains the ability to read anything by receiving it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las denuncias llegan a quien administra el servidor donde está el contenido. Tu denuncia identifica el elemento, nunca su contenido: recibirla no permite a nadie leer nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les signalements sont envoyés à l'administrateur du serveur qui héberge le contenu. Votre signalement désigne l'élément, jamais son contenu : le recevoir ne permet à personne de lire quoi que ce soit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिपोर्ट उस व्यक्ति को जाती है जो उस सर्वर को चलाता है जिस पर सामग्री है। आपकी रिपोर्ट में आइटम का नाम होता है, उसकी सामग्री कभी नहीं — रिपोर्ट पाने से किसी को कुछ भी पढ़ने की क्षमता नहीं मिलती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le segnalazioni vanno a chi gestisce il server su cui si trova il contenuto. La segnalazione indica l'elemento, mai il suo contenuto: chi la riceve non ottiene la possibilità di leggere nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告は、そのコンテンツがあるサーバーの管理者に送られます。報告には項目が示されるだけで、その内容は含まれません。報告を受け取っても、誰も何かを読めるようにはなりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고는 해당 콘텐츠가 있는 서버의 운영자에게 전달됩니다. 신고에는 항목만 표시되고 그 내용은 포함되지 않으므로, 신고를 받아도 아무것도 읽을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As denúncias vão para quem administra o servidor onde o conteúdo está. Sua denúncia identifica o item, nunca o conteúdo dele — ninguém passa a poder ler nada ao recebê-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жалобы получает тот, кто управляет сервером с этим контентом. В жалобе указывается объект, но не его содержимое — получив её, никто не сможет ничего прочитать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举报会发送给内容所在服务器的运营者。您的举报只指明项目，绝不包含其内容，任何人都不会因收到举报而获得读取内容的能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢舉會送交內容所在伺服器的管理者。您的檢舉只會指明項目，絕不包含其內容；收到檢舉的人不會因此獲得讀取任何內容的能力。"
          }
        }
      }
    },
    "app.moderation.section.untrusted": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محتوى من خوادم لم تثق بها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Inhalte von nicht vertrauenswürdigen Servern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content from Servers You Haven't Trusted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenido de servidores en los que no confías"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenu de serveurs non approuvés"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन सर्वर की सामग्री जिन पर आपने भरोसा नहीं किया है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contenuti da server non attendibili"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼していないサーバーからのコンテンツ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰하지 않은 서버의 콘텐츠"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteúdo de Servidores Não Confiáveis"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контент с недоверенных серверов"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自您未信任服务器的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自未信任伺服器的內容"
          }
        }
      }
    },
    "app.moderation.section.untrusted_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتجز Capsule المحتوى الوارد من خوادم لم تثق بها حتى توافق على ذلك. لا يُحذف أي شيء أثناء الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hält Inhalte von Servern, denen du nicht vertraust, zurück, bis du zustimmst. Während des Wartens wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule holds content from servers you haven't trusted until you say so. Nothing is deleted while it waits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule retiene el contenido de servidores en los que no confías hasta que lo autorices. No se elimina nada mientras espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule retient le contenu des serveurs que vous n'avez pas approuvés jusqu'à ce que vous l'acceptiez. Rien n'est supprimé pendant l'attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिन सर्वर पर आपने भरोसा नहीं किया है, उनकी सामग्री Capsule तब तक रोके रखता है जब तक आप अनुमति न दें। प्रतीक्षा के दौरान कुछ भी नहीं हटाया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule trattiene i contenuti provenienti da server che non hai considerato attendibili finché non decidi tu. Nulla viene eliminato durante l'attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は、信頼していないサーバーからのコンテンツを、あなたが許可するまで保留します。保留中に削除されるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 신뢰하지 않은 서버의 콘텐츠를 허용할 때까지 보류합니다. 대기 중에는 아무것도 삭제되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule retém conteúdo de servidores em que você não confiou até você autorizar. Nada é apagado enquanto ele aguarda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule задерживает контент с недоверенных серверов, пока вы не разрешите его. Во время ожидания ничего не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您同意之前，Capsule 会暂扣来自您未信任服务器的内容。等待期间不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您同意之前，Capsule 會暫留來自未信任伺服器的內容。等待期間不會刪除任何內容。"
          }
        }
      }
    },
