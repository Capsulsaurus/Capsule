    "error.directory.version_conflict": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قائمة الأجهزة هذه قديمة. سيقوم Capsule بتحديثها قبل المتابعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Geräteliste ist veraltet. Capsule aktualisiert sie, bevor es fortfährt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device list is out of date. Capsule will refresh it before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista de dispositivos está desactualizada. Capsule la actualizará antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette liste d'appareils est obsolète. Capsule l'actualisera avant de continuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस सूची पुरानी है। Capsule जारी रखने से पहले इसे रीफ़्रेश करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elenco di dispositivi non è aggiornato. Capsule lo aggiornerà prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス一覧は最新ではありません。Capsule は続行前に更新します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기 목록이 오래되었습니다. Capsule이 계속하기 전에 새로 고칩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista de dispositivos está desatualizada. O Capsule vai atualizá-la antes de continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот список устройств устарел. Capsule обновит его перед продолжением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备列表已过期。Capsule 将在继续前刷新它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置清單已過期。Capsule 會在繼續前重新整理。"
          }
        }
      }
    },
