    "app.restore.dry_run.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقارن النسخة الاحتياطية بمكتبتك ويوضّح ما ستفعله استعادتها. لا يتغيّر أي شيء بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleicht das Backup mit deiner Mediathek und zeigt, was eine Wiederherstellung bewirken würde. Es wird weiterhin nichts geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compares the backup with your library and reports what restoring it would do. Still nothing is changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara la copia de seguridad con tu fototeca e indica lo que haría restaurarla. Sigue sin cambiarse nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare la sauvegarde avec votre photothèque et indique ce que la restauration ferait. Rien n'est encore modifié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप की तुलना आपकी लाइब्रेरी से करता है और बताता है कि रीस्टोर करने से क्या होगा। अब भी कुछ नहीं बदला जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confronta il backup con la tua libreria e indica cosa farebbe il ripristino. Ancora non viene modificato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップとライブラリを比較し、復元した場合の内容を表示します。まだ何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 보관함과 비교하여 복원 시 어떤 변화가 있을지 보고합니다. 아직 아무것도 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compara o backup com sua biblioteca e informa o que a restauração faria. Nada é alterado ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сравнивает резервную копию с медиатекой и сообщает, что изменит восстановление. По-прежнему ничего не меняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将备份与您的资料库进行比较，并报告恢复后会发生什么。仍不会更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將備份與您的圖庫進行比對，並回報還原後會發生的變化。目前仍不會變更任何內容。"
          }
        }
      }
    },
