    "share.unavailable.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ربما انتهت صلاحيته أو أُلغي أو لم يكن موجودًا قط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er ist möglicherweise abgelaufen, wurde widerrufen oder hat nie existiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It may have expired, been revoked, or never existed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que haya caducado, se haya revocado o nunca haya existido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il a peut-être expiré, été révoqué ou n'a jamais existé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हो सकता है यह समाप्त हो गया हो, रद्द कर दिया गया हो, या कभी मौजूद ही न रहा हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrebbe essere scaduto, revocato o non essere mai esistito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効期限切れ、取り消し済み、または存在しない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료되었거나 취소되었거나 존재하지 않는 링크일 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele pode ter expirado, sido revogado ou nunca ter existido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, срок её действия истёк, она отозвана или никогда не существовала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已过期、已被撤销或从未存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它可能已過期、已撤銷或從未存在。"
          }
        }
      }
    },
