    "app.drops.compose.issued.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص لديه هذا الرابط أن يرسل إليك ملفات، ضمن الحدود التي وضعتها. أبطِله من قائمة روابطك عند انتهائك منه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit diesem Link kann dir Dateien senden, innerhalb der von dir festgelegten Limits. Widerrufe ihn in deiner Linkliste, wenn du ihn nicht mehr brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anyone with this link can send you files, within the limits you set. Revoke it from your links list when you're done with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con este enlace puede enviarte archivos, dentro de los límites que hayas establecido. Revócalo desde tu lista de enlaces cuando ya no lo necesites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant de ce lien peut vous envoyer des fichiers, dans les limites que vous avez définies. Révoquez-le depuis votre liste de liens quand vous n'en avez plus besoin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लिंक वाला कोई भी व्यक्ति आपकी तय सीमाओं के भीतर आपको फ़ाइलें भेज सकता है। काम पूरा होने पर इसे अपनी लिंक सूची से रद्द करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiunque abbia questo link può inviarti file, entro i limiti che hai impostato. Revocalo dall'elenco dei link quando non ti serve più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを知っている人は誰でも、設定した制限の範囲内でファイルを送信できます。使い終わったら、リンク一覧から取り消してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크가 있는 사람은 누구나 설정한 제한 내에서 파일을 보낼 수 있습니다. 사용이 끝나면 링크 목록에서 해지하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer pessoa com este link pode enviar arquivos para você, dentro dos limites definidos. Revogue-o na sua lista de links quando não precisar mais dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, у кого есть эта ссылка, может отправлять вам файлы в пределах заданных ограничений. Когда она станет не нужна, отзовите её в списке ссылок."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何拥有此链接的人都可以在您设定的限制内向您发送文件。不再需要时，请在链接列表中将其撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何擁有此連結的人都可以在你設定的限制內傳送檔案給你。用完後，請從你的連結列表中撤銷它。"
          }
        }
      }
    },
