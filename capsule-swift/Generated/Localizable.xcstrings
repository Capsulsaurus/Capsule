      }
    },
    "app.settings.security.gate.cancelled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد ألغيت آخر عملية فتح، لذا لم يُفتح أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die letzte Entsperrung abgebrochen, daher wurde nichts entsperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cancelled the last unlock, so nothing was unlocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelaste el último desbloqueo, así que no se desbloqueó nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez annulé le dernier déverrouillage, rien n'a donc été déverrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने पिछला अनलॉक रद्द कर दिया था, इसलिए कुछ भी अनलॉक नहीं हुआ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai annullato l'ultimo sblocco, quindi non è stato sbloccato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回のロック解除をキャンセルしたため、何もロック解除されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 잠금 해제를 취소했기 때문에 잠금 해제되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você cancelou o último desbloqueio, então nada foi desbloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы отменили последнюю разблокировку, поэтому ничего не было разблокировано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您取消了上次解锁，因此未解锁任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您取消了上次的解鎖，因此沒有解鎖任何內容。"
          }
        }
      }
    },
    "app.settings.security.gate.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح كل عرض بشكل مستقل ويُقفل نفسه مجددًا بعد فترة. فتح أحدهما لا يفتح الآخر أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Ansicht wird einzeln entsperrt und sperrt sich nach einer Weile wieder. Das Entsperren der einen entsperrt nie die andere."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each view unlocks on its own and locks itself again after a while. Unlocking one never unlocks the other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada vista se desbloquea por separado y se vuelve a bloquear sola al cabo de un rato. Desbloquear una nunca desbloquea la otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque vue se déverrouille séparément et se reverrouille d'elle-même après un moment. Déverrouiller l'une ne déverrouille jamais l'autre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर व्यू अलग से अनलॉक होता है और कुछ समय बाद अपने आप फिर से लॉक हो जाता है। एक को अनलॉक करने से दूसरा कभी अनलॉक नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni vista si sblocca separatamente e si blocca di nuovo dopo un po'. Sbloccarne una non sblocca mai l'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各表示は個別にロック解除され、しばらくすると自動的に再ロックされます。一方をロック解除しても、もう一方はロック解除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 보기는 따로 잠금 해제되며 일정 시간이 지나면 다시 잠깁니다. 하나를 잠금 해제해도 다른 하나는 잠금 해제되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada visualização é desbloqueada separadamente e volta a ser bloqueada depois de um tempo. Desbloquear uma nunca desbloqueia a outra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый раздел разблокируется отдельно и через некоторое время снова блокируется. Разблокировка одного никогда не разблокирует другой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个视图单独解锁，并会在一段时间后自动重新锁定。解锁其中一个绝不会解锁另一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個視圖都會各自解鎖，並在一段時間後自動重新鎖定。解鎖其中一個絕不會解鎖另一個。"
          }
        }
      }
    },
    "app.settings.security.gate.header": {
