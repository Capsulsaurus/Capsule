    "app.quarantine.detail.what_is_kept.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحذف أو يُطبَّق أي شيء هنا. إنه بانتظار قرارك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier wurde nichts gelöscht oder angewendet. Es wartet auf deine Entscheidung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here has been deleted or applied. It's waiting for you to decide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de esto se ha eliminado ni aplicado. Está esperando a que decidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici n'a été supprimé ni appliqué. Tout attend votre décision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ कुछ भी हटाया या लागू नहीं किया गया है। यह आपके निर्णय की प्रतीक्षा कर रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nulla qui è stato eliminato o applicato. Attende la tua decisione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにあるものは何も削除も適用もされていません。あなたの判断を待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 있는 항목은 삭제되거나 적용되지 않았습니다. 사용자의 결정을 기다리고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada aqui foi apagado ou aplicado. Está aguardando sua decisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего не удалено и не применено. Всё ждёт вашего решения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
