            "state": "translated",
            "value": "이 계정에는 아직 복구 문구가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há frase de recuperação para esta conta."
          }
        },
        "ru": {
