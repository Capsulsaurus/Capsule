    "app.recovery.passphrase.copy_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُمسح الحافظة بمجرد أن يسمح هذا الجهاز بذلك. الصقها مباشرة في مدير كلمات المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zwischenablage wird geleert, sobald dieses Gerät es zulässt. Füge die Phrase direkt in deinen Passwortmanager ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clipboard is cleared as soon as this device allows. Paste it straight into your password manager."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El portapapeles se borra en cuanto este dispositivo lo permite. Pégala directamente en tu gestor de contraseñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le presse-papiers est effacé dès que cet appareil le permet. Collez-la directement dans votre gestionnaire de mots de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस जितनी जल्दी अनुमति देगा, क्लिपबोर्ड साफ़ कर दिया जाएगा। इसे सीधे अपने पासवर्ड मैनेजर में पेस्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli appunti vengono cancellati non appena il dispositivo lo consente. Incollala subito nel tuo gestore di password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードは、このデバイスで可能になり次第消去されます。そのままパスワードマネージャに貼り付けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클립보드는 이 기기가 허용하는 즉시 지워집니다. 암호 관리자에 바로 붙여 넣으세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A área de transferência é limpa assim que este dispositivo permitir. Cole a frase direto no seu gerenciador de senhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Буфер обмена будет очищен, как только устройство это позволит. Сразу вставьте фразу в менеджер паролей."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剪贴板会在此设备允许时尽快清除。请直接粘贴到您的密码管理器中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "剪貼簿會在此裝置允許時立即清除。請直接貼到您的密碼管理工具中。"
          }
        }
      }
    },
