    "app.settings.import.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد بعض الصور وستُدرج هنا المصادر التي استخدمتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importiere einige Fotos, dann werden die verwendeten Quellen hier aufgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import some photos and the sources you used will be listed here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa algunas fotos y los orígenes que hayas usado aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des photos et les sources utilisées apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ फ़ोटो इंपोर्ट करें और आपके द्वारा उपयोग किए गए स्रोत यहाँ सूचीबद्ध होंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa alcune foto e le origini usate verranno elencate qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を読み込むと、使用した読み込み元がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 가져오면 사용한 소스가 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe algumas fotos e as origens que você usou serão listadas aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте фото, и использованные источники появятся здесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入一些照片后，您使用过的来源会列在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入一些照片後，您使用過的來源就會列在這裡。"
          }
        }
      }
    },
