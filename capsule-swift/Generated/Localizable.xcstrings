    "app.transfer.downloads.ladder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تصل التفاصيل أولًا، ثم المعاينات، ثم الصور بالحجم الكامل — كلٌّ منها عندما يسمح الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst kommen Details, dann Vorschauen, dann Fotos in voller Größe – jeweils, sobald die Verbindung es zulässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details arrive first, then previews, then full-size photos — each when the connection allows it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero llegan los detalles, luego las vistas previas y después las fotos a tamaño completo, cada cosa cuando la conexión lo permite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails arrivent d'abord, puis les aperçus, puis les photos en taille réelle, chacun lorsque la connexion le permet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले विवरण आते हैं, फिर प्रीव्यू, फिर पूरे आकार की फ़ोटो — हर एक तब, जब कनेक्शन इसकी अनुमति दे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrivano prima i dettagli, poi le anteprime, poi le foto a dimensione intera, ciascuno quando la connessione lo consente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細情報、プレビュー、フルサイズの写真の順に、接続状況に応じて届きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정보가 먼저 도착하고, 그다음 미리보기, 마지막으로 원본 크기 사진이 도착합니다. 각 단계는 연결 상태가 허용할 때 진행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro chegam os detalhes, depois as pré-visualizações e depois as fotos em tamanho original — cada um quando a conexão permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала поступают данные, затем превью, затем фото в полном размере — каждое, когда позволяет соединение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先接收详细信息，再接收预览，最后接收原尺寸照片——每一项都在连接允许时进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先取得詳細資料，再取得預覽，最後是原尺寸照片——各自在連線允許時進行。"
          }
        }
      }
    },
