          "stringUnit": {
            "state": "translated",
            "value": "該登入代碼已過期或已使用過，請重新開始。"
          }
        }
      }
    },
    "error.auth.oidc_device_pending": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بانتظار إنهائك تسجيل الدخول على جهازك الآخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten, bis du die Anmeldung auf deinem anderen Gerät abschließt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for you to finish signing in on your other device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
