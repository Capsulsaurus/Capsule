    "app.settings.import.kinds.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق على أي مصدر من هذا النوع لم تحدّد له ألبومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für jede Quelle dieser Art, für die du kein Album festgelegt hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to any source of that kind you haven't set an album for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a cualquier origen de ese tipo para el que no hayas elegido un álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S'applique à toute source de ce type pour laquelle vous n'avez pas défini d'album."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस प्रकार के हर उस स्रोत पर लागू होता है जिसके लिए आपने कोई एल्बम सेट नहीं किया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica a qualsiasi origine di quel tipo per cui non hai impostato un album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを設定していない、その種類のすべての読み込み元に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범을 설정하지 않은 해당 종류의 모든 소스에 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se a qualquer origem desse tipo para a qual você não definiu um álbum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к любому источнику этого типа, для которого вы не задали альбом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于您未设置相册的该类所有来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於您尚未指定相簿的所有該類來源。"
          }
        }
      }
    },
