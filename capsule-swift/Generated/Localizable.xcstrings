    "app.devices.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الأجهزة هنا بعد تسجيلها في حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte erscheinen hier, sobald sie in deinem Konto registriert sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices appear here once they're enrolled on your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos aparecen aquí cuando se registran en tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils apparaissent ici une fois enrôlés sur votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खाते पर पंजीकृत होने के बाद डिवाइस यहाँ दिखाई देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi compaiono qui dopo essere stati registrati sul tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントに登録されたデバイスがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기를 계정에 등록하면 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dispositivos aparecem aqui depois de registrados na sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройства появятся здесь после регистрации в вашей учётной записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备在您的账户上注册后将显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置註冊到你的帳號後就會顯示在這裡。"
          }
        }
      }
    },
