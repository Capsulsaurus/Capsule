    "app.import.plan.space.streaming": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتسع بالكاد. يُبقي البث كمية أقل على هذا الجهاز أثناء التقدّم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es passt, aber nur knapp. Beim Streaming bleibt währenddessen weniger auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will fit, but barely. Streaming keeps less on this device as it goes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabe, pero por poco. La transmisión continua guarda menos en este dispositivo sobre la marcha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela tiendra, mais de justesse. Le streaming conserve moins de données sur cet appareil au fil de l'importation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़िट हो जाएगा, लेकिन मुश्किल से। स्ट्रीमिंग चलते-चलते इस डिवाइस पर कम डेटा रखती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sta, ma a malapena. Lo streaming conserva meno dati su questo dispositivo durante l'importazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収まりますが、ぎりぎりです。ストリーミングを使うと、読み込み中にこのデバイスに保持するデータが少なくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간이 빠듯하지만 들어갈 수 있습니다. 스트리밍을 사용하면 진행하면서 이 기기에 보관하는 양이 줄어듭니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai caber, mas por pouco. O streaming mantém menos dados neste dispositivo durante o processo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поместится, но впритык. В потоковом режиме на устройстве хранится меньше данных по ходу импорта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间勉强够用。流式导入会在过程中减少此设备上保留的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "空間勉強足夠。串流會在進行時減少此裝置上保留的內容。"
          }
        }
      }
    },
    "app.import.plan.streaming.enabled": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البث مُفعّل، لذا يُبقي Capsule كمية أقل على هذا الجهاز أثناء الاستيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming ist aktiviert, daher behält Capsule während des Imports weniger auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming is on, so Capsule keeps less on this device as the import runs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmisión continua está activada, así que Capsule guarda menos en este dispositivo mientras se importa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le streaming est activé : Capsule conserve moins de données sur cet appareil pendant l'importation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्ट्रीमिंग चालू है, इसलिए इंपोर्ट चलते समय Capsule इस डिवाइस पर कम डेटा रखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo streaming è attivo, quindi Capsule conserva meno dati su questo dispositivo durante l'importazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストリーミングがオンのため、読み込み中に Capsule がこのデバイスに保持するデータは少なくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스트리밍이 켜져 있어 가져오는 동안 Capsule이 이 기기에 보관하는 양을 줄입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O streaming está ativado, então o Capsule mantém menos dados neste dispositivo durante a importação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потоковый режим включён, поэтому Capsule хранит меньше данных на этом устройстве во время импорта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已开启流式导入，Capsule 会在导入过程中减少此设备上保留的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "串流已開啟，因此 Capsule 會在匯入進行時減少此裝置上保留的內容。"
          }
        }
      }
    },
