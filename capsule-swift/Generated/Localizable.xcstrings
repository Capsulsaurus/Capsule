    "app.settings.appearance.density.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضبط لكل جهاز، لذا يمكن أن يختلف Mac عن هاتفك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird pro Gerät festgelegt, sodass sich dein Mac und dein Telefon unterscheiden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set per device, so your Mac and your phone can differ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se configura en cada dispositivo, así que tu Mac y tu teléfono pueden ser distintos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglée par appareil : votre Mac et votre téléphone peuvent être différents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिवाइस के लिए अलग से सेट होता है, ताकि आपके Mac और फ़ोन पर अलग-अलग हो सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostata per dispositivo, così Mac e telefono possono essere diversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスごとに設定されるため、Mac とスマートフォンで異なる設定にできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기별로 설정되므로 Mac과 휴대폰을 다르게 설정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Definida por dispositivo, então seu Mac e seu celular podem ser diferentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаётся для каждого устройства, поэтому на Mac и телефоне настройка может различаться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按设备设置，因此您的 Mac 和手机可以不同。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依裝置個別設定，因此您的 Mac 和手機可以不同。"
          }
        }
      }
    },
