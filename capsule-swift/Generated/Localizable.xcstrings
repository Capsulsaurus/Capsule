    "app.quarantine.storage.preserved": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الاحتفاظ بالبيانات الأصلية، لذا لا يزال بإمكانك استعادة هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Originaldaten wurden aufbewahrt, du kannst sie also noch zurückbekommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original data was kept, so you can still get this back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardaron los datos originales, así que aún puedes recuperarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données d'origine ont été conservées, vous pouvez donc encore les récupérer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल डेटा रखा गया था, इसलिए आप इसे अब भी वापस पा सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati originali sono stati conservati, quindi puoi ancora recuperarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のデータが保管されているため、復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원본 데이터가 보관되어 있으므로 다시 되돌릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados originais foram guardados, então você ainda pode recuperar isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исходные данные сохранены, поэтому это ещё можно вернуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
