    "app.transfer.state.offline.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُستأنف عمليات النقل من حيث توقفت بمجرد عودتك إلى الاتصال. لن يضيع شيء في هذه الأثناء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragungen werden dort fortgesetzt, wo sie aufgehört haben, sobald du wieder online bist. In der Zwischenzeit geht nichts verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfers will pick up where they left off once you're back online. Nothing is lost in the meantime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las transferencias continuarán donde se quedaron cuando vuelvas a tener conexión. Mientras tanto, no se pierde nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les transferts reprendront là où ils s'étaient arrêtés dès que vous serez de nouveau en ligne. Rien n'est perdu entre-temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके फिर से ऑनलाइन होने पर ट्रांसफ़र वहीं से जारी रहेंगे जहाँ रुके थे। इस बीच कुछ भी नहीं खोएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I trasferimenti riprenderanno da dove si erano interrotti quando tornerai online. Nel frattempo non si perde nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンラインに戻ると、転送は中断したところから再開されます。その間に失われるものはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 온라인 상태가 되면 중단된 지점부터 전송이 이어집니다. 그동안 손실되는 것은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As transferências continuarão de onde pararam quando você voltar a ficar online. Nada é perdido enquanto isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передачи продолжатся с того же места, когда вы снова подключитесь к сети. Пока ничего не теряется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复联网后，传输将从中断处继续。在此期间不会丢失任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "恢復連線後，傳輸會從中斷處繼續。在此期間不會遺失任何內容。"
          }
        }
      }
    },
    "app.transfer.state.offline.inline": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير متصل — ستُستأنف عمليات النقل تلقائيًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline – Übertragungen werden automatisch fortgesetzt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline — transfers will resume on their own"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión: las transferencias se reanudarán solas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hors ligne : les transferts reprendront d'eux-mêmes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन — ट्रांसफ़र अपने आप फिर शुरू हो जाएँगे"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline: i trasferimenti riprenderanno automaticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン — 転送は自動的に再開されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 — 전송이 자동으로 재개됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
