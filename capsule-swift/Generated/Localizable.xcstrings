      }
    },
    "app.settings.keys.revoke.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يتمكن بعد الآن من قراءة أي شيء في حسابك أو تغييره. سيحتفظ بما نزّله بالفعل، وسيظل كل ما وقّعه قابلًا للتحقق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann auf deinem Konto nichts mehr lesen oder ändern. Was es bereits geladen hat, behält es, und alles, was es signiert hat, bleibt überprüfbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can no longer read or change anything on your account. It keeps whatever it already downloaded, and everything it signed stays verifiable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no podrá leer ni cambiar nada de tu cuenta. Conserva lo que ya haya descargado, y todo lo que firmó sigue siendo verificable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne pourra plus rien lire ni modifier sur votre compte. Il conserve ce qu'il a déjà téléchargé, et tout ce qu'il a signé reste vérifiable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अब आपके खाते पर कुछ भी पढ़ या बदल नहीं सकेगा। इसने जो कुछ पहले ही डाउनलोड कर लिया है, वह इसके पास रहेगा, और इसके द्वारा हस्ताक्षरित सब कुछ सत्यापन योग्य बना रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non potrà più leggere né modificare nulla sul tuo account. Conserva ciò che ha già scaricato e tutto ciò che ha firmato resta verificabile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスはアカウントの内容を読み取ったり変更したりできなくなります。すでにダウンロードしたものは残り、このデバイスが署名したものはすべて引き続き検証できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 더 이상 계정의 어떤 항목도 읽거나 변경할 수 없습니다. 이미 다운로드한 항목은 기기에 남아 있으며, 이 기기가 서명한 모든 항목은 계속 검증할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele não poderá mais ler nem alterar nada na sua conta. Ele mantém o que já baixou, e tudo o que assinou continua verificável."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство больше не сможет ничего читать или изменять в вашей учётной записи. Всё, что оно уже загрузило, останется на нём, а всё, что оно подписало, по-прежнему можно будет проверить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该设备将无法再读取或更改您账户上的任何内容。它已下载的内容仍会保留，它签名过的所有内容仍可验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它將無法再讀取或更改您帳號上的任何內容。它已下載的內容仍會保留，而它簽署過的所有內容仍可驗證。"
          }
        }
      }
    },
    "app.settings.keys.revoke.confirm.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبطال هذا الجهاز؟"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät widerrufen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke This Device?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Revocar este dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer cet appareil ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस को रद्द करें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Revocare questo dispositivo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを取り消しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 권한을 취소하겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar este dispositivo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозвать это устройство?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销此设备？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要撤銷此裝置嗎？"
          }
        }
      }
    },
    "app.settings.keys.rotation.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي إبطال جهاز إلى تغيير مفاتيح كل ألبوم كان بإمكانه الوصول إليه، فلا يمكنه قراءة أي شيء يُضاف بعد ذلك. تحصل أجهزتك الأخرى على المفاتيح الجديدة في المزامنة التالية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du ein Gerät widerrufst, ändern sich die Schlüssel aller Alben, auf die es zugreifen konnte, sodass es nichts mehr lesen kann, was danach hinzukommt. Deine anderen Geräte erhalten die neuen Schlüssel bei der nächsten Synchronisierung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoking a device changes the keys for every album it could reach, so it can't read anything added afterwards. Your other devices pick up the new keys on their next sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al revocar un dispositivo cambian las claves de todos los álbumes a los que tenía acceso, así que no podrá leer nada de lo que se añada después. Tus otros dispositivos reciben las nuevas claves en su próxima sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Révoquer un appareil change les clés de tous les albums auxquels il avait accès ; il ne peut donc rien lire de ce qui est ajouté ensuite. Vos autres appareils récupèrent les nouvelles clés à leur prochaine synchronisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी डिवाइस को रद्द करने से उन सभी एल्बम की कुंजियाँ बदल जाती हैं जिन तक वह पहुँच सकता था, इसलिए वह बाद में जोड़ी गई कोई भी चीज़ नहीं पढ़ सकता। आपके अन्य डिवाइस अपने अगले सिंक पर नई कुंजियाँ ले लेते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La revoca di un dispositivo cambia le chiavi di ogni album a cui poteva accedere, quindi non potrà leggere nulla di ciò che viene aggiunto in seguito. Gli altri tuoi dispositivi ricevono le nuove chiavi alla sincronizzazione successiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスを取り消すと、そのデバイスがアクセスできたすべてのアルバムの鍵が変更されるため、その後に追加されたものは読み取れなくなります。ほかのデバイスは次回の同期で新しい鍵を受け取ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 권한을 취소하면 해당 기기가 접근할 수 있던 모든 앨범의 키가 변경되므로, 이후에 추가된 항목은 읽을 수 없습니다. 다른 기기는 다음 동기화 때 새 키를 받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revogar um dispositivo troca as chaves de todos os álbuns que ele podia acessar, então ele não consegue ler nada adicionado depois. Seus outros dispositivos recebem as novas chaves na próxima sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отзыве устройства меняются ключи всех альбомов, к которым оно имело доступ, поэтому оно не сможет прочитать ничего, добавленного позже. Другие ваши устройства получат новые ключи при следующей синхронизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销设备会更换其可访问的每个相册的密钥，因此它无法读取之后添加的任何内容。您的其他设备会在下次同步时获取新密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "撤銷裝置會更換它可存取的每個相簿的金鑰，因此它無法讀取之後新增的任何內容。您的其他裝置會在下次同步時取得新金鑰。"
          }
        }
      }
    },
    "app.settings.keys.rotation.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يلزمك فعل شيء هنا — هكذا يعمل Capsule بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist nichts zu tun – so verhält sich Capsule bereits."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's nothing to do here — this is how Capsule already behaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes que hacer nada aquí: Capsule ya funciona así."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez rien à faire : Capsule fonctionne déjà ainsi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ आपको कुछ नहीं करना है — Capsule पहले से ही ऐसा ही करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non devi fare nulla: Capsule funziona già così."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで操作する必要はありません。Capsule はすでにこのように動作しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따로 할 일은 없습니다. Capsule은 이미 이렇게 동작합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nada a fazer aqui — o Capsule já funciona assim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего делать не нужно — Capsule уже так работает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处无需任何操作——Capsule 已默认如此运作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡不需要任何操作，Capsule 本來就是這樣運作的。"
          }
        }
      }
    },
