    "app.enrollment.stage.default_album.explanation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء الألبوم الذي تصل إليه عمليات الاستيراد، ليكون هناك مكان للصور منذ البداية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Album für deine Importe wird erstellt, damit Fotos von Anfang an einen Platz haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating the album your imports land in, so there's somewhere to put photos from the start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creando el álbum al que llegan tus importaciones, para que haya un lugar donde poner fotos desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Création de l'album qui reçoit vos importations, pour que vos photos aient une place dès le départ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह एल्बम बनाया जा रहा है जिसमें आपके इंपोर्ट आते हैं, ताकि शुरुआत से ही फ़ोटो रखने की जगह हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione dell'album in cui finiscono le importazioni, così le foto hanno una destinazione fin dall'inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んだ写真が入るアルバムを作成し、最初から写真の置き場所を用意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져온 항목이 저장될 앨범을 생성하여 처음부터 사진을 넣을 곳을 마련합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criando o álbum onde suas importações chegam, para que haja um lugar para as fotos desde o início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаётся альбом для импорта, чтобы фото с самого начала было куда помещать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在创建用于存放导入内容的相册，让照片从一开始就有处可放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在建立存放匯入內容的相簿，讓照片從一開始就有地方存放。"
          }
        }
      }
    },
