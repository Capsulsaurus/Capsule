    "app.restore.commit.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيكتب هذا التغييرات التي راجعتها للتو في مكتبتك. اكتب العبارة أدناه للتأكيد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die eben geprüften Änderungen in deine Mediathek geschrieben. Gib zur Bestätigung die Phrase unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This writes the changes you just reviewed into your library. Type the phrase below to confirm."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto escribe en tu fototeca los cambios que acabas de revisar. Escribe la frase siguiente para confirmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications que vous venez d'examiner vont être écrites dans votre photothèque. Saisissez la phrase ci-dessous pour confirmer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे वे परिवर्तन आपकी लाइब्रेरी में लिख दिए जाएँगे जिनकी आपने अभी समीक्षा की है। पुष्टि करने के लिए नीचे फ़्रेज़ टाइप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche appena esaminate verranno scritte nella tua libreria. Digita la frase qui sotto per confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認した変更をライブラリに書き込みます。確認のため、下にフレーズを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방금 검토한 변경 사항을 보관함에 기록합니다. 확인하려면 아래 문구를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto grava na sua biblioteca as alterações que você acabou de revisar. Digite a frase abaixo para confirmar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
