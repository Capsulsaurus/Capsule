        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जगह ख़ाली करके अपनी फ़ोटो, फ़ाइलों और अन्य चीज़ों के लिए जगह बनाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai spazio per foto, file e altro liberando spazio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不要な項目を整理して、写真やファイルなどのための空き容量を確保しましょう"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간을 정리하여 사진, 파일 등을 위한 여유 공간을 확보하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Libere espaço para suas fotos, arquivos e muito mais"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освободите место для фото, файлов и не только"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清理空间，为您的照片、文件等腾出位置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清理空間，為您的照片、檔案和更多內容騰出空間"
          }
        }
      }
