    "app.restore.shamir.invalidated_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استبدال هذا الجزء ولم يعد محتسبًا. اطلب ممن يحتفظ به إتلافه، وأعطه الجزء الحالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anteil wurde ersetzt und zählt nicht mehr. Bitte die Person, die ihn verwahrt, ihn zu vernichten, und gib ihr den aktuellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This share was replaced and no longer counts. Ask whoever holds it to destroy it, and give them the current one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta parte se sustituyó y ya no cuenta. Pide a quien la tenga que la destruya y dale la actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette part a été remplacée et ne compte plus. Demandez à la personne qui la détient de la détruire et remettez-lui la part actuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शेयर बदल दिया गया था और अब मान्य नहीं है। जिसके पास यह है, उससे इसे नष्ट करने को कहें और उसे मौजूदा शेयर दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa parte è stata sostituita e non conta più. Chiedi a chi la custodisce di distruggerla e dagli quella attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この分割片は置き換えられたため、無効になりました。保管している人に破棄してもらい、現在のものを渡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 조각은 교체되어 더 이상 유효하지 않습니다. 보관 중인 사람에게 파기를 요청하고 현재 조각을 전달하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta parte foi substituída e não vale mais. Peça a quem a guarda para destruí-la e entregue a parte atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта доля заменена и больше не учитывается. Попросите её владельца уничтожить её и передайте ему текущую."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此份额已被替换，不再有效。请让持有者销毁它，并将当前份额交给对方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此份額已被取代，不再有效。請保管者將其銷毀，並交給對方目前的份額。"
          }
        }
      }
    },
