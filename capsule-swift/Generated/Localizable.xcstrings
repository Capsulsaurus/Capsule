    "app.settings.advanced.scenario.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُختار السيناريو عند بدء التطبيق. وسيطة التشغيل -mock-scenario لها الأولوية على الاختيار المحدد هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Szenario wird beim Start der App gewählt. Ein Startargument -mock-scenario hat Vorrang vor der hier getroffenen Auswahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scenario is chosen when the app starts. A -mock-scenario launch argument takes precedence over the choice made here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El escenario se elige al iniciar la aplicación. Un argumento de inicio -mock-scenario tiene prioridad sobre lo que elijas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scénario est choisi au démarrage de l'app. Un argument de lancement -mock-scenario a priorité sur le choix effectué ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिदृश्य ऐप शुरू होने पर चुना जाता है। -mock-scenario लॉन्च आर्ग्युमेंट को यहाँ किए गए चुनाव पर प्राथमिकता मिलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo scenario viene scelto all'avvio dell'app. Un argomento di avvio -mock-scenario ha la precedenza sulla scelta fatta qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シナリオはアプリの起動時に選択されます。-mock-scenario 起動引数は、ここでの選択より優先されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시나리오는 앱이 시작될 때 선택됩니다. -mock-scenario 실행 인수가 여기에서 선택한 항목보다 우선합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O cenário é escolhido quando o app é iniciado. Um argumento de inicialização -mock-scenario tem prioridade sobre a escolha feita aqui."
          }
        },
        "ru": {
          "stringUnit": {
