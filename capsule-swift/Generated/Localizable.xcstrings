    },
    "error.upload.size_exceeded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الرفع بيانات أكثر مما أعلن عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload hat mehr Daten gesendet als angegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload sent more data than it declared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La subida envió más datos de los que declaró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléversement a envoyé plus de données qu'il n'en avait déclaré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड ने अपने घोषित आकार से अधिक डेटा भेजा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caricamento ha inviato più dati di quanti ne avesse dichiarati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードが宣言したサイズより多くのデータを送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드가 선언한 크기보다 많은 데이터를 보냈습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio enviou mais dados do que declarou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка отправила больше данных, чем было заявлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传发送的数据超过了其声明的大小。"
          }
