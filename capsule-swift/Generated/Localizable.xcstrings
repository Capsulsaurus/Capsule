          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は、この中で翻訳がある最初の言語を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 이 중 번역이 있는 첫 번째 언어를 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
