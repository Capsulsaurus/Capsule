    "app.settings.storage.evict.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعيد Capsule تنزيلها عند الحاجة إليها. لن يُزال أي شيء من الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule lädt sie erneut, wenn du sie brauchst. Von deinem Server wird nichts entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule downloads these again when you need them. Nothing is removed from your server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule las vuelve a descargar cuando las necesitas. No se elimina nada de tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule les téléchargera à nouveau quand vous en aurez besoin. Rien n'est supprimé de votre serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ज़रूरत पड़ने पर Capsule इन्हें फिर से डाउनलोड कर लेता है। आपके सर्वर से कुछ भी नहीं हटाया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule le scarica di nuovo quando ti servono. Nulla viene rimosso dal tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なときに Capsule が再度ダウンロードします。サーバーからは何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "필요할 때 Capsule이 다시 다운로드합니다. 서버에서는 아무것도 제거되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule baixa estes itens de novo quando você precisar. Nada é removido do seu servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule загрузит их снова, когда они понадобятся. С вашего сервера ничего не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 会在您需要时重新下载这些内容。不会从您的服务器上移除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會在您需要時再次下載這些內容。您伺服器上的內容不會被移除。"
          }
        }
      }
    },
