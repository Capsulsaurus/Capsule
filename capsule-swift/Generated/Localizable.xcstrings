    "app.recovery.verify.never_blocks": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمنع هذا التحقق أي شيء أبدًا. تستمر مكتبتك في العمل في كل الأحوال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Prüfung blockiert nie etwas. Deine Mediathek funktioniert so oder so weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This check never blocks anything. Your library keeps working either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta comprobación nunca bloquea nada. Tu fototeca sigue funcionando igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vérification ne bloque jamais rien. Votre photothèque continue de fonctionner dans tous les cas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह जाँच कभी कुछ नहीं रोकती। आपकी लाइब्रेरी हर हाल में काम करती रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo controllo non blocca mai nulla. La tua libreria continua a funzionare in ogni caso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この確認が何かを妨げることはありません。どちらの場合もライブラリは引き続き使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 확인은 어떤 작업도 막지 않습니다. 확인 여부와 관계없이 보관함은 계속 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta verificação nunca bloqueia nada. Sua biblioteca continua funcionando de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта проверка никогда ничего не блокирует. Медиатека работает в любом случае."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此检查绝不会阻止任何操作。无论如何，您的资料库都会正常工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此檢查絕不會阻擋任何事。無論如何，您的圖庫都會正常運作。"
          }
        }
      }
    },
    "app.recovery.verify.not_armed.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسترد هذا الحساب عبر الجهة الراعية له، لذا ليست له عبارة خاصة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Konto wird über seinen Sponsor wiederhergestellt und hat daher keine eigene Phrase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account recovers through whoever sponsors it, so it has no phrase of its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta se recupera a través de quien la patrocina, así que no tiene frase propia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte se récupère par l'intermédiaire de son parrain ; il n'a donc pas de phrase propre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह खाता अपने प्रायोजक के ज़रिए रिकवर होता है, इसलिए इसका अपना कोई फ़्रेज़ नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account viene recuperato tramite chi lo sponsorizza, quindi non ha una frase propria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントはスポンサーを通じて復旧するため、独自のフレーズはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정은 후원자를 통해 복구되므로 자체 문구가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta é recuperada por meio de quem a patrocina, então ela não tem uma frase própria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта учётная запись восстанавливается через спонсора, поэтому собственной фразы у неё нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户通过其担保人进行恢复，因此没有自己的短语。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號透過其贊助者進行復原，因此沒有自己的短語。"
          }
        }
      }
    },
