    "app.passkey.scope_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحلّ مفتاح المرور محل كلمة المرور عند تسجيل الدخول. لكنه لا يستطيع استرداد حسابك — وحدها عبارة الاسترداد تفعل ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Passkey ersetzt dein Passwort bei der Anmeldung. Er kann dein Konto nicht wiederherstellen – das kann nur deine Wiederherstellungsphrase."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A passkey replaces your password when you sign in. It can't recover your account — only your recovery phrase can do that."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una llave de acceso sustituye a tu contraseña al iniciar sesión. No puede recuperar tu cuenta: solo tu frase de recuperación puede hacerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé d'accès remplace votre mot de passe lors de la connexion. Elle ne permet pas de récupérer votre compte : seule votre phrase de récupération le peut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन इन करते समय पासकी आपके पासवर्ड की जगह लेती है। यह आपका खाता रिकवर नहीं कर सकती — ऐसा केवल आपका रिकवरी फ़्रेज़ कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una passkey sostituisce la password quando accedi. Non può recuperare il tuo account: solo la frase di ripristino può farlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーはサインイン時にパスワードの代わりになります。アカウントの復旧には使えません。復旧できるのはリカバリーフレーズだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패스키는 로그인할 때 비밀번호를 대신합니다. 패스키로는 계정을 복구할 수 없으며, 복구 문구만 계정을 복구할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma chave de acesso substitui sua senha ao iniciar sessão. Ela não recupera sua conta — só sua frase de recuperação faz isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ доступа заменяет пароль при входе. Он не может восстановить учётную запись — это может сделать только фраза восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通行密钥在登录时代替您的密码。它无法恢复您的账户，只有您的恢复短语可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通行密鑰可在登入時取代您的密碼，但無法用來復原您的帳號，只有復原短語才能做到。"
          }
        }
      }
    },
    "app.passkey.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول باستخدام Face ID أو Touch ID أو رمز دخول جهازك بدلًا من كلمة المرور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit Face ID, Touch ID oder dem Gerätecode statt mit einem Passwort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in with Face ID, Touch ID, or your device passcode instead of a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión con Face ID, Touch ID o el código de tu dispositivo en lugar de una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous avec Face ID, Touch ID ou le code de votre appareil au lieu d'un mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पासवर्ड के बजाय Face ID, Touch ID या अपने डिवाइस पासकोड से साइन इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi con Face ID, Touch ID o il codice del dispositivo invece che con una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードの代わりに Face ID、Touch ID、またはデバイスのパスコードでサインインします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호 대신 Face ID, Touch ID 또는 기기 암호로 로그인합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie sessão com Face ID, Touch ID ou o código do dispositivo em vez de uma senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Входите с помощью Face ID, Touch ID или код-пароля устройства вместо пароля."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID、Touch ID 或设备密码代替密码登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID、Touch ID 或裝置密碼登入，而不必輸入密碼。"
          }
        }
      }
    },
