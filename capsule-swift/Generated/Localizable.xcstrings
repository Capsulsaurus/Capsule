    "app.moderation.audit.none": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتخذ خادمك أي إجراء بشأن حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat keine Maßnahmen gegen dein Konto ergriffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server hasn't acted on your account."
          }
