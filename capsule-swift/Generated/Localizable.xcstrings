    "app.settings.sync.policy.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في كلتا الحالتين، تُحفظ النسخة الموجودة على هذا الجهاز حتى يؤكد الخادم أنه يحتفظ بالصورة بالحجم الكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In beiden Fällen bleibt die Kopie auf diesem Gerät erhalten, bis dein Server bestätigt, dass er das Foto in voller Größe hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way, the copy on this device is kept until your server confirms it holds the full-size photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier caso, la copia de este dispositivo se conserva hasta que tu servidor confirme que tiene la foto a tamaño completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les deux cas, la copie sur cet appareil est conservée jusqu'à ce que votre serveur confirme détenir la photo en taille réelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों ही स्थितियों में, इस डिवाइस की कॉपी तब तक रखी जाती है जब तक आपका सर्वर पुष्टि नहीं कर देता कि उसके पास पूर्ण-आकार फ़ोटो है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ogni caso, la copia su questo dispositivo viene conservata finché il server non conferma di avere la foto a dimensione piena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの場合も、フルサイズの写真がサーバーに保存されたことが確認されるまで、このデバイス上のコピーは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 쪽이든, 서버가 원본 크기 사진을 보관하고 있음을 확인할 때까지 이 기기의 사본은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer forma, a cópia neste dispositivo é mantida até seu servidor confirmar que tem a foto em tamanho original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом случае копия на этом устройстве сохраняется, пока сервер не подтвердит, что получил полноразмерное фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论哪种方式，此设备上的副本都会保留，直到您的服务器确认已存有全尺寸照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論哪種方式，此裝置上的副本都會保留，直到您的伺服器確認已保存原尺寸照片為止。"
          }
        }
      }
    },
