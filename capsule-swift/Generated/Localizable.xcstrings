    "app.settings.keys.devices.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى الأجهزة الملغاة مدرجة. يُحتفظ بمفاتيحها حتى يظل بالإمكان التحقق من كل ما وقّعته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Widerrufene Geräte bleiben aufgeführt. Ihre Schlüssel werden aufbewahrt, damit alles, was sie je signiert haben, weiterhin geprüft werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoked devices stay listed. Their keys are kept so everything they ever signed can still be checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos revocados siguen en la lista. Sus claves se conservan para que todo lo que firmaron se pueda seguir verificando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils révoqués restent dans la liste. Leurs clés sont conservées afin que tout ce qu'ils ont signé puisse toujours être vérifié."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रद्द किए गए डिवाइस सूची में बने रहते हैं। उनकी कुंजियाँ रखी जाती हैं ताकि उनके द्वारा कभी भी हस्ताक्षरित हर चीज़ की अब भी जाँच की जा सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dispositivi revocati restano nell'elenco. Le loro chiavi vengono conservate per poter verificare tutto ciò che hanno firmato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消したデバイスも一覧に残ります。それらが署名したものをすべて検証できるよう、キーが保持されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "취소된 기기는 목록에 계속 표시됩니다. 해당 기기가 서명한 모든 항목을 계속 확인할 수 있도록 키가 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dispositivos revogados continuam listados. As chaves deles são mantidas para que tudo o que já assinaram ainda possa ser verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отозванные устройства остаются в списке. Их ключи сохраняются, чтобы всё, что они когда-либо подписали, можно было проверить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤销的设备仍会列出。其密钥会被保留，以便仍能验证它们签署过的所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已撤銷的裝置仍會列出。其金鑰會被保留，以便仍能驗證這些裝置曾經簽署的所有內容。"
          }
        }
      }
    },
