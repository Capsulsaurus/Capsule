    "error.auth.oidc_at_capacity": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك عمليات تسجيل دخول كثيرة جدًا قيد التنفيذ. يُرجى المحاولة مرة أخرى بعد لحظة."
          }
