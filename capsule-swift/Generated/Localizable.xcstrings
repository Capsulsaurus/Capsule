          }
        }
      }
    },
    "app.settings.recovery.escrow.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارة الاسترداد هي الطريقة الوحيدة لاستعادة الوصول إذا فقدت جميع أجهزتك. لا يمكن لأحد، بما في ذلك الخادم، استرداد مكتبتك بدونها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiederherstellungsphrase ist der einzige Weg zurück, wenn du alle Geräte verlierst. Ohne sie kann niemand, auch nicht dein Server, deine Mediathek wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery phrase is the only way back in if you lose every device. Nobody, including your server, can recover your library without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frase de recuperación es la única forma de volver a entrar si pierdes todos tus dispositivos. Nadie, ni siquiera tu servidor, puede recuperar tu biblioteca sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre phrase de récupération est le seul moyen de retrouver l'accès si vous perdez tous vos appareils. Personne, pas même votre serveur, ne peut récupérer votre bibliothèque sans elle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आपके सभी डिवाइस खो जाएँ, तो आपका रिकवरी फ़्रेज़ ही वापस आने का एकमात्र तरीका है। इसके बिना कोई भी, आपका सर्वर भी, आपकी लाइब्रेरी रिकवर नहीं कर सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase di recupero è l'unico modo per rientrare se perdi tutti i dispositivi. Nessuno, nemmeno il tuo server, può recuperare la tua libreria senza di essa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスを失った場合、リカバリーフレーズが唯一の復旧手段です。サーバーを含め、誰もこれなしではライブラリを復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기를 잃어버렸을 때 다시 접근할 수 있는 유일한 방법은 복구 문구입니다. 서버를 포함해 누구도 복구 문구 없이는 라이브러리를 복구할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frase de recuperação é a única forma de voltar se você perder todos os dispositivos. Ninguém, nem mesmo seu servidor, consegue recuperar sua biblioteca sem ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фраза восстановления — единственный способ вернуть доступ, если вы потеряете все устройства. Без неё никто, включая ваш сервер, не сможет восстановить медиатеку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您丢失了所有设备，恢复短语是唯一的找回途径。没有它，任何人（包括您的服务器）都无法恢复您的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您遺失所有裝置，復原詞組是唯一的重新存取方式。沒有它，任何人（包括您的伺服器）都無法復原您的圖庫。"
          }
        }
      }
    },
