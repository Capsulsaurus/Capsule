    "app.settings.keys.cohorts.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعادة تثبيت Capsule تسجّل مفاتيح جديدة، لذا قد يظهر جهاز واحد أكثر من مرة. يجمع Capsule هذه الإدخالات معًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei einer Neuinstallation von Capsule werden neue Schlüssel registriert, daher kann ein Gerät mehrfach erscheinen. Capsule fasst diese Einträge zusammen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalling Capsule enrolls new keys, so one device can appear more than once. Capsule groups those entries together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al reinstalar Capsule se registran claves nuevas, así que un mismo dispositivo puede aparecer más de una vez. Capsule agrupa esas entradas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinstaller Capsule génère de nouvelles clés : un même appareil peut donc apparaître plusieurs fois. Capsule regroupe ces entrées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule को फिर से इंस्टॉल करने पर नई कुंजियाँ पंजीकृत होती हैं, इसलिए एक डिवाइस एक से अधिक बार दिख सकता है। Capsule उन प्रविष्टियों को एक साथ समूहित करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstallando Capsule vengono registrate nuove chiavi, quindi un dispositivo può comparire più volte. Capsule raggruppa queste voci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule を再インストールすると新しいキーが登録されるため、1台のデバイスが複数回表示されることがあります。Capsule はそれらをまとめて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule을 다시 설치하면 새 키가 등록되므로 하나의 기기가 여러 번 표시될 수 있습니다. Capsule은 이러한 항목을 하나로 묶습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstalar o Capsule registra novas chaves, então um mesmo dispositivo pode aparecer mais de uma vez. O Capsule agrupa essas entradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При переустановке Capsule регистрирует новые ключи, поэтому одно устройство может появиться несколько раз. Capsule объединяет такие записи в группы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安装 Capsule 会注册新密钥，因此同一台设备可能会出现多次。Capsule 会将这些条目归为一组。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重新安裝 Capsule 會註冊新的金鑰，因此同一台裝置可能出現不只一次。Capsule 會將這些項目歸為一組。"
          }
        }
      }
    },
