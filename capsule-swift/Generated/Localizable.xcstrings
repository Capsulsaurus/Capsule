    "app.sync.scope.originals.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ بنسخة بالحجم الكامل من كل صورة على هذا الجهاز. يستخدم أكبر مساحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Behält eine Kopie jedes Fotos in voller Größe auf diesem Gerät. Belegt am meisten Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a full-size copy of every photo on this device. Uses the most space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una copia a tamaño completo de cada foto en este dispositivo. Usa el máximo de espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve une copie en taille réelle de chaque photo sur cet appareil. Utilise le plus d'espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर हर फ़ोटो की पूर्ण-आकार कॉपी रखता है। सबसे अधिक जगह लेता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva una copia a dimensione piena di ogni foto su questo dispositivo. Usa più spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての写真のフルサイズのコピーをこのデバイスに保持します。使用する容量が最も多くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 사진의 원본 크기 사본을 이 기기에 보관합니다. 공간을 가장 많이 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantém uma cópia em tamanho original de cada foto neste dispositivo. Usa o máximo de espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранит полноразмерную копию каждого фото на этом устройстве. Занимает больше всего места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设备上保留每张照片的全尺寸副本。占用空间最多。"
