            "value": "रिकवरी फ़्रेज़ जाँच"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica frase di recupero"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズの確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 문구 확인"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificação da frase de recuperação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка фразы восстановления"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复短语检查"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原詞組檢查"
          }
        }
      }
    },
    "app.settings.notifications.category.staleness": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الجهاز متأخر في المزامنة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hängt hinterher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Device Falling Behind"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo se está quedando atrás"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil prend du retard"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस पीछे छूट रहा है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo è indietro"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの同期の遅れ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 동기화 지연"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo está ficando para trás"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устройство отстаёт"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备同步落后"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置進度落後"
          }
        }
      }
    },
    "app.settings.notifications.detail.quarantine": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر عندما يحتجز Capsule شيئًا لتراجعه. لا يمكن إيقافه — لا يُطبَّق أي شيء أو يُتجاهل دون موافقتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angezeigt, wenn Capsule etwas zurückhält, das du dir ansehen solltest. Lässt sich nicht deaktivieren – ohne dich wird nichts übernommen oder verworfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised when Capsule holds something back for you to look at. This can't be switched off — nothing is applied or discarded without you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra cuando Capsule retiene algo para que lo revises. No se puede desactivar: nada se aplica ni se descarta sin ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyée lorsque Capsule met quelque chose de côté pour que vous l'examiniez. Elle ne peut pas être désactivée : rien n'est appliqué ni écarté sans vous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब भेजा जाता है जब Capsule आपके देखने के लिए कुछ रोककर रखता है। इसे बंद नहीं किया जा सकता — आपके बिना कुछ भी लागू या ख़ारिज नहीं किया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviata quando Capsule trattiene qualcosa perché tu lo controlli. Non può essere disattivata: nulla viene applicato o scartato senza di te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule が確認のために項目を保留したときに通知されます。この通知はオフにできません。あなたの判断なしに適用や破棄が行われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 검토를 위해 항목을 보류할 때 알립니다. 사용자의 결정 없이는 아무것도 적용되거나 폐기되지 않으므로 이 알림은 끌 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado quando o Capsule retém algo para você analisar. Não pode ser desativado — nada é aplicado ou descartado sem você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется, когда Capsule откладывает что-то для вашей проверки. Это уведомление нельзя отключить — ничего не применяется и не удаляется без вас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 Capsule 暂扣某些内容等待您查看时发出。此提醒无法关闭——未经您同意，任何内容都不会被应用或丢弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當 Capsule 保留某些項目等待您查看時發出。此通知無法關閉，因為未經您同意，不會套用或捨棄任何內容。"
          }
        }
      }
    },
    "app.settings.notifications.detail.quota": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر عندما يتوقف الخادم عن قبول عمليات الرفع. لا يمكن إيقافه — فشل الرفع بصمت أسوأ من إعلامك به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angezeigt, wenn dein Server keine Uploads mehr annimmt. Lässt sich nicht deaktivieren – unbemerkt fehlschlagende Uploads sind schlimmer als ein Hinweis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised when your server stops accepting uploads. This can't be switched off — uploads failing quietly is worse than being told."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra cuando tu servidor deja de aceptar subidas. No se puede desactivar: es peor que las subidas fallen en silencio que recibir un aviso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyée lorsque votre serveur n'accepte plus de téléversements. Elle ne peut pas être désactivée : des téléversements qui échouent en silence, c'est pire qu'être prévenu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब भेजा जाता है जब आपका सर्वर अपलोड स्वीकार करना बंद कर देता है। इसे बंद नहीं किया जा सकता — चुपचाप विफल होते अपलोड, बताए जाने से बदतर हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviata quando il tuo server smette di accettare caricamenti. Non può essere disattivata: caricamenti che falliscono in silenzio sono peggio di un avviso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがアップロードを受け付けなくなったときに通知されます。この通知はオフにできません。アップロードが知らないうちに失敗するより、知らされるほうが安全です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 업로드를 더 이상 받지 않을 때 알립니다. 업로드가 조용히 실패하는 것보다 알림을 받는 편이 낫기 때문에 이 알림은 끌 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado quando seu servidor para de aceitar envios. Não pode ser desativado — envios falhando em silêncio é pior do que ser avisado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется, когда сервер перестаёт принимать загрузки. Это уведомление нельзя отключить — незаметные сбои загрузки хуже, чем предупреждение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您的服务器停止接受上传时发出。此提醒无法关闭——上传悄无声息地失败比收到通知更糟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您的伺服器停止接受上傳時發出。此通知無法關閉，因為上傳默默失敗比收到通知更糟。"
          }
        }
      }
    },
    "app.settings.notifications.detail.recovery": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر عندما يمر وقت طويل منذ آخر فحص لعبارة الاسترداد. لا يمكن إيقافه — العبارة التي لم يفحصها أحد قد تكتشف مشكلتها في أسوأ لحظة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angezeigt, wenn deine Wiederherstellungsphrase länger nicht geprüft wurde. Lässt sich nicht deaktivieren – eine ungeprüfte Phrase fällt dir sonst im ungünstigsten Moment auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised when it's been a while since your recovery phrase was checked. This can't be switched off — a phrase nobody has checked is one you find out about at the worst moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra cuando hace tiempo que no se comprueba tu frase de recuperación. No se puede desactivar: si nadie ha comprobado una frase, descubrirás que falla en el peor momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyée lorsque votre phrase de récupération n'a pas été vérifiée depuis un moment. Elle ne peut pas être désactivée : une phrase jamais vérifiée, on découvre son problème au pire moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब भेजा जाता है जब आपके रिकवरी फ़्रेज़ की जाँच हुए काफ़ी समय हो गया हो। इसे बंद नहीं किया जा सकता — जिस फ़्रेज़ की किसी ने जाँच नहीं की, उसकी कमी सबसे बुरे समय पर पता चलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviata quando è passato un po' di tempo dall'ultima verifica della frase di recupero. Non può essere disattivata: una frase mai verificata è una che scopri non funzionare nel momento peggiore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズを最後に確認してからしばらく経ったときに通知されます。この通知はオフにできません。誰も確認していないフレーズは、最悪のタイミングで問題が発覚するものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 문구를 확인한 지 오래되었을 때 알립니다. 아무도 확인하지 않은 문구는 가장 곤란한 순간에 문제가 드러나기 때문에 이 알림은 끌 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado quando faz tempo que sua frase de recuperação não é verificada. Não pode ser desativado — uma frase que ninguém verificou é aquela que dá problema no pior momento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется, когда фразу восстановления давно не проверяли. Это уведомление нельзя отключить — о проблеме с непроверенной фразой обычно узнают в самый неподходящий момент."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您的恢复短语已有一段时间未检查时发出。此提醒无法关闭——从未检查过的短语，往往会在最糟糕的时候才发现问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當您的復原詞組已有一段時間未檢查時發出。此通知無法關閉，因為從未檢查過的詞組，往往會在最糟的時刻才發現有問題。"
          }
        }
      }
    },
    "app.settings.notifications.detail.staleness": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر بعد أسبوعين تقريبًا دون مزامنة مكتملة مع وجود تغييرات لم تُرسل بعد. إيقافه يوقف التحذير فقط — تستمر المزامنة كالمعتاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird angezeigt, wenn ein paar Wochen lang keine Synchronisierung abgeschlossen wurde und noch Änderungen ausstehen. Deaktivieren stoppt nur die Warnung – die Synchronisierung läuft wie gewohnt weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised after a couple of weeks without a completed sync while changes are still outstanding. Turning it off stops the warning only — syncing carries on as usual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra tras un par de semanas sin completar una sincronización mientras haya cambios pendientes. Desactivarla solo detiene el aviso: la sincronización continúa como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyée après quelques semaines sans synchronisation terminée alors que des modifications sont en attente. La désactiver supprime seulement l'avertissement : la synchronisation continue normalement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलाव बाकी रहते हुए लगभग दो सप्ताह तक कोई सिंक पूरा न होने पर भेजा जाता है। इसे बंद करने से केवल चेतावनी बंद होती है — सिंक सामान्य रूप से जारी रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviata dopo un paio di settimane senza una sincronizzazione completata mentre ci sono ancora modifiche in sospeso. Disattivarla interrompe solo l'avviso: la sincronizzazione continua come sempre."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信の変更があるまま、同期が2週間ほど完了していないときに通知されます。オフにすると警告が止まるだけで、同期は通常どおり続きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 변경 사항이 남아 있는데 2주 정도 동기화가 완료되지 않으면 알립니다. 끄면 경고만 표시되지 않으며, 동기화는 평소대로 계속됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado após algumas semanas sem uma sincronização concluída enquanto ainda há alterações pendentes. Desativá-lo só interrompe o aviso — a sincronização continua normalmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Появляется, если пару недель не было завершённой синхронизации, а изменения ещё ожидают отправки. Отключение убирает только предупреждение — синхронизация продолжается как обычно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当约两周未完成同步且仍有未同步的更改时发出。关闭后只会停止此警告——同步仍照常进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在仍有未完成變更的情況下，超過約兩週沒有完成同步時發出。關閉此通知只會停止警告，同步仍會照常進行。"
          }
        }
      }
    },
    "app.settings.recovery.escrow.configured": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الإعداد"
          }
        },
        "de": {
