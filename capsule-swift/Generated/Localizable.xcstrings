    "app.enrollment.complete.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إنشاء مفاتيحك ويمكن لهذا الجهاز الوصول إلى مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Schlüssel sind erstellt und dieses Gerät kann auf deine Mediathek zugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your keys are made and this device can reach your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus claves están creadas y este dispositivo puede acceder a tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos clés sont créées et cet appareil peut accéder à votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुंजियाँ बन गई हैं और यह डिवाइस आपकी लाइब्रेरी तक पहुँच सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue chiavi sono state create e questo dispositivo può accedere alla tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鍵が作成され、このデバイスからライブラリにアクセスできるようになりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 생성되었으며 이 기기에서 라이브러리에 접근할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas chaves foram criadas e este dispositivo pode acessar sua biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши ключи созданы, и это устройство имеет доступ к вашей медиатеке."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的密钥已生成，此设备现在可以访问您的资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的密鑰已建立，此裝置現在可以存取你的圖庫。"
          }
        }
      }
    },
