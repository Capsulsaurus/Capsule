    "app.auth.common.offline.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك مواصلة استخدام Capsule على هذا الجهاز. ستكتمل هذه الخطوة عندما يصبح الخادم متاحًا مجددًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst Capsule auf diesem Gerät weiter verwenden. Dieser Schritt wird abgeschlossen, sobald der Server wieder erreichbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can keep using Capsule on this device. This step will finish once the server is reachable again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes seguir usando Capsule en este dispositivo. Este paso terminará cuando el servidor vuelva a estar accesible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez continuer à utiliser Capsule sur cet appareil. Cette étape se terminera dès que le serveur sera de nouveau joignable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस डिवाइस पर Capsule का उपयोग जारी रख सकते हैं। सर्वर फिर से उपलब्ध होने पर यह चरण पूरा हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi continuare a usare Capsule su questo dispositivo. Questo passaggio verrà completato quando il server sarà di nuovo raggiungibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは引き続き Capsule を使用できます。サーバーに再び接続できるようになると、この手順は完了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 Capsule을 계속 사용할 수 있습니다. 서버에 다시 연결되면 이 단계가 완료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode continuar usando o Capsule neste dispositivo. Esta etapa será concluída quando o servidor estiver acessível novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете продолжать пользоваться Capsule на этом устройстве. Этот шаг завершится, когда сервер снова станет доступен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以继续在此设备上使用 Capsule。服务器恢复连接后，此步骤将自动完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以繼續在此裝置上使用 Capsule。伺服器恢復連線後，此步驟就會完成。"
          }
        }
      }
    },
