          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更は、この項目の古いバージョンに基づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경은 항목의 오래된 버전을 기반으로 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração se baseia em uma versão desatualizada do item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это изменение основано на устаревшей версии элемента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改基于该项目的过时版本。"
          }
