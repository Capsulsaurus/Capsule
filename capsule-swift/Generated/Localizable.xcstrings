    "app.timeline.permission.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح إذن الوصول إلى الصور لرؤية مكتبتك، أو استورد الصور مباشرة إلى Capsule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Zugriff auf Fotos, um deine Mediathek zu sehen, oder importiere Fotos direkt in Capsule."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant photo access to see your library, or import photos directly into Capsule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso a las fotos para ver tu fototeca, o importa fotos directamente en Capsule."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l'accès aux photos pour voir votre photothèque, ou importez des photos directement dans Capsule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी लाइब्रेरी देखने के लिए फ़ोटो की पहुँच दें, या फ़ोटो सीधे Capsule में इंपोर्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi l'accesso alle foto per vedere la tua libreria, oppure importa le foto direttamente in Capsule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリを表示するには写真へのアクセスを許可するか、Capsule に写真を直接読み込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리를 보려면 사진 접근 권한을 허용하거나, 사진을 Capsule로 직접 가져오십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso às fotos para ver sua fototeca ou importe fotos diretamente para o Capsule."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите доступ к фото, чтобы видеть медиатеку, или импортируйте фото прямо в Capsule."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授予照片访问权限以查看您的图库，或将照片直接导入 Capsule。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請允許取用照片以查看您的圖庫，或直接將照片匯入 Capsule。"
          }
        }
      }
    },
