    "app.export.retain.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للتصديرات التي تحتفظ بها لنفسك فقط. أي شيء تشاركه بعد ذلك يحمل هذه التفاصيل معه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur für Exporte, die du selbst behältst. Alles, was du danach teilst, enthält diese Angaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only for exports you're keeping yourself. Anything you then share carries these details with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo para exportaciones que vayas a guardar tú. Todo lo que compartas después llevará estos datos consigo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour les exports que vous gardez pour vous. Tout ce que vous partagez ensuite emporte ces informations."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल उन एक्सपोर्ट के लिए जिन्हें आप ख़ुद रख रहे हैं। आप जो भी शेयर करेंगे, उसके साथ ये विवरण भी जाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per le esportazioni che tieni per te. Tutto ciò che condividi in seguito porterà con sé questi dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分で保管する書き出しの場合のみ使用してください。その後共有したものには、これらの詳細が含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 보관할 내보내기에만 사용하세요. 이후 공유하는 항목에는 이 정보가 함께 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente para exportações que você vai guardar. Tudo o que você compartilhar depois leva estes detalhes junto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только для экспорта, который вы оставляете себе. Всё, чем вы затем поделитесь, будет содержать эти данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于您自己保留的导出内容。之后您分享的任何内容都会带有这些信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於你自己保存的輸出內容。之後分享的任何內容都會帶有這些資訊。"
          }
        }
      }
    },
