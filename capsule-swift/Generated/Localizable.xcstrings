        }
      }
    },
    "error.enrollment.relay_malformed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة طلب إضافة الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
