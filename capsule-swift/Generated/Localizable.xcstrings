    "app.enrollment.deferred.default_album": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم إنشاء ألبوم مكتبتك قبل أول عملية استيراد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mediathek-Album wird vor deinem ersten Import erstellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your library album will be created before your first import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El álbum de tu biblioteca se creará antes de tu primera importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'album de votre bibliothèque sera créé avant votre première importation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका लाइब्रेरी एल्बम आपके पहले इंपोर्ट से पहले बनाया जाएगा।"
