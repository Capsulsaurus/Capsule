          }
        }
      }
    },
    "app.settings.ai.provenance.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يستنتجه Capsule عن صورة يُحفظ منفصلًا عمّا كتبته بنفسك، ويُوسَم باسم النموذج الذي أنتجه. إزالة نموذج أو إعادة تحليل لا تمسّ تعديلاتك أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was Capsule über ein Foto ermittelt, wird getrennt von dem aufbewahrt, was du selbst geschrieben hast, und mit dem Modell gekennzeichnet, das es erzeugt hat. Das Entfernen eines Modells oder eine erneute Analyse berührt nie deine eigenen Bearbeitungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything Capsule works out about a photo is kept separately from what you wrote yourself, and labelled with the model that produced it. Removing a model or redoing an analysis never touches your own edits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que Capsule deduce sobre una foto se guarda aparte de lo que escribiste tú, y se etiqueta con el modelo que lo generó. Quitar un modelo o rehacer un análisis nunca afecta a tus propias ediciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que Capsule déduit d'une photo est conservé séparément de ce que vous avez écrit vous-même, et étiqueté avec le modèle qui l'a produit. Supprimer un modèle ou refaire une analyse ne touche jamais à vos propres modifications."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule किसी फ़ोटो के बारे में जो कुछ भी पता लगाता है, उसे आपके द्वारा ख़ुद लिखी गई चीज़ों से अलग रखा जाता है, और उस मॉडल के नाम से चिह्नित किया जाता है जिसने उसे बनाया। किसी मॉडल को हटाने या विश्लेषण दोबारा करने से आपके अपने संपादन कभी नहीं बदलते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che Capsule ricava da una foto viene conservato separatamente da ciò che hai scritto tu ed etichettato con il modello che l'ha prodotto. Rimuovere un modello o ripetere un'analisi non tocca mai le tue modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule が写真から読み取った情報は、あなた自身が書いた内容とは別に保管され、生成したモデル名が付けられます。モデルを削除したり分析をやり直したりしても、あなたの編集内容には影響しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 사진에 대해 알아낸 정보는 사용자가 직접 작성한 내용과 별도로 보관되며, 이를 생성한 모델이 표시됩니다. 모델을 제거하거나 분석을 다시 실행해도 사용자의 편집 내용은 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que o Capsule deduz sobre uma foto é guardado separadamente do que você mesmo escreveu, e identificado com o modelo que o produziu. Remover um modelo ou refazer uma análise nunca altera suas próprias edições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что Capsule определяет о фото, хранится отдельно от того, что вы написали сами, и помечается моделью, которая это получила. Удаление модели или повторный анализ никогда не затрагивают ваши собственные правки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 对照片得出的任何结果都与您自己编写的内容分开保存，并标注生成它的模型。移除模型或重新分析绝不会影响您自己的编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 對照片得出的任何結果，都會與您自己撰寫的內容分開保存，並標示產生該結果的模型。移除模型或重新分析絕不會影響您自己的編輯。"
          }
        }
      }
    },
    "app.settings.ai.provenance.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يغيّر أي شيء في هذه الشاشة تعليقاتك ووسومك الخاصة أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine eigenen Bildunterschriften und Tags werden durch nichts auf diesem Bildschirm verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own captions and tags are never changed by anything on this screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada de esta pantalla cambia nunca tus propios pies de foto ni tus etiquetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos propres légendes et tags ne sont jamais modifiés par quoi que ce soit sur cet écran."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्क्रीन की कोई भी चीज़ आपके अपने कैप्शन और टैग कभी नहीं बदलती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue didascalie e i tuoi tag non vengono mai modificati da nulla in questa schermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面の操作で、あなたのキャプションやタグが変更されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면의 어떤 설정도 사용자가 직접 작성한 캡션과 태그를 변경하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas próprias legendas e tags nunca são alteradas por nada nesta tela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничто на этом экране не изменяет ваши собственные подписи и теги."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此屏幕上的任何操作都不会更改您自己的说明和标签。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此畫面上的任何項目都絕不會變更您自己的說明和標籤。"
          }
        }
      }
    },
