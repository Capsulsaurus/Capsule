    "app.export.strip.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التصدير يُخرج الصور من Capsule، لذا تُزال التفاصيل المُعرِّفة افتراضيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Exportieren verlassen Fotos Capsule, daher werden identifizierende Angaben standardmäßig entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporting takes photos outside Capsule, so identifying details are removed by default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al exportar, las fotos salen de Capsule, así que los datos identificativos se eliminan de forma predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'exportation fait sortir les photos de Capsule : les informations d'identification sont donc supprimées par défaut."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सपोर्ट करने से फ़ोटो Capsule से बाहर जाती हैं, इसलिए पहचान संबंधी विवरण डिफ़ॉल्ट रूप से हटा दिए जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'esportazione porta le foto fuori da Capsule, quindi i dettagli identificativi vengono rimossi per impostazione predefinita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出すと写真が Capsule の外に出るため、識別情報はデフォルトで削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내보내기를 하면 사진이 Capsule 밖으로 나가므로 식별 정보는 기본적으로 제거됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A exportação leva as fotos para fora do Capsule, então os detalhes de identificação são removidos por padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При экспорте фото покидают Capsule, поэтому идентифицирующие данные по умолчанию удаляются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导出会将照片带出 Capsule，因此默认会移除身份识别信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸出會將照片帶離 Capsule，因此預設會移除識別資訊。"
          }
        }
      }
    },
