        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास इस एल्बम में फ़ोटो जोड़ने की अनुमति नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai il permesso di aggiungere foto a questo album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムに写真を追加する権限がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앨범에 사진을 추가할 권한이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não tem permissão para adicionar fotos a este álbum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас нет разрешения добавлять фото в этот альбом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
