          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 보안 저장소가 거부했습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento seguro deste dispositivo recusou"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Защищённое хранилище устройства отказало"
          }
