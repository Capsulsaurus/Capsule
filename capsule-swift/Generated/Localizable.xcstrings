          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos apagadas continuam contando até serem eliminadas de vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые фото продолжают учитываться, пока не будут окончательно удалены."
