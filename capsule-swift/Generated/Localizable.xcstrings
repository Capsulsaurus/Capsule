    "app.quarantine.surface.album_upgrade.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا التغيير بانتظار ترقية ألبومه. سيُطبَّق بمجرد اكتمال ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung wartet darauf, dass ihr Album aktualisiert wird. Sie wird angewendet, sobald das erledigt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change is waiting for its album to be upgraded. It'll be applied once that's done."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cambio está esperando a que se actualice su álbum. Se aplicará cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification attend la mise à niveau de son album. Elle sera appliquée une fois celle-ci effectuée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह परिवर्तन अपने एल्बम के अपग्रेड होने की प्रतीक्षा कर रहा है। ऐसा होते ही इसे लागू कर दिया जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa modifica attende l'aggiornamento del suo album. Verrà applicata non appena sarà completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更はアルバムのアップグレードを待っています。アップグレードが完了すると適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경은 앨범이 업그레이드되기를 기다리고 있습니다. 업그레이드가 완료되면 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração está aguardando a atualização do álbum. Ela será aplicada assim que isso for feito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это изменение ожидает обновления альбома. Оно будет применено, как только обновление завершится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改正在等待其相册升级，升级完成后即会应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此變更正在等候其相簿升級，升級完成後就會套用。"
          }
        }
      }
    },
    "app.quarantine.surface.federation": {
      "localizations": {
