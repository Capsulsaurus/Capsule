    "app.share.scope.no_analytics": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سترى أن الرابط استُخدم، لا من استخدمه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst, dass der Link verwendet wurde, aber nicht, von wem."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll see that the link was used, not who used it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verás que se usó el enlace, pero no quién lo usó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous saurez que le lien a été utilisé, mais pas par qui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको दिखेगा कि लिंक का उपयोग हुआ, यह नहीं कि किसने किया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vedrai che il link è stato usato, non chi lo ha usato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクが使用されたことはわかりますが、誰が使用したかはわかりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 사용되었는지는 알 수 있지만, 누가 사용했는지는 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você verá que o link foi usado, mas não quem o usou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы увидите, что ссылкой воспользовались, но не кто именно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您会看到链接被使用过，但不会看到是谁使用的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您會看到連結已被使用，但不會知道是誰使用。"
          }
        }
      }
    },
    "app.share.scope.read_only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمستلمين المشاهدة دون تغيير أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Empfänger können ansehen, aber nichts ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipients can look, not change anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los destinatarios pueden ver, pero no cambiar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les destinataires peuvent regarder, mais rien modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्तकर्ता देख सकते हैं, कुछ बदल नहीं सकते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I destinatari possono guardare, non modificare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信者は閲覧のみ可能で、変更はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받는 사람은 보기만 할 수 있으며 아무것도 변경할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os destinatários podem ver, mas não alterar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получатели могут смотреть, но ничего не могут изменить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接收者只能查看，无法更改任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收件者只能查看，無法更改任何內容。"
          }
        }
      }
    },
