    "app.sync.scope.metadata_only.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تصفح مكتبتك بالكامل، مع عنصر نائب صغير لكل صورة. يستخدم أقل مساحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine gesamte Mediathek ist durchsuchbar, mit einem kleinen Platzhalter für jedes Foto. Belegt am wenigsten Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your whole library is browsable, with a small placeholder for each photo. Uses the least space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes explorar toda tu biblioteca, con un pequeño marcador para cada foto. Usa el mínimo de espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute votre bibliothèque est consultable, avec une petite image de substitution pour chaque photo. Utilise le moins d'espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पूरी लाइब्रेरी ब्राउज़ की जा सकती है, हर फ़ोटो के लिए एक छोटे प्लेसहोल्डर के साथ। सबसे कम जगह लेता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi sfogliare l'intera libreria, con un piccolo segnaposto per ogni foto. Usa meno spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各写真の小さなプレースホルダとともに、ライブラリ全体を閲覧できます。使用する容量が最も少なくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 사진에 작은 자리 표시자가 표시되며 전체 라이브러리를 둘러볼 수 있습니다. 공간을 가장 적게 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda a sua biblioteca pode ser navegada, com uma pequena imagem provisória para cada foto. Usa o mínimo de espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вся медиатека доступна для просмотра, с небольшим заполнителем для каждого фото. Занимает меньше всего места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可浏览整个资料库，每张照片显示一个小占位图。占用空间最少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可瀏覽整個圖庫，每張照片都有小型預留圖片。使用最少空間。"
          }
        }
      }
    },
