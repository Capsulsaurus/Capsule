    "app.share.privacy.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل Capsule هذه التفاصيل في كل مرة تُقدَّم فيها صورة مشتركة. لا شيء هنا اختياري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule entfernt diese Angaben jedes Mal, wenn ein geteiltes Foto ausgeliefert wird. Nichts davon ist optional."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule removes these every time a shared photo is served. Nothing here is optional."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule los elimina cada vez que se sirve una foto compartida. No hay nada opcional aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule retire ces informations chaque fois qu'une photo partagée est servie. Rien de tout cela n'est facultatif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी कोई साझा फ़ोटो दिखाई जाती है, Capsule इन्हें हर बार हटा देता है। इनमें कुछ भी वैकल्पिक नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule li rimuove ogni volta che una foto condivisa viene servita. Nulla qui è facoltativo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有された写真が配信されるたびに、Capsule はこれらを削除します。省略することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공유된 사진이 제공될 때마다 Capsule이 이 정보를 제거합니다. 선택 사항이 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule remove estes dados sempre que uma foto compartilhada é exibida. Nada aqui é opcional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule удаляет эти данные каждый раз, когда отдаётся общее фото. Ничего из этого не отключается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次提供共享照片时，Capsule 都会移除这些信息。此处没有任何可选项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次提供分享的照片時，Capsule 都會移除這些資訊。這裡沒有任何項目是可選的。"
          }
        }
      }
    },
