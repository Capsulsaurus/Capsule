    "app.restore.shamir.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن تقسيم سر الاسترداد إلى أجزاء يحتفظ بها أشخاص أو أماكن مختلفة. يكفي عدد كافٍ منها معًا لإعادة بنائه؛ أما الجزء الواحد بمفرده فلا يكشف شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wiederherstellungsgeheimnis kann in Anteile aufgeteilt werden, die verschiedene Personen oder Orte verwahren. Genug davon zusammen stellen es wieder her; ein einzelner verrät nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery secret can be split into shares held by different people or places. Enough of them together rebuild it; one on its own reveals nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu secreto de recuperación se puede dividir en partes que guardan distintas personas o lugares. Juntando suficientes se reconstruye; una sola no revela nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre secret de récupération peut être divisé en parts confiées à différentes personnes ou conservées à différents endroits. Un nombre suffisant de parts réunies permet de le reconstituer ; une part seule ne révèle rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रिकवरी सीक्रेट को अलग-अलग लोगों या जगहों के पास रखे शेयर में बाँटा जा सकता है। पर्याप्त शेयर मिलकर इसे फिर से बनाते हैं; अकेला एक शेयर कुछ भी प्रकट नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo segreto di ripristino può essere diviso in parti custodite da persone o luoghi diversi. Un numero sufficiente di parti insieme lo ricostruisce; una sola non rivela nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーシークレットは分割して、別々の人や場所に保管できます。十分な数の分割片を集めると再構築でき、1つだけでは何も分かりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 비밀 정보는 여러 사람이나 장소에 나누어 보관하는 조각으로 분할할 수 있습니다. 충분한 수의 조각을 모으면 다시 만들 수 있으며, 조각 하나만으로는 아무것도 알 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu segredo de recuperação pode ser dividido em partes guardadas por pessoas ou em lugares diferentes. Partes suficientes juntas o reconstroem; uma sozinha não revela nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Секрет восстановления можно разделить на доли, которые хранят разные люди или в разных местах. Достаточное их число вместе восстанавливает секрет; одна доля сама по себе ничего не раскрывает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的恢复密钥可以拆分为多个份额，由不同的人或在不同的地方保管。足够多的份额合在一起即可重建；单独一份不会泄露任何信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的復原密鑰可以拆分成多個份額，交由不同的人或存放在不同地方。集齊足夠的份額即可重建密鑰；單一份額不會洩露任何資訊。"
          }
        }
      }
    },
