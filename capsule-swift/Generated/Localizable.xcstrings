    "app.sync.policy.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في كلتا الحالتين، تُحفظ نسختك المحلية حتى تُخزَّن الصورة بالحجم الكامل بأمان على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In beiden Fällen bleibt deine lokale Kopie erhalten, bis das Foto in voller Größe sicher auf deinem Server gespeichert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way, your local copy is kept until the full-size photo is safely stored on your server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier caso, tu copia local se conserva hasta que la foto a tamaño completo esté almacenada de forma segura en tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les deux cas, votre copie locale est conservée jusqu'à ce que la photo en taille réelle soit stockée en sécurité sur votre serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों ही स्थितियों में, आपकी लोकल कॉपी तब तक रखी जाती है जब तक पूर्ण-आकार फ़ोटो आपके सर्वर पर सुरक्षित रूप से संग्रहीत नहीं हो जाती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In ogni caso, la tua copia locale viene conservata finché la foto a dimensione piena non è archiviata in sicurezza sul tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの場合も、フルサイズの写真がサーバーに安全に保存されるまで、ローカルのコピーは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 쪽이든, 원본 크기 사진이 서버에 안전하게 저장될 때까지 로컬 사본은 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer forma, sua cópia local é mantida até a foto em tamanho original estar armazenada com segurança no seu servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом случае локальная копия сохраняется, пока полноразмерное фото не будет надёжно сохранено на вашем сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论哪种方式，您的本地副本都会保留，直到全尺寸照片已安全存储在您的服务器上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論哪種方式，您的本機副本都會保留，直到原尺寸照片已安全儲存在您的伺服器為止。"
          }
        }
      }
    },
    "app.sync.policy.full": {
      "localizations": {
