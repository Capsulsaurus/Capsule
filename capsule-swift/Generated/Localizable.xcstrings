    "error.album.roster_attester": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن نشر قائمة أعضاء الألبوم إلا من جهاز على حساب مالكه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Gerät im Konto des Albumbesitzers kann die Mitgliederliste veröffentlichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a device on the album owner's account can publish its roster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un dispositivo de la cuenta del propietario del álbum puede publicar su lista de miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un appareil du compte du propriétaire de l'album peut publier sa liste de membres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एल्बम स्वामी के खाते का कोई डिवाइस ही इसकी सदस्य सूची प्रकाशित कर सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo un dispositivo dell'account del proprietario dell'album può pubblicarne l'elenco dei membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムの名簿を公開できるのは、アルバム所有者のアカウントのデバイスのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 소유자 계정의 기기만 앨범 명단을 게시할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente um dispositivo da conta do dono do álbum pode publicar a lista de membros dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Публиковать список участников альбома может только устройство из учётной записи владельца альбома."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有相册所有者账户中的设备才能发布其成员名单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有相簿擁有者帳號上的裝置才能發布其成員名單。"
          }
        }
      }
    },
    "error.album.roster_malformed": {
