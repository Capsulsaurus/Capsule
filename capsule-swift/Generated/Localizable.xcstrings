    "app.settings.storage.quota.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل الصور المحذوفة محتسبة حتى تُزال نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte Fotos zählen mit, bis sie endgültig entfernt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted photos still count until they're purged for good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos eliminadas siguen contando hasta que se borran definitivamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos supprimées sont comptabilisées jusqu'à leur suppression définitive."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हटाई गई फ़ोटो तब तक गिनी जाती हैं जब तक वे स्थायी रूप से हटा नहीं दी जातीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto eliminate continuano a contare finché non vengono rimosse definitivamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除した写真も、完全に消去されるまでは使用量に含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 사진은 영구적으로 제거될 때까지 사용량에 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos apagadas continuam contando até serem removidas de vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалённые фото учитываются, пока не будут удалены окончательно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除的照片在被彻底清除前仍会计入用量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已刪除的照片在永久清除前仍會計入用量。"
          }
        }
      }
    },
