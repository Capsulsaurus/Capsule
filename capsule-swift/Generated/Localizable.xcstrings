    "app.enrollment.stage.master_key.explanation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء المفتاح الذي يحمي مكتبتك وتخزينه تحت عبارة الاسترداد الخاصة بك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel, der deine Mediathek schützt, wird erstellt und mit deiner Wiederherstellungsphrase gesichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating the key that protects your library and storing it under your recovery phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creando la clave que protege tu biblioteca y guardándola con tu frase de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Création de la clé qui protège votre bibliothèque et enregistrement de celle-ci sous votre phrase de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी की सुरक्षा करने वाली कुंजी बनाई जा रही है और उसे आपके रिकवरी वाक्यांश के तहत संग्रहीत किया जा रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione della chiave che protegge la tua libreria e sua protezione con la frase di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリを保護する鍵を作成し、リカバリーフレーズで保護して保存します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리를 보호하는 키를 생성하고 복구 문구로 보관합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
