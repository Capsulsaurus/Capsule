    "app.settings.security.atrest.sandbox.summary": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لأي تطبيق آخر الوصول إلى ملفات Capsule، ويُشفَّر الجهاز بالكامل عند قفله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine andere App kann auf die Dateien von Capsule zugreifen, und das gesamte Gerät ist verschlüsselt, wenn es gesperrt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No other app can reach Capsule's files, and the whole device is encrypted when it's locked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna otra app puede acceder a los archivos de Capsule, y todo el dispositivo está cifrado cuando está bloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune autre app ne peut accéder aux fichiers de Capsule, et l'appareil entier est chiffré lorsqu'il est verrouillé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई अन्य ऐप Capsule की फ़ाइलों तक नहीं पहुँच सकता, और लॉक होने पर पूरा डिवाइस एन्क्रिप्ट रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun'altra app può accedere ai file di Capsule e l'intero dispositivo è crittografato quando è bloccato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかのアプリは Capsule のファイルにアクセスできず、ロック中はデバイス全体が暗号化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 앱은 Capsule의 파일에 접근할 수 없으며, 기기가 잠기면 기기 전체가 암호화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum outro app consegue acessar os arquivos do Capsule, e o dispositivo inteiro fica criptografado quando bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никакое другое приложение не имеет доступа к файлам Capsule, а всё устройство шифруется, когда заблокировано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他应用无法访问 Capsule 的文件，且设备锁定时整台设备都处于加密状态。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "其他 App 都無法存取 Capsule 的檔案，且整台裝置在鎖定時都會加密。"
          }
        }
      }
    },
