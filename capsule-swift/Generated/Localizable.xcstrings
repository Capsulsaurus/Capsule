    "app.settings.language.preferred.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم Capsule أول لغة من هذه تتوفر لها ترجمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
