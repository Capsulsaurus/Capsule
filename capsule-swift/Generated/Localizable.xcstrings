    "notification.recovery_check_due.rewrap.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تأكيد سر الاسترداد. أعِدّ سرًا جديدًا لتتمكن من استرداد مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Wiederherstellungsgeheimnis konnte nicht bestätigt werden. Richte ein neues ein, damit du deine Mediathek weiterhin wiederherstellen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery secret could not be confirmed. Set up a new one so you can still recover your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar tu secreto de recuperación. Configura uno nuevo para poder seguir recuperando tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre secret de récupération n'a pas pu être confirmé. Configurez-en un nouveau pour pouvoir toujours récupérer votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रिकवरी सीक्रेट की पुष्टि नहीं हो सकी। नया सीक्रेट सेट करें ताकि आप अब भी अपनी लाइब्रेरी रिकवर कर सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile confermare il tuo segreto di ripristino. Configurane uno nuovo per poter ancora ripristinare la tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーシークレットを確認できませんでした。ライブラリを引き続き復元できるよう、新しいシークレットを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 비밀 키를 확인할 수 없습니다. 보관함을 계속 복구할 수 있도록 새 키를 설정하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar seu segredo de recuperação. Configure um novo para continuar podendo recuperar sua biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить ваш секрет восстановления. Настройте новый, чтобы сохранить возможность восстановить медиатеку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认您的恢复密钥。请设置新的恢复密钥，以便您仍能恢复资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認您的復原密鑰。請設定新的密鑰，以確保您仍能復原圖庫。"
          }
        }
      }
    },
