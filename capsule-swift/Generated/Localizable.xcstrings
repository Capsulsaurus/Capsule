            "value": "Pide una carpeta e importa una vez las fotos que contiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demande un dossier, puis importe une fois les photos qu'il contient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फ़ोल्डर माँगता है, फिर उसमें मौजूद फ़ोटो एक बार इंपोर्ट करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiede una cartella, poi importa una volta le foto al suo interno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダを選択し、その中の写真を1回読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더를 선택하면 그 안의 사진을 한 번 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pede uma pasta e importa as fotos dela uma única vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивает папку и однократно импортирует фото из неё."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
