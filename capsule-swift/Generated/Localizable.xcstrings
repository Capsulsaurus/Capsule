    "app.enrollment.cancel.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُحتفظ بأي شيء، ولن يكون لحسابك مفتاح صالح للاستخدام حتى يكتمل الإعداد. ستبدأ من جديد من البداية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts behalten, und dein Konto hat keinen nutzbaren Schlüssel, bis die Einrichtung abgeschlossen ist. Du beginnst wieder ganz von vorne."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is kept, and your account has no usable key until setup finishes. You'll start over from the beginning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se conserva nada y tu cuenta no tendrá ninguna clave utilizable hasta que termine la configuración. Empezarás de nuevo desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est conservé, et votre compte n'a aucune clé utilisable tant que la configuration n'est pas terminée. Vous recommencerez depuis le début."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी नहीं रखा जाता, और सेटअप पूरा होने तक आपके खाते के पास कोई उपयोग योग्य कुंजी नहीं होती। आपको शुरुआत से फिर से शुरू करना होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene conservato nulla e il tuo account non avrà una chiave utilizzabile finché la configurazione non sarà completata. Dovrai ricominciare dall'inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も保持されず、設定が完了するまでアカウントには使用可能な鍵がありません。最初からやり直すことになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 저장되지 않으며, 설정이 완료될 때까지 계정에 사용할 수 있는 키가 없습니다. 처음부터 다시 시작하게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é mantido, e sua conta fica sem uma chave utilizável até a configuração terminar. Você vai recomeçar do início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не сохранится, и у вашей учётной записи не будет рабочего ключа, пока настройка не завершится. Придётся начать с самого начала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会保留任何内容，在设置完成之前您的账户没有可用的密钥。您需要从头开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會保留任何內容，且在設定完成前，你的帳號沒有可用的密鑰。你將需要從頭開始。"
          }
        }
      }
    },
    "app.enrollment.cancel.confirm.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلغاء الإعداد؟"
          }
        },
        "de": {
