    "app.transfer.recovery.update_app.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد بإمكان هذا الإصدار التواصل مع خادمك. التحديث يحلّ المشكلة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version kann nicht mehr mit deinem Server kommunizieren. Ein Update behebt das."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version can't talk to your server any more. Updating fixes it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión ya no puede comunicarse con tu servidor. Actualizarla lo soluciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version ne peut plus communiquer avec votre serveur. Une mise à jour corrige le problème."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह संस्करण अब आपके सर्वर से बात नहीं कर सकता। अपडेट करने से यह ठीक हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non riesce più a comunicare con il tuo server. Aggiornarla risolve il problema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンはサーバーと通信できなくなりました。アップデートすると解決します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 버전은 더 이상 서버와 통신할 수 없습니다. 업데이트하면 해결됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão não consegue mais se comunicar com o seu servidor. Atualizar resolve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия больше не может работать с вашим сервером. Обновление решит проблему."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本已无法与您的服务器通信。更新即可解决。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本已無法與您的伺服器通訊。更新即可解決。"
          }
        }
      }
    },
