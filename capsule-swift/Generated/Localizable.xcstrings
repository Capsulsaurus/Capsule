    "app.passkey.unavailable.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد على هذا الجهاز مكان لحفظ مفتاح مرور. سجّل الدخول بكلمة المرور بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät kann keinen Passkey speichern. Melde dich stattdessen mit deinem Passwort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has nowhere to keep a passkey. Sign in with your password instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene dónde guardar una llave de acceso. Inicia sesión con tu contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil ne peut stocker aucune clé d'accès. Connectez-vous plutôt avec votre mot de passe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर पासकी रखने की कोई जगह नहीं है। इसके बजाय अपने पासवर्ड से साइन इन करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha dove conservare una passkey. Accedi invece con la password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにはパスキーを保存できる場所がありません。パスワードでサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에는 패스키를 보관할 곳이 없습니다. 대신 비밀번호로 로그인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não tem onde guardar uma chave de acesso. Inicie sessão com sua senha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На этом устройстве негде хранить ключ доступа. Войдите с паролем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备没有可存放通行密钥的位置。请改用密码登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置沒有可儲存通行密鑰的地方。請改用密碼登入。"
          }
        }
      }
    },
