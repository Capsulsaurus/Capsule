    "app.settings.recovery.restore.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستبدل الاستعادة أبدًا العمل الأحدث على هذا الجهاز. يُحتجز أي شيء متعارض لتقرر بشأنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Wiederherstellung überschreibt nie neuere Arbeit auf diesem Gerät. Alles, was abweicht, wird für deine Entscheidung zurückgehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A restore never overwrites newer work on this device. Anything that disagrees is held for you to decide."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una restauración nunca sobrescribe el trabajo más reciente de este dispositivo. Todo lo que no coincida se retiene para que decidas tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une restauration n'écrase jamais un travail plus récent sur cet appareil. Tout ce qui diverge est mis de côté pour que vous décidiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्स्थापना कभी भी इस डिवाइस पर नए काम को ओवरराइट नहीं करती। जो कुछ मेल नहीं खाता, उसे आपके निर्णय के लिए रोक लिया जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ripristino non sovrascrive mai lavoro più recente su questo dispositivo. Tutto ciò che non coincide viene trattenuto perché sia tu a decidere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元によって、このデバイス上の新しい作業が上書きされることはありません。食い違うものは、あなたが判断するまで保留されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원은 이 기기의 최신 작업을 절대 덮어쓰지 않습니다. 일치하지 않는 항목은 사용자가 결정할 수 있도록 보류됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma restauração nunca sobrescreve trabalho mais recente neste dispositivo. O que divergir fica retido para você decidir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Восстановление никогда не перезаписывает более новые данные на этом устройстве. Всё, что расходится, откладывается до вашего решения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复绝不会覆盖此设备上较新的内容。任何存在分歧的内容都会暂时保留，由您决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還原絕不會覆寫此裝置上較新的內容。任何不一致的項目都會保留，交由您決定。"
          }
        }
      }
    },
