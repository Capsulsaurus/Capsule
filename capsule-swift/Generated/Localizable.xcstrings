    "app.peering.enable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة مع الأجهزة القريبة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Geräten in der Nähe synchronisieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync with Nearby Devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar con dispositivos cercanos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser avec les appareils à proximité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास के डिवाइस के साथ सिंक करें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizza con dispositivi vicini"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのデバイスと同期"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기와 동기화"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar com Dispositivos Próximos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с устройствами рядом"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与附近设备同步"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與附近裝置同步"
          }
        }
      }
    },
    "app.peering.enable.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبادل أجهزتك الصور مباشرة عبر الشبكة المحلية، دون المرور بخادمك. مفيد عندما يكون الخادم بعيدًا أو غير متصل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Geräte tauschen Fotos direkt über das lokale Netzwerk aus, ohne deinen Server. Praktisch, wenn der Server weit weg oder offline ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices swap photos directly over the local network, without going through your server. Useful when the server is far away or offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus dispositivos intercambian fotos directamente por la red local, sin pasar por tu servidor. Es útil cuando el servidor está lejos o sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos appareils échangent leurs photos directement via le réseau local, sans passer par votre serveur. Pratique lorsque le serveur est éloigné ou hors ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस आपके सर्वर से होकर जाए बिना, लोकल नेटवर्क पर सीधे फ़ोटो की अदला-बदली करते हैं। यह तब उपयोगी है जब सर्वर दूर हो या ऑफ़लाइन हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dispositivi si scambiano le foto direttamente tramite la rete locale, senza passare dal server. Utile quando il server è lontano o offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス同士がサーバーを経由せず、ローカルネットワーク上で直接写真をやり取りします。サーバーが遠い場合やオフラインの場合に便利です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기들이 서버를 거치지 않고 로컬 네트워크를 통해 직접 사진을 주고받습니다. 서버가 멀리 있거나 오프라인일 때 유용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus dispositivos trocam fotos diretamente pela rede local, sem passar pelo seu servidor. Útil quando o servidor está longe ou offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши устройства обмениваются фото напрямую через локальную сеть, минуя сервер. Это удобно, когда сервер далеко или недоступен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的设备会通过本地网络直接交换照片，无需经过您的服务器。适用于服务器距离较远或离线的情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的裝置會直接透過區域網路交換照片，不經過您的伺服器。適用於伺服器距離遙遠或離線時。"
          }
        }
      }
    },
    "app.peering.idle.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule في وضع الاستماع. ستظهر أجهزتك الأخرى عندما تكون على الشبكة نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hört zu. Deine anderen Geräte erscheinen, sobald sie im selben Netzwerk sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule is listening. Your other devices will show up when they're on the same network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule está a la escucha. Tus otros dispositivos aparecerán cuando estén en la misma red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule est à l'écoute. Vos autres appareils apparaîtront lorsqu'ils seront sur le même réseau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule सुन रहा है। आपके अन्य डिवाइस एक ही नेटवर्क पर होने पर दिखाई देंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule è in ascolto. Gli altri tuoi dispositivi compariranno quando saranno sulla stessa rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は待機中です。他のデバイスが同じネットワークに接続すると表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 대기 중입니다. 다른 기기가 같은 네트워크에 있으면 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule está escutando. Seus outros dispositivos vão aparecer quando estiverem na mesma rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ожидает. Другие ваши устройства появятся, когда окажутся в той же сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 正在侦听。您的其他设备连接到同一网络时会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 正在等候連線。您的其他裝置連上同一個網路時就會顯示在這裡。"
          }
        }
      }
    },
    "app.peering.idle.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد شيء قريب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts in der Nähe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing Nearby"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada cerca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à proximité"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास कुछ नहीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun dispositivo vicino"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くにデバイスはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변에 기기 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada por Perto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядом ничего нет"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近没有设备"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近沒有裝置"
          }
        }
      }
    },
    "app.peering.note.lan_only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عبر الشبكة المحلية فقط. لا يُتبادل أي شيء عبر الإنترنت بهذه الطريقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur über das lokale Netzwerk. Auf diesem Weg wird nichts über das Internet ausgetauscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only over the local network. Nothing is exchanged across the internet this way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo por la red local. De este modo no se intercambia nada a través de internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement via le réseau local. Rien n'est échangé par Internet de cette façon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल लोकल नेटवर्क पर। इस तरह इंटरनेट पर कुछ भी साझा नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo tramite la rete locale. In questo modo non viene scambiato nulla via internet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルネットワーク上でのみ行われます。この方法でインターネット経由のやり取りが行われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 네트워크에서만 작동합니다. 이 방식으로는 인터넷을 통해 아무것도 주고받지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente pela rede local. Nada é trocado pela internet dessa forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только через локальную сеть. Таким способом ничего не передаётся через интернет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅通过本地网络进行。这种方式不会经由互联网交换任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限區域網路。此方式不會透過網際網路交換任何內容。"
          }
        }
      }
    },
    "app.peering.note.no_scope_knob": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتبع المزامنة القريبة إعداد «ما تتم مزامنته» نفسه المطبّق على كل شيء آخر — لا يوجد إعداد منفصل لها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Synchronisierung in der Nähe folgt derselben Einstellung „Was synchronisiert wird“ wie alles andere – es gibt keine eigene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nearby syncing follows the same What to Sync setting as everything else — there's no separate one to set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización cercana sigue el mismo ajuste Qué sincronizar que todo lo demás; no hay uno aparte que configurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation à proximité suit le même réglage Éléments à synchroniser que tout le reste : il n'y a pas de réglage distinct à définir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास सिंक भी बाकी सब की तरह उसी 'क्या सिंक करें' सेटिंग का पालन करता है — इसके लिए अलग से कुछ सेट करने की ज़रूरत नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione con i dispositivi vicini segue la stessa impostazione Cosa sincronizzare di tutto il resto: non ce n'è una separata da configurare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのデバイスとの同期は、他と同じ「同期する対象」の設定に従います。個別に設定する項目はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주변 기기 동기화는 다른 모든 항목과 동일한 동기화할 항목 설정을 따릅니다. 별도로 설정할 항목은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com dispositivos próximos segue o mesmo ajuste O Que Sincronizar de todo o resto — não há um ajuste separado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с устройствами рядом подчиняется той же настройке «Что синхронизировать», что и всё остальное, — отдельной настройки нет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附近同步遵循与其他内容相同的“同步内容”设置，无需单独设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "附近同步與其他功能一樣遵循「同步內容」設定，沒有另外需要設定的項目。"
          }
        }
      }
    },
    "app.peering.note.pull_only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطلب كل جهاز ما ينقصه. لا يُدفع إليك أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Gerät fragt nach dem, was ihm fehlt. Dir wird nichts aufgedrängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each device asks for what it's missing. Nothing is pushed at you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo pide lo que le falta. No se te envía nada sin pedirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appareil demande ce qui lui manque. Rien ne vous est imposé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर डिवाइस वही माँगता है जो उसके पास नहीं है। आपको कुछ भी ज़बरदस्ती नहीं भेजा जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni dispositivo chiede ciò che gli manca. Nulla ti viene inviato senza richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各デバイスは足りないものだけを要求します。一方的に送り付けられることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 기기는 자신에게 없는 항목만 요청합니다. 일방적으로 전송되는 항목은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dispositivo pede o que está faltando. Nada é enviado sem você pedir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое устройство запрашивает то, чего ему не хватает. Вам ничего не навязывается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每台设备只请求自己缺少的内容，不会向您推送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每台裝置只會索取自己缺少的內容，不會有任何內容被強行推送給您。"
          }
        }
      }
    },
    "app.peering.note.same_account": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأجهزة المسجّل دخولها إلى حسابك فقط. لا يمكن لجهاز شخص آخر على الشبكة نفسها المشاركة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Geräte, die bei deinem Konto angemeldet sind. Geräte anderer Personen im selben Netzwerk können nicht teilnehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only devices signed in to your account. Someone else's device on the same network can't take part."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo dispositivos con sesión iniciada en tu cuenta. El dispositivo de otra persona en la misma red no puede participar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement les appareils connectés à votre compte. L'appareil d'une autre personne sur le même réseau ne peut pas y participer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल आपके खाते में साइन इन किए गए डिवाइस। उसी नेटवर्क पर किसी और का डिवाइस इसमें भाग नहीं ले सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo i dispositivi che hanno eseguito l'accesso al tuo account. Il dispositivo di qualcun altro sulla stessa rete non può partecipare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのアカウントにサインインしているデバイスのみが対象です。同じネットワーク上の他人のデバイスは参加できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 계정에 로그인된 기기만 참여할 수 있습니다. 같은 네트워크에 있는 다른 사람의 기기는 참여할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente dispositivos com sessão iniciada na sua conta. O dispositivo de outra pessoa na mesma rede não pode participar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только устройства, на которых выполнен вход в вашу учётную запись. Чужое устройство в той же сети участвовать не может."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅限登录您账户的设备。同一网络中其他人的设备无法参与。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅限登入您帳號的裝置。同一個網路上其他人的裝置無法參與。"
          }
        }
      }
    },
