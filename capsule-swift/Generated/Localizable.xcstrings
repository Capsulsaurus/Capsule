    "app.settings.maintenance.scrub.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرة واحدة في الأسبوع على الأكثر، يمسح Capsule ملفات العمل المتبقية من عمليات الكتابة التي انقطعت. لا يمس إلا الملفات التي مضى عليها أكثر من عشر دقائق، وفقط تلك التي لا يشير إليها أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens einmal pro Woche entfernt Capsule übrig gebliebene Arbeitsdateien von unterbrochenen Schreibvorgängen. Es betrifft nur Dateien, die älter als zehn Minuten sind und auf die nichts verweist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At most once a week, Capsule clears leftover working files from writes that were interrupted. It only touches files more than ten minutes old, and only ones nothing refers to."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como máximo una vez por semana, Capsule borra los archivos de trabajo sobrantes de escrituras interrumpidas. Solo toca archivos con más de diez minutos de antigüedad y a los que nada haga referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au plus une fois par semaine, Capsule efface les fichiers de travail laissés par des écritures interrompues. Seuls les fichiers de plus de dix minutes auxquels rien ne fait référence sont concernés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सप्ताह में अधिकतम एक बार, Capsule बाधित हुए लेखन कार्यों से बची अस्थायी फ़ाइलें साफ़ करता है। यह केवल दस मिनट से पुरानी फ़ाइलों को छूता है, और केवल उन्हीं को जिनका कहीं संदर्भ नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo una volta a settimana, Capsule elimina i file di lavoro rimasti da scritture interrotte. Tocca solo file più vecchi di dieci minuti e solo quelli a cui nulla fa riferimento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は週に1回まで、中断された書き込みで残った作業ファイルを削除します。対象は10分以上前に作成され、どこからも参照されていないファイルのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 일주일에 최대 한 번, 중단된 쓰기 작업에서 남은 임시 파일을 정리합니다. 10분 이상 지났고 아무것도 참조하지 않는 파일만 정리합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo uma vez por semana, o Capsule limpa arquivos de trabalho que sobraram de gravações interrompidas. Ele só mexe em arquivos com mais de dez minutos e que nada referencia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не чаще раза в неделю Capsule удаляет оставшиеся рабочие файлы от прерванных операций записи. Затрагиваются только файлы старше десяти минут, на которые ничто не ссылается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 每周最多一次清理因写入中断而残留的临时文件。它只会处理超过十分钟且未被任何内容引用的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 每週最多一次清除中斷寫入所留下的暫存檔案。它只會處理超過十分鐘且沒有被任何內容參照的檔案。"
          }
        }
      }
    },
    "app.settings.maintenance.scrub.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء هنا يحتاج إلى تشغيل — يحدث هذا تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier musst du nichts starten – das passiert von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here needs starting — this happens by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta iniciar nada: esto ocurre solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à lancer ici : cela se fait tout seul."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ कुछ शुरू करने की ज़रूरत नहीं — यह अपने आप होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nulla da avviare: avviene da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで開始する必要はありません。自動的に実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따로 시작할 필요가 없습니다. 자동으로 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é preciso iniciar nada aqui — isso acontece sozinho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь ничего не нужно запускать — это происходит само."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处无需手动启动——它会自动进行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡不需要手動啟動，會自動進行。"
          }
        }
      }
    },
