    "app.settings.sync.scope.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجلب الصور بالحجم الكامل دائمًا عند الطلب عندما تفتح إحداها أو تشاركها، أيًا كان اختيارك هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos in voller Größe werden immer bei Bedarf geladen, wenn du eines öffnest oder teilst – unabhängig davon, was du hier wählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-size photos are always fetched on demand when you open or share one, whatever you choose here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos a tamaño completo siempre se descargan cuando abres o compartes una, elijas lo que elijas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos en taille réelle sont toujours récupérées à la demande lorsque vous en ouvrez ou partagez une, quel que soit votre choix ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप यहाँ जो भी चुनें, पूर्ण-आकार फ़ोटो खोलने या साझा करने पर हमेशा माँग पर लाई जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto a dimensione piena vengono sempre scaricate su richiesta quando ne apri o condividi una, qualunque cosa tu scelga qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでの選択にかかわらず、写真を開いたり共有したりするときには、フルサイズの写真が常にその場で取得されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 무엇을 선택하든, 원본 크기 사진은 열거나 공유할 때 항상 필요에 따라 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos em tamanho original são sempre baixadas sob demanda quando você abre ou compartilha uma, independentemente do que escolher aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полноразмерные фото всегда загружаются по запросу, когда вы открываете или отправляете их, что бы вы здесь ни выбрали."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论您在此选择什么，打开或共享全尺寸照片时都会按需获取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論您在此選擇什麼，打開或分享照片時，一律會即時取得原尺寸照片。"
          }
        }
      }
    },
