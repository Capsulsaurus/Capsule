          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर का स्टोरेज भर गया है। जगह ख़ाली होने पर अपलोड फिर से शुरू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di archiviazione del server è esaurito. Il caricamento riprenderà quando verrà liberato spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのストレージ容量が不足しています。空き容量が確保されるとアップロードが再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버의 저장 공간이 부족합니다. 공간이 확보되면 업로드가 재개됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor está sem espaço de armazenamento. O envio será retomado quando houver espaço livre."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервере закончилось место. Загрузка возобновится, когда место освободится."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器存储空间不足。释放空间后将恢复上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器的儲存空間已滿。釋放空間後，上傳將會恢復。"
          }
        }
      }
    },
