    "error.album.invalid_id": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تسجيل هذا الألبوم لأن مُعرّفه مُشوَّه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Album konnte nicht registriert werden, weil seine Kennung fehlerhaft ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This album could not be registered because its identifier is malformed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo registrar este álbum porque su identificador está mal formado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet album n'a pas pu être enregistré car son identifiant est mal formé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस एल्बम को पंजीकृत नहीं किया जा सका क्योंकि इसका पहचानकर्ता ग़लत रूप में है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile registrare questo album perché il suo identificatore non è valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムは識別子の形式が正しくないため登録できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앨범 식별자의 형식이 올바르지 않아 이 앨범을 등록할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível registrar este álbum porque o identificador dele está malformado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось зарегистрировать этот альбом: его идентификатор имеет неверный формат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法注册此相册，因为其标识符格式不正确。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此相簿的識別碼格式不正確，因此無法登錄。"
          }
        }
      }
    },
