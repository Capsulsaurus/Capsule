      }
    },
    "app.settings.recovery.minted.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعرض مرة واحدة فقط. دوّنها أو احفظها في مدير كلمات المرور قبل إغلاق هذه الشاشة — لا يمكن لأحد عرضها لك مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird nur einmal angezeigt. Schreib sie auf oder speichere sie in deinem Passwort-Manager, bevor du das schließt – niemand kann sie dir erneut zeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown once. Write it down or save it to your password manager before you dismiss this — nobody can show it to you again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se muestra una vez. Anótala o guárdala en tu gestor de contraseñas antes de cerrar esto: nadie podrá volver a mostrártela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichée une seule fois. Notez-la ou enregistrez-la dans votre gestionnaire de mots de passe avant de fermer : personne ne pourra vous la montrer à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल एक बार दिखाया जाता है। इसे बंद करने से पहले लिख लें या अपने पासवर्ड मैनेजर में सहेज लें — कोई भी इसे आपको दोबारा नहीं दिखा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene mostrata una sola volta. Scrivila o salvala nel tuo gestore di password prima di chiudere: nessuno potrà mostrartela di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されるのは今回のみです。閉じる前に書き留めるか、パスワードマネージャに保存してください。再表示することは誰にもできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번만 표시됩니다. 닫기 전에 적어 두거나 암호 관리자에 저장하십시오. 다시 보여줄 수 있는 사람은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exibida uma única vez. Anote-a ou salve-a no seu gerenciador de senhas antes de fechar — ninguém poderá mostrá-la de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывается один раз. Запишите её или сохраните в менеджере паролей, прежде чем закрыть, — никто не сможет показать её вам снова."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示一次。请在关闭前将其抄写下来或保存到密码管理器中——之后没有人能再次向您显示它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會顯示一次。請在關閉前抄寫下來或儲存到密碼管理工具，之後沒有人能再次顯示給您。"
          }
        }
      }
    },
