    "app.import.run.cancelled.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقفت الاستيراد. الصور التي اكتملت موجودة في مكتبتك، ولم يُمسّ الباقي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast den Import gestoppt. Bereits fertige Fotos sind in deiner Mediathek; der Rest blieb unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You stopped the import. Photos that already finished are in your library; the rest were left alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detuviste la importación. Las fotos que ya habían terminado están en tu biblioteca; el resto no se tocó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez arrêté l'importation. Les photos déjà terminées sont dans votre bibliothèque ; les autres n'ont pas été touchées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने इंपोर्ट रोक दिया। जो फ़ोटो पूरी हो चुकी थीं वे आपकी लाइब्रेरी में हैं; बाकी को छुआ नहीं गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai interrotto l'importazione. Le foto già completate sono nella tua libreria; le altre non sono state toccate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込みを停止しました。完了した写真はライブラリにあり、残りはそのままです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기를 중단했습니다. 이미 완료된 사진은 라이브러리에 있으며, 나머지는 그대로 남아 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você interrompeu a importação. As fotos já concluídas estão na sua biblioteca; as demais não foram alteradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы остановили импорт. Уже обработанные фото находятся в вашей медиатеке, остальные не тронуты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您停止了导入。已完成的照片已在您的资料库中，其余照片保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已停止匯入。已完成的照片在你的圖庫中；其餘的則未受影響。"
          }
        }
      }
    },
