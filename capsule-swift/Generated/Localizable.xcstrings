    "app.passkey.name.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم ستتعرّف عليه لاحقًا، مثل اسم هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Etwas, das du später wiedererkennst, z. B. der Name dieses Geräts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something you'll recognize later, like the name of this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que reconozcas más adelante, como el nombre de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom que vous reconnaîtrez plus tard, comme celui de cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ ऐसा जिसे आप बाद में पहचान सकें, जैसे इस डिवाइस का नाम।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcosa che riconoscerai in seguito, come il nome di questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの名前など、後で見分けがつく名前にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 알아볼 수 있는 이름(예: 이 기기의 이름)을 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algo que você reconheça depois, como o nome deste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Название, которое вы узнаете позже, например имя этого устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日后能认出的名称，例如此设备的名称。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日後能讓您認出的名稱，例如此裝置的名稱。"
          }
        }
      }
    },
