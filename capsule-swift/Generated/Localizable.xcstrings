    "app.drops.detail.claims.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من رفع هذا هو من اختار هذه التفاصيل. لا يمكن لـ Capsule تأكيد أي منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Angaben hat die hochladende Person gewählt. Capsule kann keine davon bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever uploaded this chose these details. Capsule can't confirm any of them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien subió esto eligió estos datos. Capsule no puede confirmar ninguno de ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces informations ont été choisies par la personne qui a envoyé ce fichier. Capsule ne peut en confirmer aucune."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये विवरण अपलोड करने वाले ने चुने हैं। Capsule इनमें से किसी की भी पुष्टि नहीं कर सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi dettagli sono stati scelti da chi ha caricato il file. Capsule non può confermarne nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの詳細はアップロードした人が指定したものです。Capsule はいずれも確認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드한 사람이 이 세부 정보를 지정했습니다. Capsule은 이 중 어느 것도 확인할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem enviou escolheu estes detalhes. O Capsule não pode confirmar nenhum deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти сведения указал тот, кто загрузил файл. Capsule не может подтвердить ни одно из них."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些信息由上传者自行填写，Capsule 无法确认其中任何一项。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些詳細資料由上傳者自行提供，Capsule 無法確認其中任何一項。"
          }
        }
      }
    },
