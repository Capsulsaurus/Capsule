    "app.sync.criterion.non_metered.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتم مزامنة التفاصيل والمعاينات على أي اتصال غير خلوي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Details und Vorschauen werden über jede Verbindung außer Mobilfunk synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details and previews sync on any connection that isn't cellular."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los detalles y las previsualizaciones se sincronizan con cualquier conexión que no sea de datos móviles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les détails et aperçus se synchronisent sur toute connexion autre que cellulaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विवरण और प्रीव्यू किसी भी गैर-सेल्युलर कनेक्शन पर सिंक होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dettagli e anteprime si sincronizzano su qualsiasi connessione che non sia cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細とプレビューは、モバイルデータ通信以外のすべての接続で同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세부 정보와 미리보기는 셀룰러가 아닌 모든 연결에서 동기화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detalhes e prévias sincronizam em qualquer conexão que não seja celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сведения и превью синхронизируются через любое подключение, кроме сотовой сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详细信息和预览会通过任何非蜂窝网络连接同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細資訊和預覽會透過任何非行動網路的連線同步。"
          }
        }
      }
    },
