    "app.storage.free_up.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعاد تنزيل أي شيء يُمسح هنا عند الحاجة إليه، ما دام موجودًا على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was hier gelöscht wird, wird erneut geladen, wenn du es brauchst – sofern dein Server es hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything cleared here is downloaded again when you need it, as long as your server has it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que se borre aquí se vuelve a descargar cuando lo necesites, siempre que tu servidor lo tenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est effacé ici est téléchargé à nouveau quand vous en avez besoin, tant que votre serveur le détient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ साफ़ की गई कोई भी चीज़ ज़रूरत पड़ने पर फिर से डाउनलोड हो जाती है, बशर्ते वह आपके सर्वर पर हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che cancelli qui viene scaricato di nuovo quando ti serve, purché il tuo server lo abbia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで消去したものは、サーバーにある限り、必要なときに再度ダウンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 정리한 항목은 서버에 있는 한 필요할 때 다시 다운로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que for limpo aqui é baixado de novo quando você precisar, desde que seu servidor o tenha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что здесь удалено, загрузится снова, когда понадобится, если оно есть на вашем сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只要您的服务器上存有，此处清除的内容都会在需要时重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要您的伺服器仍保有，在此清除的任何內容都會在您需要時再次下載。"
          }
        }
      }
    },
