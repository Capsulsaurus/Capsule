    "app.quarantine.surface.pending_drop.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفع شخص ما هذا عبر أحد روابطك. إنه بانتظار قبولك له في مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemand hat dies über einen deiner Links hochgeladen. Es wartet darauf, dass du es in deine Mediathek aufnimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone uploaded this through one of your links. It's waiting for you to accept it into your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguien subió esto a través de uno de tus enlaces. Está esperando a que lo aceptes en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quelqu'un a téléversé cet élément via l'un de vos liens. Il attend que vous l'acceptiez dans votre photothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी ने इसे आपके किसी लिंक से अपलोड किया है। यह आपकी लाइब्रेरी में स्वीकार किए जाने की प्रतीक्षा कर रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualcuno l'ha caricato tramite uno dei tuoi link. Attende che tu lo accetti nella tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かがあなたのリンクからこれをアップロードしました。ライブラリへの取り込みの承認を待っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가가 내 링크를 통해 이 항목을 업로드했습니다. 보관함에 수락되기를 기다리고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguém enviou isto por um dos seus links. Está aguardando você aceitá-lo na sua biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто-то загрузил это по одной из ваших ссылок. Оно ожидает, пока вы примете его в медиатеку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人通过您的某个链接上传了此内容，正在等待您将其接受到资料库中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有人透過您的其中一個連結上傳了此項目，正在等候您將其接受至您的圖庫。"
          }
        }
      }
    },
    "app.quarantine.surface.restore_conflict": {
      "localizations": {
        "ar": {
