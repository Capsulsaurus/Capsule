    "notification.quota_soft.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقتربت من حدّ التخزين لديك. لا يزال الرفع يعمل حاليًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast dein Speicherlimit fast erreicht. Uploads funktionieren vorerst weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are close to your storage limit. Uploads still work for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás cerca de tu límite de almacenamiento. Por ahora, las subidas siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous approchez de votre limite de stockage. Les téléversements fonctionnent encore pour le moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अपनी स्टोरेज सीमा के क़रीब हैं। फ़िलहाल अपलोड अब भी काम कर रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei vicino al limite dello spazio di archiviazione. Per ora i caricamenti funzionano ancora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージの上限に近づいています。現時点ではアップロードは引き続き可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 한도에 가까워지고 있습니다. 아직은 업로드할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está perto do limite de armazenamento. Os envios ainda funcionam por enquanto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы приближаетесь к лимиту хранилища. Пока загрузки работают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
