          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаётся ключ, защищающий вашу медиатеку, и сохраняется под защитой фразы восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
