        }
      }
    },
    "app.settings.maintenance.dedupe.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكتفي Capsule بالعثور على النسخ المكررة. اختيار النسخة التي تحتفظ بها يعود إليك دائمًا — لا يُدمج أو يُحذف أي شيء تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule findet Duplikate nur. Welche Kopie du behältst, entscheidest immer du – nichts wird von selbst zusammengeführt oder gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule only finds duplicates. Which copy to keep is always yours to choose — nothing is merged or deleted on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule solo encuentra duplicados. Tú eliges siempre qué copia conservar: no se combina ni se elimina nada por sí solo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule se contente de trouver les doublons. Le choix de la copie à conserver vous appartient toujours : rien n'est fusionné ni supprimé automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule केवल डुप्लिकेट ढूँढता है। कौन-सी कॉपी रखनी है, यह हमेशा आप चुनते हैं — अपने आप कुछ भी मर्ज या हटाया नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule si limita a trovare i duplicati. Quale copia tenere lo scegli sempre tu: nulla viene unito o eliminato automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は重複を見つけるだけです。どのコピーを残すかは常にあなたが選びます。自動で結合や削除が行われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 중복 항목을 찾기만 합니다. 어떤 사본을 남길지는 항상 사용자가 선택하며, 자동으로 병합되거나 삭제되는 항목은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule apenas encontra duplicatas. A escolha de qual cópia manter é sempre sua — nada é mesclado ou apagado automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule только находит дубликаты. Какую копию оставить, всегда решаете вы — ничего не объединяется и не удаляется само по себе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 只负责查找重复项。保留哪一份始终由您决定——不会自动合并或删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 只會找出重複項目。要保留哪一份永遠由您決定，不會自動合併或刪除任何內容。"
          }
        }
      }
    },
