    "app.devices.cohort.explanation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُجمَّع الإدخالات حسب الجهاز. إعادة تثبيت Capsule تسجّل مفاتيح جديدة، لذا قد يظهر هاتف واحد هنا أكثر من مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einträge werden nach Gerät gruppiert. Bei einer Neuinstallation von Capsule werden neue Schlüssel registriert, daher kann ein Telefon hier mehrmals erscheinen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entries are grouped by device. Reinstalling Capsule enrolls new keys, so one phone can appear here more than once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las entradas se agrupan por dispositivo. Al reinstalar Capsule se registran claves nuevas, por lo que un mismo teléfono puede aparecer aquí más de una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les entrées sont regroupées par appareil. Réinstaller Capsule enrôle de nouvelles clés : un même téléphone peut donc apparaître ici plusieurs fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रविष्टियाँ डिवाइस के अनुसार समूहित हैं। Capsule को फिर से इंस्टॉल करने पर नई कुंजियाँ पंजीकृत होती हैं, इसलिए एक फ़ोन यहाँ एक से अधिक बार दिख सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci sono raggruppate per dispositivo. Reinstallando Capsule vengono registrate nuove chiavi, quindi uno stesso telefono può comparire qui più volte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エントリはデバイスごとにグループ化されます。Capsule を再インストールすると新しい鍵が登録されるため、1台のスマートフォンがここに複数回表示されることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "항목은 기기별로 그룹화됩니다. Capsule을 다시 설치하면 새 키가 등록되므로 하나의 휴대폰이 여기에 여러 번 표시될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As entradas são agrupadas por dispositivo. Reinstalar o Capsule registra novas chaves, então um mesmo celular pode aparecer aqui mais de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записи сгруппированы по устройствам. При переустановке Capsule регистрируются новые ключи, поэтому один телефон может появиться здесь несколько раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "条目按设备分组。重新安装 Capsule 会注册新密钥，因此同一部手机可能在此出现多次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "項目會依裝置分組。重新安裝 Capsule 會註冊新的密鑰，因此同一支手機可能在這裡出現不只一次。"
          }
        }
      }
    },
