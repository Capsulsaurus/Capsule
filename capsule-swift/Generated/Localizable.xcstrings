    "app.enrollment.failure.hardware.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على Capsule وضع مفاتيح هذا الجهاز في التخزين الآمن الخاص به. غالبًا ما تنجح المحاولة مرة أخرى. ويمكنك أيضًا المتابعة بمفاتيح محفوظة برمجيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule konnte die Schlüssel dieses Geräts nicht in seinem sicheren Speicher ablegen. Ein erneuter Versuch hilft oft. Du kannst auch mit Schlüsseln in Software fortfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule couldn't put this device's keys in its secure storage. Trying again often works. You can also continue with keys kept in software."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no pudo guardar las claves de este dispositivo en su almacenamiento seguro. Volver a intentarlo suele funcionar. También puedes continuar con claves guardadas por software."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas pu placer les clés de cet appareil dans son stockage sécurisé. Réessayer fonctionne souvent. Vous pouvez aussi continuer avec des clés conservées par logiciel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule इस डिवाइस की कुंजियाँ उसके सुरक्षित स्टोरेज में नहीं रख सका। फिर से प्रयास करने पर अक्सर यह काम कर जाता है। आप सॉफ़्टवेयर में रखी कुंजियों के साथ भी जारी रख सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non è riuscito a salvare le chiavi di questo dispositivo nella sua memoria sicura. Spesso riprovare funziona. Puoi anche continuare con chiavi conservate via software."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はこのデバイスの鍵をセキュアストレージに保存できませんでした。もう一度試すとうまくいくことがよくあります。ソフトウェアで保管する鍵で続行することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 이 기기의 키를 보안 저장소에 넣지 못했습니다. 다시 시도하면 대부분 해결됩니다. 소프트웨어에 보관되는 키로 계속할 수도 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não conseguiu colocar as chaves deste dispositivo no armazenamento seguro dele. Tentar novamente costuma funcionar. Você também pode continuar com chaves mantidas em software."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не удалось поместить ключи этого устройства в его защищённое хранилище. Повторная попытка часто помогает. Также можно продолжить с ключами, хранящимися программно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 无法将此设备的密钥存入其安全存储区。重试通常可以解决。您也可以继续使用以软件方式保存的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 無法將此裝置的密鑰存放到其安全儲存區。再試一次通常就能成功。你也可以使用以軟體存放的密鑰繼續。"
          }
        }
      }
    },
    "app.enrollment.failure.hardware.deviation_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن قراءة المفاتيح البرمجية بواسطة أي شيء يصل إلى تخزين هذا الجهاز، بينما تقاوم المفاتيح المدعومة بالعتاد ذلك. يمكنك إعداد هذا الجهاز مجددًا لاحقًا على العتاد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Software-Schlüssel können von allem gelesen werden, was Zugriff auf den Speicher dieses Geräts erhält – hardwaregestützte Schlüssel widerstehen dem. Du kannst dieses Gerät später erneut mit Hardware einrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software keys can be read by anything that gets into this device's storage, which hardware-backed keys resist. You can set this device up again later on hardware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de software pueden ser leídas por cualquier cosa que acceda al almacenamiento de este dispositivo, algo que las claves respaldadas por hardware resisten. Puedes volver a configurar este dispositivo con hardware más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés logicielles peuvent être lues par tout ce qui accède au stockage de cet appareil, ce à quoi les clés protégées par le matériel résistent. Vous pourrez reconfigurer cet appareil plus tard avec le matériel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सॉफ़्टवेयर कुंजियों को वह कुछ भी पढ़ सकता है जो इस डिवाइस के स्टोरेज तक पहुँच जाए, जबकि हार्डवेयर-समर्थित कुंजियाँ इसका प्रतिरोध करती हैं। आप बाद में इस डिवाइस को हार्डवेयर पर फिर से सेट अप कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi software possono essere lette da qualsiasi cosa acceda alla memoria di questo dispositivo, mentre le chiavi protette dall'hardware resistono. Potrai riconfigurare questo dispositivo con l'hardware in seguito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ソフトウェア鍵は、このデバイスのストレージに侵入したものなら何でも読み取れますが、ハードウェアで保護された鍵はそれに耐えられます。あとでこのデバイスをハードウェア鍵で設定し直すこともできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소프트웨어 키는 이 기기의 저장소에 접근하는 모든 것이 읽을 수 있지만, 하드웨어로 보호되는 키는 이를 막아 줍니다. 나중에 이 기기를 하드웨어 키로 다시 설정할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves em software podem ser lidas por qualquer coisa que acesse o armazenamento deste dispositivo, algo a que chaves protegidas por hardware resistem. Você pode configurar este dispositivo novamente com hardware mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программные ключи может прочитать всё, что получит доступ к хранилищу этого устройства, а ключи с аппаратной защитой этому противостоят. Позже вы сможете заново настроить это устройство с аппаратными ключами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何能访问此设备存储的程序都可以读取软件密钥，而硬件保护的密钥能抵御这种情况。您之后可以使用硬件重新设置此设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何能存取此裝置儲存空間的東西都能讀取軟體密鑰，而硬體保護的密鑰則能抵禦這種情況。你之後可以再以硬體方式重新設定此裝置。"
          }
        }
      }
    },
