          }
        }
      }
    },
    "app.quarantine.storage.recorded_only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُحتفظ إلا بسجل لما حدث — لا توجد بيانات هنا لاستردادها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde nur ein Eintrag über das Geschehene aufbewahrt – hier gibt es keine Daten zum Wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only a record of what happened was kept — there's no data here to recover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se guardó un registro de lo ocurrido; aquí no hay datos que recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une trace de l'événement a été conservée : il n'y a ici aucune donnée à récupérer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस बात का रिकॉर्ड रखा गया कि क्या हुआ — यहाँ रिकवर करने के लिए कोई डेटा नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stata conservata solo una registrazione dell'accaduto: non ci sono dati da recuperare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発生した記録だけが残っており、復元できるデータはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발생한 일에 대한 기록만 보관되었습니다. 복구할 데이터는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só foi guardado um registro do que aconteceu — não há dados aqui para recuperar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранена только запись о произошедшем — восстанавливать здесь нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留了事件记录，这里没有可恢复的数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只保留了發生經過的紀錄，這裡沒有可復原的資料。"
          }
        }
      }
    },
