    "app.auth.signup.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر معرّفًا وكلمة مرور لهذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle ein Handle und ein Passwort für diesen Server."
          }
        },
        "en": {
