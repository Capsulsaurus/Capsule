    "app.quarantine.discard.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُتلَف ما تم الاحتفاظ به نهائيًا. يبقى سجل ما حدث في سجلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Aufbewahrte wird endgültig vernichtet. Der Eintrag, dass dies passiert ist, bleibt in deinem Verlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What was kept will be destroyed for good. The record that this happened stays in your history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que se guardó se destruirá para siempre. El registro de lo ocurrido se conserva en tu historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui a été conservé sera définitivement détruit. La trace de l'événement reste dans votre historique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो रखा गया था वह हमेशा के लिए नष्ट हो जाएगा। ऐसा होने का रिकॉर्ड आपके इतिहास में बना रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò che è stato conservato verrà distrutto definitivamente. La registrazione dell'accaduto resta nella tua cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管されているデータは完全に消去されます。発生した記録は履歴に残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 항목이 영구적으로 파기됩니다. 이 일이 발생했다는 기록은 기록에 남습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que foi guardado será destruído para sempre. O registro de que isso aconteceu permanece no seu histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые данные будут уничтожены навсегда. Запись о том, что это произошло, останется в вашей истории."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的内容将被永久销毁。事件记录仍会保留在您的历史记录中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留的內容將被永久銷毀。此事發生過的紀錄會留在您的歷史紀錄中。"
          }
        }
      }
    },
