    "settings.language.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدد اللغة الكلمات المعروضة على الشاشة. وتحدد المنطقة طريقة كتابة التواريخ والأوقات والأرقام. كلاهما يتبع إعدادات النظام حتى تغيّرهما، ويبقيان على هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache bestimmt die Texte auf dem Bildschirm. Die Region bestimmt, wie Datum, Uhrzeit und Zahlen geschrieben werden. Beide folgen deinem System, bis du sie änderst, und gelten nur auf diesem Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language picks the words on screen. Region picks how dates, times and numbers are written. Both follow your system until you change them, and stay on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma determina los textos de la pantalla. La región determina cómo se escriben las fechas, las horas y los números. Ambos siguen la configuración del sistema hasta que los cambies y se guardan solo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue détermine les textes affichés. La région détermine le format des dates, des heures et des nombres. Les deux suivent votre système tant que vous ne les modifiez pas, et restent propres à cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भाषा से तय होता है कि स्क्रीन पर कौन-से शब्द दिखें। क्षेत्र से तय होता है कि तारीख़, समय और संख्याएँ कैसे लिखी जाएँ। जब तक आप इन्हें नहीं बदलते, दोनों आपके सिस्टम के अनुसार रहते हैं, और ये इसी डिवाइस पर रहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua sceglie le parole sullo schermo. La regione sceglie come vengono scritti date, ore e numeri. Entrambe seguono il sistema finché non le modifichi e restano su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語は画面に表示される文字を決め、地域は日付、時刻、数値の表記方法を決めます。どちらも変更するまではシステムの設定に従い、このデバイスにのみ保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언어는 화면에 표시되는 문구를 정합니다. 지역은 날짜, 시간, 숫자의 표시 방식을 정합니다. 둘 다 변경하기 전까지는 시스템 설정을 따르며, 이 기기에만 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma define as palavras na tela. A região define como datas, horas e números são escritos. Ambos seguem o sistema até você alterá-los e ficam salvos apenas neste dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык определяет текст на экране. Регион определяет формат дат, времени и чисел. Оба параметра следуют настройкам системы, пока вы их не измените, и сохраняются только на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言决定屏幕上显示的文字，地区决定日期、时间和数字的书写方式。在您更改之前，两者都跟随系统设置，且仅保存在此设备上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "語言決定畫面上顯示的文字，地區決定日期、時間和數字的格式。兩者都會跟隨系統設定，直到您變更為止，且僅儲存在此裝置上。"
          }
        }
      }
    },
