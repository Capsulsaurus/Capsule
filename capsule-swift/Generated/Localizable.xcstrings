    "app.quarantine.surface.orphan.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عُثر على ملف صورة بلا سجل يوضّح ماهيته. يُحتفظ بالملف تمامًا كما كان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Fotodatei wurde ohne Eintrag dazu gefunden, was sie ist. Die Datei wird genau so aufbewahrt, wie sie war."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo file was found with no record of what it is. The file is kept exactly as it was."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se encontró un archivo de foto sin ningún registro de lo que es. El archivo se conserva exactamente como estaba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier photo a été trouvé sans fiche indiquant de quoi il s'agit. Le fichier est conservé exactement tel quel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक फ़ोटो फ़ाइल मिली जिसका कोई रिकॉर्ड नहीं है कि वह क्या है। फ़ाइल को ठीक वैसा ही रखा गया है जैसी वह थी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È stato trovato un file foto senza alcun record che indichi cosa sia. Il file viene conservato esattamente com'era."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何の写真かを示す記録のない写真ファイルが見つかりました。ファイルはそのままの状態で保管されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇인지에 대한 기록이 없는 사진 파일이 발견되었습니다. 파일은 원래 상태 그대로 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi encontrado um arquivo de foto sem registro do que ele é. O arquivo está guardado exatamente como estava."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найден файл фото без записи о том, что это. Файл сохранён в точности как был."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现了一个照片文件，但没有关于它的记录。该文件已按原样保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發現一個照片檔案，但沒有說明其內容的紀錄。此檔案會完全按原樣保留。"
          }
        }
      }
    },
    "app.quarantine.surface.pending_drop": {
