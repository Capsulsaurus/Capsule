    "app.enrollment.stage.device_keys.explanation": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء مفاتيح هذا الجهاز، في تخزينه الآمن إن توفّر لديه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Schlüssel dieses Geräts werden erstellt – im sicheren Speicher, sofern das Gerät einen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating this device's keys, in its secure storage where the device has it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creando las claves de este dispositivo, en su almacenamiento seguro si lo tiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Création des clés de cet appareil, dans son stockage sécurisé s'il en dispose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस की कुंजियाँ बनाई जा रही हैं, जहाँ उपलब्ध हो वहाँ इसके सुरक्षित स्टोरेज में।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creazione delle chiavi di questo dispositivo, nella sua memoria sicura se disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスの鍵を、セキュアストレージがある場合はそこに作成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 키를 생성하며, 기기에 보안 저장소가 있으면 그곳에 보관합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criando as chaves deste dispositivo, no armazenamento seguro dele quando disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создаются ключи этого устройства — в его защищённом хранилище, если оно есть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
