        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de synchronisation est obsolète. Capsule va resynchroniser depuis le début."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक सत्र पुराना है। Capsule शुरू से फिर से सिंक करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione di sincronizzazione non è aggiornata. Capsule risincronizzerà dall'inizio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期セッションが最新ではありません。Capsule は最初から再同期します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 세션이 오래되었습니다. Capsule이 처음부터 다시 동기화합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão de sincronização está desatualizada. O Capsule vai sincronizar novamente do início."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс синхронизации устарел. Capsule повторно синхронизируется с самого начала."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步会话已过期。Capsule 将从头重新同步。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同步工作階段已過期。Capsule 會從頭重新同步。"
          }
        }
      }
    },
    "error.sync.unauthenticated": {
