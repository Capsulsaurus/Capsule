          }
        }
      }
    },
    "error.upload.session_not_found": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية جلسة الرفع. جارٍ البدء من جديد…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Upload-Sitzung ist abgelaufen. Neustart…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload session expired. Starting over…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión de subida ha caducado. Empezando de nuevo…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de téléversement a expiré. Redémarrage…"
          }
