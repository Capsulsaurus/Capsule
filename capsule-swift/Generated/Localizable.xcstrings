    "error.drop.at_capacity": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعامل هذا الخادم مع عدد كبير جدًا من روابط الرفع حاليًا. يُرجى المحاولة مرة أخرى بعد قليل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server verarbeitet gerade zu viele Upload-Links. Bitte versuche es in Kürze erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This server is handling too many upload links right now. Please try again shortly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está gestionando demasiados enlaces de subida en este momento. Inténtalo de nuevo en breve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur gère trop de liens de téléversement en ce moment. Veuillez réessayer sous peu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्वर अभी बहुत अधिक अपलोड लिंक संभाल रहा है। कृपया थोड़ी देर बाद फिर से प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al momento questo server sta gestendo troppi link di caricamento. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーは現在、多数のアップロードリンクを処理しています。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 이 서버가 처리 중인 업로드 링크가 너무 많습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor está lidando com muitos links de envio no momento. Tente novamente em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас этот сервер обрабатывает слишком много ссылок для загрузки. Повторите попытку чуть позже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器当前正在处理过多上传链接。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此伺服器目前處理的上傳連結過多，請稍後再試。"
          }
        }
      }
    },
