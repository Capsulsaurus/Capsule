    "app.quarantine.reason.malformed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة البيانات كأي شيء يفهمه Capsule."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Daten konnten nicht als etwas gelesen werden, das Capsule versteht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The data couldn't be read as anything Capsule understands."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos no se pudieron leer como nada que Capsule entienda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données n'ont pu être lues sous aucune forme que Capsule comprend."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा को किसी ऐसी चीज़ के रूप में नहीं पढ़ा जा सका जिसे Capsule समझता हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile interpretare i dati in un formato comprensibile per Capsule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データを Capsule が理解できる形式として読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터를 Capsule이 이해할 수 있는 형식으로 읽을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler os dados como algo que o Capsule entenda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные не удалось распознать ни в одном из понятных Capsule форматов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些数据无法被读取为 Capsule 可识别的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法將這些資料讀取為 Capsule 能理解的任何內容。"
          }
        }
      }
    },
    "app.quarantine.reason.schema_ahead": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كُتب هذا بواسطة إصدار أحدث من Capsule. يُحتفظ به تمامًا كما هو، ولن يغيّره هذا الإصدار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wurde von einer neueren Version von Capsule geschrieben. Es wird genau so aufbewahrt, wie es ist, und diese Version ändert es nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was written by a newer version of Capsule. It's kept exactly as it is, and this version won't change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto lo escribió una versión más reciente de Capsule. Se conserva exactamente como está y esta versión no lo modificará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément a été écrit par une version plus récente de Capsule. Il est conservé exactement tel quel, et cette version ne le modifiera pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे Capsule के नए संस्करण ने लिखा था। इसे ठीक वैसा ही रखा गया है जैसा यह है, और यह संस्करण इसे नहीं बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento è stato scritto da una versione più recente di Capsule. Viene conservato esattamente com'è e questa versione non lo modificherà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは新しいバージョンの Capsule で書き込まれました。そのままの状態で保管され、このバージョンで変更されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전의 Capsule에서 작성된 항목입니다. 있는 그대로 보관되며, 이 버전에서는 변경하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto foi gravado por uma versão mais recente do Capsule. Está guardado exatamente como está, e esta versão não vai alterá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это записано более новой версией Capsule. Данные сохранены в точности как есть, и эта версия не будет их изменять."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目由更新版本的 Capsule 写入。它会按原样完整保留，此版本不会对其做任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目由較新版本的 Capsule 寫入。它會完全按原樣保留，此版本不會變更它。"
          }
        }
      }
    },
    "app.quarantine.reason.server_rejected": {
      "localizations": {
        "ar": {
