    "app.settings.keys.enroll.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل الرمز مرة واحدة وتنتهي صلاحيته قريبًا. ستقارن رمز أمان على كلا الجهازين قبل نقل أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code funktioniert einmal und läuft bald ab. Bevor etwas übertragen wird, vergleichst du auf beiden Geräten einen Sicherheitscode."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code works once and expires shortly. You'll compare a safety code on both devices before anything is transferred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código solo funciona una vez y caduca en poco tiempo. Compararás un código de seguridad en ambos dispositivos antes de que se transfiera nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code ne fonctionne qu'une fois et expire rapidement. Vous comparerez un code de sécurité sur les deux appareils avant tout transfert."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कोड एक ही बार काम करता है और जल्द ही समाप्त हो जाता है। कुछ भी स्थानांतरित होने से पहले आप दोनों डिवाइस पर एक सुरक्षा कोड का मिलान करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice funziona una sola volta e scade a breve. Prima di trasferire qualsiasi cosa confronterai un codice di sicurezza su entrambi i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このコードは1回限り有効で、まもなく期限切れになります。転送を始める前に、両方のデバイスで安全確認コードを照合します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드는 한 번만 사용할 수 있으며 곧 만료됩니다. 전송이 시작되기 전에 두 기기에서 보안 코드를 비교하게 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código funciona uma única vez e expira em pouco tempo. Você vai comparar um código de segurança nos dois dispositivos antes de qualquer transferência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Код действует один раз и вскоре истекает. Перед передачей данных вы сверите код безопасности на обоих устройствах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此代码仅能使用一次，且很快就会过期。在传输任何内容之前，您需要在两台设备上核对安全码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此代碼只能使用一次，且很快就會過期。在傳輸任何內容之前，您會在兩台裝置上比對安全碼。"
          }
        }
      }
    },
