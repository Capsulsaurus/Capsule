    "app.moderation.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تحظر أي شخص ولم تقدّم أي بلاغ، ولم يتخذ خادمك أي إجراء بشأن حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast niemanden blockiert und nichts gemeldet, und dein Server hat keine Maßnahmen gegen dein Konto ergriffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't blocked anyone or filed a report, and your server hasn't acted on your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No has bloqueado a nadie ni enviado ninguna denuncia, y tu servidor no ha tomado ninguna medida sobre tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez bloqué personne ni effectué de signalement, et votre serveur n'a pris aucune mesure concernant votre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने न किसी को ब्लॉक किया है, न कोई रिपोर्ट दर्ज की है, और आपके सर्वर ने आपके खाते पर कोई कार्रवाई नहीं की है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai bloccato nessuno né inviato segnalazioni, e il tuo server non ha intrapreso azioni sul tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロックや報告は行われておらず、サーバーもあなたのアカウントに対して何の措置も取っていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차단한 사람이나 제출한 신고가 없으며, 서버가 계정에 대해 조치를 취한 적도 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não bloqueou ninguém nem fez denúncias, e seu servidor não tomou nenhuma ação na sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы никого не заблокировали и не отправляли жалоб, а ваш сервер не применял мер к вашей учётной записи."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您没有屏蔽任何人或提交举报，您的服务器也未对您的账户采取任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您尚未封鎖任何人或提出檢舉，您的伺服器也未曾對您的帳號採取任何處置。"
          }
        }
      }
    },
    "app.moderation.empty.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد ما يُعرض"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts anzuzeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to Show"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que mostrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à afficher"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखाने के लिए कुछ नहीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da mostrare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する項目なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표시할 항목 없음"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para Mostrar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь пока пусто"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂无内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可顯示的內容"
          }
        }
      }
    },
    "app.moderation.note.appeal_master_key": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُؤكَّد الطعن بمفتاح حسابك، لا بجلستك — لذا يمكنك تقديم طعن حتى لو كان حسابك هو الموقوف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Einspruch wird mit deinem Kontoschlüssel bestätigt, nicht mit deiner Sitzung – so kannst du auch dann Einspruch einlegen, wenn gerade dein Konto gesperrt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An appeal is confirmed with your account key, not your session — so you can appeal even when it's your account that's suspended."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las apelaciones se confirman con la clave de tu cuenta, no con tu sesión, así que puedes apelar incluso si la cuenta suspendida es la tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un recours est confirmé avec la clé de votre compte, et non avec votre session : vous pouvez donc faire appel même si c'est votre compte qui est suspendu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपील की पुष्टि आपकी खाता कुंजी से होती है, आपके सत्र से नहीं — इसलिए आपका खाता निलंबित होने पर भी आप अपील कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ricorso viene confermato con la chiave del tuo account, non con la sessione: così puoi fare ricorso anche quando è proprio il tuo account a essere sospeso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "異議申し立てはセッションではなくアカウントキーで確認されます。そのため、アカウント自体が停止されていても異議を申し立てられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이의 제기는 세션이 아닌 계정 키로 확인됩니다. 따라서 계정이 정지된 경우에도 이의를 제기할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um recurso é confirmado com a chave da sua conta, não com a sua sessão — então você pode recorrer mesmo quando é a sua conta que está suspensa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Апелляция подтверждается ключом учётной записи, а не сеансом — поэтому её можно подать, даже если приостановлена именно ваша учётная запись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "申诉通过您的账户密钥确认，而非会话。因此即使被停用的正是您的账户，您也可以申诉。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "申訴是以您的帳號金鑰確認，而非工作階段，因此即使您的帳號遭停權，您仍可提出申訴。"
          }
        }
      }
    },
    "app.moderation.note.no_scanning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع خادمك الاطلاع على صورك. فهي تُختم قبل مغادرتها جهازك، فلا يوجد ما يمكن فحصه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server kann deine Fotos nicht einsehen. Sie werden versiegelt, bevor sie dein Gerät verlassen, daher gibt es nichts zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server can't look at your photos. They're sealed before they leave your device, so there's nothing to scan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor no puede ver tus fotos. Se sellan antes de salir de tu dispositivo, así que no hay nada que analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur ne peut pas voir vos photos. Elles sont scellées avant de quitter votre appareil, il n'y a donc rien à analyser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका सर्वर आपकी फ़ोटो नहीं देख सकता। वे आपके डिवाइस से निकलने से पहले ही सील कर दी जाती हैं, इसलिए स्कैन करने के लिए कुछ होता ही नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server non può vedere le tue foto. Vengono sigillate prima di lasciare il dispositivo, quindi non c'è nulla da analizzare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはあなたの写真を見ることができません。写真はデバイスを離れる前に暗号化されるため、スキャンできるものは何もありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버는 사진을 볼 수 없습니다. 사진은 기기를 떠나기 전에 봉인되므로 스캔할 수 있는 것이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor não consegue ver suas fotos. Elas são lacradas antes de sair do seu dispositivo, então não há nada para analisar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер не может просматривать ваши фото. Они шифруются до того, как покинут устройство, поэтому сканировать нечего."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器无法查看您的照片。照片在离开您的设备前就已加密封存，因此没有任何内容可供扫描。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的伺服器無法查看您的照片。照片在離開您的裝置前就已加密封存，因此沒有任何內容可供掃描。"
          }
        }
      }
    },
    "app.moderation.note.no_silent_ops": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُسجَّل هنا كل إجراء يُتخذ بشأن حسابك. لا يحدث أي شيء خفية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Maßnahme an deinem Konto wird hier festgehalten. Nichts geschieht im Verborgenen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every action taken on your account is recorded here. Nothing happens quietly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada medida tomada sobre tu cuenta queda registrada aquí. Nada ocurre en silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mesure prise concernant votre compte est enregistrée ici. Rien ne se fait en silence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खाते पर की गई हर कार्रवाई यहाँ दर्ज होती है। कुछ भी चुपचाप नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni azione intrapresa sul tuo account viene registrata qui. Nulla avviene di nascosto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントに対するすべての措置はここに記録されます。気づかないうちに行われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에 대해 취해진 모든 조치가 여기에 기록됩니다. 몰래 일어나는 일은 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toda ação tomada na sua conta fica registrada aqui. Nada acontece em silêncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждое действие с вашей учётной записью записывается здесь. Ничего не происходит незаметно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对您账户采取的每项操作都会记录在这里，不会有任何悄然发生的事。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對您帳號採取的每項處置都會記錄在這裡。沒有任何事會悄悄發生。"
          }
        }
      }
    },
