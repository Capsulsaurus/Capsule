    "mfa.totp.start_description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تطبيق مصادقة (مثل Google Authenticator أو Authy) لمسح رمز QR وإنشاء رموز لمرة واحدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine Authentifizierungs-App (z. B. Google Authenticator, Authy), um einen QR-Code zu scannen und Einmalcodes zu erzeugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an authenticator app (e.g. Google Authenticator, Authy) to scan a QR code and generate one-time codes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una app de autenticación (p. ej., Google Authenticator o Authy) para escanear un código QR y generar códigos de un solo uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une app d'authentification (par ex. Google Authenticator, Authy) pour scanner un QR code et générer des codes à usage unique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR कोड स्कैन करने और वन-टाइम कोड बनाने के लिए किसी ऑथेंटिकेटर ऐप (जैसे Google Authenticator, Authy) का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un'app di autenticazione (ad es. Google Authenticator, Authy) per scansionare un codice QR e generare codici monouso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリ（Google Authenticator、Authy など）で QR コードをスキャンし、ワンタイムコードを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱(예: Google Authenticator, Authy)으로 QR 코드를 스캔하여 일회용 코드를 생성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um app autenticador (por exemplo, Google Authenticator ou Authy) para ler um código QR e gerar códigos de uso único."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте приложение-аутентификатор (например, Google Authenticator или Authy), чтобы отсканировать QR-код и генерировать одноразовые коды."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用验证器应用（例如 Google Authenticator、Authy）扫描二维码并生成一次性验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用驗證器 App（例如 Google Authenticator、Authy）掃描 QR 碼並產生一次性驗證碼。"
          }
        }
      }
    },
