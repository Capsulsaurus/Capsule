    "app.settings.account.actions.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسجيل الخروج لا يمسّ صورك على هذا الجهاز. لا يُحذف أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Abmelden bleiben deine Fotos auf diesem Gerät unangetastet. Es wird nichts gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing out leaves your photos on this device alone. Nothing is deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al cerrar sesión, tus fotos de este dispositivo no se tocan. No se elimina nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déconnexion ne touche pas aux photos présentes sur cet appareil. Rien n'est supprimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "साइन आउट करने से इस डिवाइस पर मौजूद आपकी फ़ोटो पर कोई असर नहीं पड़ता। कुछ भी नहीं हटाया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscendo dall'account le foto su questo dispositivo restano intatte. Nulla viene eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインアウトしても、このデバイス上の写真はそのまま残ります。何も削除されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그아웃해도 이 기기의 사진은 그대로 유지됩니다. 아무것도 삭제되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair não mexe nas fotos deste dispositivo. Nada é apagado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При выходе фото на этом устройстве остаются нетронутыми. Ничего не удаляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录不会影响此设备上的照片，不会删除任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登出不會影響此裝置上的照片，不會刪除任何內容。"
          }
        }
      }
    },
