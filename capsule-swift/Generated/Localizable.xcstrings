    "app.settings.sync.force.confirm.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينقل Capsule كل ما هو معلّق عبر اتصالك الحالي، بما في ذلك الخلوي. قد يستهلك هذا الكثير من البيانات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule überträgt alles Ausstehende über deine aktuelle Verbindung, auch über Mobilfunk. Das kann viele Daten verbrauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule will transfer everything outstanding on your current connection, cellular included. This can use a lot of data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule transferirá todo lo pendiente con tu conexión actual, incluidos los datos móviles. Esto puede consumir muchos datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule va transférer tout ce qui est en attente via votre connexion actuelle, y compris cellulaire. Cela peut consommer beaucoup de données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule बाकी सब कुछ आपके मौजूदा कनेक्शन पर ट्रांसफ़र करेगा, सेल्युलर सहित। इसमें बहुत डेटा खर्च हो सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule trasferirà tutto ciò che è in sospeso sulla connessione attuale, rete cellulare inclusa. Questo può consumare molti dati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は、モバイルデータ通信を含む現在の接続で、未処理のものをすべて転送します。大量のデータを使用する場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 셀룰러를 포함한 현재 연결로 남은 모든 항목을 전송합니다. 데이터를 많이 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule vai transferir tudo o que estiver pendente na sua conexão atual, inclusive dados celulares. Isso pode consumir muitos dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule передаст всё ожидающее через текущее подключение, включая сотовую сеть. Это может потребовать много трафика."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 将通过当前网络连接（包括蜂窝网络）传输所有待处理的内容。这可能会消耗大量数据流量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會透過您目前的連線（包括行動網路）傳輸所有待處理的內容。這可能會使用大量數據。"
          }
        }
      }
    },
    "app.settings.sync.force.confirm.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة على هذا الاتصال؟"
          }
