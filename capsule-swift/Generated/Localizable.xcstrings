    "app.share.issued.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح هذا الرابط موجود في العنوان نفسه، لذا يمكن لأي شخص ترسله إليه فتحه. لا يرى الخادم هذا المفتاح أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel zu diesem Link steckt in der Adresse selbst, daher kann ihn jeder öffnen, dem du ihn sendest. Dein Server sieht diesen Schlüssel nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key to this link is in the address itself, so anyone you send it to can open it. Your server never sees that key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de este enlace está en la propia dirección, así que cualquiera a quien se lo envíes puede abrirlo. Tu servidor nunca ve esa clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé de ce lien se trouve dans l'adresse elle-même : toute personne à qui vous l'envoyez peut l'ouvrir. Votre serveur ne voit jamais cette clé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लिंक की कुंजी पते में ही है, इसलिए जिसे भी आप इसे भेजेंगे वह इसे खोल सकता है। आपका सर्वर वह कुंजी कभी नहीं देखता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave di questo link è contenuta nell'indirizzo stesso, quindi chiunque lo riceva può aprirlo. Il tuo server non vede mai quella chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクの鍵はアドレス自体に含まれているため、送信した相手は誰でも開くことができます。その鍵がサーバーに渡ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크의 키는 주소 자체에 포함되어 있으므로, 링크를 받은 사람은 누구나 열 수 있습니다. 서버는 이 키를 볼 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave deste link está no próprio endereço, então qualquer pessoa para quem você o enviar pode abri-lo. Seu servidor nunca vê essa chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ к этой ссылке содержится в самом адресе, поэтому её сможет открыть любой, кому вы её отправите. Ваш сервер никогда не видит этот ключ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此链接的密钥就在地址中，因此您发送给的任何人都可以打开它。您的服务器永远看不到该密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此連結的金鑰就在網址中，因此您傳送給的任何人都能開啟它。您的伺服器永遠看不到該金鑰。"
          }
        }
      }
    },
