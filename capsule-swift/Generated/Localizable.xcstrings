            "value": "Non è stato possibile confermare la tua identità. Nessuna disconnessione effettuata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本人確認ができませんでした。ログアウトは行われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인 확인에 실패했습니다. 로그아웃된 기기는 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível confirmar que é você. Nenhuma sessão foi encerrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подтвердить, что это вы. Выход ни с одного устройства не выполнен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未能确认是您本人。未退出任何设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法確認是您本人，因此未登出任何裝置。"
          }
        }
      }
    },
    "error.auth.revoke_proof_required": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكِّد بمفتاح حسابك لتسجيل الخروج من جميع الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige mit deinem Kontoschlüssel, um dich von allen Geräten abzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm with your account key to log out of all devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma con la clave de tu cuenta para cerrar sesión en todos los dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez avec la clé de votre compte pour vous déconnecter de tous les appareils."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी डिवाइस से लॉग आउट करने के लिए अपनी खाता कुंजी से पुष्टि करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma con la chiave del tuo account per disconnetterti da tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスからログアウトするには、アカウントキーで確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 기기에서 로그아웃하려면 계정 키로 확인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme com a chave da sua conta para sair de todos os dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подтвердите ключом учётной записи, чтобы выйти на всех устройствах."
          }
        },
        "zh-Hans": {
