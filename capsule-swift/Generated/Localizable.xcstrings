    "app.custody.verdict.durable.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ خادمك بهذه الصورة ويمكنه إعادتها. يمكن تحرير النسخة الموجودة على هذا الجهاز بأمان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server hat dieses Foto gespeichert und kann es zurückgeben. Die Kopie auf diesem Gerät kann sicher freigegeben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server holds this photo and can hand it back. The copy on this device can safely be released."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor guarda esta foto y puede devolverla. La copia de este dispositivo se puede liberar con seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur détient cette photo et peut la restituer. La copie sur cet appareil peut être libérée en toute sécurité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर के पास यह फ़ोटो है और वह इसे वापस दे सकता है। इस डिवाइस की कॉपी सुरक्षित रूप से हटाई जा सकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server possiede questa foto e può restituirla. La copia su questo dispositivo può essere liberata in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはこの写真を保管しており、返すことができます。このデバイス上のコピーは安全に解放できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 사진을 보관하고 있으며 돌려줄 수 있습니다. 이 기기의 사본을 안전하게 해제할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor tem esta foto e pode devolvê-la. A cópia neste dispositivo pode ser liberada com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер хранит это фото и может его вернуть. Копию на этом устройстве можно безопасно освободить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的服务器已保存此照片并可将其取回。可以放心释放此设备上的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的伺服器保存了此照片，並能將其取回。可以安全地釋放此裝置上的副本。"
          }
        }
      }
    },
