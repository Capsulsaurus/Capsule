    "app.import.scan.unreadable.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر فتح هذه الملفات — غالبًا بسبب مشكلة في الأذونات. لن يتم استيرادها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Dateien konnten nicht geöffnet werden – meist ein Berechtigungsproblem. Sie werden nicht importiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files couldn't be opened — usually a permissions problem. They won't be imported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos archivos no se pudieron abrir, normalmente por un problema de permisos. No se importarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces fichiers n'ont pas pu être ouverts, généralement à cause d'un problème d'autorisations. Ils ne seront pas importés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये फ़ाइलें खोली नहीं जा सकीं — आमतौर पर यह अनुमतियों की समस्या होती है। इन्हें इंपोर्ट नहीं किया जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire questi file, di solito per un problema di autorizzazioni. Non verranno importati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのファイルは開けませんでした。多くの場合、アクセス権の問題です。これらは読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 파일들을 열 수 없습니다. 대개 권한 문제입니다. 이 파일들은 가져오지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir estes arquivos — geralmente por um problema de permissões. Eles não serão importados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти файлы не удалось открыть — обычно из-за прав доступа. Они не будут импортированы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件无法打开，通常是权限问题。它们不会被导入。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法開啟這些檔案，通常是權限問題。這些檔案不會被匯入。"
          }
        }
      }
    },
