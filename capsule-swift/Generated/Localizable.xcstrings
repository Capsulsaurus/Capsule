    "app.transfer.tier.preview.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صور مصغّرة ونسخة بحجم المعاينة. تُرفع على أي اتصال غير خلوي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniaturen und eine Kopie in Vorschaugröße. Wird über jede Verbindung außer Mobilfunk hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thumbnails and a preview-sized copy. Uploads on any connection that isn't cellular."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniaturas y una copia del tamaño de una vista previa. Se sube con cualquier conexión que no sea de datos móviles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vignettes et une copie au format aperçu. Téléversés sur toute connexion autre que cellulaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थंबनेल और प्रीव्यू आकार की कॉपी। सेल्युलर को छोड़कर किसी भी कनेक्शन पर अपलोड होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniature e una copia in formato anteprima. Viene caricato con qualsiasi connessione non cellulare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネイルとプレビューサイズのコピー。モバイル通信以外の接続でアップロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "썸네일과 미리보기 크기의 사본입니다. 셀룰러가 아닌 모든 연결에서 업로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Miniaturas e uma cópia em tamanho de pré-visualização. É enviada em qualquer conexão que não seja celular."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Миниатюры и копия для просмотра. Загружаются при любом соединении, кроме сотовой сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩略图和一份预览尺寸的副本。在任何非蜂窝网络连接下都会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮圖和預覽尺寸的副本。只要不是行動網路就會上傳。"
          }
        }
      }
    },
