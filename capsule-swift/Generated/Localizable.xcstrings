    "app.custody.link.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيان موقَّع من خادمك بأنه يحتفظ بهذه الصورة — وهو ما يتيح التمييز بين «فقدها الخادم» و«لم تُرفع أبدًا»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die signierte Erklärung deines Servers, dass er dieses Foto gespeichert hat – damit lässt sich „der Server hat es verloren“ von „es wurde nie hochgeladen“ unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server's signed statement that it holds this photo — what makes 'the server lost it' and 'it was never uploaded' tellable apart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La declaración firmada de tu servidor de que guarda esta foto: lo que permite distinguir entre «el servidor la perdió» y «nunca se subió»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La déclaration signée de votre serveur attestant qu'il détient cette photo — ce qui permet de distinguer « le serveur l'a perdue » de « elle n'a jamais été téléversée »."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके सर्वर का हस्ताक्षरित कथन कि उसके पास यह फ़ोटो है — इसी से 'सर्वर ने इसे खो दिया' और 'यह कभी अपलोड ही नहीं हुई' में अंतर पता चलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La dichiarazione firmata del tuo server che attesta che possiede questa foto: è ciò che permette di distinguere tra «il server l'ha persa» e «non è mai stata caricata»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を保管していることを示す、サーバーの署名付き証明です。これにより「サーバーが紛失した」のか「アップロードされていなかった」のかを区別できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 사진을 보관하고 있다는 서명된 증명입니다. 이를 통해 ‘서버가 분실함’과 ‘업로드된 적 없음’을 구별할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A declaração assinada do seu servidor de que tem esta foto — é o que permite distinguir entre 'o servidor a perdeu' e 'ela nunca foi enviada'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписанное заявление вашего сервера о том, что он хранит это фото. Благодаря ему можно отличить «сервер его потерял» от «оно так и не было загружено»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您的服务器签名确认保存此照片的声明，借此可以区分“服务器弄丢了”和“从未上传过”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的伺服器所簽署的聲明，證明它保存了此照片，藉此區分「伺服器遺失了它」和「它從未被上傳」。"
          }
        }
      }
    },
    "app.custody.log.chained": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشكّل الإيصالات سلسلة متصلة"
          }
        },
        "de": {
