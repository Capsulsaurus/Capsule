          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage plein : modifications suspendues"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोरेज भर गया — संपादन रुके हुए हैं"
          }
        },
        "it": {
          "stringUnit": {
