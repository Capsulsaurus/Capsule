    "library.trash.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُحذف العناصر الموجودة في سلة المهملات نهائيًا بعد 30 يومًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Objekte im Papierkorb werden nach 30 Tagen endgültig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Items in trash will be permanently deleted after 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los elementos de la papelera se eliminarán definitivamente al cabo de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les éléments de la corbeille seront définitivement supprimés au bout de 30 jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैश में मौजूद आइटम 30 दिनों के बाद स्थायी रूप से हटा दिए जाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli elementi nel cestino verranno eliminati definitivamente dopo 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱内の項目は 30 日後に完全に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통에 있는 항목은 30일 후 영구적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os itens na lixeira serão excluídos permanentemente após 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Объекты в корзине будут окончательно удалены через 30 дней."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓中的项目将在 30 天后被永久删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾桶中的項目會在 30 天後永久刪除。"
          }
        }
      }
    },
