    "mfa.totp.verify_description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز المكوّن من 6 أرقام من تطبيق المصادقة لإكمال الإعداد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den 6-stelligen Code aus deiner Authentifizierungs-App ein, um die Einrichtung abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the 6-digit code from your authenticator app to complete setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código de 6 dígitos de tu app de autenticación para completar la configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code à 6 chiffres de votre app d'authentification pour terminer la configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटअप पूरा करने के लिए अपने ऑथेंटिकेटर ऐप से 6 अंकों का कोड दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice a 6 cifre dalla tua app di autenticazione per completare la configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定を完了するには、認証アプリに表示される 6 桁のコードを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정을 완료하려면 인증 앱에 표시된 6자리 코드를 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código de 6 dígitos do seu app autenticador para concluir a configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите 6-значный код из приложения-аутентификатора, чтобы завершить настройку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入验证器应用中的 6 位验证码以完成设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入驗證器 App 中的 6 位數驗證碼以完成設定。"
          }
        }
      }
    },
