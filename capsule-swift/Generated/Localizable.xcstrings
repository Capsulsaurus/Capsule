    "app.settings.security.capture.status": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقطات الشاشة والتسجيلات غير محظورة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildschirmfotos und -aufnahmen werden nicht blockiert"
