      }
    },
    "app.transfer.session.waiting.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصلت صورتك. يُنهي الخادم المعالجة — ولا يمكنه قراءة المحتوى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Foto ist angekommen. Der Server schließt den Vorgang ab – er kann die Inhalte nicht lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your photo has arrived. The server is finishing up — it can't read the contents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu foto ha llegado. El servidor está terminando; no puede leer el contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre photo est arrivée. Le serveur termine le traitement, sans pouvoir en lire le contenu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी फ़ोटो पहुँच गई है। सर्वर काम पूरा कर रहा है — वह इसकी सामग्री नहीं पढ़ सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua foto è arrivata. Il server sta completando l'operazione, senza poterne leggere il contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真は届きました。サーバーが処理を完了しています。サーバーは内容を読み取ることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진이 도착했습니다. 서버에서 마무리 중이며, 서버는 콘텐츠를 읽을 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua foto chegou. O servidor está finalizando — ele não consegue ler o conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше фото получено. Сервер завершает обработку — он не может прочитать содержимое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的照片已送达。服务器正在完成处理——它无法读取其内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的照片已送達。伺服器正在完成處理——它無法讀取照片內容。"
          }
        }
      }
    },
    "app.transfer.state.error.title": {
      "localizations": {
        "ar": {
