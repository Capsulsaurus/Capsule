    "app.share.state.offline.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Capsule إلى الخادم لإنشاء رابط أو تغييره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule benötigt deinen Server, um einen Link zu erstellen oder zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule needs your server to create or change a link."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule necesita tu servidor para crear o cambiar un enlace."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule a besoin de votre serveur pour créer ou modifier un lien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक बनाने या बदलने के लिए Capsule को आपके सर्वर की ज़रूरत है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ha bisogno del tuo server per creare o modificare un link."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクの作成や変更にはサーバーへの接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 생성하거나 변경하려면 서버에 연결되어 있어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule precisa do seu servidor para criar ou alterar um link."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы создать или изменить ссылку, Capsule нужен ваш сервер."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
