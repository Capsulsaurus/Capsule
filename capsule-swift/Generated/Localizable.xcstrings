    "app.transfer.tier.index.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجل الصورة وصورة بديلة صغيرة. تُرفع على أي اتصال يعمل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Datensatz des Fotos und ein winziger Platzhalter. Wird über jede funktionierende Verbindung hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The photo's record and a tiny placeholder. Uploads on any working connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de la foto y un pequeño marcador de posición. Se sube con cualquier conexión que funcione."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiche de la photo et une minuscule image provisoire. Téléversés sur toute connexion fonctionnelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो का रिकॉर्ड और एक छोटा प्लेसहोल्डर। किसी भी चालू कनेक्शन पर अपलोड होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il record della foto e un minuscolo segnaposto. Viene caricato con qualsiasi connessione funzionante."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の記録と小さなプレースホルダ。使用可能な接続であればアップロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진의 기록과 작은 자리 표시 이미지입니다. 사용 가능한 모든 연결에서 업로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O registro da foto e um pequeno marcador de posição. É enviado em qualquer conexão que funcione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись о фото и крошечная заглушка. Загружается при любом рабочем соединении."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片的记录和一张极小的占位图。在任何可用连接下都会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "照片的記錄和一張小型預留位置影像。只要有可用連線就會上傳。"
          }
        }
      }
    },
