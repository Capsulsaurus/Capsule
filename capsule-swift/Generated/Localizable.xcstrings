    "app.share.list.section.record_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظة لتتمكن من رؤية ما شاركته ومتى. لم تعد هذه الروابط تفتح أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufbewahrt, damit du sehen kannst, was du wann geteilt hast. Diese Links öffnen nichts mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kept so you can see what you shared and when. These links no longer open anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan para que veas qué compartiste y cuándo. Estos enlaces ya no abren nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservés pour que vous puissiez voir ce que vous avez partagé et quand. Ces liens n'ouvrent plus rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्हें रखा गया है ताकि आप देख सकें कि आपने क्या और कब साझा किया। ये लिंक अब कुछ नहीं खोलते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservati per mostrarti cosa hai condiviso e quando. Questi link non aprono più nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をいつ共有したか確認できるよう保持されています。これらのリンクでは何も開けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 언제 공유했는지 확인할 수 있도록 보관됩니다. 이 링크로는 더 이상 아무것도 열 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantidos para que você veja o que compartilhou e quando. Estes links não abrem mais nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняются, чтобы вы видели, чем и когда делились. Эти ссылки больше ничего не открывают."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留这些记录以便您查看共享过的内容及时间。这些链接已无法打开任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留這些紀錄，讓您查看分享過的內容與時間。這些連結已無法開啟任何內容。"
          }
        }
      }
    },
