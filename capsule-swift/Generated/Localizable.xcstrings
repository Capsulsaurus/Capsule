    "app.settings.confirm.phrase.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب العبارة تمامًا كما هي معروضة. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib die Phrase genau wie angezeigt ein. Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type the phrase exactly as shown. This action can't be undone."
          }
        },
        "es": {
