    "app.storage.exempt.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه هي النسخ الوحيدة. لن يمسحها Capsule حتى يؤكد الخادم أنه يحتفظ بكل منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind die einzigen Kopien. Capsule löscht sie erst, wenn dein Server bestätigt, dass er jede davon hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the only copies. Capsule won't clear them until your server confirms it has each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son las únicas copias. Capsule no las borrará hasta que tu servidor confirme que tiene cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les seules copies. Capsule ne les effacera pas tant que votre serveur n'aura pas confirmé détenir chacune d'elles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये ही एकमात्र कॉपियाँ हैं। जब तक आपका सर्वर हर एक के होने की पुष्टि नहीं करता, Capsule इन्हें साफ़ नहीं करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono le uniche copie. Capsule non le cancellerà finché il tuo server non confermerà di averle tutte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは唯一のコピーです。サーバーが各ファイルの保存を確認するまで、Capsule は消去しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목들은 유일한 사본입니다. 서버가 각 항목을 보관하고 있음을 확인할 때까지 Capsule은 정리하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são as únicas cópias. O Capsule não vai limpá-las até seu servidor confirmar que tem cada uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это единственные копии. Capsule не удалит их, пока ваш сервер не подтвердит получение каждой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是仅有的副本。在您的服务器确认已存有每一份之前，Capsule 不会清除它们。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些是僅有的副本。在您的伺服器確認已保存每一份之前，Capsule 不會清除它們。"
          }
        }
      }
    },
