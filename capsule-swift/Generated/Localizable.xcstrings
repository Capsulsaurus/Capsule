    "app.crossdevice.aborted.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتطابق رموز الأمان، لذا لم يُنقل أي شيء وأصبح الرمز غير صالح. ابدأ من جديد برمز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherheitscodes stimmten nicht überein, daher wurde nichts übertragen und der Code ist ungültig. Beginne erneut mit einem neuen Code."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The safety codes didn't match, so nothing was transferred and the code is dead. Start again with a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos de seguridad no coincidían, así que no se transfirió nada y el código ya no sirve. Empieza de nuevo con un código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes de sécurité ne correspondaient pas : rien n'a été transféré et le code n'est plus valide. Recommencez avec un nouveau code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षा कोड मेल नहीं खाए, इसलिए कुछ भी ट्रांसफ़र नहीं हुआ और कोड अब काम नहीं करेगा। नए कोड के साथ फिर से शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici di sicurezza non corrispondevano, quindi non è stato trasferito nulla e il codice non è più valido. Ricomincia con un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全コードが一致しなかったため、何も転送されず、コードは無効になりました。新しいコードでやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전 코드가 일치하지 않아 아무것도 전송되지 않았으며 코드는 무효화되었습니다. 새 코드로 다시 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos de segurança não coincidiram, então nada foi transferido e o código foi invalidado. Comece novamente com um novo código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коды безопасности не совпали, поэтому ничего не передано, а код больше недействителен. Начните заново с новым кодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安全码不一致，因此没有传输任何内容，该代码也已失效。请使用新代码重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安全碼不相符，因此沒有傳輸任何內容，此代碼也已失效。請使用新代碼重新開始。"
          }
        }
      }
    },
