            "value": "Registro ilegible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiche illisible"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पढ़ा न जा सकने वाला रिकॉर्ड"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Record illeggibile"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れない記録"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 수 없는 기록"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registro Ilegível"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечитаемая запись"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取的记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取的紀錄"
          }
        }
      }
    },
    "app.quarantine.surface.sidecar.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة سجل إحدى الصور. يُحتفظ بالبيانات غير المقروءة تمامًا كما كانت، تحسّبًا لإمكانية استردادها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Eintrag eines Fotos konnte nicht gelesen werden. Die unlesbaren Daten werden genau so aufbewahrt, wie sie waren, falls sie wiederhergestellt werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A photo's record couldn't be read. The unreadable data is kept exactly as it was, in case it can be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el registro de una foto. Los datos ilegibles se conservan exactamente como estaban, por si se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fiche d'une photo n'a pas pu être lue. Les données illisibles sont conservées exactement telles quelles, au cas où elles pourraient être récupérées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी फ़ोटो का रिकॉर्ड पढ़ा नहीं जा सका। पढ़ा न जा सकने वाला डेटा ठीक वैसा ही रखा गया है जैसा वह था, ताकि उसे रिकवर किया जा सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il record di una foto. I dati illeggibili vengono conservati esattamente com'erano, nel caso sia possibile recuperarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の記録を読み取れませんでした。読み取れなかったデータは、復元できる場合に備えてそのままの状態で保管されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진의 기록을 읽을 수 없습니다. 복구할 수 있도록 읽을 수 없는 데이터는 원래 상태 그대로 보관됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o registro de uma foto. Os dados ilegíveis estão guardados exatamente como estavam, caso possam ser recuperados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать запись фото. Нечитаемые данные сохранены в точности как были, на случай если их удастся восстановить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取某张照片的记录。无法读取的数据已按原样保留，以便日后恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取某張照片的紀錄。無法讀取的資料會完全按原樣保留，以便日後可能復原。"
          }
        }
      }
    },
    "app.quarantine.surface.stale_revival": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حالة أقدم مُرسَلة"
          }
        },
        "de": {
