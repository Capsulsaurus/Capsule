    "app.settings.ai.slots.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُنزَّل النماذج بشكل منفصل عن التطبيق، لذا لا تنزّل إلا ما تستخدمه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelle werden getrennt von der App geladen, sodass du nur die lädst, die du nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Models download separately from the app, so you only fetch the ones you use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modelos se descargan por separado de la aplicación, así que solo descargas los que usas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles se téléchargent séparément de l'app : vous ne récupérez que ceux que vous utilisez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल ऐप से अलग डाउनलोड होते हैं, इसलिए आप केवल वही डाउनलोड करते हैं जिनका आप उपयोग करते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I modelli vengono scaricati separatamente dall'app, così scarichi solo quelli che usi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルはアプリとは別にダウンロードされるため、使用するものだけを取得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델은 앱과 별도로 다운로드되므로 사용하는 모델만 받으면 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos são baixados separadamente do app, então você só baixa os que usa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модели загружаются отдельно от приложения, поэтому вы скачиваете только те, которыми пользуетесь."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型与应用分开下载，因此您只需获取您使用的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型與 App 分開下載，因此您只需取得要使用的模型。"
          }
        }
      }
    },
