    "app.recovery.verify.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق سريع من أن العبارة التي حفظتها لا تزال تعمل. لا يتوقف شيء على إجرائه الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine kurze Prüfung, ob die gespeicherte Phrase noch funktioniert. Es hängt nichts davon ab, dass du es jetzt tust."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quick check that the phrase you saved still works. Nothing depends on doing it now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comprobación rápida de que la frase que guardaste sigue funcionando. Nada depende de hacerla ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vérification rapide que la phrase enregistrée fonctionne toujours. Rien n'oblige à le faire maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक छोटी-सी जाँच कि आपके द्वारा सहेजा गया फ़्रेज़ अब भी काम करता है। अभी करना ज़रूरी नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un rapido controllo che la frase salvata funzioni ancora. Non c'è nulla che dipenda dal farlo adesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したフレーズが今も使えるかを簡単に確認します。今すぐ行う必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장해 둔 문구가 아직 유효한지 간단히 확인합니다. 지금 하지 않아도 아무 문제가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação rápida de que a frase que você guardou ainda funciona. Nada depende de fazer isso agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Быстрая проверка того, что сохранённая фраза всё ещё работает. Делать это прямо сейчас не обязательно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速检查您保存的短语是否仍然有效。现在不做也没有任何影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速檢查您保存的短語是否仍然有效。現在不做也沒有任何影響。"
          }
        }
      }
    },
