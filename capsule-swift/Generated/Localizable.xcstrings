    "app.quarantine.detail.actions.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد خيار افتراضي هنا. لن يختار Capsule نيابةً عنك، مهما طال الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier gibt es keine Voreinstellung. Capsule entscheidet nicht für dich, egal wie lange das wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no default here. Capsule won't choose for you, however long this waits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay opción predeterminada. Capsule no decidirá por ti, por mucho que espere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun choix par défaut. Capsule ne décidera pas à votre place, quel que soit le temps d'attente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ कोई डिफ़ॉल्ट नहीं है। Capsule आपके लिए नहीं चुनेगा, चाहे यह कितनी भी देर प्रतीक्षा करे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è un'opzione predefinita. Capsule non sceglierà al posto tuo, per quanto a lungo resti in attesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定の選択はありません。どれだけ時間が経っても、Capsule が代わりに選ぶことはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본값은 없습니다. 얼마나 오래 대기하든 Capsule이 대신 선택하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há opção padrão aqui. O Capsule não vai escolher por você, por mais tempo que isso aguarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Варианта по умолчанию нет. Capsule не будет решать за вас, сколько бы это ни ждало."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有默认选项。无论等待多久，Capsule 都不会替您做决定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡沒有預設選項。無論等待多久，Capsule 都不會替您決定。"
          }
        }
      }
    },
