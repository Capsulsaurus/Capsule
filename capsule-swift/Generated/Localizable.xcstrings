    "error.federation.circuit_open": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف هذا المصدر مؤقتًا بعد أخطاء متكررة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Quelle wird nach wiederholten Fehlern vorübergehend zurückgestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This source is temporarily backed off after repeated errors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fuente está temporalmente en espera tras errores repetidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette source est temporairement mise en attente après des erreurs répétées."
