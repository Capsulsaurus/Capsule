            "value": "कम से कम 12 वर्ण।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno 12 caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12文字以上。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12자 이상."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos 12 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не менее 12 символов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "至少 12 個字元。"
          }
        }
      }
    },
    "app.auth.signup.scope_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا ينشئ حسابك على الخادم فقط لا أكثر. المفتاح الذي يفتح صورك يُنشأ على هذا الجهاز في الخطوة التالية، ولا يراه الخادم أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird nur dein Konto auf dem Server erstellt, sonst nichts. Der Schlüssel, der deine Fotos entsperrt, wird im nächsten Schritt auf diesem Gerät erzeugt, und der Server sieht ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This creates your account on the server and nothing more. The key that unlocks your photos is made on this device in the next step, and the server never sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto solo crea tu cuenta en el servidor. La clave que desbloquea tus fotos se crea en este dispositivo en el siguiente paso, y el servidor nunca la ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette étape crée uniquement votre compte sur le serveur. La clé qui déverrouille vos photos sera créée sur cet appareil à l'étape suivante, et le serveur ne la voit jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे सर्वर पर केवल आपका खाता बनता है, और कुछ नहीं। आपकी फ़ोटो अनलॉक करने वाली कुंजी अगले चरण में इस डिवाइस पर बनती है, और सर्वर उसे कभी नहीं देखता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo crea il tuo account sul server e nient'altro. La chiave che sblocca le tue foto viene creata su questo dispositivo nel passaggio successivo e il server non la vede mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではサーバー上にアカウントを作成するだけです。写真のロックを解除する鍵は次の手順でこのデバイス上に作成され、サーバーがそれを見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단계에서는 서버에 계정만 생성됩니다. 사진을 잠금 해제하는 키는 다음 단계에서 이 기기에서 생성되며, 서버는 이 키를 절대 볼 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto cria sua conta no servidor e nada mais. A chave que desbloqueia suas fotos é criada neste dispositivo na próxima etapa, e o servidor nunca a vê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Так создаётся только ваша учётная запись на сервере. Ключ, открывающий доступ к вашим фото, будет создан на этом устройстве на следующем шаге, и сервер его никогда не увидит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作仅在服务器上创建您的账户。解锁您照片的密钥将在下一步于此设备上生成，服务器永远看不到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這只會在伺服器上建立你的帳號。解鎖照片的密鑰會在下一步於此裝置上產生，伺服器永遠看不到它。"
          }
        }
      }
    },
