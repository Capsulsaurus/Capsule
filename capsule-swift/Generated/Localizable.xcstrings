    "app.federation.state.unreachable_owner": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب أحد الخوادم منذ وقت طويل. ستعود صوره إذا استجاب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Server hat seit Langem nicht geantwortet. Seine Fotos kehren zurück, sobald er wieder antwortet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server hasn't answered in a long time. Its photos will come back if it does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servidor lleva mucho tiempo sin responder. Sus fotos volverán si responde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur ne répond plus depuis longtemps. Ses photos reviendront s'il répond."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सर्वर ने लंबे समय से उत्तर नहीं दिया है। यदि वह उत्तर देता है तो उसकी फ़ोटो वापस आ जाएँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un server non risponde da molto tempo. Le sue foto torneranno se risponderà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あるサーバーが長期間応答していません。応答があれば、その写真は再び表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 서버가 오랫동안 응답하지 않았습니다. 서버가 응답하면 해당 사진이 다시 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um servidor não responde há muito tempo. As fotos dele voltarão se ele responder."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один сервер давно не отвечает. Его фото вернутся, когда он ответит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一台服务器长时间没有响应。它恢复响应后，其照片就会回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一台伺服器已長時間沒有回應。若它恢復回應，其照片就會回來。"
          }
        }
      }
    },
    "app.federation.summary.complete_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خادم كل مساهم متاح، لذا ترى الألبوم كاملًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Server aller Beitragenden sind erreichbar, du siehst also das gesamte Album."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every contributor's server is reachable, so you're seeing the whole album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los servidores de los colaboradores están accesibles, así que estás viendo el álbum completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs de tous les contributeurs sont joignables : vous voyez l'album entier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर योगदानकर्ता का सर्वर उपलब्ध है, इसलिए आप पूरा एल्बम देख रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i server dei partecipanti sono raggiungibili, quindi stai vedendo l'intero album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての参加者のサーバーに接続できるため、アルバム全体が表示されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 참여자의 서버에 연결할 수 있으므로 앨범 전체를 보고 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de cada colaborador está acessível, então você está vendo o álbum inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверы всех участников доступны, поэтому вы видите весь альбом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有参与者的服务器均可访问，您看到的是完整的相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有參與者的伺服器都可連線，因此你看到的是完整的相簿。"
          }
        }
      }
    },
    "app.federation.summary.partial_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترى كل ما يمكن لـ Capsule الوصول إليه حاليًا. الباقي موجود على خوادم لا تستجيب — لم يُزَل أي شيء، وسيعود عندما تستجيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du siehst alles, was Capsule gerade erreichen kann. Der Rest liegt auf Servern, die nicht antworten – nichts wurde entfernt, und es kehrt zurück, sobald sie antworten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're seeing everything Capsule can reach right now. The rest is on servers that aren't answering — nothing has been removed, and it returns when they do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás viendo todo lo que Capsule puede alcanzar ahora mismo. El resto está en servidores que no responden: no se ha eliminado nada y volverá cuando respondan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous voyez tout ce que Capsule peut atteindre pour le moment. Le reste se trouve sur des serveurs qui ne répondent pas — rien n'a été supprimé, et tout reviendra quand ils répondront."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप वह सब देख रहे हैं जिस तक Capsule अभी पहुँच सकता है। बाकी उन सर्वरों पर है जो उत्तर नहीं दे रहे — कुछ भी हटाया नहीं गया है, और उनके उत्तर देने पर यह वापस आ जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai vedendo tutto ciò che Capsule riesce a raggiungere al momento. Il resto si trova su server che non rispondono: non è stato rimosso nulla e tornerà quando risponderanno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在 Capsule が接続できるものをすべて表示しています。残りは応答していないサーバーにあります。何も削除されておらず、サーバーが応答すれば再び表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 Capsule이 연결할 수 있는 모든 항목을 보고 있습니다. 나머지는 응답하지 않는 서버에 있으며, 제거된 것은 없고 서버가 응답하면 다시 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está vendo tudo o que o Capsule consegue acessar agora. O restante está em servidores que não estão respondendo — nada foi removido, e tudo volta quando eles responderem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы видите всё, что Capsule может получить сейчас. Остальное находится на серверах, которые не отвечают, — ничего не удалено, и всё вернётся, когда они ответят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您看到的是 Capsule 当前可以访问的全部内容。其余内容位于没有响应的服务器上——没有任何内容被移除，服务器恢复响应后就会回来。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你看到的是 Capsule 目前能存取的所有內容。其餘內容位於沒有回應的伺服器上；沒有任何內容被移除，伺服器回應後就會回來。"
          }
        }
      }
    },
