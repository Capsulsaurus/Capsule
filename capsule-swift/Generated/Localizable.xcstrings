    "app.devices.support_bundle.ready.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرفق هذه التفاصيل في بلاغك. فهي تحدد التجميع فقط — دون أي صور أو محتويات ألبومات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge diese Angaben deiner Meldung bei. Sie identifizieren nur die Gruppierung – keine Fotos und keine Albuminhalte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Include these details in your report. They identify the grouping only — no photos and no album contents."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluye estos datos en tu informe. Solo identifican la agrupación: no contienen fotos ni contenido de álbumes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez ces informations à votre signalement. Elles identifient uniquement le regroupement — aucune photo ni contenu d'album."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इन विवरणों को अपनी रिपोर्ट में शामिल करें। ये केवल समूह की पहचान करते हैं — कोई फ़ोटो या एल्बम सामग्री नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includi questi dettagli nella segnalazione. Identificano solo il raggruppamento: nessuna foto e nessun contenuto degli album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらの詳細を報告に含めてください。グループを識別する情報のみで、写真やアルバムの内容は含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신고에 이 세부 정보를 포함하세요. 그룹만 식별하며 사진이나 앨범 콘텐츠는 포함되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclua estes detalhes no seu relatório. Eles identificam apenas o agrupamento — nenhuma foto e nenhum conteúdo de álbum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложите эти данные к своему отчёту. Они идентифицируют только группировку — никаких фото и содержимого альбомов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在报告中附上这些信息。它们仅用于识别该分组，不包含任何照片或相册内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在回報中附上這些詳細資料。它們僅用於識別此分組，不含任何照片或相簿內容。"
          }
        }
      }
    },
