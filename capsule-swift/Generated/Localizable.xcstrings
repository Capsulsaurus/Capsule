    "app.crossdevice.safety.mismatch_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا اختلفت الرموز، فتوقّف. لن يُنقل أي شيء، ويمكنك البدء من جديد برمز جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Codes abweichen, brich ab. Es wird nichts übertragen, und du kannst mit einem neuen Code neu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the codes differ, stop. Nothing is transferred, and you can start again with a new code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los códigos son distintos, detente. No se transfiere nada y puedes empezar de nuevo con un código nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les codes diffèrent, arrêtez. Rien n'est transféré et vous pouvez recommencer avec un nouveau code."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि कोड अलग हैं, तो रुक जाएँ। कुछ भी ट्रांसफ़र नहीं होता, और आप नए कोड के साथ फिर से शुरू कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se i codici sono diversi, fermati. Non viene trasferito nulla e puoi ricominciare con un nuovo codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードが異なる場合は中止してください。何も転送されず、新しいコードでやり直すことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드가 다르면 중단하세요. 아무것도 전송되지 않으며 새 코드로 다시 시작할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se os códigos forem diferentes, pare. Nada é transferido, e você pode começar novamente com um novo código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если коды различаются, остановитесь. Ничего не передаётся, и вы можете начать заново с новым кодом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果安全码不同，请停止。不会传输任何内容，您可以使用新代码重新开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果代碼不同，請停止。不會傳輸任何內容，你可以使用新代碼重新開始。"
          }
        }
      }
    },
