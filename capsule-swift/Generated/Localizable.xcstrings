    "security.totp.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تطبيق مصادقة لإنشاء رموز لمرة واحدة لتسجيل الدخول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine Authentifizierungs-App, um Einmalcodes für die Anmeldung zu erzeugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an authenticator app to generate one-time codes for login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una app de autenticación para generar códigos de un solo uso para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une app d'authentification pour générer des codes de connexion à usage unique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉगिन के लिए वन-टाइम कोड बनाने हेतु ऑथेंटिकेटर ऐप का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un'app di autenticazione per generare codici monouso per l'accesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリを使用して、ログイン用のワンタイムコードを生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱을 사용하여 로그인용 일회용 코드를 생성합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um app autenticador para gerar códigos de uso único para o login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте приложение-аутентификатор для создания одноразовых кодов для входа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用验证器应用生成用于登录的一次性验证码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用驗證器 App 產生登入用的一次性驗證碼。"
          }
        }
      }
    },
