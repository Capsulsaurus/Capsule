      }
    },
    "error.auth.oidc_device_denied": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض تسجيل الدخول لدى موفّر الهوية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung wurde bei deinem Identitätsanbieter abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sign-in was declined at your identity provider."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión se rechazó en tu proveedor de identidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a été refusée auprès de votre fournisseur d'identité."
