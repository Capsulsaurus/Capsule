        }
      }
    },
    "error.upload.size_exceeded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الرفع بيانات أكثر مما أعلن عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload hat mehr Daten gesendet als angegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload sent more data than it declared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La subida envió más datos de los que declaró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléversement a envoyé plus de données qu'il n'en avait déclaré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड ने अपने घोषित आकार से अधिक डेटा भेजा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il caricamento ha inviato più dati di quanti ne avesse dichiarati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードが宣言したサイズより多くのデータを送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드가 선언한 크기보다 많은 데이터를 보냈습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio enviou mais dados do que declarou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка отправила больше данных, чем было заявлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传发送的数据超过了其声明的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳傳送的資料超過了其宣告的大小。"
          }
        }
      }
    },
    "error.upload.stale_revival": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستند هذا التغيير إلى نسخة قديمة من العنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung basiert auf einer veralteten Version des Elements."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change is based on an out-of-date version of the item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cambio se basa en una versión desactualizada del elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification repose sur une version obsolète de l'élément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह परिवर्तन आइटम के पुराने संस्करण पर आधारित है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa modifica si basa su una versione non aggiornata dell'elemento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更は、この項目の古いバージョンに基づいています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경은 항목의 오래된 버전을 기반으로 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração se baseia em uma versão desatualizada do item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это изменение основано на устаревшей версии элемента."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改基于该项目的过时版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此變更基於該項目的過時版本。"
          }
        }
      }
    },
    "error.upload.storage_inconsistent": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واجه الخادم مشكلة في التخزين. يُرجى المحاولة مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Server ist ein Speicherproblem aufgetreten. Bitte versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server hit a storage problem. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor tuvo un problema de almacenamiento. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur a rencontré un problème de stockage. Veuillez réessayer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर को स्टोरेज समस्या आई। कृपया फिर से प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha riscontrato un problema di archiviazione. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーでストレージの問題が発生しました。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 저장소 문제가 발생했습니다. 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor teve um problema de armazenamento. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервере возникла проблема с хранилищем. Повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器遇到存储问题。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器遇到儲存問題。請重試。"
          }
        }
      }
    },
    "error.upload.timestamp_out_of_range": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن ساعة جهازك غير صحيحة. تحقّق من التاريخ والوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr Ihres Geräts scheint falsch zu sein. Überprüfen Sie Datum und Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device's clock appears to be wrong. Check its date and time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj de tu dispositivo parece estar mal. Comprueba su fecha y hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'horloge de votre appareil semble incorrecte. Vérifiez sa date et son heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस की घड़ी ग़लत लगती है। इसकी तारीख़ और समय जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio del tuo dispositivo sembra errato. Controlla data e ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの時計が正しくないようです。日付と時刻を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 시계가 잘못된 것 같습니다. 날짜와 시간을 확인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio do seu dispositivo parece estar errado. Verifique a data e a hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, часы вашего устройства выставлены неверно. Проверьте дату и время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您设备的时钟似乎不正确。请检查其日期和时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您裝置的時鐘似乎不正確。請檢查其日期和時間。"
          }
        }
      }
    },
    "error.upload.unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload couldn't be completed. Please try again."
          }
        }
      }
    },
    "error.upload.unknown_crypto_suite": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا الإصدار من التطبيق مجموعة تشفير لا يتعرّف عليها الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Version verwendet eine Verschlüsselungs-Suite, die der Server nicht erkennt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app version uses an encryption suite the server doesn't recognize."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de la aplicación usa un conjunto de cifrado que el servidor no reconoce."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de l'application utilise une suite de chiffrement que le serveur ne reconnaît pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप का यह संस्करण एक ऐसा एन्क्रिप्शन सूट उपयोग करता है जिसे सर्वर नहीं पहचानता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione dell'app usa una suite di crittografia che il server non riconosce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリのバージョンは、サーバーが認識しない暗号スイートを使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 버전은 서버가 인식하지 못하는 암호화 방식을 사용합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do aplicativo usa um conjunto de criptografia que o servidor não reconhece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта версия приложения использует набор шифрования, который сервер не распознаёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用版本使用了服务器无法识别的加密套件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此應用程式版本使用了伺服器無法辨識的加密套件。"
          }
        }
      }
    },
