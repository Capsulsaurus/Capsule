          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor teve um problema de armazenamento. Tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервере возникла проблема с хранилищем. Повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
