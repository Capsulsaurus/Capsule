    "app.settings.import.sources.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّد ألبومًا هنا وستذهب عمليات الاستيراد من ذلك المصدر إليه دائمًا، أيًا كان ما كانت ستختاره القواعد أعلاه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege hier ein Album fest, dann landen Importe aus dieser Quelle immer dort, egal was die Regeln oben gewählt hätten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set an album here and imports from that source always go there, whatever the rules above would have chosen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si eliges un álbum aquí, las importaciones de ese origen irán siempre a él, independientemente de lo que hubieran elegido las reglas anteriores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un album ici pour que les importations de cette source y aillent toujours, quel que soit le choix des règles ci-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ एल्बम सेट करें और उस स्रोत से इंपोर्ट हमेशा वहीं जाएँगे, चाहे ऊपर के नियम कुछ भी चुनते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta qui un album e le importazioni da quell'origine finiranno sempre lì, qualunque cosa avrebbero scelto le regole sopra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでアルバムを設定すると、上のルールに関係なく、その読み込み元からの読み込みは常にそのアルバムに保存されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에서 앨범을 설정하면 위의 규칙과 관계없이 해당 소스에서 가져온 항목이 항상 그 앨범으로 이동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um álbum aqui e as importações dessa origem sempre irão para ele, independentemente do que as regras acima escolheriam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте здесь альбом, и импорт из этого источника всегда будет попадать туда, что бы ни выбрали правила выше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此设置相册后，来自该来源的导入将始终进入该相册，无论上述规则会如何选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此設定相簿後，從該來源匯入的內容一律會存到那裡，不論上方規則原本會如何選擇。"
          }
        }
      }
    },
