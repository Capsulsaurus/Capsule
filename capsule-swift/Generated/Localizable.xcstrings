            "state": "translated",
            "value": "Capsule obtendrá el estado actual de tu servidor y lo intentará de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule récupérera l'état actuel depuis votre serveur et réessaiera."
          }
        },
        "hi": {
