    "app.federation.section.constituents_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ كل شخص بصوره على خادمه الخاص. ويعرضها Capsule معًا كألبوم واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Person behält ihre eigenen Fotos auf ihrem eigenen Server. Capsule zeigt sie gemeinsam als ein Album an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each person keeps their own photos on their own server. Capsule shows them together as one album."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada persona guarda sus propias fotos en su propio servidor. Capsule las muestra juntas como un solo álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque personne conserve ses propres photos sur son propre serveur. Capsule les affiche ensemble dans un seul album."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर व्यक्ति अपनी फ़ोटो अपने सर्वर पर रखता है। Capsule उन्हें एक साथ एक एल्बम के रूप में दिखाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni persona conserva le proprie foto sul proprio server. Capsule le mostra insieme come un unico album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各参加者は自分の写真を自分のサーバーに保管しています。Capsule はそれらを1つのアルバムとしてまとめて表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 사람은 자신의 서버에 자신의 사진을 보관합니다. Capsule은 이를 하나의 앨범으로 모아 보여 줍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada pessoa mantém as próprias fotos no próprio servidor. O Capsule as exibe juntas como um único álbum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый хранит свои фото на собственном сервере. Capsule показывает их вместе как один альбом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个人都将自己的照片保存在自己的服务器上，Capsule 将它们合并显示为一个相册。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個人都將自己的照片保存在自己的伺服器上。Capsule 會將它們合併顯示為一個相簿。"
          }
        }
      }
    },
