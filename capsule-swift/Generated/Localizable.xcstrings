    "app.import.state.offline.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذّر على Capsule الوصول إلى خادمك. لا يزال الفحص يعمل — أما تخطيط الاستيراد فيحتاج إلى عودة الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule kann deinen Server nicht erreichen. Scannen funktioniert weiterhin – zum Planen eines Imports wird die Verbindung benötigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule can't reach your server. Scanning still works — planning an import needs the connection back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no puede conectar con tu servidor. El análisis sigue funcionando; para planificar una importación hace falta recuperar la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ne parvient pas à joindre votre serveur. L'analyse fonctionne toujours, mais la planification d'une importation nécessite que la connexion soit rétablie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule आपके सर्वर तक नहीं पहुँच पा रहा है। स्कैन करना अब भी काम करता है — इंपोर्ट की योजना बनाने के लिए कनेक्शन वापस चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non riesce a raggiungere il tuo server. La scansione funziona comunque: per pianificare un'importazione serve di nuovo la connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はサーバーに接続できません。スキャンは引き続き可能ですが、読み込みの計画には接続の回復が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 서버에 연결할 수 없습니다. 스캔은 계속 가능하지만, 가져오기를 계획하려면 연결이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não consegue acessar seu servidor. A análise continua funcionando — planejar uma importação exige a conexão de volta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не удаётся связаться с вашим сервером. Сканирование по-прежнему работает — для планирования импорта нужно восстановить подключение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 无法连接到您的服务器。扫描仍可进行，但规划导入需要恢复连接。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 無法連線到您的伺服器。掃描仍可進行，但規劃匯入需要恢復連線。"
          }
        }
      }
    },
