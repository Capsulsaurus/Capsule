    "app.settings.diagnostics.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجمع بيانات تشخيص الأعطال والأداء على هذا الجهاز باستخدام MetricKit من Apple. لا يغادر أي شيء جهازك ما لم تشغّل الرفع أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfasst Absturz- und Leistungsdiagnosen auf diesem Gerät mit Apples MetricKit. Nichts verlässt dein Gerät, es sei denn, du aktivierst unten das Hochladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collects crash and performance diagnostics on this device using Apple's MetricKit. Nothing leaves your device unless you turn on uploads below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recopila diagnósticos de bloqueos y rendimiento en este dispositivo mediante MetricKit de Apple. Nada sale de tu dispositivo a menos que actives los envíos más abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collecte des diagnostics de plantage et de performances sur cet appareil à l'aide de MetricKit d'Apple. Rien ne quitte votre appareil, sauf si vous activez l'envoi ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple के MetricKit का उपयोग करके इस डिवाइस पर क्रैश और परफ़ॉर्मेंस डायग्नोस्टिक्स एकत्र करता है। जब तक आप नीचे अपलोड चालू नहीं करते, कुछ भी आपके डिवाइस से बाहर नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raccoglie dati diagnostici su arresti anomali e prestazioni su questo dispositivo tramite MetricKit di Apple. Nulla lascia il dispositivo a meno che tu non attivi i caricamenti qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple の MetricKit を使用して、このデバイス上でクラッシュとパフォーマンスの診断情報を収集します。以下でアップロードをオンにしない限り、デバイスの外に送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple의 MetricKit을 사용하여 이 기기에서 충돌 및 성능 진단 정보를 수집합니다. 아래에서 업로드를 켜지 않는 한 아무것도 기기 밖으로 전송되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coleta diagnósticos de falhas e desempenho neste dispositivo usando o MetricKit da Apple. Nada sai do seu dispositivo a menos que você ative os envios abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собирает диагностику сбоев и производительности на этом устройстве с помощью Apple MetricKit. Ничто не покидает устройство, если вы не включите отправку ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 的 MetricKit 在此设备上收集崩溃和性能诊断信息。除非您在下方打开上传，否则不会有任何内容离开您的设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Apple 的 MetricKit 在此裝置上收集當機與效能診斷資料。除非您在下方開啟上傳，否則不會有任何資料離開您的裝置。"
          }
        }
      }
    },
