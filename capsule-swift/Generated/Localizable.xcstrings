    "app.settings.state.offline.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج بعض الإعدادات إلى الخادم. ما تراه هو آخر ما أبلغ به هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Einstellungen benötigen deinen Server. Angezeigt wird der letzte Stand, den er diesem Gerät mitgeteilt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some settings need your server. What you can see is the last it told this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos ajustes necesitan tu servidor. Lo que ves es lo último que le comunicó a este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains réglages nécessitent votre serveur. Ce que vous voyez correspond à ce qu'il a communiqué en dernier à cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ सेटिंग्स के लिए आपके सर्वर की ज़रूरत है। आप जो देख रहे हैं, वह वही है जो सर्वर ने इस डिवाइस को पिछली बार बताया था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcune impostazioni richiedono il tuo server. Ciò che vedi è l'ultima informazione ricevuta da questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の設定にはサーバーが必要です。表示されている内容は、サーバーがこのデバイスに最後に伝えたものです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 설정은 서버가 필요합니다. 표시된 내용은 서버가 이 기기에 마지막으로 알려준 정보입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns ajustes precisam do seu servidor. O que você vê é a última informação que ele enviou a este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для некоторых настроек нужен ваш сервер. Показаны последние данные, которые он передал этому устройству."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分设置需要连接服务器。您看到的是服务器上次告知此设备的信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分設定需要連接您的伺服器。您看到的是伺服器最後一次提供給此裝置的資訊。"
          }
        }
      }
    },
