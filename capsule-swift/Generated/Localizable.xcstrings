    "app.auth.welcome.later_note": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك الاتصال بخادم لاحقًا دون فقدان أي شيء استوردته بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst später einen Server verbinden, ohne etwas zu verlieren, das du bereits importiert hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can connect a server later without losing anything you've already imported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes conectar un servidor más adelante sin perder nada de lo que ya hayas importado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez connecter un serveur plus tard sans perdre ce que vous avez déjà importé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पहले से इंपोर्ट की गई किसी भी चीज़ को खोए बिना बाद में सर्वर कनेक्ट कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi collegare un server in seguito senza perdere nulla di ciò che hai già importato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーにはあとで接続できます。すでに読み込んだものが失われることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 서버에 연결해도 이미 가져온 항목은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode conectar um servidor depois sem perder nada do que já importou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сможете подключить сервер позже, не потеряв ничего из уже импортированного."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以稍后再连接服务器，已导入的内容不会丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以稍後再連接伺服器，已匯入的內容都不會遺失。"
          }
        }
      }
    },
