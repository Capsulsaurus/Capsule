          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置清單已過期。Capsule 會在繼續前重新整理。"
          }
        }
      }
    },
    "error.drop.adoption_refused": {
      "localizations": {
        "ar": {
