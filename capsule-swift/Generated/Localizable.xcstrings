    "app.sync.scope.thumbnails.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضيف الصور المصغّرة ونسخًا بحجم المعاينة، فيبدو التصفح سليمًا دون الاحتفاظ بالملفات بالحجم الكامل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt Miniaturen und Vorschaukopien hinzu, damit das Durchsehen gut aussieht, ohne Dateien in voller Größe zu behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds thumbnails and preview-sized copies, so browsing looks right without keeping full-size files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade miniaturas y copias de tamaño de previsualización, para que la navegación se vea bien sin guardar archivos a tamaño completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des vignettes et des copies de la taille d'un aperçu, pour une navigation fidèle sans conserver les fichiers en taille réelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थंबनेल और प्रीव्यू-आकार की कॉपियाँ जोड़ता है, ताकि पूर्ण-आकार फ़ाइलें रखे बिना ब्राउज़िंग सही दिखे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge miniature e copie in formato anteprima, così la navigazione appare corretta senza conservare i file a dimensione piena."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネイルとプレビューサイズのコピーを追加し、フルサイズのファイルを保持せずに正しい見た目で閲覧できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "썸네일과 미리보기 크기의 사본을 추가하여, 원본 크기 파일을 보관하지 않고도 제대로 둘러볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona miniaturas e prévias, para que a navegação fique boa sem manter os arquivos originais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляет миниатюры и превью, чтобы просмотр выглядел как надо без хранения полноразмерных файлов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "额外获取缩略图和预览尺寸的副本，无需保留全尺寸文件即可正常浏览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "加入縮圖和預覽大小的副本，不需保留原尺寸檔案也能正常瀏覽。"
          }
        }
      }
    },
