    "app.totp.confirm.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل الرمز الحالي من تطبيق المصادقة. لن يتغير شيء في حسابك حتى يُقبل الرمز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den aktuellen Code aus deiner Authentifizierungs-App ein. An deinem Konto ändert sich nichts, bis er akzeptiert wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the current code from your authenticator app. Nothing changes on your account until it's accepted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce el código actual de tu app de autenticación. No cambia nada en tu cuenta hasta que se acepte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez le code actuel de votre app d'authentification. Rien ne change sur votre compte tant qu'il n'est pas accepté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने ऑथेंटिकेटर ऐप से मौजूदा कोड दर्ज करें। जब तक यह स्वीकार नहीं होता, आपके खाते में कुछ नहीं बदलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci il codice attuale dall'app di autenticazione. Sul tuo account non cambia nulla finché non viene accettato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証アプリに表示されている現在のコードを入力してください。コードが受け付けられるまで、アカウントは何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인증 앱에 표시된 현재 코드를 입력하십시오. 코드가 승인될 때까지 계정에는 아무것도 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite o código atual do seu app autenticador. Nada muda na sua conta até ele ser aceito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите текущий код из приложения-аутентификатора. В вашей учётной записи ничего не изменится, пока код не будет принят."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请输入身份验证器应用中的当前代码。在代码被接受之前，您的账户不会有任何更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請輸入驗證器 App 中目前的代碼。在代碼被接受之前，您的帳號不會有任何變更。"
          }
        }
      }
    },
