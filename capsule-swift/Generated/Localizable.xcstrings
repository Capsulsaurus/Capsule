    "app.transfer.recovery.report.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا خلل في Capsule، وليس شيئًا فعلته أنت. يساعد البلاغ على إصلاحه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist ein Fehler in Capsule, nicht etwas, das du getan hast. Eine Meldung hilft, ihn zu beheben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a fault in Capsule, not something you did. A report helps get it fixed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es un fallo de Capsule, no algo que hayas hecho tú. Un informe ayuda a corregirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s'agit d'une erreur de Capsule, pas de quelque chose que vous avez fait. Un signalement aide à la corriger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Capsule की ख़राबी है, आपकी कोई गलती नहीं। रिपोर्ट भेजने से इसे ठीक करने में मदद मिलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tratta di un errore di Capsule, non di qualcosa che hai fatto tu. Una segnalazione aiuta a risolverlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは Capsule の不具合であり、お客様の操作によるものではありません。報告していただくと修正に役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자의 잘못이 아닌 Capsule의 오류입니다. 신고해 주시면 문제 해결에 도움이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta é uma falha do Capsule, não algo que você fez. Um relatório ajuda a corrigi-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ошибка в Capsule, а не ваша. Отчёт поможет её исправить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 Capsule 的故障，并非您的操作所致。提交报告有助于修复问题。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是 Capsule 的錯誤，並非您的操作所致。回報有助於修正問題。"
          }
        }
      }
    },
