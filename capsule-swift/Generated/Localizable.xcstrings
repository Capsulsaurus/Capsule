        }
      }
    },
    "drop.error.passphrase": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلّب هذا الرفع كلمة مرور الرابط. افتح قفل الصفحة وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diesen Upload ist das Passwort des Links erforderlich. Entsperre die Seite und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upload needs the link's password. Unlock the page and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta subida necesita la contraseña del enlace. Desbloquea la página e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce téléversement nécessite le mot de passe du lien. Déverrouillez la page et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस अपलोड के लिए लिंक का पासवर्ड चाहिए। पेज अनलॉक करें और फिर से प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
