    "app.settings.upload.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل اختياريًا تقارير التشخيص إلى خادم Capsule الخاص بك. متوقف افتراضيًا — لا يرسل Capsule أي شيء إلى جهة خارجية أبدًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sende Diagnoseberichte optional an deinen eigenen Capsule-Server. Standardmäßig deaktiviert – Capsule sendet nie etwas an Dritte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionally send diagnostic reports to your own Capsule server. Off by default — Capsule never sends anything to a third party."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalmente, envía informes de diagnóstico a tu propio servidor de Capsule. Desactivado de forma predeterminada: Capsule nunca envía nada a terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez éventuellement des rapports de diagnostic à votre propre serveur Capsule. Désactivé par défaut : Capsule n'envoie jamais rien à un tiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक रूप से निदान रिपोर्ट अपने Capsule सर्वर पर भेजें। डिफ़ॉल्ट रूप से बंद — Capsule कभी भी किसी तीसरे पक्ष को कुछ नहीं भेजता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativamente, invia i rapporti di diagnostica al tuo server Capsule. Disattivato per impostazione predefinita: Capsule non invia mai nulla a terze parti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要に応じて、診断レポートを自分の Capsule サーバーに送信できます。デフォルトではオフです。Capsule が第三者に何かを送信することはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 경우 진단 보고서를 자신의 Capsule 서버로 보낼 수 있습니다. 기본적으로 꺼져 있으며, Capsule은 제3자에게 아무것도 보내지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcionalmente, envie relatórios de diagnóstico para o seu próprio servidor Capsule. Desativado por padrão — o Capsule nunca envia nada a terceiros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При желании отправляйте диагностические отчёты на собственный сервер Capsule. По умолчанию выключено — Capsule никогда ничего не отправляет третьим лицам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选择将诊断报告发送到您自己的 Capsule 服务器。默认关闭——Capsule 绝不会向第三方发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選擇將診斷報告傳送到您自己的 Capsule 伺服器。預設為關閉，Capsule 絕不會將任何內容傳送給第三方。"
          }
        }
      }
    },
