    "app.drops.compose.passphrase.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا يمنع الغرباء من ملء مساحة التخزين لديك إذا تسرّب الرابط. وليس هو ما يحمي الملفات — فهي مختومة على جهاز المرسل في كل الأحوال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So können Fremde deinen Speicher nicht füllen, falls der Link in falsche Hände gerät. Die Dateien schützt sie nicht – die werden ohnehin auf dem Gerät des Absenders versiegelt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This keeps strangers from filling your storage if the link gets out. It isn't what protects the files — they're sealed on the sender's device either way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto evita que desconocidos llenen tu almacenamiento si el enlace se difunde. No es lo que protege los archivos: estos se sellan en el dispositivo del remitente en cualquier caso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle empêche des inconnus de remplir votre stockage si le lien circule. Ce n'est pas elle qui protège les fichiers : ils sont scellés sur l'appareil de l'expéditeur dans tous les cas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लिंक बाहर चले जाने पर यह अजनबियों को आपका स्टोरेज भरने से रोकता है। यह फ़ाइलों की सुरक्षा नहीं करता — वे दोनों ही स्थितियों में भेजने वाले के डिवाइस पर सील की जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impedisce agli estranei di riempire il tuo spazio di archiviazione se il link finisce in giro. Non è ciò che protegge i file: vengono comunque sigillati sul dispositivo del mittente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクが流出しても、他人にストレージを埋められるのを防ぎます。ファイルを保護するものではありません。ファイルはいずれにしても送信者のデバイス上で封印されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 유출되더라도 낯선 사람이 저장 공간을 채우지 못하게 합니다. 파일을 보호하는 수단은 아니며, 파일은 어느 경우든 보낸 사람의 기기에서 봉인됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso impede que estranhos encham seu armazenamento se o link vazar. Não é o que protege os arquivos — eles são selados no dispositivo do remetente de qualquer forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это не даст посторонним заполнить ваше хранилище, если ссылка попадёт в чужие руки. Файлы защищает не она — они в любом случае запечатываются на устройстве отправителя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样可以防止链接外泄后陌生人占满您的存储空间。它并不是保护文件的手段——无论如何，文件都会在发送者的设备上封装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這可避免連結外流時陌生人塞滿你的儲存空間。它並非用來保護檔案：無論如何，檔案都會在傳送者的裝置上加密封存。"
          }
        }
      }
    },
