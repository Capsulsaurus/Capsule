    "error.directory.malformed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة قائمة الأجهزة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
