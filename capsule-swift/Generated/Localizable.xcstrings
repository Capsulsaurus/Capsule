    "app.drops.detail.destination.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "القبول يضيف هذا إلى مكتبتك دون رفعه مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Annehmen wird dies zu deiner Mediathek hinzugefügt, ohne es erneut hochzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting adds this to your library without uploading it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al aceptarlo, se añade a tu biblioteca sin volver a subirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accepter l'ajoute à votre bibliothèque sans le téléverser à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वीकार करने पर यह फिर से अपलोड किए बिना आपकी लाइब्रेरी में जुड़ जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettandolo, il file viene aggiunto alla tua libreria senza caricarlo di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると、再アップロードせずにライブラリに追加されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락하면 다시 업로드하지 않고 라이브러리에 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitar adiciona isto à sua biblioteca sem enviá-lo novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При принятии файл добавляется в медиатеку без повторной загрузки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受后，此文件将添加到您的资料库，无需重新上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接受後會將此項目加入你的圖庫，無需重新上傳。"
          }
        }
      }
    },
