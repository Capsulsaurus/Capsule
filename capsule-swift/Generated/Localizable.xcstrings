          }
        }
      }
    },
    "error.upload.stale_revival": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستند هذا التغيير إلى نسخة قديمة من العنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung basiert auf einer veralteten Version des Elements."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change is based on an out-of-date version of the item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
