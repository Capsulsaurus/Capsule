    "app.drops.compose.no_albums.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشئ ألبومًا أولًا، ليكون هناك مكان للملفات المرفوعة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle zuerst ein Album, damit Uploads einen Ort haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create an album first, so there's somewhere for uploads to go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero crea un álbum para que las subidas tengan adónde ir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez d'abord un album pour que les envois aient une destination."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले एक एल्बम बनाएँ, ताकि अपलोड के जाने के लिए कोई जगह हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea prima un album, così i caricamenti avranno una destinazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードの保存先となるアルバムを先に作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드를 보관할 곳이 있도록 먼저 앨범을 생성하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie um álbum primeiro, para que os envios tenham para onde ir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала создайте альбом, чтобы загрузкам было куда попадать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先创建一个相册，以便上传内容有处可放。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先建立相簿，讓上傳內容有地方存放。"
          }
        }
      }
    },
