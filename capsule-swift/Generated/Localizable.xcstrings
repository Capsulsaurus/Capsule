    },
    "ios.peering.enable.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your devices swap photos directly over the local network, without going through your server. Useful when the server is far away or offline."
          }
        }
      }
    },
    "ios.peering.idle.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule is listening. Your other devices will show up when they're on the same network."
