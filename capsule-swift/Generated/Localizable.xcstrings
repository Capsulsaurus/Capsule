    "app.settings.language.resolved.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Capsule ترتيب اللغات في إعدادات النظام. غيّره من هناك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule folgt der Sprachreihenfolge in deinen Systemeinstellungen. Ändere sie dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule follows the language order in your system settings. Change it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule sigue el orden de idiomas de los ajustes del sistema. Cámbialo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule suit l'ordre des langues défini dans les réglages du système. Modifiez-le à cet endroit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule आपकी सिस्टम सेटिंग्स के भाषा क्रम का पालन करता है। इसे वहीं बदलें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule segue l'ordine delle lingue nelle impostazioni di sistema. Modificalo lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はシステム設定の言語の優先順位に従います。変更はシステム設定で行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 시스템 설정의 언어 순서를 따릅니다. 변경하려면 시스템 설정에서 변경하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule segue a ordem de idiomas dos ajustes do sistema. Altere-a por lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule следует порядку языков в системных настройках. Измените его там."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 遵循系统设置中的语言顺序。请在系统设置中更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會依照系統設定中的語言順序。請在該處更改。"
          }
        }
      }
    },
