          }
        }
      }
    },
    "error.upload.amk_regressed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يشير هذا التغيير إلى مفتاح ألبوم أقدم مما سجّله الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Änderung verweist auf einen älteren Album-Schlüssel als den, den der Server gespeichert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change references an older album key than the server has recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cambio hace referencia a una clave de álbum más antigua que la registrada por el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette modification référence une clé d'album plus ancienne que celle enregistrée par le serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह परिवर्तन सर्वर द्वारा दर्ज की गई एल्बम कुंजी से पुरानी कुंजी को संदर्भित करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa modifica fa riferimento a una chiave dell'album più vecchia di quella registrata dal server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この変更は、サーバーが記録しているものより古いアルバムキーを参照しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 변경은 서버에 기록된 것보다 오래된 앨범 키를 참조합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta alteração faz referência a uma chave de álbum mais antiga do que a registrada pelo servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это изменение ссылается на более старый ключ альбома, чем записан на сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此更改引用的相册密钥比服务器记录的更旧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此變更引用的相簿金鑰比伺服器記錄的更舊。"
          }
        }
      }
    },
    "error.upload.checksum_mismatch": {
      "localizations": {
        "ar": {
          "stringUnit": {
