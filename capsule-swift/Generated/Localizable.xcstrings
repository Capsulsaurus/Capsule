    "app.drops.caps.issue.expiry_past": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تاريخ انتهاء الصلاحية في الماضي، لذا لن يعمل الرابط إطلاقًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ablaufdatum liegt in der Vergangenheit, daher würde der Link überhaupt nicht funktionieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expiry date is in the past, so the link wouldn't work at all"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de caducidad ya pasó, así que el enlace no funcionaría en absoluto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date d'expiration est passée : le lien ne fonctionnerait pas du tout"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समाप्ति तिथि बीत चुकी है, इसलिए लिंक बिल्कुल काम नहीं करेगा"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La data di scadenza è nel passato, quindi il link non funzionerebbe affatto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効期限が過去の日付のため、リンクはまったく機能しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "만료일이 과거이므로 링크가 전혀 작동하지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de expiração já passou, então o link não funcionaria"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата окончания уже прошла, поэтому ссылка вообще не будет работать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过期日期已过，链接将完全无法使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "到期日已過，因此連結將完全無法使用"
          }
        }
      }
    },
    "app.drops.caps.issue.file_over_total": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدّ الملف الواحد أكبر من الإجمالي، لذا لن يُطبَّق أبدًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Limit pro Datei ist größer als das Gesamtlimit und würde daher nie greifen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The per-file limit is larger than the total, so it would never apply"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite por archivo es mayor que el total, así que nunca se aplicaría"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite par fichier dépasse la limite totale : elle ne s'appliquerait jamais"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति फ़ाइल सीमा कुल सीमा से बड़ी है, इसलिए यह कभी लागू नहीं होगी"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il limite per file supera il totale, quindi non verrebbe mai applicato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルごとの制限が合計より大きいため、適用されることはありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일당 제한이 전체 제한보다 커서 적용되지 않습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O limite por arquivo é maior que o total, então nunca seria aplicado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ограничение на файл больше общего, поэтому оно никогда не сработает"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单个文件限制大于总量限制，因此永远不会生效"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "單一檔案限制大於總量限制，因此永遠不會生效"
          }
        }
      }
    },
    "app.drops.caps.issue.single_use_conflict": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل الرابط أحادي الاستخدام ملفًا واحدًا، لذا لن يُطبَّق حدّ الملفات أعلاه"
          }
