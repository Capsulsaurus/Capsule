    "ios.sync.pending.downloads": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To Download"
          }
        }
      }
    },
    "ios.sync.pending.none": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing waiting"
          }
        }
      }
    },
    "ios.sync.pending.section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting"
          }
        }
      }
    },
    "ios.sync.pending.uploads": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To Upload"
          }
        }
      }
    },
    "ios.sync.policy.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way, your local copy is kept until the full-size photo is safely stored on your server."
          }
        }
      }
    },
    "ios.sync.policy.full": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All at Once"
          }
        }
      }
    },
    "ios.sync.policy.full.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads the full-size photo along with everything else, as soon as the connection allows."
          }
        }
      }
    },
    "ios.sync.policy.section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upload Order"
          }
        }
      }
    },
    "ios.sync.policy.staged": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Stages"
          }
        }
      }
    },
    "ios.sync.policy.staged.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends details and previews first, so photos appear on your other devices quickly, and the full-size file when Wi-Fi is available."
          }
        }
      }
    },
    "ios.sync.scope.empty.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a server to choose what this device keeps."
          }
        }
      }
    },
    "ios.sync.scope.empty.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to Configure"
          }
        }
      }
    },
    "ios.sync.scope.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-size photos are always fetched on demand when you open or share one, whatever you choose here."
          }
        }
      }
    },
    "ios.sync.scope.metadata_only": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details Only"
          }
        }
      }
    },
    "ios.sync.scope.metadata_only.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your whole library is browsable, with a small placeholder for each photo. Uses the least space."
          }
        }
      }
    },
    "ios.sync.scope.originals": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything"
          }
        }
      }
    },
    "ios.sync.scope.originals.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeps a full-size copy of every photo on this device. Uses the most space."
          }
        }
      }
    },
    "ios.sync.scope.section": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fetch"
          }
        }
      }
    },
    "ios.sync.scope.thumbnails": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Details and Previews"
          }
        }
      }
    },
    "ios.sync.scope.thumbnails.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adds thumbnails and preview-sized copies, so browsing looks right without keeping full-size files."
          }
        }
      }
    },
    "ios.sync.scope.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What to Sync"
          }
        }
      }
    },
    "ios.sync.scope.unknown": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unknown"
          }
        }
      }
    },
    "ios.sync.scope.unknown.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A setting a newer version of Capsule wrote. It's kept exactly as it is."
          }
        }
      }
    },
    "ios.sync.snooze.active": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder put off"
          }
        }
      }
    },
    "ios.sync.snooze.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You won't be reminded again for a couple of weeks. Syncing carries on as usual in the meantime."
          }
        }
      }
    },
    "ios.sync.stale.description": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hasn't finished a sync in two weeks, and there are still changes to send. On this device the system decides when background work runs, and it hasn't granted any."
          }
        }
      }
    },
    "ios.sync.stale.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Syncing now uses your current connection, whatever it is. You can also put this reminder off or turn it off in settings."
          }
        }
      }
    },
    "ios.sync.stale.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Device Is Behind"
          }
        }
      }
    },
