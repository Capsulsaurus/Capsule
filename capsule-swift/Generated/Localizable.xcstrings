    "app.custody.receipt.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجزئة المحتوى هنا هي ما حسبه خادمك من البايتات التي خزّنها، وليست رقمًا أرسله هذا الجهاز. وهذا ما يجعل الإيصال قادرًا على حسم أي خلاف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Inhalts-Hash hier wurde von deinem Server aus den gespeicherten Bytes berechnet, nicht von diesem Gerät übermittelt. Deshalb kann eine Quittung eine Unstimmigkeit klären."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content hash here is what your server computed from the bytes it stored, not a number this device sent it. That's what lets a receipt settle a disagreement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El hash del contenido que aparece aquí lo calculó tu servidor a partir de los bytes que almacenó, no es un número que le envió este dispositivo. Por eso un recibo puede resolver un desacuerdo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le hachage du contenu indiqué ici a été calculé par votre serveur à partir des octets qu'il a stockés, et non transmis par cet appareil. C'est ce qui permet à un reçu de trancher un désaccord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ दिया गया सामग्री हैश आपके सर्वर ने अपने संग्रहीत बाइट्स से गणना किया है, यह इस डिवाइस द्वारा भेजी गई संख्या नहीं है। इसी कारण रसीद किसी असहमति को सुलझा सकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hash del contenuto qui è quello calcolato dal tuo server sui byte archiviati, non un numero inviato da questo dispositivo. È questo che permette a una ricevuta di risolvere un disaccordo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに表示されるコンテンツハッシュは、このデバイスが送信した値ではなく、サーバーが保存したデータから計算したものです。そのため、受領証で食い違いを解決できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 표시된 콘텐츠 해시는 이 기기가 보낸 값이 아니라, 서버가 저장한 바이트로부터 직접 계산한 값입니다. 그래서 영수증으로 의견 차이를 해결할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O hash de conteúdo aqui foi calculado pelo seu servidor a partir dos bytes que ele armazenou, não um número enviado por este dispositivo. É isso que permite que um recibo resolva uma divergência."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хеш содержимого здесь вычислен вашим сервером по сохранённым байтам, а не передан этим устройством. Именно поэтому квитанция может разрешить спор."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处的内容哈希是您的服务器根据其存储的字节计算得出的，而非此设备发送给它的数值。正因如此，回执可以用来解决分歧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處的內容雜湊是你的伺服器根據其所儲存的位元組計算出來的，而不是此裝置傳送給它的數值。這讓收據能夠用來釐清爭議。"
          }
        }
      }
    },
