    "app.share.list.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر الروابط التي تنشئها هنا، لتتمكن من رؤيتها وإبطالها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von dir erstellte Links werden hier aufgelistet, damit du sie sehen und widerrufen kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links you create will be listed here, so you can see and revoke them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces que crees aparecerán aquí para que puedas verlos y revocarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens que vous créez s'afficheront ici, pour que vous puissiez les consulter et les révoquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बनाए लिंक यहाँ सूचीबद्ध होंगे, ताकि आप उन्हें देख और रद्द कर सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I link che crei verranno elencati qui, così potrai vederli e revocarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成したリンクはここに一覧表示され、確認や取り消しができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성한 링크가 여기에 표시되며, 확인하고 취소할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os links que você criar aparecerão aqui, para que você possa vê-los e revogá-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Созданные ссылки появятся здесь, чтобы вы могли просматривать и отзывать их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您创建的链接会列在这里，方便您查看和撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您建立的連結會列在這裡，方便您查看及撤銷。"
          }
        }
      }
    },
    "app.share.list.empty.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
