    "error.escrow.album_keys_full": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتسع النسخة الاحتياطية للاسترداد في هذا الحساب لمفاتيح ألبوم آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Wiederherstellungs-Backup dieses Kontos ist kein Platz für die Schlüssel eines weiteren Albums."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account's recovery backup has no room for another album's keys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de recuperación de esta cuenta no tiene espacio para las claves de otro álbum."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde de récupération de ce compte n'a plus de place pour les clés d'un autre album."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते के रिकवरी बैकअप में किसी और एल्बम की कुंजियों के लिए जगह नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup di ripristino di questo account non ha spazio per le chiavi di un altro album."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのリカバリーバックアップには、これ以上アルバムのキーを保存する空きがありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 복구 백업에 다른 앨범의 키를 저장할 공간이 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup de recuperação desta conta não tem espaço para as chaves de mais um álbum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В резервной копии для восстановления этой учётной записи нет места для ключей ещё одного альбома."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的恢复备份已没有空间存放另一个相册的密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號的復原備份已沒有空間容納另一本相簿的金鑰。"
          }
        }
      }
    },
    "error.escrow.identity_not_stored": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتضمن النسخة الاحتياطية للاسترداد في هذا الحساب مفتاح الهوية، لذا لا يمكن استرداد هذا الجهاز بوصفه الحساب نفسه. أعد إعداد الاسترداد من جهاز لا تزال مكتبة هذا الحساب تُفتح عليه، ثم استرد باستخدام سر الاسترداد الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Wiederherstellungs-Backup dieses Kontos enthält nicht dessen Identitätsschlüssel, daher kann dieses Gerät nicht als dasselbe Konto wiederhergestellt werden. Richte die Wiederherstellung auf einem Gerät neu ein, auf dem sich die Mediathek dieses Kontos noch öffnen lässt, und stelle dann mit dem neuen Wiederherstellungsgeheimnis wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This account's recovery backup does not include its identity key, so this device cannot be recovered as the same account. Set recovery up again from a device where this account's library still opens, then recover with the new recovery secret."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de recuperación de esta cuenta no incluye su clave de identidad, así que este dispositivo no se puede recuperar como la misma cuenta. Vuelve a configurar la recuperación desde un dispositivo en el que la biblioteca de esta cuenta aún se abra y, después, recupera con el nuevo secreto de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde de récupération de ce compte ne contient pas sa clé d'identité : cet appareil ne peut donc pas être récupéré en tant que même compte. Configurez à nouveau la récupération depuis un appareil où la bibliothèque de ce compte s'ouvre encore, puis effectuez la récupération avec le nouveau secret de récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस खाते के रिकवरी बैकअप में इसकी पहचान कुंजी शामिल नहीं है, इसलिए इस डिवाइस को उसी खाते के रूप में रिकवर नहीं किया जा सकता। किसी ऐसे डिवाइस से रिकवरी फिर से सेट करें जहाँ इस खाते की लाइब्रेरी अब भी खुलती है, फिर नए रिकवरी सीक्रेट से रिकवर करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup di ripristino di questo account non include la sua chiave di identità, quindi questo dispositivo non può essere ripristinato come lo stesso account. Configura di nuovo il ripristino da un dispositivo su cui la libreria di questo account si apre ancora, quindi esegui il ripristino con il nuovo segreto di ripristino."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントのリカバリーバックアップには ID キーが含まれていないため、このデバイスを同じアカウントとして復元できません。このアカウントのライブラリをまだ開けるデバイスでリカバリーを再設定し、新しいリカバリーシークレットで復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계정의 복구 백업에 ID 키가 포함되어 있지 않아 이 기기를 같은 계정으로 복구할 수 없습니다. 이 계정의 보관함이 아직 열리는 기기에서 복구를 다시 설정한 다음, 새 복구 비밀 키로 복구하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup de recuperação desta conta não inclui a chave de identidade dela, então este dispositivo não pode ser recuperado como a mesma conta. Configure a recuperação novamente em um dispositivo onde a biblioteca desta conta ainda abre e depois recupere com o novo segredo de recuperação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия для восстановления этой учётной записи не содержит её ключа идентификации, поэтому это устройство нельзя восстановить как ту же учётную запись. Настройте восстановление заново на устройстве, где медиатека этой учётной записи ещё открывается, а затем выполните восстановление с новым секретом восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账户的恢复备份不包含其身份密钥，因此无法将此设备恢复为同一账户。请在仍能打开此账户资料库的设备上重新设置恢复，然后使用新的恢复密钥进行恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此帳號的復原備份不包含其身分金鑰，因此無法將此裝置復原為同一個帳號。請在仍能開啟此帳號圖庫的裝置上重新設定復原，然後使用新的復原密鑰進行復原。"
          }
        }
      }
    },
