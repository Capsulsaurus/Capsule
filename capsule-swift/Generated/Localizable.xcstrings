        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提供元はリクエスト上限に達しました。しばらくしてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 원본이 요청 한도에 도달했습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
