        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expires in {remaining}"
          }
        }
      }
    },
    "android.enrollment.code.numeric_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shorter than the square code on purpose, so it can be read aloud. It is safe because it is single-use, expires, and is rate-limited — and because the safety code is what actually protects the channel."
          }
        }
      }
    },
    "android.enrollment.code.numeric_label": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Or type this in"
          }
        }
      }
    },
