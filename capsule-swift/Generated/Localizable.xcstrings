    "app.transfer.connection.policy.adverse": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفع التفاصيل الصغيرة فقط ما دام الاتصال ضعيفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei schlechter Verbindung werden nur kleine Details hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only small details upload while the connection is poor."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se suben los detalles pequeños mientras la conexión es mala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les petits détails sont téléversés tant que la connexion est médiocre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन कमज़ोर होने तक केवल छोटे विवरण अपलोड होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una connessione scarsa vengono caricati solo i dettagli più piccoli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続状態が悪い間は、小さな詳細情報のみアップロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 상태가 좋지 않은 동안에는 작은 정보만 업로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas os detalhes pequenos são enviados enquanto a conexão está ruim."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При плохом соединении загружаются только небольшие данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接较差时仅上传少量详细信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連線不佳時，只會上傳小型的詳細資料。"
          }
        }
      }
    },
    "app.transfer.connection.policy.constrained": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفع التفاصيل والمعاينات فقط على هذا الاتصال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über diese Verbindung werden nur Details und Vorschauen hochgeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only details and previews upload on this connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con esta conexión solo se suben los detalles y las vistas previas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les détails et les aperçus sont téléversés sur cette connexion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कनेक्शन पर केवल विवरण और प्रीव्यू अपलोड होते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con questa connessione vengono caricati solo dettagli e anteprime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この接続では、詳細情報とプレビューのみアップロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연결에서는 정보와 미리보기만 업로드됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas detalhes e pré-visualizações são enviados nesta conexão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Через это соединение загружаются только данные и превью."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此连接下仅上传详细信息和预览。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此連線時，只會上傳詳細資料和預覽。"
          }
        }
      }
    },
    "app.transfer.connection.policy.metered": {
      "localizations": {
