            "value": "Elige un identificador y una contraseña para este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un identifiant et un mot de passe pour ce serveur."
          }
        },
        "hi": {
