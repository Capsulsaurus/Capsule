    "app.import.plan.reason.scope_override": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قاعدة وضعتها لهذا المصدر ترسل الصور إلى هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Regel, die du für diese Quelle festgelegt hast, schickt Fotos hierher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rule you set for this source sends photos here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla que estableciste para esta fuente envía las fotos aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle que vous avez définie pour cette source envoie les photos ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्रोत के लिए आपका सेट किया गया एक नियम फ़ोटो यहाँ भेजता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regola che hai impostato per questa origine invia qui le foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このソースに設定したルールにより、写真がここに送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 소스에 설정한 규칙에 따라 여기에 저장됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma regra que você definiu para esta fonte envia as fotos para cá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сюда фото направляет правило, заданное вами для этого источника."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您为此来源设置的规则会将照片存放到这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你為此來源設定的規則會將照片送到這裡。"
          }
        }
      }
    },
