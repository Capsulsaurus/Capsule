    "error.auth.oidc_address_taken": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد هنا بالفعل حساب بعنوان البريد الإلكتروني هذا. سجّل الدخول بكلمة مروره بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier existiert bereits ein Konto mit dieser E-Mail-Adresse. Melde dich stattdessen mit dessen Passwort an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An account with that email address already exists here. Sign in with its password instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe aquí una cuenta con esa dirección de correo electrónico. Inicia sesión con su contraseña."
          }
        },
        "fr": {
          "stringUnit": {
