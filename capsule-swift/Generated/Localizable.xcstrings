    "app.custody.action.blocked.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يحرّر Capsule النسخة الموجودة على هذا الجهاز حتى يؤكد خادمك أنه يحتفظ بهذه الصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule gibt die Kopie auf diesem Gerät erst frei, wenn dein Server bestätigt, dass er dieses Foto gespeichert hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule won't release the copy on this device until your server confirms it holds this photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no liberará la copia de este dispositivo hasta que tu servidor confirme que guarda esta foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ne libérera pas la copie sur cet appareil tant que votre serveur n'aura pas confirmé détenir cette photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आपका सर्वर यह पुष्टि नहीं करता कि उसके पास यह फ़ोटो है, Capsule इस डिवाइस की कॉपी नहीं हटाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non libererà la copia su questo dispositivo finché il tuo server non confermerà di avere questa foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがこの写真の保管を確認するまで、Capsule はこのデバイス上のコピーを解放しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 사진을 보관하고 있다고 확인할 때까지 Capsule은 이 기기의 사본을 해제하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não vai liberar a cópia neste dispositivo até que seu servidor confirme que tem esta foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не освободит копию на этом устройстве, пока ваш сервер не подтвердит, что хранит это фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的服务器确认已保存此照片之前，Capsule 不会释放此设备上的副本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在你的伺服器確認已保存此照片之前，Capsule 不會釋放此裝置上的副本。"
          }
        }
      }
    },
