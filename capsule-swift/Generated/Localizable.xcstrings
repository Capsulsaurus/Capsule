    "app.auth.path.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في كلتا الحالتين، بيانات الاعتماد تسجّل دخولك فقط. المفتاح الذي يفتح صورك يُنشأ على جهازك، ولا يراه أبدًا من يتحقق من بيانات اعتمادك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "So oder so meldet dich die Anmeldeinformation nur an. Der Schlüssel, der deine Fotos entsperrt, wird auf deinem Gerät erzeugt, und wer deine Anmeldeinformation prüft, sieht ihn nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Either way, the credential only signs you in. The key that unlocks your photos is made on your device, and whoever checks your credential never sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cualquier caso, la credencial solo inicia tu sesión. La clave que desbloquea tus fotos se crea en tu dispositivo, y quien comprueba tu credencial nunca la ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans les deux cas, l'identifiant sert uniquement à vous connecter. La clé qui déverrouille vos photos est créée sur votre appareil, et celui qui vérifie votre identifiant ne la voit jamais."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों ही स्थितियों में, क्रेडेंशियल केवल आपको साइन इन करता है। आपकी फ़ोटो अनलॉक करने वाली कुंजी आपके डिवाइस पर बनती है, और आपका क्रेडेंशियल जाँचने वाला उसे कभी नहीं देखता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In entrambi i casi, la credenziale serve solo per accedere. La chiave che sblocca le tue foto viene creata sul tuo dispositivo e chi verifica la tua credenziale non la vede mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どちらの方法でも、認証情報はサインインにのみ使用されます。写真のロックを解除する鍵はデバイス上で作成され、認証情報を確認する側がそれを見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어느 방법이든 자격 증명은 로그인에만 사용됩니다. 사진을 잠금 해제하는 키는 기기에서 생성되며, 자격 증명을 확인하는 쪽은 이 키를 절대 볼 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qualquer forma, a credencial serve apenas para você entrar. A chave que desbloqueia suas fotos é criada no seu dispositivo, e quem verifica sua credencial nunca a vê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В любом случае эти данные служат только для входа. Ключ, открывающий доступ к вашим фото, создаётся на вашем устройстве, и тот, кто проверяет ваши данные для входа, его никогда не видит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论选择哪种方式，凭证都只用于登录。解锁您照片的密钥在您的设备上生成，核验您凭证的一方永远看不到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無論選擇哪一種，憑證都只用於登入。解鎖照片的密鑰是在你的裝置上產生的，檢查憑證的一方永遠看不到它。"
          }
        }
      }
    },
