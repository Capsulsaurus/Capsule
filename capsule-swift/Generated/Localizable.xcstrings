    "app.settings.account.identity.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معرّفك مرتبط بهذا الخادم. أما هويتك فلا — فهي تبقى لك إذا انتقلت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Handle ist an diesen Server gebunden. Deine Identität nicht – du behältst sie, wenn du umziehst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your handle is bound to this server. Your identity isn't — you keep it if you move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu identificador está vinculado a este servidor. Tu identidad no: la conservas si te mudas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identifiant est lié à ce serveur. Votre identité ne l'est pas : vous la conservez si vous changez de serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हैंडल इस सर्वर से जुड़ा है। आपकी पहचान नहीं — सर्वर बदलने पर भी वह आपके पास रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo handle è legato a questo server. La tua identità no: la mantieni se ti trasferisci."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハンドルはこのサーバーに紐付いていますが、ID はそうではありません。移行しても ID はそのまま保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "핸들은 이 서버에 연결되어 있지만 ID는 그렇지 않습니다. 서버를 옮겨도 ID는 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu identificador está vinculado a este servidor. Sua identidade não — você a mantém se mudar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш идентификатор привязан к этому серверу. Ваша личность — нет: она сохранится при переезде."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的用户名与此服务器绑定，但您的身份不是。即使迁移，您也会保留身份。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的帳號代號與此伺服器綁定，但您的身分不會；即使搬遷，您仍會保有身分。"
          }
        }
      }
    },
