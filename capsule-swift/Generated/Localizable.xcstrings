    "app.transfer.recovery.merge.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي الخادم بالفعل على المحتوى نفسه تمامًا. سيربط Capsule هذه الصورة به بدلًا من رفعها مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat bereits genau diese Inhalte. Capsule verknüpft dieses Foto damit, statt es erneut hochzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server already has these exact contents. Capsule will point this photo at them instead of uploading again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor ya tiene exactamente este contenido. Capsule vinculará esta foto a él en lugar de volver a subirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur possède déjà exactement ce contenu. Capsule associera cette photo à celui-ci au lieu de la téléverser à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर के पास पहले से ठीक यही सामग्री है। Capsule फिर से अपलोड करने के बजाय इस फ़ोटो को उसी से जोड़ देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server ha già questi contenuti identici. Capsule collegherà questa foto a quelli invece di caricarla di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーにはすでにまったく同じ内容があります。Capsule は再アップロードせずに、この写真をそれに関連付けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버에 이미 동일한 콘텐츠가 있습니다. Capsule이 다시 업로드하는 대신 이 사진을 해당 콘텐츠에 연결합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor já tem exatamente este conteúdo. O Capsule vai vincular esta foto a ele em vez de enviar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На сервере уже есть точно такое же содержимое. Capsule свяжет это фото с ним, а не будет загружать заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器已存有完全相同的内容。Capsule 会将此照片指向该内容，而不再重新上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器上已有完全相同的內容。Capsule 會將這張照片指向該內容，而不再重新上傳。"
          }
        }
      }
    },
