    "app.quota.state.hard_exceeded.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفض عمليات الرفع الجديدة حتى تحرّر مساحة. يبقى كل ما خُزِّن بالفعل كما هو وقابلًا للقراءة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Uploads werden abgelehnt, bis du Speicher freigibst. Alles bereits Gespeicherte bleibt unberührt und lesbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New uploads are refused until you free space. Everything already stored is untouched and still readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las subidas nuevas se rechazan hasta que liberes espacio. Todo lo que ya está guardado sigue intacto y se puede leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux téléversements sont refusés jusqu'à ce que vous libériez de l'espace. Tout ce qui est déjà stocké reste intact et consultable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप जगह ख़ाली नहीं करते, नए अपलोड अस्वीकार किए जाएँगे। पहले से संग्रहीत सब कुछ सुरक्षित है और अब भी पढ़ा जा सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nuovi caricamenti vengono rifiutati finché non liberi spazio. Tutto ciò che è già archiviato resta intatto e leggibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空き容量を確保するまで、新規アップロードは受け付けられません。保存済みのものはそのまま残り、引き続き閲覧できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간을 확보할 때까지 새 업로드가 거부됩니다. 이미 저장된 항목은 그대로 유지되며 계속 볼 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Novos envios são recusados até você liberar espaço. Tudo o que já está armazenado permanece intacto e legível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые загрузки отклоняются, пока вы не освободите место. Всё, что уже сохранено, остаётся нетронутым и доступным."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您释放空间之前，新上传将被拒绝。已存储的所有内容都不受影响，仍可读取。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您釋放空間前，新上傳會被拒絕。所有已儲存的內容都不受影響，且仍可讀取。"
          }
        }
      }
    },
