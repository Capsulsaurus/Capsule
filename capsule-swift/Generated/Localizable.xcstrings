          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor não tomou nenhuma ação na sua conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш сервер не применял мер к вашей учётной записи."
