          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この提供元は、あなたのアカウントでのキャッシュ上限に達しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 원본은 계정의 캐싱 한도에 도달했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
