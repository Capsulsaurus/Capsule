    "app.export.outcome.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عاد خيار الاحتفاظ بالتفاصيل المُعرِّفة إلى وضع الإيقاف تلقائيًا للتصدير التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Beibehalten identifizierender Angaben wurde für den nächsten Export automatisch wieder deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping identifying details has switched itself back off for the next export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La opción de conservar datos identificativos se ha desactivado automáticamente para la próxima exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La conservation des informations d'identification a été désactivée automatiquement pour le prochain export."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहचान संबंधी विवरण रखने का विकल्प अगले एक्सपोर्ट के लिए अपने आप फिर से बंद हो गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'opzione per mantenere i dettagli identificativi è stata disattivata automaticamente per la prossima esportazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "識別情報の保持は、次回の書き出しに向けて自動的にオフに戻りました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 내보내기를 위해 식별 정보 유지 설정이 자동으로 꺼졌습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A opção de manter detalhes de identificação foi desativada automaticamente para a próxima exportação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранение идентифицирующих данных для следующего экспорта снова выключено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
