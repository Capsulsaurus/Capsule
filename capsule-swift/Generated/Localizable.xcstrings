    "notification.recovery_check_due.check.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكّد من أنك لا تزال قادرًا على استرداد مكتبتك إذا فقدت هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestätige, dass du deine Mediathek noch wiederherstellen kannst, falls du dieses Gerät verlierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you can still recover your library if you lose this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que aún puedes recuperar tu biblioteca si pierdes este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez que vous pouvez toujours récupérer votre bibliothèque si vous perdez cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि करें कि यह डिवाइस खो जाने पर भी आप अपनी लाइब्रेरी रिकवर कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma di poter ancora ripristinare la tua libreria se perdi questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスを紛失した場合でもライブラリを復元できることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기를 잃어버려도 보관함을 복구할 수 있는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que você ainda consegue recuperar sua biblioteca se perder este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что сможете восстановить медиатеку, если потеряете это устройство."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确认在丢失此设备时您仍能恢复资料库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認您在遺失此裝置時仍能復原圖庫。"
          }
        }
      }
    },
    "notification.recovery_check_due.check.title": {
      "localizations": {
        "ar": {
