    "app.sync.policy.staged.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل التفاصيل والمعاينات أولًا لتظهر الصور على أجهزتك الأخرى بسرعة، ثم الملف بالحجم الكامل عند توفر Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet zuerst Details und Vorschauen, damit Fotos schnell auf deinen anderen Geräten erscheinen, und die Datei in voller Größe, sobald WLAN verfügbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sends details and previews first, so photos appear on your other devices quickly, and the full-size file when Wi-Fi is available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía primero los detalles y las previsualizaciones, para que las fotos aparezcan rápido en tus otros dispositivos, y el archivo a tamaño completo cuando haya Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoie d'abord les détails et les aperçus, pour que les photos apparaissent vite sur vos autres appareils, puis le fichier en taille réelle lorsque le Wi-Fi est disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले विवरण और प्रीव्यू भेजता है, ताकि फ़ोटो आपके अन्य डिवाइस पर जल्दी दिखें, और Wi-Fi उपलब्ध होने पर पूर्ण-आकार फ़ाइल।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia prima dettagli e anteprime, così le foto compaiono rapidamente sugli altri tuoi dispositivi, e il file a dimensione piena quando è disponibile il Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細とプレビューを先に送信してほかのデバイスにすぐ写真が表示されるようにし、フルサイズのファイルは Wi-Fi が使えるときに送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세부 정보와 미리보기를 먼저 보내 다른 기기에 사진이 빠르게 표시되도록 하고, 원본 크기 파일은 Wi-Fi를 사용할 수 있을 때 보냅니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia detalhes e prévias primeiro, para que as fotos apareçam logo nos seus outros dispositivos, e o arquivo original quando houver Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала отправляет сведения и превью, чтобы фото быстро появились на других устройствах, а полноразмерный файл — при наличии Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先发送详细信息和预览，让照片快速出现在您的其他设备上，再在有 Wi-Fi 时发送全尺寸文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先傳送詳細資訊和預覽，讓照片快速出現在您的其他裝置上，並在有 Wi-Fi 時傳送原尺寸檔案。"
          }
        }
      }
    },
    "app.sync.scope.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اربط خادمًا لاختيار ما يحتفظ به هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde einen Server, um festzulegen, was dieses Gerät behält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a server to choose what this device keeps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta un servidor para elegir qué conserva este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un serveur pour choisir ce que cet appareil conserve."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिवाइस क्या रखे, यह चुनने के लिए कोई सर्वर कनेक्ट करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un server per scegliere cosa conserva questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保持する内容を選ぶには、サーバーに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 보관할 항목을 선택하려면 서버를 연결하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte um servidor para escolher o que este dispositivo mantém."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите сервер, чтобы выбрать, что хранить на этом устройстве."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接服务器后即可选择此设备保留哪些内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接伺服器以選擇此裝置要保留的內容。"
          }
        }
      }
    },
