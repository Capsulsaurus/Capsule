        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 보관을 확인하지 않은 일부 사본은 제외됩니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Algumas cópias foram retidas porque seu servidor ainda não confirmou que as tem"
