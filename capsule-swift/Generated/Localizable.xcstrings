            "state": "translated",
            "value": "尚未檢查"
          }
        }
      }
    },
    "app.custody.verdict.unchecked.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يسأل Capsule خادمك عن هذه الصورة بعد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hat deinen Server noch nicht nach diesem Foto gefragt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule hasn't asked your server about this photo yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule aún no ha consultado a tu servidor sobre esta foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule n'a pas encore interrogé votre serveur au sujet de cette photo."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ने अभी तक आपके सर्वर से इस फ़ोटो के बारे में नहीं पूछा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non ha ancora chiesto al tuo server di questa foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule はまだこの写真についてサーバーに問い合わせていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 아직 이 사진에 대해 서버에 확인하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule ainda não consultou seu servidor sobre esta foto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ещё не запрашивал у вашего сервера данные об этом фото."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 尚未向您的服务器询问此照片的情况。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 尚未向你的伺服器詢問此照片的狀態。"
          }
        }
      }
    },
    "app.destination.missing.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد هذا العنصر في مكتبتك. ربما أُزيل أو اعتُمد أو حُسم في مكان آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist nicht mehr in deiner Mediathek. Es wurde möglicherweise entfernt, übernommen oder anderweitig erledigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is no longer in your library. It may have been removed, adopted, or resolved elsewhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ya no está en tu biblioteca. Puede que se haya eliminado, adoptado o resuelto en otro lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément ne se trouve plus dans votre bibliothèque. Il a peut-être été supprimé, adopté ou traité ailleurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अब आपकी लाइब्रेरी में नहीं है। हो सकता है इसे हटा दिया गया हो, अपना लिया गया हो, या कहीं और हल कर दिया गया हो।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento non è più nella tua libreria. Potrebbe essere stato rimosso, adottato o risolto altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはライブラリにはもうありません。削除されたか、取り込まれたか、別の場所で解決された可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목은 더 이상 라이브러리에 없습니다. 다른 곳에서 제거, 채택 또는 해결되었을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não está mais na sua biblioteca. Pode ter sido removido, adotado ou resolvido em outro lugar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этого больше нет в вашей медиатеке. Возможно, объект удалён, принят или обработан в другом месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项已不在您的资料库中。它可能已被移除、采纳或在其他地方处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此項目已不在你的圖庫中。它可能已在其他地方被移除、採納或處理。"
          }
        }
      }
    },
    "app.devices.cohort.assertion": {
      "localizations": {
        "ar": {
          "stringUnit": {
