    "error.upload.timestamp_out_of_range": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن ساعة جهازك غير صحيحة. تحقّق من التاريخ والوقت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr Ihres Geräts scheint falsch zu sein. Überprüfen Sie Datum und Uhrzeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your device's clock appears to be wrong. Check its date and time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj de tu dispositivo parece estar mal. Comprueba su fecha y hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'horloge de votre appareil semble incorrecte. Vérifiez sa date et son heure."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके डिवाइस की घड़ी ग़लत लगती है। इसकी तारीख़ और समय जाँचें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'orologio del tuo dispositivo sembra errato. Controlla data e ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスの時計が正しくないようです。日付と時刻を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기의 시계가 잘못된 것 같습니다. 날짜와 시간을 확인해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio do seu dispositivo parece estar errado. Verifique a data e a hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, часы вашего устройства выставлены неверно. Проверьте дату и время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您设备的时钟似乎不正确。请检查其日期和时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您裝置的時鐘似乎不正確。請檢查其日期和時間。"
          }
        }
      }
    },
    "error.upload.unknown_crypto_suite": {
