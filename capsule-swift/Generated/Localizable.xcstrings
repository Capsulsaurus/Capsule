    "app.settings.storage.local.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إخلاء المساحة هنا لا يغيّر ما هو مخزّن على الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speicherplatz hier freizugeben ändert nichts an dem, was auf deinem Server gespeichert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clearing space here doesn't change what's stored on your server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberar espacio aquí no cambia lo que hay almacenado en tu servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérer de l'espace ici ne modifie pas ce qui est stocké sur votre serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ जगह ख़ाली करने से आपके सर्वर पर संग्रहीत चीज़ें नहीं बदलतीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberare spazio qui non cambia ciò che è archiviato sul tuo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで容量を空けても、サーバーに保存されている内容は変わりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기서 공간을 정리해도 서버에 저장된 항목은 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Liberar espaço aqui não altera o que está armazenado no seu servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Освобождение места здесь не влияет на то, что хранится на вашем сервере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此处释放空间不会改变您服务器上存储的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除此處的空間不會影響儲存在伺服器上的內容。"
          }
        }
      }
    },
