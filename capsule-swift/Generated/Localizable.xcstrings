    "app.storage.consumers.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجمّعة حسب النوع لا حسب الصورة — يتتبع Capsule هذه الأرقام بشكل إجمالي، لا لكل صورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Art statt nach Foto gruppiert – Capsule erfasst diese Werte gesammelt, nicht pro Bild."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grouped by kind rather than by photo — Capsule tracks these figures in bulk, not per picture."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupado por tipo y no por foto: Capsule registra estas cifras en conjunto, no por imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupé par type plutôt que par photo : Capsule suit ces chiffres globalement, pas image par image."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो के बजाय प्रकार के अनुसार समूहित — Capsule ये आँकड़े हर तस्वीर के लिए नहीं, बल्कि कुल मिलाकर रखता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppato per tipo anziché per foto: Capsule tiene traccia di questi valori in blocco, non per singola immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ごとではなく種類ごとに分類しています。Capsule はこれらの数値を写真単位ではなく、まとめて記録しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진별이 아닌 종류별로 묶어 표시합니다. Capsule은 이 수치를 사진마다가 아니라 전체적으로 추적합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupado por tipo, e não por foto — o Capsule acompanha esses números em conjunto, não imagem por imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сгруппировано по типу, а не по фото — Capsule учитывает эти данные в целом, а не для каждого снимка."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按类型而非按照片分组——Capsule 是整体统计这些数据的，而不是按每张照片统计。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依類型而非依照片分組，Capsule 是整批追蹤這些數字，而非逐張計算。"
          }
        }
      }
    },
