    "app.quarantine.inspect.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بداية البيانات المحفوظة، معروضة كما هي. مفيدة في تقرير الأخطاء؛ لا شيء هنا يغيّر العنصر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Anfang der aufbewahrten Daten, unverändert dargestellt. Nützlich für einen Fehlerbericht; nichts hier verändert das Element."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start of the kept data, shown as-is. Useful in a bug report; nothing here changes the item."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de los datos guardados, tal cual. Útil en un informe de errores; nada de esto cambia el elemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le début des données conservées, affiché tel quel. Utile pour un rapport de bug ; rien ici ne modifie l'élément."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखे गए डेटा की शुरुआत, जैसी है वैसी दिखाई गई। बग रिपोर्ट में उपयोगी; यहाँ कुछ भी आइटम को नहीं बदलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inizio dei dati conservati, mostrato così com'è. Utile in una segnalazione di bug; nulla qui modifica l'elemento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保管データの先頭部分をそのまま表示しています。バグ報告に役立ちます。ここでは項目は何も変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 데이터의 시작 부분을 있는 그대로 표시합니다. 버그 신고에 유용하며, 여기서는 항목이 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O início dos dados guardados, mostrado como está. Útil em um relatório de bug; nada aqui altera o item."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начало сохранённых данных в исходном виде. Пригодится для отчёта об ошибке; ничто здесь не изменяет объект."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留数据的开头部分，按原样显示。可用于问题报告；这里的任何内容都不会更改该项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保留資料的開頭部分，按原樣顯示。可用於錯誤回報；這裡的任何內容都不會變更此項目。"
          }
        }
      }
    },
