    "notification.quota_grace_expiring.expired.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت فترة السماح للتخزين. أُوقفت مؤقتًا عمليات الرفع والتعديلات التي تضيف بيانات حتى تحرّر مساحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachfrist für den Speicher ist abgelaufen. Uploads und Bearbeitungen, die Daten hinzufügen, sind pausiert, bis du Speicherplatz freigibst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The storage grace period has ended. Uploads and edits that add data are paused until you free up space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El período de gracia del almacenamiento ha terminado. Las subidas y las ediciones que añaden datos están en pausa hasta que liberes espacio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de grâce du stockage a pris fin. Les téléversements et les modifications qui ajoutent des données sont suspendus jusqu'à ce que vous libériez de l'espace."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोरेज की छूट अवधि समाप्त हो गई है। जगह ख़ाली करने तक अपलोड और डेटा जोड़ने वाले संपादन रोक दिए गए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il periodo di tolleranza dello spazio di archiviazione è terminato. I caricamenti e le modifiche che aggiungono dati sono in pausa finché non liberi spazio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージの猶予期間が終了しました。空き容量を確保するまで、データを追加するアップロードや編集は一時停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간 유예 기간이 끝났습니다. 공간을 확보할 때까지 데이터를 추가하는 업로드와 편집이 일시 정지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O período de tolerância do armazenamento terminou. Envios e edições que adicionam dados estão pausados até você liberar espaço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Льготный период хранилища закончился. Загрузки и изменения, добавляющие данные, приостановлены, пока вы не освободите место."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存储宽限期已结束。在您释放空间之前，上传和会增加数据的编辑将被暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存空間寬限期已結束。在您釋放空間之前，會增加資料的上傳和編輯都將暫停。"
          }
        }
      }
    },
    "notification.quota_grace_expiring.expired.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت فترة السماح للتخزين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachfrist für Speicher abgelaufen"
          }
