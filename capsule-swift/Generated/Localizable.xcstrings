    "app.drops.compose.scope.quota": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب الملفات المنتظرة في صندوق الوارد ضمن مساحة التخزين لديك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, die in deinem Posteingang warten, zählen zu deinem Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files waiting in your inbox count towards your storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos que esperan en tu bandeja de entrada cuentan para tu almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers en attente dans votre boîte de réception sont comptés dans votre stockage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके इनबॉक्स में प्रतीक्षारत फ़ाइलें आपके स्टोरेज में गिनी जाती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file in attesa nella posta in arrivo contano nel tuo spazio di archiviazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイで待機中のファイルは、ストレージ使用量に含まれます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받은 편지함에서 대기 중인 파일도 저장 공간 사용량에 포함됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos aguardando na sua caixa de entrada contam para o seu armazenamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы во входящих учитываются в объёме вашего хранилища."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收件箱中等待处理的文件会计入您的存储空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收件匣中等待的檔案會計入你的儲存空間。"
          }
        }
      }
    },
    "app.drops.compose.scope.review_required": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما يُرسَل ينتظر في صندوق الوارد حتى تقبله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles Gesendete wartet in deinem Posteingang, bis du es annimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything sent waits in your inbox until you accept it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que se envía espera en tu bandeja de entrada hasta que lo aceptes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est envoyé attend dans votre boîte de réception jusqu'à ce que vous l'acceptiez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजी गई हर चीज़ आपके स्वीकार करने तक आपके इनबॉक्स में रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che viene inviato resta in attesa nella posta in arrivo finché non lo accetti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信されたものはすべて、承認するまで受信トレイで待機します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낸 모든 항목은 수락할 때까지 받은 편지함에서 대기합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que for enviado aguarda na sua caixa de entrada até você aceitar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё отправленное ждёт во входящих, пока вы это не примете."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有发送的内容都会在收件箱中等待，直到您接受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有傳送來的內容都會在收件匣中等待，直到你接受為止。"
          }
        }
      }
    },
    "app.drops.compose.scope.write_only": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لمن لديه الرابط أن يرسل إليك ملفات. ولا يمكنه رؤية أي شيء في مكتبتك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer den Link hat, kann dir Dateien senden, aber nichts in deiner Mediathek sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whoever has the link can send you files. They can't see anything in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quien tenga el enlace puede enviarte archivos. No puede ver nada de tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant du lien peut vous envoyer des fichiers. Elle ne peut rien voir de votre bibliothèque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिसके पास भी लिंक है वह आपको फ़ाइलें भेज सकता है। वह आपकी लाइब्रेरी में कुछ भी नहीं देख सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi ha il link può inviarti file, ma non può vedere nulla della tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクを知っている人はファイルを送信できます。ライブラリ内のものを見ることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크가 있는 사람은 파일을 보낼 수 있습니다. 라이브러리의 항목은 볼 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem tiver o link pode enviar arquivos para você. Não pode ver nada da sua biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой, у кого есть ссылка, может отправлять вам файлы. Содержимое вашей медиатеки ему не видно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拥有此链接的人可以向您发送文件，但无法查看您资料库中的任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "擁有此連結的人可以傳送檔案給你，但無法看到你圖庫中的任何內容。"
          }
        }
      }
    },
