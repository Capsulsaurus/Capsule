    "app.recovery.passphrase.gate.no_skip": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تخطي هذه الخطوة. العبارة التي لم يدوّنها أحد لا تحمي شيئًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schritt kann nicht übersprungen werden. Eine Phrase, die niemand notiert hat, schützt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This step can't be skipped. A phrase nobody wrote down protects nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este paso no se puede omitir. Una frase que nadie anotó no protege nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette étape ne peut pas être ignorée. Une phrase que personne n'a notée ne protège rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चरण को छोड़ा नहीं जा सकता। जिस फ़्रेज़ को किसी ने लिखा ही नहीं, वह किसी चीज़ की सुरक्षा नहीं करता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo passaggio non può essere saltato. Una frase che nessuno ha annotato non protegge nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手順は省略できません。誰も書き留めていないフレーズでは何も守れません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 단계는 건너뛸 수 없습니다. 아무도 적어 두지 않은 문구는 아무것도 보호하지 못합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta etapa não pode ser ignorada. Uma frase que ninguém anotou não protege nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот шаг нельзя пропустить. Незаписанная фраза ничего не защищает."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此步骤无法跳过。没人记下的短语起不到任何保护作用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此步驟無法略過。沒有人抄寫下來的短語無法提供任何保護。"
          }
        }
