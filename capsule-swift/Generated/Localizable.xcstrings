    "app.sync.policy.full.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفع الصورة بالحجم الكامل مع كل شيء آخر، فور أن يسمح الاتصال بذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt das Foto in voller Größe zusammen mit allem anderen hoch, sobald die Verbindung es zulässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uploads the full-size photo along with everything else, as soon as the connection allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube la foto a tamaño completo junto con todo lo demás en cuanto la conexión lo permite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Téléverse la photo en taille réelle avec tout le reste, dès que la connexion le permet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन अनुमति देते ही पूर्ण-आकार फ़ोटो को बाकी सब के साथ अपलोड करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica la foto a dimensione piena insieme a tutto il resto, appena la connessione lo consente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が許す限りすぐに、フルサイズの写真をほかのデータと一緒にアップロードします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결이 허용되는 즉시 원본 크기 사진을 다른 모든 항목과 함께 업로드합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia a foto em tamanho original junto com todo o resto, assim que a conexão permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает полноразмерное фото вместе со всем остальным, как только позволяет подключение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在连接允许时，立即将全尺寸照片连同其他所有内容一起上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只要連線允許，就會將原尺寸照片連同其他所有內容一起上傳。"
          }
        }
      }
    },
