    "app.albums.detail.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف صورًا باستخدام إجراء «إضافة إلى ألبوم» في العارض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Fotos über die Aktion „Zu Album hinzufügen“ in der Fotoansicht hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add photos using a viewer's Add to Album action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade fotos con la acción Añadir a álbum del visor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des photos avec l'action Ajouter à l'album de la visionneuse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "व्यूअर की \"एल्बम में जोड़ें\" क्रिया से फ़ोटो जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi foto con l'azione Aggiungi all'album del visualizzatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビューアの「アルバムに追加」から写真を追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뷰어의 앨범에 추가 동작으로 사진을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione fotos usando a ação Adicionar ao álbum do visualizador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавляйте фото с помощью действия «Добавить в альбом» в режиме просмотра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在查看器中使用“添加到相册”来添加照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在檢視器中使用「加入相簿」動作來加入照片。"
          }
        }
      }
    },
