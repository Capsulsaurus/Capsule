    "app.import.source.takeout.detail": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفك ضغط أرشيف تصدير من خدمة صور أخرى ويستورد ما بداخله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entpackt ein Exportarchiv eines anderen Fotodienstes und importiert den Inhalt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unpacks an export archive from another photo service and imports what's inside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descomprime un archivo de exportación de otro servicio de fotos e importa su contenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décompresse une archive d'exportation d'un autre service photo et importe son contenu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अन्य फ़ोटो सेवा का एक्सपोर्ट आर्काइव खोलता है और उसके अंदर की सामग्री इंपोर्ट करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrae un archivio di esportazione da un altro servizio di foto e ne importa il contenuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の写真サービスの書き出しアーカイブを展開し、その中身を読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사진 서비스의 내보내기 아카이브를 풀어 그 안의 항목을 가져옵니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descompacta um arquivo de exportação de outro serviço de fotos e importa o conteúdo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распаковывает архив экспорта из другого фотосервиса и импортирует его содержимое."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解压来自其他照片服务的导出归档，并导入其中的内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解開其他照片服務的匯出封存檔，並匯入其中的內容。"
          }
        }
      }
    },
