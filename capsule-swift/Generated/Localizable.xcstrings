    "app.custody.verdict.stale.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تأكيد هذا منذ فترة. تحقّق مرة أخرى للتأكد من أنها لا تزال موجودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wurde vor einiger Zeit bestätigt. Prüfe erneut, um sicherzugehen, dass es noch da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This was confirmed a while ago. Check again to be sure it's still there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto se confirmó hace un tiempo. Vuelve a comprobarlo para asegurarte de que sigue ahí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette confirmation date un peu. Vérifiez à nouveau pour vous assurer que la photo est toujours là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसकी पुष्टि कुछ समय पहले हुई थी। यह सुनिश्चित करने के लिए फिर से जाँचें कि यह अभी भी वहाँ है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La conferma risale a qualche tempo fa. Controlla di nuovo per assicurarti che sia ancora lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはしばらく前に確認されたものです。まだ保管されているか、再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼마 전에 확인된 상태입니다. 아직 그대로 있는지 다시 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto foi confirmado há algum tempo. Verifique novamente para ter certeza de que ainda está lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это было подтверждено некоторое время назад. Проверьте снова, чтобы убедиться, что фото на месте."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一段时间前确认的。请再次检查以确保它仍然存在。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是一段時間前確認的。請再次檢查，以確定它仍然存在。"
          }
        }
      }
    },
