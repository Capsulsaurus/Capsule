          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento è nel cestino da troppo tempo per essere ripristinato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目はゴミ箱に入ってから時間が経ちすぎているため、復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
