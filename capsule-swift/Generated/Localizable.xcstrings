    "app.restore.subtitle": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطّلع على محتويات هذه النسخة الاحتياطية وما ستغيّره قبل تطبيق أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh dir an, was in diesem Backup ist und was es ändern würde, bevor etwas angewendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at what's in this backup and see what it would change before anything is applied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué contiene esta copia de seguridad y qué cambiaría antes de aplicar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez le contenu de cette sauvegarde et ce qu'elle modifierait avant que quoi que ce soit ne soit appliqué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी लागू करने से पहले देखें कि इस बैकअप में क्या है और इससे क्या बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda cosa contiene questo backup e cosa cambierebbe prima che venga applicato qualcosa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適用する前に、このバックアップの内容と変更される内容を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적용하기 전에 이 백업에 무엇이 있고 어떤 변화가 생길지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja o que há neste backup e o que ele mudaria antes que qualquer coisa seja aplicada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Посмотрите, что содержит эта резервная копия и что она изменит, прежде чем что-либо будет применено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在应用任何内容之前，先查看此备份包含什么以及会带来哪些更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在套用任何內容之前，先查看此備份中有什麼，以及它會造成哪些變更。"
          }
        }
      }
    },
