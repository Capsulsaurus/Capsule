          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードが宣言したサイズより多くのデータを送信しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드가 선언한 크기보다 많은 데이터를 보냈습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envio enviou mais dados do que declarou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузка отправила больше данных, чем было заявлено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上传发送的数据超过了其声明的大小。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
