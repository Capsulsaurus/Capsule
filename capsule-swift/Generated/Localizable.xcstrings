    "error.upload.replace_incomplete": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال Capsule يستقبل الإصدار الجديد من هذه الصورة. سينتهي ذلك تلقائيًا."
          }
        },
        "de": {
