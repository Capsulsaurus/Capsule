    },
    "ios.settings.notifications.category.staleness": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Device Falling Behind"
          }
        }
      }
    },
    "ios.settings.notifications.detail.quarantine": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised when Capsule holds something back for you to look at. This can't be switched off — nothing is applied or discarded without you."
          }
        }
      }
    },
    "ios.settings.notifications.detail.quota": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised when your server stops accepting uploads. This can't be switched off — uploads failing quietly is worse than being told."
          }
        }
      }
    },
    "ios.settings.notifications.detail.recovery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised when it's been a while since your recovery phrase was checked. This can't be switched off — a phrase nobody has checked is one you find out about at the worst moment."
          }
        }
      }
    },
    "ios.settings.notifications.detail.staleness": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raised after a couple of weeks without a completed sync while changes are still outstanding. Turning it off stops the warning only — syncing carries on as usual."
          }
        }
      }
    },
    "ios.settings.recovery.escrow.configured": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up"
          }
        }
      }
    },
    "ios.settings.recovery.escrow.footer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery phrase is the only way back in if you lose every device. Nobody, including your server, can recover your library without it."
          }
        }
      }
    },
    "ios.settings.recovery.escrow.header": {
      "localizations": {
