    "notification.quota_grace_expiring.counting.body": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مساحة التخزين لديك ممتلئة، لذا أُوقفت عمليات الرفع الجديدة مؤقتًا. حرّر مساحة قبل انتهاء فترة السماح لمواصلة التعديل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Speicher ist voll, daher sind neue Uploads pausiert. Gib Speicherplatz frei, bevor die Nachfrist endet, um weiter bearbeiten zu können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your storage is full, so new uploads are paused. Free up space before the grace period ends to keep editing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacenamiento está lleno, así que las nuevas subidas están en pausa. Libera espacio antes de que termine el período de gracia para seguir editando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre stockage est plein : les nouveaux téléversements sont suspendus. Libérez de l'espace avant la fin du délai de grâce pour pouvoir continuer à modifier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका स्टोरेज भर गया है, इसलिए नए अपलोड रोक दिए गए हैं। संपादन जारी रखने के लिए छूट अवधि समाप्त होने से पहले जगह ख़ाली करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo spazio di archiviazione è pieno, quindi i nuovi caricamenti sono in pausa. Libera spazio prima della fine del periodo di tolleranza per continuare a modificare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレージがいっぱいのため、新しいアップロードは一時停止されています。編集を続けるには、猶予期間が終わる前に空き容量を確保してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 공간이 가득 차서 새 업로드가 일시 정지되었습니다. 계속 편집하려면 유예 기간이 끝나기 전에 공간을 확보하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu armazenamento está cheio, então novos envios estão pausados. Libere espaço antes do fim do período de tolerância para continuar editando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше хранилище заполнено, поэтому новые загрузки приостановлены. Освободите место до окончания льготного периода, чтобы сохранить возможность редактирования."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的存储空间已满，新上传已暂停。请在宽限期结束前释放空间，以便继续编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的儲存空間已滿，新的上傳已暫停。請在寬限期結束前釋放空間，才能繼續編輯。"
          }
        }
      }
    },
    "notification.quota_grace_expiring.counting.title": {
      "localizations": {
        "ar": {
