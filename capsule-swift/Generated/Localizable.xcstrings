        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La session de téléversement a expiré. Redémarrage…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपलोड सत्र समाप्त हो गया। फिर से शुरू किया जा रहा है…"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione di caricamento è scaduta. Ricomincio…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップロードセッションの有効期限が切れました。最初からやり直しています…"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업로드 세션이 만료되었습니다. 처음부터 다시 시작하는 중…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sessão de envio expirou. Recomeçando…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сеанс загрузки истёк. Начинаем заново…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
