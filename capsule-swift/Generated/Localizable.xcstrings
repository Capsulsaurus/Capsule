    "notification.channel.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تذكيرات بشأن مكتبتك تحتاج إلى انتباهك، مثل مزامنة متأخرة أو فحص استرداد حان موعده."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen zu deiner Mediathek, die deine Aufmerksamkeit erfordern, etwa eine Synchronisierung, die in Verzug geraten ist, oder eine fällige Wiederherstellungsprüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders about your library that need your attention, such as a sync that has fallen behind or a recovery check that is due."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordatorios sobre tu biblioteca que requieren tu atención, como una sincronización retrasada o una comprobación de recuperación pendiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappels concernant votre bibliothèque qui nécessitent votre attention, comme une synchronisation en retard ou une vérification de récupération à effectuer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लाइब्रेरी से जुड़े ऐसे रिमाइंडर जिन पर आपका ध्यान चाहिए, जैसे पीछे छूट गया सिंक या बकाया रिकवरी जाँच।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Promemoria sulla tua libreria che richiedono attenzione, come una sincronizzazione rimasta indietro o un controllo di ripristino in scadenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期の遅れや、リカバリー確認の期限など、対応が必要なライブラリに関するリマインダー。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동기화 지연이나 복구 확인 시기 등 확인이 필요한 보관함 관련 알림입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembretes sobre sua biblioteca que precisam da sua atenção, como uma sincronização atrasada ou uma verificação de recuperação pendente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Напоминания о медиатеке, требующие вашего внимания, например отстающая синхронизация или запланированная проверка восстановления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于您资料库中需要留意事项的提醒，例如同步已落后或需要进行恢复检查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要您留意的圖庫提醒，例如同步進度落後或復原檢查到期。"
          }
        }
      }
    },
