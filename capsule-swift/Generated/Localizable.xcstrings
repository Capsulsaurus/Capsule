          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上傳工作階段已過期。正在重新開始…"
          }
        }
      }
    },
    "error.upload.size_exceeded": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أرسل الرفع بيانات أكثر مما أعلن عنه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Upload hat mehr Daten gesendet als angegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The upload sent more data than it declared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La subida envió más datos de los que declaró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléversement a envoyé plus de données qu'il n'en avait déclaré."
          }
