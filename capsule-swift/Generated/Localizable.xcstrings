    "app.recovery.verify.field.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُكتب هنا للتحقق منها فقط. لا تُرسل إلى أي مكان ولا تُخزَّن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird hier nur zur Prüfung eingegeben. Sie wird nirgendwohin gesendet und nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Typed here only to check it. It isn't sent anywhere and isn't stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se escribe aquí solo para comprobarla. No se envía a ningún sitio ni se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisie ici uniquement pour la vérifier. Elle n'est ni envoyée ni stockée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ केवल जाँच के लिए टाइप किया गया है। इसे कहीं नहीं भेजा जाता और संग्रहीत नहीं किया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene inserita qui solo per il controllo. Non viene inviata da nessuna parte né memorizzata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認のためにここで入力するだけです。どこにも送信されず、保存もされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인을 위해서만 여기에 입력합니다. 어디로도 전송되거나 저장되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digitada aqui apenas para verificação. Ela não é enviada a lugar nenhum nem armazenada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводится здесь только для проверки. Фраза никуда не отправляется и не сохраняется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此输入仅用于检查，不会发送到任何地方，也不会被存储。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此輸入僅用於檢查，不會傳送到任何地方，也不會被儲存。"
          }
        }
      }
    },
