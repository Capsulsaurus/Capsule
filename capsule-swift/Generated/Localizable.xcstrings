    "app.import.source.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُستورد أي شيء قبل أن ترى ما سيحدث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts importiert, bevor du gesehen hast, was passieren wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is imported until you've seen what will happen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se importa nada hasta que hayas visto lo que va a ocurrir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est importé tant que vous n'avez pas vu ce qui va se passer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप यह नहीं देख लेते कि क्या होगा, तब तक कुछ भी इंपोर्ट नहीं किया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene importato nulla finché non hai visto cosa succederà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何が行われるかを確認するまで、何も読み込まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어떤 작업이 진행될지 확인하기 전에는 아무것도 가져오지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é importado antes de você ver o que vai acontecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не импортируется, пока вы не увидите, что произойдёт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您看到将发生什么之前，不会导入任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在您看過將會發生的事之前，不會匯入任何內容。"
          }
        }
      }
    },
