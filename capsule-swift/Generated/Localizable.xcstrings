    "app.auth.server.empty.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يستجب أي شيء في هذا النطاق كخادم Capsule. تحقّق من الإملاء وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter dieser Domain hat kein Capsule-Server geantwortet. Prüfe die Schreibweise und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing at that domain answered as a Capsule server. Check the spelling and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en ese dominio respondió como servidor de Capsule. Comprueba cómo está escrito e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur Capsule n'a répondu à ce domaine. Vérifiez l'orthographe et réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस डोमेन पर किसी ने भी Capsule सर्वर के रूप में उत्तर नहीं दिया। वर्तनी जाँचें और फिर से प्रयास करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server Capsule ha risposto a quel dominio. Controlla l'ortografia e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドメインには Capsule サーバーとして応答するものがありませんでした。綴りを確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 도메인에서 Capsule 서버로 응답한 곳이 없습니다. 철자를 확인하고 다시 시도하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada nesse domínio respondeu como um servidor Capsule. Verifique a grafia e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По этому домену не ответил ни один сервер Capsule. Проверьте написание и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该域名下没有响应的 Capsule 服务器。请检查拼写后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "該網域沒有任何 Capsule 伺服器回應。請檢查拼字後再試一次。"
          }
        }
      }
    },
