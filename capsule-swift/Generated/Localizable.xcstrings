    "app.crossdevice.start.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيعرض Capsule رمزًا ليمسحه الجهاز الآخر أو يكتبه. يعمل الرمز مرة واحدة وتنتهي صلاحيته خلال عشر دقائق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule zeigt einen Code an, den das andere Gerät scannen oder eingeben kann. Er funktioniert nur einmal und läuft nach zehn Minuten ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule will show a code for the other device to scan or type. It works once and expires in ten minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule mostrará un código para que el otro dispositivo lo escanee o lo escriba. Funciona una sola vez y caduca en diez minutos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule affichera un code que l'autre appareil devra scanner ou saisir. Il ne fonctionne qu'une fois et expire dans dix minutes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule दूसरे डिवाइस के लिए स्कैन या टाइप करने हेतु एक कोड दिखाएगा। यह एक ही बार काम करता है और दस मिनट में समाप्त हो जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule mostrerà un codice da scansionare o digitare sull'altro dispositivo. Funziona una sola volta e scade dopo dieci minuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule が、もう一方のデバイスでスキャンまたは入力するためのコードを表示します。コードは1回限り有効で、10分で期限切れになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule이 다른 기기에서 스캔하거나 입력할 코드를 표시합니다. 코드는 한 번만 작동하며 10분 후 만료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule vai mostrar um código para o outro dispositivo escanear ou digitar. Ele funciona uma vez e expira em dez minutos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule покажет код, который нужно отсканировать или ввести на другом устройстве. Он одноразовый и действует десять минут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 将显示一个代码，供另一台设备扫描或输入。该代码仅能使用一次，十分钟后过期。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會顯示一組代碼，供另一台裝置掃描或輸入。此代碼只能使用一次，十分鐘後過期。"
          }
        }
      }
    },
