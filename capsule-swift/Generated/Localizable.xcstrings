            "value": "ID 제공업체에서 로그인이 거부되었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login foi recusado no seu provedor de identidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход отклонён в вашем поставщике удостоверений."
