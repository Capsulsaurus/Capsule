    "app.peering.section.unpaired_footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتبادل Capsule الصور إلا مع الأجهزة المسجّل دخولها إلى حسابك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule tauscht Fotos nur mit Geräten aus, die bei deinem eigenen Konto angemeldet sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule only exchanges photos with devices signed in to your own account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule solo intercambia fotos con dispositivos que tienen sesión iniciada en tu propia cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule échange des photos uniquement avec les appareils connectés à votre propre compte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule केवल आपके अपने खाते में साइन इन किए गए डिवाइस के साथ फ़ोटो साझा करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule scambia foto solo con i dispositivi che hanno eseguito l'accesso al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は、あなたのアカウントにサインインしているデバイスとのみ写真をやり取りします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 내 계정에 로그인된 기기와만 사진을 주고받습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule só troca fotos com dispositivos com sessão iniciada na sua própria conta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule обменивается фото только с устройствами, на которых выполнен вход в вашу учётную запись."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 只与登录您自己账户的设备交换照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 只會與登入您本人帳號的裝置交換照片。"
          }
        }
      }
    },
