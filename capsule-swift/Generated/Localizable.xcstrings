    "app.sync.scope.unknown.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعداد كتبه إصدار أحدث من Capsule. يُحتفظ به كما هو تمامًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Einstellung, die eine neuere Version von Capsule geschrieben hat. Sie bleibt genau so erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A setting a newer version of Capsule wrote. It's kept exactly as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ajuste que escribió una versión más reciente de Capsule. Se conserva exactamente tal cual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un réglage écrit par une version plus récente de Capsule. Il est conservé tel quel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule के नए संस्करण द्वारा लिखी गई सेटिंग। इसे ठीक वैसा ही रखा जाता है जैसी यह है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'impostazione scritta da una versione più recente di Capsule. Viene conservata esattamente così com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいバージョンの Capsule が書き込んだ設定です。そのままの状態で保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 버전의 Capsule에서 저장한 설정입니다. 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ajuste gravado por uma versão mais recente do Capsule. Ele é mantido exatamente como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметр, записанный более новой версией Capsule. Он сохраняется в точности как есть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由较新版本的 Capsule 写入的设置。它会被原样保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由較新版本的 Capsule 寫入的設定，會完全依原樣保留。"
          }
        }
      }
    },
    "app.sync.snooze.active": {
      "localizations": {
