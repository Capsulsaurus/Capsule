    "app.transfer.recovery.refresh.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيجلب Capsule الحالة الراهنة من خادمك ويعيد المحاولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ruft den aktuellen Stand von deinem Server ab und versucht es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule will fetch the current state from your server and try again."
          }
        },
        "es": {
