        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A check every so often catches a phrase that was written down wrong. It never blocks anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una comprobación de vez en cuando detecta una frase que se anotó mal. Nunca bloquea nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vérification de temps en temps permet de repérer une phrase mal recopiée. Elle ne bloque jamais rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समय-समय पर जाँच करने से ग़लत लिखा गया फ़्रेज़ पकड़ में आ जाता है। यह कभी कुछ नहीं रोकती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una verifica ogni tanto individua una frase trascritta male. Non blocca mai nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定期的に確認することで、書き間違えたフレーズに気づけます。確認によって何かが妨げられることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가끔 확인하면 잘못 적은 문구를 발견할 수 있습니다. 확인하지 않아도 아무것도 차단되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma verificação de vez em quando detecta uma frase anotada errado. Ela nunca bloqueia nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Периодическая проверка выявляет фразу, записанную с ошибкой. Она ничего не блокирует."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定期检查可以发现抄写错误的短语。它不会阻止任何操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "定期檢查能發現抄錯的詞組。它絕不會阻擋任何操作。"
          }
        }
      }
    },
