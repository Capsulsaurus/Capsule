    "app.settings.sync.status.footer": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ Capsule التغييرات بالترتيب، لذا تستأنف المزامنة المنقطعة من حيث توقفت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule liest Änderungen der Reihe nach, sodass eine unterbrochene Synchronisierung dort weitermacht, wo sie aufgehört hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule reads changes in order, so an interrupted sync picks up where it stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule lee los cambios en orden, así que una sincronización interrumpida continúa donde se detuvo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule lit les modifications dans l'ordre : une synchronisation interrompue reprend là où elle s'était arrêtée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule बदलावों को क्रम से पढ़ता है, इसलिए बाधित सिंक वहीं से शुरू होता है जहाँ वह रुका था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule legge le modifiche in ordine, quindi una sincronizzazione interrotta riprende da dove si era fermata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule は変更を順番に読み込むため、中断された同期は停止した位置から再開されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule은 변경 사항을 순서대로 읽으므로, 중단된 동기화는 멈춘 곳부터 이어집니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule lê as alterações em ordem, então uma sincronização interrompida continua de onde parou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule читает изменения по порядку, поэтому прерванная синхронизация продолжается с места остановки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 按顺序读取更改，因此中断的同步会从停止处继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule 會依序讀取變更，因此中斷的同步會從停止的地方繼續。"
          }
        }
      }
    },
