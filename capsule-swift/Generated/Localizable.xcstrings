    "app.restore.verify.refused": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يستعيد Capsule هذه النسخة الاحتياطية ما دامت الفحوص أعلاه تفشل. يبقى الملف تمامًا كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule stellt dieses Backup nicht wieder her, solange die Prüfungen oben fehlschlagen. Die Datei bleibt genau so, wie sie ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule won't restore this backup while the checks above are failing. The file is left exactly as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule no restaurará esta copia de seguridad mientras fallen las comprobaciones anteriores. El archivo se deja exactamente como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule ne restaurera pas cette sauvegarde tant que les vérifications ci-dessus échouent. Le fichier reste exactement tel quel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक ऊपर की जाँचें विफल हो रही हैं, Capsule यह बैकअप रीस्टोर नहीं करेगा। फ़ाइल को ठीक वैसा ही छोड़ दिया गया है जैसी वह है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule non ripristinerà questo backup finché i controlli qui sopra non vengono superati. Il file resta esattamente com'è."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上のチェックが失敗している間、Capsule はこのバックアップを復元しません。ファイルはそのまま残されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위의 검사가 실패하는 동안 Capsule은 이 백업을 복원하지 않습니다. 파일은 있는 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Capsule não vai restaurar este backup enquanto as verificações acima estiverem falhando. O arquivo permanece exatamente como está."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule не будет восстанавливать эту резервную копию, пока проверки выше не пройдены. Файл остаётся в точности как есть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上述检查未通过时，Capsule 不会恢复此备份。文件将保持原样。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在上方的檢查未通過之前，Capsule 不會還原此備份。檔案會完全保持原樣。"
          }
        }
      }
    },
