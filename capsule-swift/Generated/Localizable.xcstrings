    "storage.cleanup_hint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفسح المجال لصورك وملفاتك والمزيد عن طريق تنظيف المساحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaffe Platz für deine Fotos, Dateien und mehr, indem du Speicherplatz aufräumst"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make room for your photos, files, and more by cleaning up space"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libera espacio para tus fotos, archivos y más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Libérez de l'espace pour vos photos, fichiers et plus encore en faisant le ménage"
