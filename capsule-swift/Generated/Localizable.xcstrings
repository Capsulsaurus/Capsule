    "app.quarantine.surface.federation.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصل محتوى من خادم آخر تعذّر على Capsule التحقق منه، لذا لم تتم إضافته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einem anderen Server sind Inhalte eingetroffen, die Capsule nicht verifizieren konnte, daher wurden sie nicht hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content arrived from another server that Capsule couldn't verify, so it wasn't added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llegó contenido de otro servidor que Capsule no pudo verificar, así que no se añadió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du contenu provenant d'un autre serveur n'a pas pu être vérifié par Capsule ; il n'a donc pas été ajouté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी अन्य सर्वर से ऐसी सामग्री आई जिसे Capsule सत्यापित नहीं कर सका, इसलिए उसे जोड़ा नहीं गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono arrivati contenuti da un altro server che Capsule non è riuscito a verificare, quindi non sono stati aggiunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Capsule が検証できなかった他のサーバーからコンテンツが届いたため、追加されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 서버에서 받은 콘텐츠를 Capsule이 검증할 수 없어 추가하지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chegou conteúdo de outro servidor que o Capsule não conseguiu verificar, então ele não foi adicionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С другого сервера пришёл контент, который Capsule не удалось проверить, поэтому он не был добавлен."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自另一台服务器的内容无法通过 Capsule 验证，因此未被添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有內容來自 Capsule 無法驗證的其他伺服器，因此未被加入。"
          }
        }
      }
    },
