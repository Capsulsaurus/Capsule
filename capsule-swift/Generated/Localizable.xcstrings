    "app.transfer.session.failed.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على الخادم إنهاء هذا الرفع. لم تُمسّ نسختك المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte diesen Upload nicht abschließen. Deine lokale Kopie ist unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server couldn't finish this upload. Your local copy is untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no pudo terminar esta subida. Tu copia local no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas pu terminer ce téléversement. Votre copie locale est intacte."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर यह अपलोड पूरा नहीं कर सका। आपकी स्थानीय कॉपी सुरक्षित है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non è riuscito a completare questo caricamento. La copia su questo dispositivo è intatta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはこのアップロードを完了できませんでした。ローカルのコピーには影響ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 이 업로드를 완료하지 못했습니다. 이 기기의 사본은 그대로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não conseguiu concluir este envio. Sua cópia local não foi afetada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверу не удалось завершить эту загрузку. Копия на этом устройстве не затронута."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器未能完成此上传。您设备上的副本未受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器無法完成這筆上傳。此裝置上的副本完全不受影響。"
          }
        }
      }
    },
