#!/usr/bin/env bash
#MISE description="Generate the capsule_sdk uniffi Kotlin/Swift bindings from its compiled cdylib"
set -euo pipefail
ext="so"; [ "$(uname)" = "Darwin" ] && ext="dylib"
out="target/bindings"
rm -rf "$out"

# The `capsule_sdk` namespace (one pinned uniffi, 0.31.1 — the S-F1 consolidation):
# capsule-sdk's `FfiCapsuleClient`/`FfiSession` user-flow primitives (S-D9), its
# `FfiWorkspace` workspace verbs (S-P1), and the hardware-signer and key-agreement
# seams the native harnesses implement. Generated library-mode from its own compiled
# cdylib. capsule-core exports no namespace of its own (ADR-0005); the Apple app's
# `capsule_core_ffi` catalog namespace is generated by capsule-swift's FFI build.
cargo build -p capsule-sdk --features ffi
lib="target/debug/libcapsule_sdk.${ext}"
for lang in kotlin swift; do
    cargo run -q -p capsule-sdk --features ffi-bindgen --bin uniffi-bindgen -- \
        generate --library "$lib" --language "$lang" --out-dir "$out/$lang"
done

# Smoke: the surface must have produced non-empty sources in both languages, and
# nothing else — a second namespace in the output means some crate in the cdylib's
# graph started exporting one, which is exactly what ADR-0005 rules out.
sdk_kt="$out/kotlin/uniffi/capsule_sdk/capsule_sdk.kt"
sdk_swift="$out/swift/capsule_sdk.swift"
for f in "$sdk_kt" "$sdk_swift"; do
    test -s "$f" || { echo "empty or missing binding source: $f" >&2; exit 1; }
done
for f in "$out"/kotlin/uniffi/* "$out"/swift/*.swift; do
    case "$f" in
        "$out/kotlin/uniffi/capsule_sdk" | "$sdk_swift") ;;
        *) echo "unexpected uniffi namespace in the capsule-sdk cdylib: $f" >&2; exit 1 ;;
    esac
done

# Non-empty is not enough: a verb that fails to cross the namespace boundary still
# leaves a large, plausible file behind. Assert the surfaces each lane actually
# consumes are present by name.
#
#   S-D9 — the networked user flows (login → upload → status → sync).
#   S-P1 — the capsule_sdk workspace verbs the whole iOS lane is blocked on:
#          enroll (incl. hardware-signer parity), album, seal+import, the
#          seal→upload bridge, verify, sync-apply, escrow, device directory.
#   S-D29 — the local alert surface: the shared predicate plus the per-class
#          pre-arm deadlines a client actually schedules its alarms from. The
#          arm call is the one that must not go missing: without it a client
#          can only ask "what is true now?", which is the question pre-arming
#          exists to stop it having to ask.
require() {  # $1=file  $2..=symbols
    local file="$1"; shift
    for sym in "$@"; do
        grep -q "$sym" "$file" \
            || { echo "binding surface missing '$sym' in $file" >&2; exit 1; }
    done
}
for f in "$sdk_kt" "$sdk_swift"; do
    require "$f" FfiCapsuleClient FfiSession
    require "$f" FfiWorkspace FfiHardwareSigner FfiSyncEntry FfiAssetFacts FfiUploadBlob
    require "$f" FfiAlert FfiClassDeadline FfiNotifyInput
done
# Both languages lower these free functions to the same camelCase spelling.
require "$sdk_swift" evaluateAlerts preArmDeadlines nextAlertDeadline
require "$sdk_kt" evaluateAlerts preArmDeadlines nextAlertDeadline
# Swift and Kotlin lower method names differently (camelCase vs camelCase on the
# object); assert the verbs per-language rather than assuming one spelling.
require "$sdk_swift" sealAsset uploadBlobs applySyncEntry escrowBlob \
    signedDeviceDirectory publishDeviceDirectory escrowPut escrowGet \
    createWithP256HardwareSigner
require "$sdk_kt" sealAsset uploadBlobs applySyncEntry escrowBlob \
    signedDeviceDirectory publishDeviceDirectory escrowPut escrowGet \
    createWithP256HardwareSigner
# The rest of what capsule-core-kotlin and capsule-core-swift drive (#424, #579): the
# Ed25519 hardware-signer constructor, the key-agreement seam and the hardware DEK
# round-trip, the device tier they enroll at, and the verify verb.
for f in "$sdk_kt" "$sdk_swift"; do
    require "$f" FfiHardwareKeyAgreement FfiHardwareSignerError FfiDeviceTier \
        createWithHardwareSigner p256HardwareDekRoundTrip verifyAsset
done

echo "uniffi bindings written to $out (capsule_sdk, kotlin + swift)"
echo "surface check passed: S-D9 client/session + S-P1 workspace verbs + S-D29 alert surface present in both languages"
