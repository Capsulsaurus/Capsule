#!/usr/bin/env bash
#MISE description="Generate the capsule_sdk uniffi Kotlin/Swift bindings and dump their surface (--check: fail if the dump is stale)"
set -euo pipefail
# `--check` verifies the committed capsule-sdk/bindings-surface.json instead of rewriting it;
# the Rust gate runs it that way. Anything else is a typo that must not silently mean "write".
check=""
case "${1:-}" in
    "") ;;
    --check) check="--check" ;;
    *) echo "usage: mise run gen-bindings [--check]" >&2; exit 2 ;;
esac
ext="so"; [ "$(uname)" = "Darwin" ] && ext="dylib"
out="target/bindings"
surface="target/bindings-surface"
rm -rf "$out" "$surface"

# The `capsule_sdk` namespace (one pinned uniffi, 0.31.1):
# capsule-sdk's `FfiCapsuleClient`/`FfiSession` user-flow primitives, its
# `FfiWorkspace` workspace verbs, and the hardware-signer and key-agreement
# seams the native harnesses implement. Generated library-mode from its own compiled
# cdylib. capsule-core exports no namespace of its own (ADR-0005); the Apple app's
# `capsule_core_ffi` catalog namespace is generated by capsule-swift's FFI build.
cargo build -p capsule-sdk --features ffi
lib="target/debug/libcapsule_sdk.${ext}"
for lang in kotlin swift; do
    cargo run -q -p capsule-sdk --features ffi-bindgen --bin uniffi-bindgen -- \
        generate --library "$lib" --language "$lang" --out-dir "$out/$lang"
    # A second, unformatted copy for the surface dump. uniffi runs ktlint over Kotlin when one
    # is on PATH; a developer's machine usually has it and the Rust CI job does not, so a dump
    # read from formatted output would depend on the machine that wrote it.
    cargo run -q -p capsule-sdk --features ffi-bindgen --bin uniffi-bindgen -- \
        generate --no-format --library "$lib" --language "$lang" --out-dir "$surface/$lang"
done

# Smoke: the surface must have produced non-empty sources in both languages, and
# nothing else — a second namespace in the output means some crate in the cdylib's
# graph started exporting one, which is exactly what ADR-0005 rules out.
sdk_kt="$out/kotlin/uniffi/capsule_sdk/capsule_sdk.kt"
sdk_swift="$out/swift/capsule_sdk.swift"
for f in "$sdk_kt" "$sdk_swift"; do
    test -s "$f" || { echo "empty or missing binding source: $f" >&2; exit 1; }
done
for f in "$out"/kotlin/uniffi/* "$out"/swift/*.swift; do
    case "$f" in
        "$out/kotlin/uniffi/capsule_sdk" | "$sdk_swift") ;;
        *) echo "unexpected uniffi namespace in the capsule-sdk cdylib: $f" >&2; exit 1 ;;
    esac
done

# Non-empty is not enough: a verb that fails to cross the namespace boundary still
# leaves a large, plausible file behind. `xtask bindings-surface` reads the declarations
# out of the unformatted copy, fails unless every verb the native clients consume is
# declared in both languages (its `REQUIRED` table: client/session, the workspace verbs,
# the alert surface, and the hardware seams) and the two languages declare the same
# names, then writes them to the committed capsule-sdk/bindings-surface.json that
# /reference/sdk/swift/ and /reference/sdk/kotlin/ are generated from.
cargo run -q -p xtask -- bindings-surface ${check:+"$check"}

echo "uniffi bindings written to $out (capsule_sdk, kotlin + swift)"
echo "surface check passed: every required declaration present in both languages"
