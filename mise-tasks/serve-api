#!/usr/bin/env bash
#MISE description="Run the API server locally: compose deps up, seed .env, migrate, serve (S-P7)"
set -euo pipefail

# One command between a clean checkout and a server the CLI and the iOS simulator can talk
# to. Before this, bring-up was an undocumented sequence of `podman compose up`, a
# hand-written .env, an `openssl genpkey` incantation, and `systemfd`/`cargo watch`.
#
# Deliberately NOT --release: `capsule-api/src/main.rs` runs `Migrator::up` only under
# `debug_assertions`, so a release build here would serve against an unmigrated database.

root="$(git rev-parse --show-toplevel)"
cd "$root"

env_file="capsule-api/.env"
compose_file="capsule-api/compose.yaml"

# podman ships a `docker` shim on most dev hosts; prefer whichever is actually present.
if [ -n "${COMPOSE_CMD:-}" ]; then
    read -r -a compose <<< "$COMPOSE_CMD"
elif command -v podman >/dev/null 2>&1; then
    compose=(podman compose)
elif command -v docker >/dev/null 2>&1; then
    compose=(docker compose)
else
    echo "error: neither podman nor docker found; install one or set COMPOSE_CMD" >&2
    exit 1
fi

echo "==> starting postgres + valkey (${compose[*]})"
"${compose[@]}" -f "$compose_file" up -d postgres valkey

# --- .env bootstrap -----------------------------------------------------------------
# The server refuses to boot without DATABASE_URL, VALKEY_URL and JWT_ED25519_DER, and it
# reports the first one missing as a bare `MissingVariable`. Rather than let that happen one
# variable at a time, seed or top up the file here and say exactly what was added.
if [ ! -f "$env_file" ]; then
    echo "==> no $env_file; seeding one from .env.example"
    cp capsule-api/.env.example "$env_file"
fi

have() { grep -qE "^${1}=" "$env_file"; }
add()  { printf '%s=%s
' "$1" "$2" >> "$env_file"; echo "==> added $1 to $env_file"; }

# JWT_ED25519_DER: no default is possible — mint one. Everything else has a sane local value.
if ! have JWT_ED25519_DER || grep -q 'JWT_ED25519_DER=\$(CHANGE_ME)' "$env_file"; then
    key="$(cargo run -q -p capsule-api --bin keygen -- --raw)"
    tmp="$(mktemp)"
    grep -v '^JWT_ED25519_DER=' "$env_file" > "$tmp" || true
    mv "$tmp" "$env_file"
    add JWT_ED25519_DER "$key"
    echo "    (SYNC_CURSOR_MAC_KEY and ATTESTATION_KEY_SEED derive from it by default)"
fi
have DATABASE_URL || add DATABASE_URL "postgresql://capsule:capsule@localhost:5432/capsule"
have VALKEY_URL   || add VALKEY_URL   "redis://127.0.0.1:6379"
have UPLOAD_DIR   || add UPLOAD_DIR   "./capsule-api/uploads"

# Blobs go to the filesystem UPLOAD_DIR (there is no object store); create it up front so a
# first upload does not fail on a missing directory.
upload_dir="$(grep -E '^UPLOAD_DIR=' "$env_file" | tail -1 | cut -d= -f2-)"
mkdir -p "$upload_dir"

# --- wait for deps ------------------------------------------------------------------
echo "==> waiting for postgres"
for _ in $(seq 1 60); do
    if "${compose[@]}" -f "$compose_file" exec -T postgres pg_isready -U capsule -q 2>/dev/null; then
        break
    fi
    sleep 1
done
"${compose[@]}" -f "$compose_file" exec -T postgres pg_isready -U capsule -q 2>/dev/null \
    || { echo "error: postgres did not become ready in 60s" >&2; exit 1; }

echo "==> waiting for valkey"
for _ in $(seq 1 30); do
    if "${compose[@]}" -f "$compose_file" exec -T valkey valkey-cli ping 2>/dev/null | grep -q PONG; then
        break
    fi
    sleep 1
done

# --- serve --------------------------------------------------------------------------
# The server calls `dotenvy::dotenv()`, which searches the *current* directory — and
# `cargo run -p capsule-api` runs from the workspace root, where there is no `.env`. Rather
# than cd into capsule-api/ (which would silently reinterpret every relative path in the
# file, UPLOAD_DIR included), export the file here and keep the root as cwd.
#
# Parsed line-by-line rather than sourced: values are base64 and URLs, and a stray `$(...)`
# in a config file must never become command substitution.
while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
        ''|'#'*) continue ;;
    esac
    key="${line%%=*}"
    val="${line#*=}"
    case "$key" in
        *[!A-Za-z0-9_]*|'') continue ;;   # not a shell-safe identifier; skip
    esac
    export "$key=$val"
done < "$env_file"

# Migrations run inside the server on a debug build; no separate migrate step needed here.
port="${SERVER_PORT:-3000}"
echo "==> serving on http://127.0.0.1:${port} (migrations run at startup on debug builds)"
echo "==> CLI:  export CAPSULE_ENDPOINT=http://127.0.0.1:${port}"
exec cargo run -p capsule-api
