#!/usr/bin/env bash
#MISE description="Build the Apple client for every destination (macOS only)"
set -euo pipefail
if [ "$(uname)" != "Darwin" ]; then echo "Skipping swift build (not macOS)"; exit 0; fi

# The mock lane by default: no Rust core, no xcframework, no cross-compile, so this
# runs from a clean checkout with only Xcode installed. Set TUIST_FFI=1 (after
# `mise run build-ffi-apple`) to build the Rust-backed graph instead.
cd capsule-swift
mise exec -- tuist generate --no-open
for destination in "generic/platform=macOS" "generic/platform=iOS Simulator"; do
    echo "▸ Building for ${destination}"
    set -o pipefail
    xcodebuild -workspace Capsule.xcworkspace -scheme Capsule -configuration Debug \
        -destination "${destination}" CODE_SIGNING_ALLOWED=NO build \
        | mise exec -- xcbeautify
done
