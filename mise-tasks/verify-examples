#!/usr/bin/env bash
#MISE description="Check HardwareSigner examples exist + run the software-signer smoke"
set -euo pipefail
# Each device-key backend ships a HardwareSigner reference example. This verifies they
# exist and runs the software-backend smoke (pure Rust — no uniffi/hardware/TPM). The
# native (Kotlin/Swift) and TPM examples are exercised locally per their READMEs; see
# capsule-core-{kotlin,swift}.
for f in \
    capsule-core/src/crypto/keys/software.rs \
    capsule-core/src/crypto/keys/tpm.rs \
    capsule-core-kotlin/src/main/kotlin/com/justin13888/capsule/hardware/SoftwareSigner.kt \
    capsule-core-kotlin/src/main/kotlin/com/justin13888/capsule/hardware/StrongBoxSigner.kt \
    capsule-core-swift/Sources/CapsuleHardware/SoftwareSigner.swift \
    capsule-core-swift/Sources/CapsuleHardware/SecureEnclaveSigner.swift; do
    test -f "$f" || { echo "missing HardwareSigner example: $f" >&2; exit 1; }
done
# The software-signer smoke: the simplest backend (no uniffi foreign trait, no hardware).
cargo nextest run -p capsule-core --features ffi --lib crypto::keys::software

# S-D9 + S-P1: the SDK's FFI surface must exist and its host-verifiable smoke must pass.
#
#   S-D9  — the networked user flow (login → upload → status), driven from Rust against
#           the established mock-HTTP-server pattern.
#   S-P1  — the workspace verbs the iOS lane is blocked on, driven as one flow
#           (enroll → album → seal+import → upload → sync-apply) through the FFI types,
#           plus escrow put/get, device-directory publish, and hardware-signer
#           constructor parity over the `FfiHardwareSigner` foreign-trait seam.
#
# The native (Swift + Kotlin) harnesses drive the same flows through the generated
# bindings against a dev server (platform CI's half; the Kotlin toolchain is unavailable
# on this host — see SLICES.md S-D9).
for f in \
    capsule-sdk/src/ffi.rs \
    capsule-sdk/src/ffi/workspace.rs; do
    test -f "$f" || { echo "missing SDK FFI surface: $f" >&2; exit 1; }
done
cargo nextest run -p capsule-sdk --features ffi --lib ffi::tests

# The `capsule_sdk` workspace verbs delegate to capsule-core for every cryptographic
# step; these are the core-side receiving/import halves S-P1 added, run here so the two
# sides of each verb are smoked together rather than only in the full suite.
cargo nextest run -p capsule-core --lib lifecycle::sync_apply lifecycle::import

echo "HardwareSigner examples present; software-signer + SDK FFI-flow (S-D9) + workspace-verb (S-P1) smokes passed"
