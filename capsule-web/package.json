{
    "name": "capsule-web",
    "version": "0.1.0",
    "type": "module",
    "license": "AGPL-3.0-only",
    "scripts": {
        "build": "rsbuild build",
        "build:analyze": "cross-env BUNDLE_ANALYZE=true bun run build",
        "build:doctor": "RSDOCTOR=true bun run build",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "dev": "rsbuild dev",
        "dev:analyze": "cross-env BUNDLE_ANALYZE=true bun run dev",
        "dev:doctor": "cross-env RSDOCTOR=true bun run dev",
        "preview": "rsbuild preview",
        "intl:extract": "formatjs extract 'src/**/*.{ts,tsx}' --out-file build/i18n-extracted.json",
        "intl:compile": "formatjs compile src/i18n/messages/en.json --ast --out-file build/i18n-en.json"
    },
    "dependencies": {
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-context-menu": "^2.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-direction": "^1.2.0",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@tailwindcss/postcss": "^4.3.5",
        "@tanstack/react-query": "^5.107.1",
        "@tanstack/react-query-devtools": "^5.107.1",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-table": "^9.3.1",
        "@tanstack/react-virtual": "^3.14.26",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "filesize": "^11.0.32",
        "lucide-react": "^1.73.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-intl": "^12.1.7",
        "react-qr-code": "^2.2.0",
        "sonner": "^2.0.8",
        "tailwind-merge": "^3.7.0",
        "tailwindcss": "^4.3.5"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.8",
        "@formatjs/cli": "^6.19.0",
        "@rsbuild/core": "^2.3.2",
        "@rsbuild/plugin-react": "^2.1.1",
        "@rsdoctor/rspack-plugin": "^1.6.5",
        "@tanstack/react-router-devtools": "^1.167.3",
        "@tanstack/router-plugin": "^1.169.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "cross-env": "^10.1.0",
        "typescript": "^7.0.2"
    }
}
