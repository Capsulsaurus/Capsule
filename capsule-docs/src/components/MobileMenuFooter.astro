---
// Starlight MobileMenuFooter override: Starlight's row of social links and
// preferences, with the version switcher. The section links are not repeated
// here: the header's section menu (SectionMenu.astro) carries them on every
// page.
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import VersionSelect from './VersionSelect.astro';
---

<div class="mobile-footer">
  <div class="mobile-preferences">
    <SocialIcons />
    <span class="spacer"></span>
    <VersionSelect />
    <ThemeSelect />
    <LanguageSelect />
  </div>
</div>

<style>
  .mobile-preferences {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    padding-block: 1rem;
    border-top: 1px solid var(--sl-color-hairline);
  }

  .spacer {
    flex: 1;
  }
</style>
