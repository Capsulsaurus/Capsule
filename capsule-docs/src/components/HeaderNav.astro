---
// The section links (Guides, Design, Reference and, once live, Blog). Rendered
// as a row in the header on wide screens and as a list in the header's section
// menu (SectionMenu.astro) on narrower ones. The list itself is
// src/lib/site-nav.mjs. On a locale's routes the links stay in that locale
// and carry its labels.
import { normalizeBase, stripBase } from '../lib/docs-version.mjs';
import { localizeLabel } from '../lib/nav-labels.mjs';
import { ariaCurrent, headerLinks } from '../lib/site-nav.mjs';

// Set in astro.config.mjs from src/lib/blog-posts.mjs.
declare const __BLOG_IS_LIVE__: boolean;

interface Props {
    /** `bar` lays the links out in a row; `menu` stacks them. */
    variant: 'bar' | 'menu';
}

const { variant } = Astro.props;
const { locale } = Astro.locals.starlightRoute;
const links = headerLinks({ blogIsLive: __BLOG_IS_LIVE__, locale });
// A release build lives under /v/X.Y/, so the current section is matched on
// the path without it. (Its links are rebased with the rest of the built
// HTML: src/lib/base-links.mjs.)
const base = normalizeBase(import.meta.env.BASE_URL);
const pathname = stripBase(Astro.url.pathname, base);
---

<nav class:list={['site-nav', variant]} aria-label={localizeLabel('Sections', locale)}>
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={ariaCurrent(link, pathname)}
      >
        <span class="label">{link.label}</span>
      </a>
    ))
  }
</nav>

<style>
  .site-nav {
    display: flex;
    gap: 0.25rem;
  }

  .site-nav a {
    padding: 0.375rem 0.75rem;
    border-radius: var(--capsule-radius-pill);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  .site-nav a[aria-current] {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
  }

  /* The row's spacing follows the form the header measured
     (src/lib/nav-fit.mjs): wide by default, tighter when that does not fit.
     A link can collapse to nothing (the pill form), so it clips its label,
     which keeps its own width and so stays measurable. */
  .bar {
    gap: var(--capsule-nav-gap, 0.25rem);
  }

  .bar a {
    flex: none;
    max-width: calc(
      var(--capsule-nav-label, 20rem) + 2 * var(--capsule-nav-pad-x, 0.75rem)
    );
    overflow: hidden;
    padding-inline: var(--capsule-nav-pad-x, 0.75rem);
  }

  .label {
    display: inline-block;
  }

  /* A list in a card: full-width rows tall enough to tap. */
  .menu {
    flex-direction: column;
    gap: 0.125rem;
  }

  .menu a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border-radius: var(--capsule-radius-sm);
    font-size: var(--sl-text-base);
  }

  .menu a:focus-visible {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }
</style>
