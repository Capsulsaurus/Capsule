---
// Starlight PageTitle override: renders an authored page's computed audit
// status (src/lib/page-audit.mjs) as a badge beside its title, with the commit
// and date it was last audited at; and on a page scripts/gen-reference.mjs
// generated, the banner that says so: which surface it documents, what it was
// generated from, and where to download that. The status mapping is shared
// with the sidebar (src/lib/status-badge.mjs).
import { Badge, Icon } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { commitUrl, entryAudit } from '../lib/entry-audit.mjs';
import { titleBadge } from '../lib/status-badge.mjs';

const { entry } = Astro.locals.starlightRoute;
const { generated } = entry.data;
// A generated page has no audit state; an audit on one would claim a review
// its artifact never had.
if (generated && entry.data.audit !== undefined) {
    throw new Error(`${entry.id} is generated and sets audit`);
}
const audit = entryAudit(entry);
const badge = titleBadge(audit?.status);
const pin = audit && 'commit' in audit ? audit : undefined;
---

{
  badge ? (
    <div class="title-with-status">
      <Default><slot /></Default>
      <Badge text={badge.text} variant={badge.variant} />
    </div>
  ) : (
    <Default><slot /></Default>
  )
}
{
  pin && (
    <p class="audit-pin not-content">
      {pin.status === 'audited' ? 'Audited' : 'Last audited'} as of{' '}
      <a href={commitUrl(pin.commit)}><code>{pin.commit.slice(0, 12)}</code></a> on{' '}
      <time datetime={pin.date}>{pin.date}</time>
      {pin.status === 'outdated' ? '; the page has changed since.' : '.'}
    </p>
  )
}
{
  generated && (
    <p class="generated-banner not-content">
      <span class="surface">{generated.surface}</span>
      <span class="generated" title="Regenerated from the code; CI fails if the two differ">Generated</span>
      <span class="source">from {generated.source}</span>
      {generated.download && (
        <a href={generated.download} download>
          <Icon name="download" size="1em" />
          {generated.download.split('/').pop()}
        </a>
      )}
    </p>
  )
}
{
  generated?.stale && (
    <p class="stale-banner not-content" role="note">
      The code this page documents changed on this branch after it was generated, so it may be
      stale. Regenerate the artifact to refresh it.
    </p>
  )
}

<style>
  .title-with-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 1rem;
  }

  /* Default's h1 carries its own margin-block-start: 1rem, which would inflate
     this flex item's box asymmetrically and throw off align-items: center
     relative to the actual heading glyphs. Move that spacing to the
     wrapper above instead. */
  .title-with-status :global(h1) {
    margin-block-start: 0;
  }

  .audit-pin {
    margin-block-start: 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .audit-pin a {
    color: var(--sl-color-text-accent);
  }

  .stale-banner {
    margin-block-start: 0.5rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-orange);
    border-radius: 0.5rem;
    background: var(--sl-color-orange-low);
    color: var(--sl-color-orange-high);
    font-size: var(--sl-text-sm);
  }

  .generated-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-block-start: 0.75rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .surface,
  .generated {
    padding: 0.125rem 0.5rem;
    border-radius: var(--capsule-radius-pill);
    font-weight: 600;
    font-size: var(--sl-text-xs);
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .surface {
    background: var(--sl-color-accent-low);
    color: var(--sl-color-text-accent);
  }

  .generated {
    border: 1px dashed var(--sl-color-gray-4);
    color: var(--sl-color-gray-2);
  }

  .generated-banner a {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-start: auto;
    color: var(--sl-color-text-accent);
    font-weight: 500;
    text-decoration: none;
  }

  .generated-banner a:hover {
    text-decoration: underline;
  }
</style>
