---
// Starlight PageTitle override: renders the `status` frontmatter field
// (see src/content.config.ts) as a badge beside the page title. The mapping
// is shared with the sidebar (src/lib/status-badge.mjs).
import { Badge } from '@astrojs/starlight/components';
import Default from '@astrojs/starlight/components/PageTitle.astro';
import { titleBadge } from '../lib/status-badge.mjs';

const badge = titleBadge(Astro.locals.starlightRoute.entry.data.status);
---

{
  badge ? (
    <div class="title-with-status">
      <Default><slot /></Default>
      <Badge text={badge.text} variant={badge.variant} />
    </div>
  ) : (
    <Default><slot /></Default>
  )
}

<style>
  .title-with-status {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  /* Default's h1 carries its own margin-top: 1rem, which would inflate
     this flex item's box asymmetrically and throw off align-items: center
     relative to the actual heading glyphs. Move that spacing to the
     wrapper above instead. */
  .title-with-status :global(h1) {
    margin-top: 0;
  }
</style>
