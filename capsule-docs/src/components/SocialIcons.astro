---
// Starlight SocialIcons override. GitHub is the one link a reader comes
// looking for, so it is a labelled, outlined button rather than a bare glyph.
// Any other social link (the blog plugin adds RSS) stays a quiet icon.
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';

const links = config.social ?? [];
const github = links.find((link) => link.icon === 'github');
const others = links.filter((link) => link !== github);
---

{
  github && (
    <a class="github" href={github.href} rel="me">
      <Icon name="github" size="1.125rem" />
      <span>{github.label}</span>
    </a>
  )
}
{
  others.map(({ label, href, icon }) => (
    <a class="icon" href={href} rel="me">
      <span class="sr-only">{label}</span>
      <Icon name={icon} />
    </a>
  ))
}

<style>
  .github {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 2.25rem;
    padding-inline: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
  }

  .github:hover,
  .github:focus-visible {
    border-color: var(--sl-color-gray-3);
    background: var(--sl-color-gray-6);
  }

  .icon {
    display: flex;
    padding: 0.5em;
    margin: -0.5em;
    color: var(--sl-color-gray-3);
  }

  .icon:hover {
    color: var(--sl-color-white);
  }
</style>
