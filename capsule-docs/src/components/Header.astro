---
// Starlight Header override. Wide screens: the wordmark, the section links
// centred in the free space, then search, GitHub and the theme toggle. Narrow
// screens keep Starlight's layout (title and search), and the section links
// move into the mobile menu (MobileMenuFooter.astro). The layout is a contract
// of the Visual Language doc (development/visual-language.md).
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import config from 'virtual:starlight/user-config';
import HeaderNav from './HeaderNav.astro';
import VersionSelect from './VersionSelect.astro';

// Mirrors Starlight's own Header: search renders when Pagefind is on or the
// Search component is overridden.
const shouldRenderSearch =
    config.pagefind ||
    config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper">
    <SiteTitle />
  </div>
  <div class="nav-wrapper print:hidden">
    <HeaderNav variant="bar" />
  </div>
  <div class="right-group print:hidden">
    {shouldRenderSearch && <div class="search"><Search /></div>}
    <div class="actions">
      <VersionSelect />
      <SocialIcons />
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    display: flex;
    /* Keep a long title from covering the search and menu buttons. */
    overflow: clip;
    /* Leave room for the title link's focus ring. */
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .nav-wrapper,
  .actions {
    display: none;
  }

  .right-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .actions {
    align-items: center;
    gap: 0.75rem;
  }

  /* Every rule below depends on the window's width alone, never on the
     page's layout, so the bar is the same on every page: the splash front
     page, which has no sidebar, included. (Starlight's own header sizes its
     title column from --sl-content-inline-start, which only sidebar pages
     set, so its bar moves between the two.) */
  @media (min-width: 50rem) {
    .header {
      display: grid;
      grid-template-columns: auto 1fr auto;
    }

    /* Its own column, whether or not the section links are shown. */
    .right-group {
      grid-column: 3;
    }

    .actions {
      display: flex;
    }

    /* Search shrinks to a compact field so the section links own the middle. */
    .search {
      width: clamp(9rem, 16vw, 15rem);
    }
  }

  /* The section links need the width the table of contents also waits for.
     Below it, the sidebar (and on narrow screens the menu) carries them. */
  @media (min-width: 72rem) {
    .header {
      /* The title column runs to the sidebar's edge, so the wordmark lines
         up with the navigation below it. */
      grid-template-columns:
        minmax(calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x)), auto)
        1fr
        auto;
    }

    .nav-wrapper {
      display: flex;
      justify-content: center;
      min-width: 0;
    }
  }
</style>
