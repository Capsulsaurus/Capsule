---
// Starlight Header override: the wordmark, the section links centred in the
// free space, then search, GitHub and the theme toggle. The section links take
// the widest form that fits the free space (src/lib/nav-fit.mjs): the row as
// designed, the same row tighter, or one section menu beside the wordmark
// (SectionMenu.astro), animating between them as the space changes. They fold
// only when they would otherwise meet a neighbour, on every page: the mobile
// menu exists only on pages with a sidebar. Below 50rem the preferences leave
// the bar for the mobile menu (MobileMenuFooter.astro), or the section menu
// where there is none. The layout is a contract of the Visual Language doc
// (development/visual-language.md).
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
import config from 'virtual:starlight/user-config';
import { installScript as navFitScript } from '../lib/nav-fit.mjs';
import HeaderNav from './HeaderNav.astro';
import SectionMenu from './SectionMenu.astro';
import VersionSelect from './VersionSelect.astro';

// Mirrors Starlight's own Header: search renders when Pagefind is on or the
// Search component is overridden.
const shouldRenderSearch =
    config.pagefind ||
    config.components.Search !== '@astrojs/starlight/components/Search.astro';
---

<div class="header">
  <div class="title-wrapper">
    <SiteTitle />
  </div>
  <div class="nav-wrapper print:hidden" data-section-nav>
    <div class="fold">
      <div class="bar"><HeaderNav variant="bar" /></div>
      <div class="pill"><SectionMenu /></div>
    </div>
  </div>
  <div class="right-group print:hidden">
    {shouldRenderSearch && <div class="search"><Search /></div>}
    <div class="actions">
      <VersionSelect />
      <SocialIcons />
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>
{/* After the whole bar, so the free space it measures is final; classic and
    inline, so the links open in their form rather than animating into it. */}
<script is:inline set:html={navFitScript()} />

<style>
  .header {
    display: flex;
    gap: var(--sl-nav-gap);
    justify-content: space-between;
    align-items: center;
    height: 100%;
  }

  .title-wrapper {
    display: flex;
    /* Keep a long title from covering the search and menu buttons. */
    overflow: clip;
    /* Leave room for the title link's focus ring. */
    padding: 0.25rem;
    margin: -0.25rem;
    min-width: 0;
  }

  .actions {
    display: none;
  }

  /* The free space between the wordmark and the search field, sized by the
     bar alone (`min-width: 0` in a `1fr` column, or a zero-basis flex item),
     never by the links in it: nav-fit.mjs measures it to pick their form.
     The clip is a backstop that keeps a link mid-animation from painting over
     a neighbour; its margin leaves room for a focus ring. */
  .nav-wrapper {
    display: flex;
    flex: 1;
    min-width: 0;
    overflow: clip;
    overflow-clip-margin: 0.25rem;
  }

  /* The row and the pill share one grid cell, so the cell is as wide as the
     larger of the two: folding the row's links to nothing narrows it to the
     pill. Centred in the free space; the pill form slides to the start, beside
     the wordmark. */
  .fold {
    display: grid;
    align-items: center;
    position: relative;
    inset-inline-start: 50%;
    translate: -50% 0;
  }

  :global([dir="rtl"]) .fold {
    translate: 50% 0;
  }

  .bar,
  .pill {
    grid-area: 1 / 1;
    display: flex;
  }

  .pill {
    justify-self: start;
    opacity: 0;
    visibility: hidden;
    scale: 0.92;
  }

  /* The pill form. Also the form before the script has measured, so a page
     never paints a row that may not fit. */
  .nav-wrapper:is([data-fit="pill"], :not([data-fit])) .fold {
    inset-inline-start: 0;
    translate: 0 0;
  }

  .nav-wrapper:is([data-fit="pill"], :not([data-fit])) .bar {
    opacity: 0;
    visibility: hidden;
  }

  .nav-wrapper:is([data-fit="pill"], :not([data-fit])) .bar :global(.site-nav) {
    gap: 0;
  }

  .nav-wrapper:is([data-fit="pill"], :not([data-fit])) .bar :global(a) {
    max-width: 0;
    padding-inline: 0;
  }

  .nav-wrapper:is([data-fit="pill"], :not([data-fit])) .pill {
    opacity: 1;
    visibility: visible;
    scale: 1;
  }

  /* Every change of form after the first animates: the links narrow, fold
     away and fade as the pill grows in from the start, and back. `visibility`
     flips at the end of a fade out and the start of a fade in, so neither
     form is focusable while hidden. */
  @media (prefers-reduced-motion: no-preference) {
    .nav-wrapper[data-fit-ready] {
      --capsule-fold-ease: cubic-bezier(0.2, 0.8, 0.2, 1);
      --capsule-fold-time: 280ms;
    }

    .nav-wrapper[data-fit-ready] .fold {
      transition:
        inset-inline-start var(--capsule-fold-time) var(--capsule-fold-ease),
        translate var(--capsule-fold-time) var(--capsule-fold-ease);
    }

    .nav-wrapper[data-fit-ready] .bar :global(.site-nav) {
      transition: gap var(--capsule-fold-time) var(--capsule-fold-ease);
    }

    .nav-wrapper[data-fit-ready] .bar :global(a) {
      transition:
        max-width var(--capsule-fold-time) var(--capsule-fold-ease),
        padding-inline var(--capsule-fold-time) var(--capsule-fold-ease);
    }

    .nav-wrapper[data-fit-ready] .bar,
    .nav-wrapper[data-fit-ready] .pill {
      transition:
        opacity calc(var(--capsule-fold-time) * 0.6) ease,
        visibility calc(var(--capsule-fold-time) * 0.6),
        scale var(--capsule-fold-time) var(--capsule-fold-ease);
    }

    /* The pill arrives once the links have mostly folded; the row starts
       back only once the pill has gone. */
    .nav-wrapper[data-fit-ready][data-fit="pill"] .pill,
    .nav-wrapper[data-fit-ready]:not([data-fit="pill"]) .bar {
      transition-delay: calc(var(--capsule-fold-time) * 0.4);
    }
  }

  .right-group {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .actions {
    align-items: center;
    gap: 0.75rem;
  }

  /* Every rule below depends on the window's width alone, never on the
     page's layout, so the bar is the same on every page: the splash front
     page, which has no sidebar, included. (Starlight's own header sizes its
     title column from --sl-content-inline-start, which only sidebar pages
     set, so its bar moves between the two.) */
  @media (min-width: 50rem) {
    .header {
      display: grid;
      grid-template-columns: auto 1fr auto;
    }

    /* Its own column, whether or not the section links are shown. */
    .right-group {
      grid-column: 3;
    }

    .actions {
      display: flex;
    }

    /* Search shrinks to a compact field so the section links own the middle. */
    .search {
      width: clamp(9rem, 16vw, 15rem);
    }
  }

  /* Where the table of contents appears, the title column runs to the
     sidebar's edge, so the wordmark lines up with the navigation below it. */
  @media (min-width: 72rem) {
    .header {
      grid-template-columns:
        minmax(calc(var(--sl-sidebar-width) - var(--sl-nav-pad-x)), auto)
        1fr
        auto;
    }
  }
</style>
