---
// The docs version switcher: Latest (master, at /) and every released
// version (/v/X.Y/). The released list is /versions.json on production, read
// at runtime, so an old version's switcher lists the releases after it
// without being rebuilt. Hidden until there is a release to switch to. The
// URL layout is src/lib/docs-version.mjs.

// Set in astro.config.mjs: the release this build is, or null for Latest.
declare const __DOCS_VERSION__: string | null;
const current = __DOCS_VERSION__;
---

<capsule-version-select data-current={current ?? ''} hidden>
  <select aria-label="Docs version">
    <option value="">{current ? `v${current}` : 'Latest'}</option>
  </select>
</capsule-version-select>

<script>
  import {
    normalizeBase,
    releasedVersions,
    switchTarget,
  } from '../lib/docs-version.mjs';

  class VersionSelect extends HTMLElement {
    async connectedCallback() {
      const select = this.querySelector('select');
      if (!select) return;
      let versions: string[] = [];
      try {
        // Absolute: production serves the list to every version.
        const response = await fetch('/versions.json', { cache: 'no-cache' });
        versions = releasedVersions(await response.json());
      } catch {
        return;
      }
      if (versions.length === 0) return;
      const current = this.dataset.current ?? '';
      select.replaceChildren(
        new Option('Latest', '/', false, current === ''),
        ...versions.map(
          (v) => new Option(`v${v}`, `/v/${v}/`, false, v === current),
        ),
      );
      this.hidden = false;
      const fromBase = normalizeBase(import.meta.env.BASE_URL);
      select.addEventListener('change', async () => {
        const toBase = select.value;
        const target = switchTarget(location.pathname, fromBase, toBase);
        // The same page when it exists in that version, its home otherwise.
        const exists = await fetch(target, { method: 'HEAD' })
          .then((r) => r.ok)
          .catch(() => false);
        location.assign(exists ? target + location.hash : toBase);
      });
    }
  }
  customElements.define('capsule-version-select', VersionSelect);
</script>

<style>
  select {
    padding: 0.25rem 1.75rem 0.25rem 0.625rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    background-color: transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  select:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-3);
  }
</style>
