---
// The docs version switcher: Latest (master, at /) and every released
// version (/v/X.Y/). Always shown, so a reader can see which version they are
// reading; until a release exists it holds this build's version alone. The
// released list is /versions.json on production, read at runtime, so an old
// version's switcher lists the releases after it without being rebuilt. The
// URL layout is src/lib/docs-version.mjs.

// Set in astro.config.mjs: the release this build is, or null for Latest.
declare const __DOCS_VERSION__: string | null;
const current = __DOCS_VERSION__;
---

<capsule-version-select data-current={current ?? ''}>
  <select aria-label="Docs version">
    <option value="" selected>{current ? `v${current}` : 'Latest'}</option>
  </select>
</capsule-version-select>

<script>
  import {
    normalizeBase,
    releasedVersions,
    switchTarget,
  } from '../lib/docs-version.mjs';

  class VersionSelect extends HTMLElement {
    async connectedCallback() {
      const select = this.querySelector('select');
      if (!select) return;
      let versions: string[] = [];
      try {
        // Absolute: production serves the list to every version.
        const response = await fetch('/versions.json', { cache: 'no-cache' });
        versions = releasedVersions(await response.json());
      } catch {
        // No list (offline, or a preview without it): the switcher keeps
        // naming this build's version and offers nothing to switch to.
        return;
      }
      if (versions.length === 0) return;
      const current = this.dataset.current ?? '';
      select.replaceChildren(
        new Option('Latest', '/', false, current === ''),
        ...versions.map(
          (v) => new Option(`v${v}`, `/v/${v}/`, false, v === current),
        ),
      );
      const fromBase = normalizeBase(import.meta.env.BASE_URL);
      select.addEventListener('change', async () => {
        const toBase = select.value;
        const target = switchTarget(location.pathname, fromBase, toBase);
        // The same page when it exists in that version, its home otherwise.
        const exists = await fetch(target, { method: 'HEAD' })
          .then((r) => r.ok)
          .catch(() => false);
        location.assign(exists ? target + location.hash : toBase);
      });
    }
  }
  customElements.define('capsule-version-select', VersionSelect);
</script>

<style>
  capsule-version-select {
    display: inline-flex;
  }

  /* A pill the height of the theme toggle beside it. */
  select {
    height: var(--capsule-control-size);
    padding-inline: 0.75rem 1.75rem;
    border: 1px solid var(--capsule-control-border);
    border-radius: var(--capsule-radius-pill);
    background-color: transparent;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  /* With nothing to switch to, it is a label, not a control. */
  select:has(option:only-child) {
    cursor: default;
  }

  select:hover,
  select:focus-visible {
    color: var(--sl-color-white);
    border-color: var(--capsule-control-border-hover);
    background-color: var(--sl-color-gray-6);
  }
</style>
