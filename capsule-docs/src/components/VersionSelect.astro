---
// The docs version switcher: Latest (master, at /) and every released
// version (/v/X.Y/). Always shown, so a reader can see which version they are
// reading; until a release exists it holds this build's version alone. The
// released list is /versions.json on production, read at runtime, so an old
// version's switcher lists the releases after it without being rebuilt. The
// URL layout is src/lib/docs-version.mjs; what the menu lists, keyboard focus
// and which side it opens on are src/lib/version-menu.mjs.
//
// A pill button that discloses a list of links, drawn in the site's own
// controls rather than the browser's native dropdown, which no page style
// reaches. Each item is a real link to the same page in that version, so it
// can be opened in a new tab.
import { currentLabel } from '../lib/version-menu.mjs';

// Set in astro.config.mjs: the release this build is, or null for Latest.
declare const __DOCS_VERSION__: string | null;
const current = __DOCS_VERSION__;
---

<capsule-version-select data-current={current ?? ''}>
  <button type="button" class="trigger" aria-expanded="false" disabled>
    <span class="sr-only">Docs version:</span>
    <span class="label">{currentLabel(current ?? '')}</span>
    <svg
      class="chevron"
      aria-hidden="true"
      viewBox="0 0 16 16"
      width="12"
      height="12"
    >
      <path
        d="m4 6 4 4 4-4"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </button>
  <ul class="menu" hidden></ul>
</capsule-version-select>

<script>
  import { normalizeBase } from '../lib/docs-version.mjs';
  import { menuEntries, moveFocus, placement } from '../lib/version-menu.mjs';

  /** The check mark beside the version being read. */
  const CHECK =
    '<svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14"><path d="m3.5 8.5 3 3 6-7" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/></svg>';

  let instances = 0;

  class VersionSelect extends HTMLElement {
    async connectedCallback() {
      const trigger = this.querySelector<HTMLButtonElement>('.trigger');
      const menu = this.querySelector<HTMLUListElement>('.menu');
      if (!trigger || !menu) return;
      let json: unknown;
      try {
        // Absolute: production serves the list to every version.
        const response = await fetch('/versions.json', { cache: 'no-cache' });
        json = await response.json();
      } catch {
        // No list (offline, or a preview without it): the switcher keeps
        // naming this build's version and offers nothing to switch to.
        return;
      }
      const fromBase = normalizeBase(import.meta.env.BASE_URL);
      const entries = menuEntries(
        json,
        this.dataset.current ?? '',
        location.pathname,
        fromBase,
      );
      // Nothing to switch to: it stays a label, not a control.
      if (entries.length === 0) return;

      menu.id = `capsule-version-menu-${++instances}`;
      menu.replaceChildren(
        ...entries.map((entry) => {
          const item = document.createElement('li');
          const link = document.createElement('a');
          link.href = entry.href;
          link.dataset.base = entry.base;
          link.textContent = entry.label;
          if (entry.current) {
            link.setAttribute('aria-current', 'page');
            link.insertAdjacentHTML('beforeend', CHECK);
          }
          item.append(link);
          return item;
        }),
      );
      const links = [...menu.querySelectorAll('a')];
      trigger.setAttribute('aria-controls', menu.id);
      trigger.disabled = false;
      this.dataset.ready = '';

      const isOpen = () => trigger.getAttribute('aria-expanded') === 'true';
      const open = (focus?: 'current' | 'first' | 'last') => {
        menu.hidden = false;
        const box = trigger.getBoundingClientRect();
        this.dataset.placement = placement(
          window.innerHeight - box.bottom,
          box.top,
          menu.offsetHeight + 8,
        );
        trigger.setAttribute('aria-expanded', 'true');
        const current = links.findIndex((link) => link.hasAttribute('aria-current'));
        const index =
          focus === 'first'
            ? 0
            : focus === 'last'
              ? links.length - 1
              : Math.max(current, 0);
        if (focus) links[index]?.focus();
      };
      const close = (returnFocus: boolean) => {
        if (!isOpen()) return;
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        if (returnFocus) trigger.focus();
      };

      trigger.addEventListener('click', () => {
        if (isOpen()) close(false);
        else open();
      });
      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          open(event.key === 'ArrowDown' ? 'current' : 'last');
        }
      });
      menu.addEventListener('keydown', (event) => {
        const index = links.indexOf(document.activeElement as HTMLAnchorElement);
        const next = moveFocus(event.key, index, links.length);
        if (next !== null) {
          event.preventDefault();
          links[next]?.focus();
        }
      });
      this.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
          event.preventDefault();
          close(true);
        }
      });
      // Focus or a click anywhere else closes it.
      this.addEventListener('focusout', (event) => {
        if (!this.contains(event.relatedTarget as Node | null)) close(false);
      });
      document.addEventListener('pointerdown', (event) => {
        if (!this.contains(event.target as Node)) close(false);
      });

      // A plain click goes to the same page in that version when it exists
      // there, and to that version's home otherwise. A modified click (new
      // tab, new window) is left to the browser.
      menu.addEventListener('click', async (event) => {
        const link = (event.target as Element).closest('a');
        if (!link || event.defaultPrevented) return;
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
          return;
        }
        event.preventDefault();
        if (link.hasAttribute('aria-current')) {
          close(true);
          return;
        }
        const exists = await fetch(link.href, { method: 'HEAD' })
          .then((r) => r.ok)
          .catch(() => false);
        location.assign(
          exists ? link.href + location.hash : (link.dataset.base ?? '/'),
        );
      });
    }
  }
  customElements.define('capsule-version-select', VersionSelect);
</script>

<style>
  capsule-version-select {
    position: relative;
    display: inline-flex;
  }

  /* A pill the height of the theme toggle beside it. */
  .trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    height: var(--capsule-control-size);
    padding-inline: 0.875rem 0.75rem;
    border: 1px solid var(--capsule-control-border);
    border-radius: var(--capsule-radius-pill);
    background: transparent;
    color: var(--sl-color-gray-2);
    font: inherit;
    font-size: var(--sl-text-xs);
    font-weight: 600;
    cursor: pointer;
  }

  /* With nothing to switch to, it is a label, not a control: no chevron,
     no hover, and the label keeps its full colour. */
  .trigger:disabled {
    padding-inline: 0.875rem;
    cursor: default;
  }

  .trigger:disabled .chevron {
    display: none;
  }

  .chevron {
    transition: transform 150ms ease;
  }

  .trigger[aria-expanded='true'] .chevron {
    transform: rotate(180deg);
  }

  .trigger:not(:disabled):hover,
  .trigger:focus-visible,
  .trigger[aria-expanded='true'] {
    color: var(--sl-color-white);
    border-color: var(--capsule-control-border-hover);
    background: var(--sl-color-gray-6);
  }

  /* The popup: a raised card in the page's colours, right-aligned under
     the pill, or above it when only that side has room. */
  /* The items are created at runtime, outside Astro's scoping, so their
     rules are :global() under the scoped .menu. */
  .menu {
    position: absolute;
    inset-inline-end: 0;
    top: calc(100% + 0.375rem);
    z-index: 10;
    min-width: max(100%, 8.5rem);
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    border: 1px solid var(--sl-color-hairline-light);
    border-radius: var(--capsule-radius-card);
    background: var(--sl-color-bg);
    box-shadow: var(--sl-shadow-md);
  }

  .menu[hidden] {
    display: none;
  }

  capsule-version-select[data-placement='above'] .menu {
    top: auto;
    bottom: calc(100% + 0.375rem);
  }

  .menu :global(a) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.375rem 0.625rem;
    border-radius: var(--capsule-radius-sm);
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
  }

  .menu :global(a:hover),
  .menu :global(a:focus-visible) {
    color: var(--sl-color-white);
    background: var(--sl-color-gray-6);
  }

  /* Inside the card's edge, so the ring is never clipped and still shows
     on the version being read, whose tint hover cannot change. */
  .menu :global(a:focus-visible) {
    outline: 2px solid var(--sl-color-text-accent);
    outline-offset: -2px;
  }

  /* The version being read: the accent pill the sidebar gives the current
     page, with a check mark. */
  .menu :global(a[aria-current='page']) {
    color: var(--sl-color-text-accent);
    background: var(--sl-color-accent-low);
    font-weight: 600;
  }
</style>
