<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon background. Deep indigo through violet: the product is a private
     archive, and the palette leans away from the bright greens and blues every other
     gallery app uses. Drawn at the full 108dp adaptive canvas so the launcher can crop
     it to any mask without revealing an edge. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:offset="0" android:color="#FF241A4D" />
                <item android:offset="0.55" android:color="#FF3B2A87" />
                <item android:offset="1" android:color="#FF6D4BD6" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- A soft off-centre glow so the mark does not sit on flat colour. -->
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:centerX="74"
                android:centerY="30"
                android:gradientRadius="70"
                android:type="radial">
                <item android:offset="0" android:color="#4DFFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
