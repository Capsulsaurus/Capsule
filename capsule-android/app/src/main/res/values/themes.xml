<?xml version="1.0" encoding="utf-8"?>
<!-- The app draws entirely in Compose; this platform theme exists only so the window
     background and system-bar handling are correct before the first frame. -->
<resources>
    <style name="Theme.Capsule" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/background_dark</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
