DATABASE_URL=postgresql://capsule:capsule@localhost:5432/capsule
VALKEY_URL=redis://127.0.0.1:6379

SERVER_HOST=0.0.0.0
SERVER_PORT=3000

# In production, it should be your public domain (e.g. api.capsule.com)
SERVER_DOMAIN=localhost

# PKCS#8 v1 DER-encoded ED25519 key encoded in base64
# Generate: `openssl genpkey -algorithm ed25519 -outform DER | base64 -w 0`
# Convert to PEM: `echo "MC4CAQAwBQYDK2VwBCIEIN6eTvXEL7xMZWHY8rTk7VbQSGSuRkle5MVfiiYUStLF" | base64 -d | openssl pkey -inform DER -pubout`
# Example value for `JWT_ED25519_DER`: `MC4CAQAwBQYDK2VwBCIEIN6eTvXEL7xMZWHY8rTk7VbQSGSuRkle5MVfiiYUStLF`
JWT_ED25519_DER=$(CHANGE_ME)

# Where ciphertext blobs are written. There is no object store — this filesystem path is the
# blob backend, and `capsule-gc` / `capsule-scrub` read the same directory.
UPLOAD_DIR=./capsule-api/uploads

# Optional. Both are HKDF-derived from JWT_ED25519_DER when unset, which is the right default
# for a single-server deployment. Set them explicitly only to rotate one independently of the
# token-signing key, or to share attestation identity across replicas.
# SYNC_CURSOR_MAC_KEY=   # base64, exactly 32 bytes
# ATTESTATION_KEY_SEED=  # base64, 32 or 64 bytes
