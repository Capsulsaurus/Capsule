[package]
name = "capsule-api-media"
version.workspace = true
edition.workspace = true
license.workspace = true
publish.workspace = true

[lib]
name = "media"
path = "src/lib.rs"

[dependencies]
capsule-api-auth = { path = "../auth" }
capsule-api-entity = { path = "../entity" }
capsule-api-environment = { path = "../environment", features = ["media"] }
capsule-api-model = { path = "../model" }
capsule-api-service = { path = "../service" }
capsule-api-upload = { path = "../upload" }
# Deep-scan re-hashing (S-C3) + drop descriptor/verifier types (S-C5): the WASM-safe
# crypto/drop surface only — no on-device SQLite/native stack needed here (the upload
# crate's own capsule-core dependency unifies features in the workspace build anyway).
capsule-core = { path = "../../capsule-core", default-features = false }
capsule-i18n = { path = "../../capsule-i18n" }
capsule-wire = { path = "../../capsule-wire" }
base64 = { workspace = true }
bytes = { workspace = true }
derive_more = { workspace = true, features = ["from"] }
eyre = { workspace = true }
jiff = { workspace = true }
jsonwebtoken = { workspace = true }
# The public half of the deployment's operational Ed25519 signing key, recovered from the
# PKCS#8 DER for `.well-known/capsule/server-info` (S-C18) — the same parser the environment
# loader uses.
ring = { workspace = true }
salvo = { workspace = true }
sea-orm = { workspace = true, features = [
    "sqlx-postgres",
    "runtime-tokio-rustls",
] }
serde = { workspace = true }
serde_json = { workspace = true }
thiserror = { workspace = true }
tokio = { workspace = true }
tracing = { workspace = true }
uuid = { workspace = true }

[dev-dependencies]
migration = { path = "../migration", package = "capsule-api-migration" }
# The peer half of the federation surfaces this crate *publishes*: the capability
# scope gate (`authorize_blob_fetch`) a federated `/blob/{hash}` fetch passes before
# the takedown gate answers `410` (S-C17), and the verifier-side `RevocationList`
# that consumes the `.well-known/capsule/revoked-jti` document (S-C18). A dev-dep so
# the published document and the second server that reads it are exercised together;
# nothing in the media server depends on `sync` at build time.
sync = { path = "../sync", package = "capsule-api-sync" }
base64 = { workspace = true }
ed25519-dalek = { workspace = true }
nanoid = { workspace = true }
serde_json = { workspace = true }
salvo = { workspace = true, features = ["test"] }
sea-orm-migration = { workspace = true }
testcontainers = { workspace = true }
testcontainers-modules = { workspace = true }
tracing-subscriber = { workspace = true }
